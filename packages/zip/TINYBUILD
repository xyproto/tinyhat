set pkgname zip
set pkgver 3.0
set -g _pkgver (string replace . '' -- $pkgver)
set pkgrel 14
set pkgdesc 'Compressor/archiver for creating and modifying zipfiles'
set url http://www.info-zip.org/Zip.html
set arch i686 x32
set license LicenseRef-Info-ZIP
set depends bzip2
set flags arch
set source "https://downloads.sourceforge.net/infozip/$pkgname$_pkgver.tar.gz" \
    https://src.fedoraproject.org/rpms/zip/raw/rawhide/f/zip-3.0-currdir.patch \
    https://src.fedoraproject.org/rpms/zip/raw/rawhide/f/zip-3.0-exec-shield.patch \
    https://src.fedoraproject.org/rpms/zip/raw/rawhide/f/zip-3.0-format-security.patch \
    https://src.fedoraproject.org/rpms/zip/raw/rawhide/f/zipnote.patch \
    https://src.fedoraproject.org/rpms/zip/raw/rawhide/f/buffer_overflow.patch \
    https://sources.debian.org/data/main/z/zip/3.0-16/debian/patches/buffer-overflow-cve-2018-13410.patch \
    https://sources.debian.org/data/main/z/zip/3.0-16/debian/patches/fix-command-injection.patch
set sha256sums f0e8bb1f9b7eb0b01285495a2699df3a4b766784c1765a8f1aeedf63c0806369 \
    44cac3d4e8b447988b6e4eeb4bb6e701110cedfb09ea49eac471011328c8acab \
    10f0f3756a2415e33edf1455373b322404962b743b3a52a757b669e47dd7f1b2 \
    3759134487afad9c63e2e9693aa05b9dcc67f55a9ef961e82074b587b094292a \
    89249a3f1fdf838b795ce432a2d763fdbe913d6a146541e41b7a2e2769291ba0 \
    d74384c0159662b83c9b8080e92c77c0816a763e926014c612e672835a1ad1f7 \
    39461c3ffd5fbd2a377779855c9e3e87e30e0db235e41256c6547a752da1f388 \
    0905dd62604a4db8d7d9fb2bc228f355e90635fbc32208c21ed72bde1541bdc4

set options '!makeflags'

function prepare
    cd "$srcdir/$pkgname$_pkgver"; or return
    # | as the sed delimiter, since CFLAGS has paths in -ffile-prefix-map
    sed -e "/^CFLAGS_NOOPT =/s|\$| $CPPFLAGS $CFLAGS|" -i unix/Makefile; or return
    sed -e 's/CC=gcc/CC="gcc -std=gnu89"/' -i unix/Makefile; or return
    sed -e "s|^LFLAGS1=''|LFLAGS1=$LDFLAGS|" -i unix/configure; or return
    patch -p1 -i ../zip-3.0-currdir.patch; or return
    patch -p1 -i ../zip-3.0-exec-shield.patch; or return
    patch -p1 -i ../zip-3.0-format-security.patch; or return
    patch -p1 -i ../zipnote.patch; or return
    patch -p1 -i ../buffer_overflow.patch; or return
    patch -p1 -i ../buffer-overflow-cve-2018-13410.patch; or return
    patch -p1 -i ../fix-command-injection.patch; or return
end

function build
    cd "$srcdir/$pkgname$_pkgver"; or return
    make -f unix/Makefile prefix=/usr generic_gcc; or return
end

function package
    cd "$srcdir/$pkgname$_pkgver"; or return
    make -f unix/Makefile prefix="$pkgdir"/usr \
        MANDIR="$pkgdir"/usr/share/man/man1 \
        install; or return
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
