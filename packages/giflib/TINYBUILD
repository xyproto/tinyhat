set pkgname giflib
set pkgver 6.1.3
set pkgrel 2
set pkgdesc 'Library for reading and writing gif images'
set arch i686 x32
set url https://giflib.sourceforge.net/
set license MIT
set depends glibc
set makedepends docbook-xml docbook-xsl git imagemagick xmlto
set provides libgif.so
set flags arch
set source "$pkgname::git+https://git.code.sf.net/p/giflib/code#tag=$pkgver"
set sha512sums 8d2c425c9a5ae4f1ad00d302bf485148f67d7c29f6065e525c971808747a337015c34a79e331218300f601e256bc16ff68ccd051ebeb4a111a68a99d5c7a93d2

function prepare
    cd $pkgname; or return
    # security fixes not in the newest release
    git cherry-pick -n \
        061605081115bbfd7019bafc119a13b6f17fcf25; or return
    git cherry-pick -n \
        4a731eacbb1861e866e84024aba201f1cbf0f22f; or return
    git cherry-pick -n \
        8abe475b7dde75961ea46b9cb69aa7d658d002f3; or return
end

function build
    cd $pkgname; or return
    set CFLAGS (string replace -- _FORTIFY_SOURCE=3 _FORTIFY_SOURCE=2 $CFLAGS)
    make; or return
end

function check
    cd $pkgname; or return
    # failing tests
    make check; or true
end

function package
    cd $pkgname; or return
    make PREFIX=/usr DESTDIR="$pkgdir" install; or return
    install -vDm 644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
