set pkgbase fftw
set pkgname fftw fftw-openmpi
set pkgver 3.3.11
set pkgrel 1
set pkgdesc 'A library for computing the discrete Fourier transform (DFT)'
set arch i686 x32
set url http://www.fftw.org/
set license GPL-2.0-or-later
set makedepends bash cmake gcc-fortran glibc libgcc libgomp libquadmath openmpi
set flags arch
set source http://www.fftw.org/$pkgbase-$pkgver.tar.gz
set sha512sums ca1bf80490dc6955a0ab49b1af05d6658c2ecc0968b3bde5b4af22271e47d30cd38f6f8347e8e6124091b6a17717447942bee95f94ca29574ba71c4d167af351
set b2sums 4bd2ae0ada612243f0681b185230969da2bca6cfccb1e16d17f84459cbdd4ae84dc8a9ddb39ce5e4dfc7d0308709d1dc56688826299ee1017fc6115d16b2bd38
set -g _build_types single double long-double quad
set -g _soname 3.7.11

# Moves files (relative to the current directory, which is $pkgdir) to $srcdir/$argv[1], keeping their paths
function _pick
    set -l p $argv[1]
    for f in $argv[2..-1]
        set -l d "$srcdir/$p/"(string replace -- "$pkgdir/" '' $f)
        mkdir -p (dirname $d); or return
        mv $f $d; or return
        rmdir -p --ignore-fail-on-non-empty (dirname $f); or return
    end
end

function prepare
    # fix wrong soname in FFTW3LibraryDepends.cmake
    sed -e "s/3.6.9/$_soname/" -i $pkgbase-$pkgver/CMakeLists.txt; or return

    mv -v $pkgbase-$pkgver $pkgbase-$pkgver-single; or return
    for _name in $_build_types[2..-1]
        cp -av $pkgbase-$pkgver-single $pkgbase-$pkgver-$_name; or return
    end
end

function build
    set -l _configure \
        ./configure \
        --prefix=/usr \
        --enable-shared \
        --enable-threads \
        --enable-mpi \
        --enable-openmp \
        "MPILIBS=$(mpicc --showme:link)"
    set -l _configure_single \
        --enable-sse \
        --enable-avx \
        --enable-single
    set -l _configure_double \
        --enable-sse2 \
        --enable-avx
    set -l _configure_long_double \
        --enable-long-double
    set -l _configure_quad \
        --disable-mpi \
        --enable-quad-precision
    set -l _cmake_options \
        -B build \
        -S $pkgbase-$pkgver-$_build_types[1] \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_BUILD_TYPE=None \
        -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -D ENABLE_OPENMP=ON \
        -D ENABLE_THREADS=ON \
        -D ENABLE_FLOAT=ON \
        -D ENABLE_LONG_DOUBLE=ON \
        -D ENABLE_QUAD_PRECISION=ON \
        -D ENABLE_SSE=ON \
        -D ENABLE_SSE2=ON \
        -D ENABLE_AVX=ON \
        -D ENABLE_AVX2=ON

    # create missing FFTW3LibraryDepends.cmake
    # https://bugs.archlinux.org/task/67604
    cmake $_cmake_options; or return
    # fix broken IMPORTED_LOCATION: https://github.com/FFTW/fftw3/issues/130#issuecomment-1030280157
    sed -e 's|\(IMPORTED_LOCATION_NONE\).*|\1 "/usr/lib/libfftw3.so.3"|' -i build/FFTW3LibraryDepends.cmake; or return

    set -lx F77 gfortran
    # use upstream default CFLAGS while keeping our -march/-mtune
    set -a CFLAGS -O3 -fomit-frame-pointer -malign-double -fstrict-aliasing -ffast-math

    for _name in $_build_types
        cd "$srcdir/$pkgbase-$pkgver-$_name"; or return
        switch $_name
            case single
                $_configure $_configure_single; or return
            case double
                $_configure $_configure_double; or return
            case long-double
                $_configure $_configure_long_double; or return
            case quad
                $_configure $_configure_quad; or return
        end
        # fix overlinking because of libtool
        sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    end
    cd "$srcdir"; or return

    for _name in $_build_types
        make -C $pkgbase-$pkgver-$_name; or return
    end
end

function check
    for _name in $_build_types
        make smallcheck -C $pkgbase-$pkgver-$_name/tests; or return
    end
end

function package_fftw
    set depends bash glibc libgcc libgomp libquadmath
    set optdepends 'fftw-openmpi: for OpenMPI integration'
    set provides libfftw3q_threads.so libfftw3q_omp.so libfftw3q.so libfftw3l_threads.so libfftw3l_omp.so libfftw3l.so libfftw3f_threads.so libfftw3f_omp.so libfftw3f.so libfftw3_threads.so libfftw3_omp.so libfftw3.so

    for _name in $_build_types
        make DESTDIR="$pkgdir" install -C $pkgname-$pkgver-$_name; or return
    end
    set -l _somajor (string split -f1 . -- $_soname)
    pushd "$pkgdir"; or return
    _pick $pkgbase-openmpi usr/include/fftw3-mpi.h; or return
    _pick $pkgbase-openmpi usr/include/fftw3{,l}-mpi.f03; or return
    _pick $pkgbase-openmpi usr/lib/libfftw3{,f,l}_mpi.{a,so}; or return
    _pick $pkgbase-openmpi usr/lib/libfftw3{,f,l}_mpi.so.$_somajor; or return
    _pick $pkgbase-openmpi usr/lib/libfftw3{,f,l}_mpi.so.$_soname; or return
    popd; or return
    install -vDm 644 $pkgname-$pkgver-$_build_types[1]/{AUTHORS,ChangeLog,NEWS,README,TODO} -t "$pkgdir/usr/share/doc/$pkgname"; or return
    # install missing FFTW3LibraryDepends.cmake
    install -vDm 644 build/FFTW3LibraryDepends.cmake -t "$pkgdir/usr/lib/cmake/fftw3/"; or return
end

function package_fftw-openmpi
    set pkgdesc "$pkgdesc - OpenMPI libraries"
    set depends fftw glibc openmpi
    set provides libfftw3l_mpi.so libfftw3f_mpi.so libfftw3_mpi.so

    mv -v $pkgname/* "$pkgdir"; or return
end
