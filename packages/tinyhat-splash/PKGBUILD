pkgname=tinyhat-splash
pkgver=1.0.0
pkgrel=1
pkgdesc="Tiny Hat boot splash, boot and shutdown animations in C, and the Boot Animations gallery"
arch=(i686 x32)
url="https://github.com/xyproto/tinyhat-bootsplash"
license=(BSD-3-Clause)
depends=(gtk4)
makedepends=(kbd python)
optdepends=('tcc: building animations' 'make: building animations' 'orbiton: editing animations')
provides=(tinyhat-bootsplash)
source=("tinyhat-bootsplash-$pkgver.tar.gz::https://github.com/xyproto/tinyhat-bootsplash/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('9644910ff925e3f376657a6d1a5beaf25c5e88cabe8740848a9260ad7b76bc40')

prepare() {
  cd tinyhat-bootsplash-$pkgver
  local m
  for m in animations/*/Makefile templates/*/Makefile; do
    grep -q 'origin CC' "$m" ||
      sed -i 's/^CFLAGS ?= -O2 -Wall$/&\nifeq ($(origin CC),default)\nCC := $(if $(shell command -v cc 2>\/dev\/null),cc,tcc)\nendif/' "$m"
  done
}

build() {
  cd tinyhat-bootsplash-$pkgver
  local colors
  colors=$(python3 -c 'import sys, tomllib; d = tomllib.load(open(sys.argv[1], "rb")); print("-DHAT_COLOR=0x" + d["hat_color"][1:], "-DHAT_HIGHLIGHT_COLOR=0x" + d["hat_highlight_color"][1:])' /tinyhat/build/theme.toml)
  make PREFIX=/usr COLORS="$colors" SPLASH_LDFLAGS=-static
}

package() {
  cd tinyhat-bootsplash-$pkgver
  make PREFIX=/usr DESTDIR="$pkgdir" install
  strip --strip-all "$pkgdir/usr/bin/tinyhat-splash"
}
