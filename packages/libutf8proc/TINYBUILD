set pkgname libutf8proc
set pkgver 2.12.0
set -g _sover 3.3.0
set pkgrel 2
set pkgdesc 'C library for processing UTF-8 encoded Unicode strings'
set arch i686 x32
set url https://github.com/JuliaStrings/utf8proc
set nvchecker source=git git=https://github.com/JuliaStrings/utf8proc.git prefix=v
set license MIT custom
set depends glibc
set makedepends cmake git
set source "git+$url#tag=v$pkgver" \
    $pkgname.pc.in
set b2sums 202449ac0b85954348d4c08da6a9a75499a3647d83e3c2266d235f7bd17c1263f8fd660417bcc1ebc8a1abf36076cbaf02812b44ab575b70e3ad3393efb749aa \
    27cfd2086b63b0d9b08720d966d760e4237734a85a293eab81065f49857aa11ed57682a4bd26e4081701d34e61c156170b65bbf38f19387539f5472d0d94db23
set flags arch

function prepare
    sed "s#@VERSION@#$pkgver#" libutf8proc.pc.in >libutf8proc.pc; or return
end

function build
    cmake \
        -B build \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_INSTALL_LIBDIR=lib \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D BUILD_SHARED_LIBS=ON \
        -S utf8proc; or return
    make -C build; or return
end

function package
    # The install command does not work for libutf8proc
    cd utf8proc; or return
    install -Dm644 utf8proc.h "$pkgdir/usr/include/utf8proc.h"; or return
    install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"; or return
    install -Dm644 "$srcdir/$pkgname.pc" "$pkgdir/usr/lib/pkgconfig/$pkgname.pc"; or return
    install -Dm644 ../build/$pkgname.so.$_sover \
        "$pkgdir/usr/lib/$pkgname.so.$_sover"; or return
    ln -s $pkgname.so.$_sover "$pkgdir/usr/lib/$pkgname.so"; or return
    ln -s $pkgname.so.$_sover "$pkgdir/usr/lib/$pkgname.so."(string split . -- $_sover)[1]; or return
end
