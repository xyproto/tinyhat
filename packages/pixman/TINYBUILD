set pkgname pixman
set pkgver 0.46.4
set pkgrel 1
set pkgdesc 'The pixel-manipulation library for X and cairo'
set arch i686 x32
set url https://gitlab.freedesktop.org/pixman/pixman
set nvchecker source=gitlab gitlab=pixman/pixman host=gitlab.freedesktop.org use_max_tag=true prefix=pixman-
set license MIT
set depends glibc
set makedepends meson libpng
set provides libpixman-1.so
set source "https://www.x.org/releases/individual/lib/pixman-$pkgver.tar.xz"
set sha256sums a098c33924754ad43f981b740f6d576c70f9ed1006e12221b1845431ebce1239
set flags arch

function build
    arch-meson $pkgname-$pkgver build -D loongson-mmi=disabled -D vmx=disabled -D arm-simd=disabled -D neon=disabled -D a64-neon=disabled -D rvv=disabled -D mips-dspr2=disabled -D gtk=disabled; or return
    ninja -C build; or return
end

function package
    DESTDIR="$pkgdir" meson install -C build; or return
    install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 $pkgname-$pkgver/COPYING; or return
end
