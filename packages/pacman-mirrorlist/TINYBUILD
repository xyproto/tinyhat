set pkgname pacman-mirrorlist
# The archlinux32 mirror list: put a new mirrorlist here, then run ./update-list to update its header, pkgver and
# the checksums
set pkgver 20260322
set pkgrel 2
set pkgdesc 'Arch Linux mirror list for use by pacman'
set arch i686 x32 x86_64 aarch64
set url https://www.archlinux.org/mirrorlist/
set license GPL-2.0-or-later
set backup etc/pacman.d/mirrorlist
set source mirrorlist mirrorlist.x86_64 mirrorlist.aarch64
set sha256sums 868eb0a40b0dd0808a04e58c48f51c35990131f1e8092de5a4c6654be08be643 \
    80b0ab108bfcdf3e8edb4a62408568b635e4daf58169a49030ffbb7cd4334f57 \
    e25f0bc284287342b221377d2a0ca0203eaf13f52d369d6676c4730a8e2b1de1
set flags arch

function package
    mkdir -p "$pkgdir/etc/pacman.d"; or return
    set -l list mirrorlist
    contains -- $CARCH x86_64 aarch64; and set list mirrorlist.$CARCH
    install -m0644 "$srcdir/$list" "$pkgdir/etc/pacman.d/mirrorlist"; or return
end
