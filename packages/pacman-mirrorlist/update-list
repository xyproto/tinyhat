#!/bin/bash

cd "${0%/*}"

sed -i '
  1i ##\
## Arch Linux repository mirrorlist for i686\
## Generated on '"$(date +%F)"'\
##\

  1,/^$/d
' mirrorlist

sed -i \
  -e "s/^set pkgver .*/set pkgver $(date '+%Y%m%d')/" \
  -e "s/^set sha256sums .*/set sha256sums $(sha256sum mirrorlist | awk '{print $1}')/" \
  -e "s/^set b2sums .*/set b2sums $(b2sum mirrorlist | awk '{print $1}')/" \
  TINYBUILD
