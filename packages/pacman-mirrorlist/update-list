#!/bin/bash

cd "${0%/*}"

sed -i '
  1i ##\
## Arch Linux repository mirrorlist for i686\
## Generated on '"$(date +%F)"'\
##\

  1,/^$/d
' mirrorlist

sed -i "s/^set pkgver .*/set pkgver $(date '+%Y%m%d')/" TINYBUILD
MAKEP_CONF=../makep/root/etc/makep.conf fish ../makep/root/usr/bin/makep --updsums
