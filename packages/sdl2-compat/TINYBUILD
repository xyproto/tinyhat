set pkgname sdl2-compat
set pkgver 2.32.74
set pkgrel 1
set pkgdesc 'An SDL2 compatibility layer that uses SDL3 behind the scenes'
set arch i686 x32 x86_64 aarch64
set url https://github.com/libsdl-org/sdl2-compat
set license Zlib
set depends sdl3 glibc
set makedepends cmake ninja
set provides "sdl2=$pkgver"
set conflicts sdl2
set replaces sdl2
set source "https://github.com/libsdl-org/sdl2-compat/releases/download/release-$pkgver/sdl2-compat-$pkgver.tar.gz"
set sha512sums 9130719dc57137c22fe9d553fdae0400e6d9ad4fa55592dc942b4d79e3654478c494b932eebcfbe2f89da2f43bf37ea7705dcaea94c9bb5b01c655802cbd3b12
set flags arch

function build
    set -a CFLAGS -ffat-lto-objects
    cmake -S sdl2-compat-$pkgver -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=None; or return
    cmake --build build; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
    ln -s sdl2-compat.pc "$pkgdir/usr/lib/pkgconfig/sdl2.pc"; or return
    install -Dm644 sdl2-compat-$pkgver/LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
