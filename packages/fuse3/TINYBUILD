set pkgbase fuse3
set pkgname fuse-common fuse3
set -g _name libfuse
set pkgver 3.18.3
set pkgrel 1
set pkgdesc 'Interface for userspace programs to export a filesystem to the Linux kernel'
set url https://github.com/libfuse/libfuse
set nvchecker source=git git=https://github.com/libfuse/libfuse.git 'include_regex=fuse-3.[\d\.]+' prefix=fuse-
set arch i686 x32
set makedepends glibc libiconv liburing meson numactl systemd
set options '!emptydirs'
set source "$url/archive/refs/tags/fuse-$pkgver.tar.gz"
set sha512sums 48b4d1c68d9e82377d2e854cfc3be1b437fe72acd09a4970b5692ac1d5808162db77524f495924d2e369243446aa496bdc9d2a87246fa677c15bf115434e6540
set b2sums 9247827434834a9f7f7d70f65989fad22ba2b6cd1c75e00f43727f12a2146411885c2c8643e26a36311da02fa3af8534fd8a46dcabcb0b9960142d56ce013be5
set flags arch

function build
    # Built as a normal user (useroot=false): fusermount3 gets its setuid bit when packaged. No init script (systemd),
    # examples or tests
    arch-meson build $_name-fuse-$pkgver -D useroot=false -D initscriptdir= -D examples=false -D tests=false; or return
    meson compile -C build; or return
end

function package_fuse-common
    set pkgdesc 'Common files for fuse2/3 packages'
    set license GPL-2.0-only
    set backup etc/fuse.conf
    install -vDm 644 $_name-fuse-$pkgver/util/fuse.conf -t "$pkgdir"/etc/; or return
end

function package_fuse3
    set depends fuse-common glibc liburing liburing.so numactl libnuma.so
    set license GPL-2.0-only LGPL-2.1-only
    meson install -C build --destdir "$pkgdir"; or return
    # fuse.conf belongs to fuse-common
    rm "$pkgdir"/etc/fuse.conf; or return
    chmod 4755 "$pkgdir"/usr/bin/fusermount3; or return
end
