set pkgname imath
set pkgver 3.2.3
set pkgrel 1
set pkgdesc 'A C++ and python library of 2D and 3D vector, matrix, and math operations for computer graphics'
set arch i686 x32
set url https://www.openexr.com/
set nvchecker source=github github=AcademySoftwareFoundation/Imath use_max_tag=true prefix=v 'exclude_regex=.*rc.*'
set license BSD-3-Clause
set depends glibc libgcc libstdc++
set makedepends boost boost-libs cmake git python python-numpy
set optdepends 'boost-libs: python bindings' 'python: python bindings'
set source "git+https://github.com/AcademySoftwareFoundation/Imath#tag=v$pkgver"
set sha256sums 995eeb88f9ccc5d52c6ff91536ceafb7ca63b2284c0dac9830386df45d4490ec
set flags arch

function build
    cmake -B build -S Imath -DCMAKE_INSTALL_PREFIX=/usr -DPYTHON=ON; or return
    cmake --build build; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
    install -Dm644 Imath/LICENSE.md -t "$pkgdir"/usr/share/licenses/$pkgname; or return
end
