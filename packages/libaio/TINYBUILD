set pkgname libaio
set pkgver 0.3.113
set pkgrel 5
set pkgdesc 'The Linux-native asynchronous I/O facility (aio) library'
set arch i686 x32
set url https://codeberg.org/jmoyer/libaio
set nvchecker source=git git=https://codeberg.org/jmoyer/libaio prefix=libaio- 'include_regex=(libaio)-([\d.*]+)'
set license LGPL-2.0-or-later
set depends glibc
set provides libaio.so
# LTO is not supported: https://codeberg.org/jmoyer/libaio/issues/10
set options '!lto'
# patch for off_t -> off64_t (test 23)
set source $url/archive/$pkgname-$pkgver.tar.gz libaio-0.3.113-off_t.patch
set sha512sums 9544f595fe325a37df2afd6369ce348005202db47363587cad29d46522304dc7e733a4cd195d9c5b724a2d4f225834b10a30307efdd1b2df245dfe2f7c18a9a2 \
    4393b6f1322f9349f3dc00063867a8d80b97ec77978aad60a26424c6749e6800f77f7d854fcaa3d3517fbaba7f0441d694d0afeb43d7a6b5e10b709c65f9fa84
set b2sums dc86b25c8487cdbaa57ebc70d699c6c90509ba0ea86672b33624892a4f3245d857031f104d0024d10d2fbbdb149b189c548e6f9a6e53ebc3cd01bad13cb5c5c1 \
    9776de4c42eafd6bcd1042d0a161ac16eb38b4377408d2ad18c4533e6a3d7638fb8cf5cdb9179fa3180a381dc984eefc032f5341d11ce381d7b2914a2dea67bb
set flags arch

function prepare
    # -Werror, not even once
    sed s/-Werror// -i $pkgname/harness/Makefile; or return
    # remove failing tests until upstream fixes them
    rm -frv $pkgname/harness/cases/20.t; or return
    rm -frv $pkgname/harness/cases/21.t; or return
    cd $pkgname; or return
    patch -Np1 -i "$srcdir/libaio-0.3.113-off_t.patch"; or return
end

function build
    make -C $pkgname; or return
end

function check
    make partcheck -k -C $pkgname; or return
end

function package
    make DESTDIR="$pkgdir" install -C $pkgname; or return
    install -vDm 644 $pkgname/{ChangeLog,README.md} -t "$pkgdir/usr/share/doc/$pkgname/"; or return
    install -vDm 644 $pkgname/man/*.3 -t "$pkgdir/usr/share/man/man3/"; or return
end
