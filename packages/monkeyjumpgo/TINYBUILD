set pkgname monkeyjumpgo
set -g _commit 7222c4240e5b73b0514d7f113ce66d7526e60bd1
set pkgver 1.0.0+7222c42
set pkgrel 1
set pkgdesc 'Minimalistic GUI for playing Go against GNU Go (the Go port of Monkeyjump)'
set arch i686
set url https://github.com/xyproto/monkeyjump
set license GPL-2.0-only
set depends glibc gnugo sdl3 sdl3_image
set makedepends go-tinyhat
set options '!buildflags'
set source "monkeyjump-$_commit.tar.gz::https://github.com/xyproto/monkeyjump/archive/$_commit.tar.gz"
set sha256sums 651b54a6a11c18ced22cd5e0047f944fa9739416fa891264a13b49e183bc6382

function build
    cd monkeyjump-$_commit/go; or return
    set -lx GOROOT /usr/lib/go-tinyhat
    set -lx GOPATH "$srcdir/gopath"
    set -lx GOCACHE "$srcdir/gocache"
    set -lx GOTOOLCHAIN local
    set -lx CGO_ENABLED 1
    set -lx GOARCH 386
    set -lx GO386 softfloat
    switch $CARCH
        case aarch64
            set GOROOT /usr/lib/go
            set GOARCH arm64
        case x86_64
            set GOROOT /usr/lib/go
            set GOARCH amd64
    end
    set -lx PATH "$GOROOT/bin" $PATH
    go build -trimpath -buildvcs=false -ldflags "-s -w" -o monkeyjump; or return
end

function package
    cd monkeyjump-$_commit/go; or return
    make DESTDIR="$pkgdir" install; or return
    install -Dm644 ../COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"; or return
end
