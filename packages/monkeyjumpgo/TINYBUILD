set pkgname monkeyjumpgo
set pkgver 1.0.0
set pkgrel 1
set pkgdesc 'Minimalistic GUI for playing Go against GNU Go (the Go port of Monkeyjump)'
set arch i686
set url https://github.com/xyproto/monkeyjumpgo
set license GPL-2.0-only
set depends glibc gnugo sdl3 sdl3_image
set makedepends go-tinyhat
set options '!buildflags'
set source "$pkgname-$pkgver.tar.gz::https://github.com/xyproto/monkeyjumpgo/archive/refs/tags/v$pkgver.tar.gz"
set sha256sums 627fee5f57afd52ea5c898b0e31767a709a76fc961673a91a69faa17fd4cf6bf
# network: go build downloads its Go modules (builds have no network access otherwise)
set -a options network

function build
    cd $pkgname-$pkgver; or return
    set -lx GOROOT /usr/lib/go-tinyhat
    # A cross build on x86_64 has no go-tinyhat: the build environment's Go builds the same 386 binaries
    test -d $GOROOT; or set GOROOT /usr/lib/go
    set -lx GOPATH "$srcdir/gopath"
    set -lx GOCACHE "$srcdir/gocache"
    set -lx GOTOOLCHAIN local
    set -lx CGO_ENABLED 1
    set -lx GOARCH 386
    set -lx GO386 softfloat
    switch $CARCH
        case aarch64
            set GOROOT /usr/lib/go
            set GOARCH arm64
        case x86_64
            set GOROOT /usr/lib/go
            set GOARCH amd64
    end
    set -lx PATH "$GOROOT/bin" $PATH
    go build -trimpath -buildvcs=false -ldflags "-s -w" -o monkeyjump; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
end
