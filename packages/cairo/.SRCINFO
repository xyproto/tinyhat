pkgbase = cairo
	pkgdesc = 2D graphics library with support for multiple output devices
	pkgver = 1.18.6
	pkgrel = 1
	url = https://cairographics.org/
	arch = i686
	arch = x32
	license = LGPL-2.1-only OR MPL-1.1
	makedepends = git
	makedepends = gtk-doc
	makedepends = meson
	makedepends = valgrind
	depends = bash
	depends = fontconfig
	depends = freetype2
	depends = glib2
	depends = glibc
	depends = libpng
	depends = lzo
	depends = pixman
	depends = zlib
	conflicts = cairo
	source = git+https://gitlab.freedesktop.org/cairo/cairo.git#tag=1.18.6
	sha256sums = SKIP

pkgname = cairo-wayland
	provides = cairo=1.18.6
	provides = libcairo-gobject.so
	provides = libcairo-script-interpreter.so
	provides = libcairo.so
	options = !emptydirs
