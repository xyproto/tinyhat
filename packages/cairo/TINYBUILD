set pkgbase cairo
set pkgname cairo-wayland
set pkgver 1.18.6
set pkgrel 1
set pkgdesc '2D graphics library with support for multiple output devices'
set arch i686 x32
set url https://cairographics.org/
set license 'LGPL-2.1-only OR MPL-1.1'
set depends bash fontconfig freetype2 glib2 glibc libpng lzo pixman zlib
# No documentation (gtk-doc) and no tests (valgrind)
set makedepends git meson
set conflicts cairo
set source "git+https://gitlab.freedesktop.org/cairo/cairo.git#tag=$pkgver"
set sha256sums 4250a85c6d5a4032b2dc24fa74bfb740e5555b1be34473b20c5da9e53286a58a
set flags arch
set -g _d bash fontconfig freetype2 glib2 glibc libpng lzo pixman zlib
set -g _p zlib

function prepare
    cd cairo; or return
end

function build
    set -l meson_options -D dwrite=disabled -D xlib=disabled -D xcb=disabled -D gtk_doc=false -D spectre=disabled -D symbol-lookup=disabled -D tests=disabled
    arch-meson cairo build $meson_options; or return
    meson compile -C build; or return
end

function package_cairo
    set provides libcairo-gobject.so libcairo-script-interpreter.so libcairo.so
    set -a options !emptydirs
    meson install -C build --destdir "$pkgdir"; or return
end

function package_cairo-wayland
    set provides "cairo=$pkgver" libcairo-gobject.so libcairo-script-interpreter.so libcairo.so
    set -a options !emptydirs
    meson install -C build --destdir "$pkgdir"; or return
end
