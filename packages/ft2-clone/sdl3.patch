+static void audioStreamCallback(void *userdata, SDL_AudioStream *stream, int additional, int total)
+{
+	static Uint8 buf[16384];
+	(void)total;
+
+	const int frameSize = 1 << smpShiftValue;
+	while (additional > 0)
+	{
+		int len = additional;
+		if (len > (int)sizeof (buf))
+			len = sizeof (buf);
+		len &= ~(frameSize - 1);
+		if (len <= 0)
+			break;
+
+		audioCallback(userdata, buf, len);
+		SDL_PutAudioStreamData(stream, buf, len);
+		additional -= len;
+	}
+}
+
+SDL_AudioDeviceID findAudioDeviceByName(const char *name, bool recording)
+{
+	if (name == NULL)
+		return 0;
+
+	int count = 0;
+	SDL_AudioDeviceID found = 0;
+	SDL_AudioDeviceID *devs = recording ? SDL_GetAudioRecordingDevices(&count) : SDL_GetAudioPlaybackDevices(&count);
+	if (devs == NULL)
+		return 0;
+
+	for (int i = 0; i < count; i++)
+	{
+		const char *devName = SDL_GetAudioDeviceName(devs[i]);
+		if (devName != NULL && strcmp(devName, name) == 0)
+		{
+			found = devs[i];
+			break;
+		}
+	}
+
+	SDL_free(devs);
+	return found;
+}
