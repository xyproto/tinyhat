set pkgname ft2-clone
set pkgver 2.28
set pkgrel 1
set pkgdesc 'Portable Fasttracker II clone'
set arch i686 x32
set url https://16-bits.org/ft2.php
set license BSD-3-Clause MIT CC-BY-NC-SA-4.0
set depends glibc libgcc libstdc++ alsa-lib sdl3 hicolor-icon-theme
# No libicns or gendesk: the .desktop file and 512x512 icon shipped in release/other/Freedesktop.org Resources are used
set makedepends git cmake ninja
set source "$pkgname::git+https://github.com/8bitbubsy/ft2-clone#tag=v$pkgver" \
    sdl3.patch
set sha512sums fdf4a8711a2f0e0c6b3d7673b1663f3eaf3c18edbdb81d8f30bc6b647c1b1d24b5eeeb4d129c4ab9996aedbd11aa9be1b860dc727248ca9f5a4ba9ba8c26c63d \
    aedf554233699296243a98dc7cce32511b257c1183006dab4b303e366d75e2544e833a1bb3d83a12bc1ef28d21049ab8daac4a27917cbdf8909cccab89b7c65e
set b2sums 08fefc57ce7112f9b4d1bd320db38634baf70896c48f2f0da071b8ae8104a9b5fccb47fdf9a92b1597447a9b3453e7cb2e353d68be2d6db8757fbc400d446d85 \
    1b9d108081fe87028a94cc3f16421fc8657ef528b87a1f403756774493de4acc1f4e1f227ab6db90bd85df9abf3e69b2916ae24d6e505b9e5336a4f9379e37a5
set flags arch

function prepare
    cd $pkgname; or return
    # attempt repro build by using commit date as build date
    set -l commit_date (git show --no-patch --format=%cd --date=format:'%d %B %Y'); or return
    patch -p1 -i "$srcdir/sdl3.patch"; or return
    sed -e "s/__DATE__/\"$commit_date\"/" -i src/ft2_about.c; or return
end

function build
    set -l cmake_options \
        -B build \
        -S $pkgname \
        -G Ninja \
        -W no-author \
        -D CMAKE_BUILD_TYPE=None \
        -D CMAKE_INSTALL_PREFIX=/usr
    cmake $cmake_options; or return
    cmake --build build; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
    cd $pkgname; or return
    # application icon and desktop file, as shipped upstream (the icon is renamed to $pkgname)
    set -l res 'release/other/Freedesktop.org Resources'
    install -vDm644 "$res/Fasttracker II clone.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"; or return
    sed -e "s/^Icon=.*/Icon=$pkgname/" "$res/Fasttracker II clone.desktop" | install -vDm644 /dev/stdin "$pkgdir/usr/share/applications/$pkgname.desktop"; or return
    install -vDm644 "$res/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.freedesktop-resources"; or return
    # documentation
    install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md; or return
    # licensing
    install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE*; or return
end
