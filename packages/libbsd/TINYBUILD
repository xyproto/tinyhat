set pkgname libbsd
set pkgver 0.12.2
set pkgrel 2
set pkgdesc 'Provides useful functions commonly found on BSD systems like strlcpy()'
set arch i686 x32
set url https://libbsd.freedesktop.org
set license custom
set depends glibc libmd
set makedepends git
set options staticlibs
set source "git+https://gitlab.freedesktop.org/libbsd/libbsd.git?signed#tag=$pkgver"
set sha512sums cea336318d941992d0f624386d4d43828940de9b4ebbf580bb4771efb2cf00fd85e2d17c9006fe1b5fecaa277d25d5e6af15e7456722b172270e4a77e1a0299e
set flags arch

function build
    cd $pkgname; or return
    autoreconf -vfi; or return
    CFLAGS="$CFLAGS -ffat-lto-objects" ./configure --prefix=/usr; or return
    make; or return
end

function check
    cd $pkgname; or return
    make check; or return
end

function package
    cd $pkgname; or return
    make DESTDIR="$pkgdir" install; or return
    rm "$pkgdir"/usr/lib/libbsd.a; or return
    install -D -m644 COPYING "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
    # included now in man-pages, FS#53351
    rm -f "$pkgdir"/usr/share/man/man3/explicit_bzero.3
end
