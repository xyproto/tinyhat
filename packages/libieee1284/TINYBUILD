set pkgname libieee1284
set pkgver 0.2.11
set -g _tag (string replace -a . _ -- $pkgver)
set pkgrel 19
set pkgdesc 'A library to query devices connected in parallel port'
set arch i686 x32
set license GPL-2.0-or-later
set url https://github.com/twaugh/libieee1284
set depends glibc
# No man pages (xmlto, docbook-xml, docbook-xsl): man3_MANS is emptied for make
set makedepends python
set optdepends 'python: for python module'
set source "$pkgname-$pkgver.tar.gz::$url/archive/V$_tag.tar.gz" \
    "upstream_python_fix1.patch::$url/commit/c48855528beee1397d883f9c8a5df7aed5c917a6.patch" \
    "upstream_python_fix2.patch::$url/commit/b4d63327dfef8dbf12aabf4bba0f6818a3519995.patch" \
    "fix-python-3-compatibility.patch::$url/commit/357005f6b19c4e2febd3c0f17e59de541accbe92.patch" \
    "fix-python-3.12-compatibility.patch::$url/commit/cf59766dd848bd8b4318b1c67b5df053903ddefb.patch"
set sha256sums eb6a4305f5d44f74b548c8dd41ec1103175cabb57f9661bec4af49e11f8a0238 \
    53dc16334556f7c2554bcb6d2370c3bae4d07d29af34fb96ffa4d522a9eedc0f \
    20190a7841f0fc672ead0caf1cf87a1e94b824515906ea972ae17bdb5ce99f82 \
    40efc0e6ab7c8ab30a61b89ea515dcdfbd5b110c2c08feccda7abb2dc3381583 \
    38dad4a5eb686c6cfe45b6bdedb2c68ad8625db10783f313024131752c8ecabe
set flags arch

function prepare
    cd "$pkgname-$_tag"; or return
    patch -Np1 -F3 -i ../upstream_python_fix1.patch; or return
    patch -Np1 -F3 -i ../upstream_python_fix2.patch; or return
    patch -Np1 -i ../fix-python-3-compatibility.patch; or return
    patch -Np1 -i ../fix-python-3.12-compatibility.patch; or return
end

function build
    cd "$pkgname-$_tag"; or return
    ./bootstrap; or return
    ./configure --prefix=/usr --mandir=/usr/share/man --with-python; or return
    make man3_MANS=; or return
end

function package
    cd "$pkgname-$_tag"; or return
    make DESTDIR="$pkgdir" man3_MANS= install; or return
end
