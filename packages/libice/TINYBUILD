set pkgname libice
set pkgver 1.1.2
set pkgrel 1
set pkgdesc 'X11 Inter-Client Exchange library'
set arch i686 x32
set url https://xorg.freedesktop.org/
set nvchecker source=gitlab gitlab=xorg/lib/libICE host=gitlab.freedesktop.org 'include_regex=.*libICE-.*' use_max_tag=true prefix=libICE-
set license MIT-open-group
set depends glibc xorgproto
set makedepends xtrans xorg-util-macros
set source "https://xorg.freedesktop.org//releases/individual/lib/libICE-$pkgver.tar.xz"
set sha256sums 974e4ed414225eb3c716985df9709f4da8d22a67a2890066bc6dfc89ad298625
set flags arch

function build
    cd libICE-$pkgver; or return
    ./configure --prefix=/usr --sysconfdir=/etc; or return
    make; or return
end

function package
    cd libICE-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"; or return
end
