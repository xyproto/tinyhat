set pkgname shadow
set pkgver 4.20.0.arch1
set -g _upstream_tag (string replace -r '\.[^.]*$' '' -- $pkgver)
set -g _dist_tag $_upstream_tag-arch(string replace -r '^.*?\.arch' '' -- $pkgver)
set pkgrel 2
set pkgdesc 'Password and account management tool suite with support for shadow files and PAM'
set arch i686 x32
set url https://github.com/shadow-maint/shadow
set nvchecker source=git git=https://gitlab.archlinux.org/archlinux/packaging/upstream/shadow 'include_regex=^[\d.]+-(arch[\d]+)$' 'from_pattern=([\d.]+)-(arch[\d]+)' 'to_pattern=\1.\2'
set license \
    0BSD \
    BSD-3-Clause
# systemd-libs: logind integration (who is logged in, for the account tools)
set depends glibc systemd-libs
# shadow and systemd need each other (through util-linux)
set bootstrap_without systemd-libs
# No man pages: they need docbook-xsl, itstool and libxslt (itstool needs python with the libxml2 module)
set makedepends \
    acl \
    audit \
    git \
    libcap \
    libxcrypt \
    pam
set backup \
    etc/default/useradd \
    etc/login.defs \
    etc/pam.d/chpasswd \
    etc/pam.d/newusers \
    etc/pam.d/passwd
set options '!emptydirs'
# NOTE: distribution patches are taken from https://gitlab.archlinux.org/archlinux/packaging/upstream/shadow/
set source \
    "git+$url.git?signed#tag=$_upstream_tag" \
    "https://gitlab.archlinux.org/archlinux/packaging/upstream/shadow/-/releases/$_dist_tag/downloads/$pkgname-$_dist_tag.patch.zst" \
    shadow.{timer,service} \
    useradd.defaults \
    LICENSE
