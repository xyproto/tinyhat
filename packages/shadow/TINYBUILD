function prepare
    cd $pkgname; or return

    for src in $source
        set -l name (string replace -r '::.*' '' -- $src | string replace -r '.*/' '')
        if string match -q '*.patch.zst' -- $name
            # makep does not decompress single files
            echo "Applying patch $name..."
            zstd -dc <"../$name" | patch -Np1; or return
            grep -q '^ENV_PATH[[:space:]]*PATH=/usr/local/sbin:' etc/login.defs; or return
        else if string match -q '*.patch' -- $name
            echo "Applying patch $name..."
            patch -Np1 <"../$name"; or return
        end
    end

    autoreconf -fiv; or return
end

function build
    # --disable-account-tools-setuid: no setuid for chgpasswd, chpasswd, groupadd, groupdel, groupmod, newusers, useradd, userdel, usermod
    # --without-fcaps: newuidmap and newgidmap are setuid root, like the other helpers: the build runs unprivileged and
    # cannot setcap, and the image is unpacked without xattrs (until makep can declare file capabilities)
    # --with-libpam: PAM integration for chpasswd, newusers, passwd
    # --without-libbsd: shadow can use internal implementation for getting passphrase
    # --without-nscd: we do not ship nscd anymore
    # --without-su: su is provided by util-linux
    set -l configure_options \
        --bindir=/usr/bin \
        --disable-account-tools-setuid \
        --disable-man \
        --libdir=/usr/lib \
        --mandir=/usr/share/man \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --with-audit \
        --without-fcaps \
        --with-group-name-max-length=32 \
        --with-libpam \
        --with-yescrypt \
        --without-bcrypt \
        --without-libbsd \
        --without-nscd \
        --without-selinux \
        --without-su

    cd $pkgname; or return
    # add extra check, preventing accidental deletion of other user's home dirs when using `userdel -r <user with home in />`
    set -a CFLAGS -DEXTRA_CHECK_HOME_DIR
    # Without libsystemd (the first build in a bootstrap, see bootstrap_without): no logind integration
    pkg-config --exists libsystemd; or set -a configure_options --disable-logind
    ./configure $configure_options; or return

    # prevent excessive overlinking due to libtool
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make; or return
end

function package
    set -a depends acl libacl.so audit libaudit.so libxcrypt libcrypt.so pam libpam.so libpam_misc.so

    cd $pkgname; or return

    # usbindir: src/Makefile.am has ${prefix}/sbin, where --sbindir does not reach (usr/sbin is a link to bin)
    make DESTDIR="$pkgdir" usbindir=/usr/bin install; or return

    # license
    install -vDm 644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
    install -vDm 644 ../LICENSE "$pkgdir/usr/share/licenses/$pkgname/0BSD.txt"; or return

    # custom useradd(8) defaults (not provided by upstream)
    install -vDm 600 ../useradd.defaults "$pkgdir/etc/default/useradd"; or return

    # systemd units
    install -vDm 644 ../shadow.timer -t "$pkgdir/usr/lib/systemd/system/"; or return
    install -vDm 644 ../shadow.service -t "$pkgdir/usr/lib/systemd/system/"; or return
    install -vdm 755 "$pkgdir/usr/lib/systemd/system/timers.target.wants"; or return
    ln -s ../shadow.timer "$pkgdir/usr/lib/systemd/system/timers.target.wants/shadow.timer"; or return
end
