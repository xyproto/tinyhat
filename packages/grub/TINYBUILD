set pkgname grub
set pkgver 2.16
set pkgrel 1
set epoch 2
set pkgdesc 'GNU GRand Unified Bootloader (2)'
set arch i686
set url https://gnu-grub.freedesktop.org/
set license GPL-3.0-or-later
set depends gettext sh xz
# Libraries that grub is built against (for the machine it runs on), and tools that run during the build. No
# device-mapper (grub-probe on LVM and RAID), fuse3 (grub-mount), libusb (grub-emu USB) or freetype2 (grub-mkfont
# and GRUB's own fonts): Tiny Hat uses none of them, and the image scripts take grub-mkfont from the build environment
set makedepends_host gettext xz
set makedepends_build autogen help2man python rsync texinfo
set optdepends 'dosfstools: For grub-mkrescue FAT FS and EFI support' 'efibootmgr: For grub-install EFI support' 'libisoburn: Provides xorriso for generating grub rescue iso using grub-mkrescue' 'lzop: For grub-mkrescue LZO support' 'mtools: For grub-mkrescue FAT FS support' 'os-prober: To detect other OSes when generating grub.cfg in BIOS systems' 'sdl: For grub-emu SDL support'
switch $CARCH
    case x86_64
        set -g provides grub-common grub-emu grub-bios grub-efi-x86_64
    case '*'
        set -g provides grub-common grub-emu
end
switch $CARCH
    case x86_64
        set -g conflicts grub-common grub-emu grub-legacy grub-bios grub-efi-x86_64
    case '*'
        set -g conflicts grub-common grub-emu grub-legacy
end
switch $CARCH
    case x86_64
        set -g replaces grub-common grub-emu grub-bios grub-efi-x86_64
    case '*'
        set -g replaces grub-common grub-emu
end
set backup etc/default/grub etc/grub.d/40_custom
set install grub.install
set source "https://gitlab.freedesktop.org/api/v4/projects/26558/packages/generic/source-assets/grub-$pkgver/grub-$pkgver.tar.xz" \
    0001-00_header-add-GRUB_COLOR_-variables.patch \
    0002-10_linux-detect-archlinux-initramfs.patch \
    0003-support-dropins-for-default-configuration.patch \
    grub.default \
    sbat.csv
set sha256sums f0db0104927df0b9a48bc41b735c702936190d17eb2d73d3018fa77474a0cabe \
    5dee6628c48eef79812bb9e86ee772068d85e7fcebbd2b2b8d1e19d24eda9dab \
    8488aec30a93e8fe66c23ef8c23aefda39c38389530e9e73ba3fbcc8315d244d \
    b5d9fcd62ffb3c3950fdeb7089ec2dc2294ac52e9861980ad90a437dedbd3d47 \
    7df3f5cb5df7d2dfb17f4c9b5c5dedc9519ddce6f8d2c6cd43d1be17cecb65cb \
    2448f41911a6c1eb80cdbccb72cc10721293ed4811c9526330f373e91df7a3f0
set flags arch
set -g _configure_options --prefix=/usr --bindir=/usr/bin --sbindir=/usr/bin --mandir=/usr/share/man --infodir=/usr/share/info --datarootdir=/usr/share --sysconfdir=/etc --program-prefix= --with-bootdir=boot --with-grubdir=grub --enable-boot-time --enable-cache-stats --disable-device-mapper --disable-grub-mount --disable-libzfs --disable-grub-emu-usb --disable-grub-mkfont
set -g _pkgver 2.16
switch $CARCH
    case aarch64
        set -g _platform aarch64-efi
    case x86_64
        set -g _platform i386-pc i386-efi x86_64-efi
    case '*'
        # The i686 compiler has no 64-bit mode, so no x86_64-efi (grub-efi64 has it) and no efiemu
        set -g _platform i386-pc i386-efi
end

function prepare
    rm -rf "$srcdir/grub"; or return
    mv "$srcdir/$pkgname-$pkgver" "$srcdir/grub"; or return
    cd "$srcdir/grub"; or return
    patch -Np1 -i "$srcdir/0001-00_header-add-GRUB_COLOR_-variables.patch"; or return
    patch -Np1 -i "$srcdir/0002-10_linux-detect-archlinux-initramfs.patch"; or return
    patch -Np1 -i "$srcdir/0003-support-dropins-for-default-configuration.patch"; or return
    sed 's| ro | rw |g' -i util/grub.d/10_linux.in; or return
    sed 's|GNU/Linux|Linux|' -i util/grub.d/10_linux.in; or return
    sed -i '1i /^PO-Revision-Date:/ d' po/*.sed; or return
end

function build
    for i in $_platform
        echo "Unset CFLAGS for build..."; or return
        set -e CFLAGS
        cp -a "$srcdir/grub" "$srcdir/grub-$i"; or return
        cd "$srcdir/grub-$i"; or return
        echo "Run ./configure for $i build..."; or return
        if test "$i" = i386-pc
            set -l efiemu --enable-efiemu
            contains x86_64-efi $_platform; or set efiemu --disable-efiemu
            set -a _configure_options $efiemu --with-platform="pc" --target="i386"
        end
        if test "$i" = i386-efi
            set -a _configure_options --disable-efiemu --with-platform="efi" --target="i386"
        end
        if test "$i" = x86_64-efi
            set -a _configure_options --with-platform="efi" --target="x86_64"
        end
        ./configure PACKAGE_VERSION="$epoch:$pkgver-$pkgrel" $_configure_options; or return
        if test "$i" = x86_64-efi
            echo "Build language and doc files only for most common variant..."; or return
            make -j1 po/; or return
        else
            sed -i -e 's#po docs##' Makefile; or return
        end
        echo "Run make for $i build..."; or return
        make; or return
        if test ! -z "$SOURCE_DATE_EPOCH"
            echo "Make info pages reproducible..."; or return
            touch -d "@$SOURCE_DATE_EPOCH" $(find -name '*.texi'); or return
        end
    end
end

function package
    for i in $_platform
        cd "$srcdir/grub-$i"; or return
        echo "Run make install for $i build..."; or return
        make DESTDIR="$pkgdir/" bashcompletiondir="/usr/share/bash-completion/completions" install; or return
        echo "Remove gdb debugging related files for $i..."; or return
        set -l debug "$pkgdir/usr/lib/grub/$i"/{*.module,*.image}
        rm -f $debug; or return
        rm -f "$pkgdir/usr/lib/grub/$i"/{kernel.exec,gdb_grub,gmodule.pl}; or return
    end
    echo "Install /etc/default/grub (used by grub-mkconfig)..."; or return
    install -D -m0644 "$srcdir/grub.default" "$pkgdir/etc/default/grub"; or return
    sed -e "s/%PKGVER%/$epoch:$pkgver-$pkgrel/" <"$srcdir/sbat.csv" >"$pkgdir/usr/share/grub/sbat.csv"; or return
end
