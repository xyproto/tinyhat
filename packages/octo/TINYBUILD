set pkgname octo
set -g _commit 102994e6166236045a067efa930a88532510e03e
set pkgver 20260914.181012.g102994e6166
set pkgrel 3
set pkgdesc 'Octo CHIP-8 assembler, player and IDE (c-octo), with SDL3'
set arch i686 x32 x86_64 aarch64
set url https://github.com/JohnEarnest/c-octo
set license MIT
set depends sdl3
set source "octo-$_commit.tar.gz::https://github.com/JohnEarnest/c-octo/archive/$_commit.tar.gz" \
    sdl3.patch \
    buzzer.patch \
    sharp.patch
set sha256sums e160d02a05071bbd5a0d9b180ca9e5680be817f458a95e3af055749163f068ed \
    946ded8b83ea8d225b527263ce6f50d13d41cd24c683592835e9c1b91f791c43 \
    8ee701aa0e0b688a7ca2196a8472afcfc98ffe1bc69efed770e5b97430bf47f6 \
    4e80cdedc1113bd1a38f4b660f5d08cf0a6ff2fe5285c15dc988eee662c05a62

function prepare
    cd c-octo-$_commit; or return
    patch -Np1 -i ../sdl3.patch; or return
    patch -Np1 -i ../buzzer.patch; or return
    patch -Np1 -i ../sharp.patch; or return
end

function build
    cd c-octo-$_commit; or return
    set -l sdl (pkg-config --cflags --libs sdl3); or return
    set sdl (string split -n ' ' -- $sdl)
    for f in cli run de
        cc -std=c99 $CFLAGS -DVERSION='"1.2"' -o octo-$f src/octo_$f.c $LDFLAGS $sdl -lm; or return
    end
end

function package
    cd c-octo-$_commit; or return
    install -Dm755 -t "$pkgdir/usr/bin" octo-cli octo-run octo-de; or return
    install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
