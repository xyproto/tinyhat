set pkgname procps-ng
set pkgver 4.0.7
set pkgrel 1
set pkgdesc 'Utilities for monitoring your system and its processes'
set url https://gitlab.com/procps-ng/procps
set license GPL LGPL
set arch i686 x32
set depends glibc ncurses libncursesw.so systemd-libs
set makedepends gettext git po4a systemd
set checkdepends dejagnu
set conflicts procps sysvinit-tools
set provides procps sysvinit-tools libproc2.so
set replaces procps sysvinit-tools
set options '!emptydirs'
set source "git+https://gitlab.com/procps-ng/procps.git?signed#tag=v$pkgver"
set sha256sums eea741f9b1487ea6c1e8d539665fffb93349ff882d2e0daa2cdca5675691961f
set b2sums eee40f9db3ed1facf08b3c79f4529913b1323d6aa703c191ad5e1b76c9e6073a0da1a468b662d43b6b7cb926ee0ced19416aca4cfcced04e5b699dc6008c43e8
set flags arch

set -g _backports
set -g _reverts

function prepare
    cd procps; or return
    for _c in $_backports
        set -l _l --max-count=1
        string match -q '*..*' -- $_c; and set _l --reverse
        git log --oneline $_l $_c; or return
        git cherry-pick --mainline 1 --no-commit $_c; or return
    end
    for _c in $_reverts
        set -l _l --max-count=1
        string match -q '*..*' -- $_c; and set _l --reverse
        git log --oneline $_l $_c; or return
        git revert --mainline 1 --no-commit $_c; or return
    end
    ./autogen.sh; or return
end

function build
    cd procps; or return
    ./configure --prefix=/usr --exec-prefix=/ --sysconfdir=/etc --libdir=/usr/lib --bindir=/usr/bin \
        --sbindir=/usr/bin --enable-watch8bit --with-systemd --disable-modern-top --disable-kill; or return
    make; or return
end

function check
    cd procps; or return
    make check; or return
end

function package
    cd procps; or return
    make DESTDIR="$pkgdir" install; or return
end
