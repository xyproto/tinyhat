set pkgname lmdb
set pkgver 0.9.35
set pkgrel 1
set pkgdesc 'Symas Lightning Memory-Mapped Database'
set arch i686 x32
set url https://symas.com/lmdb
set nvchecker source=git git=https://git.openldap.org/openldap/openldap.git prefix=LMDB_ 'exclude_regex=^(?!LMDB_).*'
set license custom:OpenLDAP
set depends glibc
set makedepends git
set options '!emptydirs'
set source "git+https://git.openldap.org/openldap/openldap.git#tag=LMDB_$pkgver" lmdb.pc
set sha512sums 7e58038d3e414d7e0c90559fb1e080c78da988df27a07bda471bcc69a00ec03140c1c2ab8a2e3da18f10077fb290ea46d85f753d8b8727716eefc16871922b5f \
    0349d4b08a1f93fe338d8f8e3e5a83e24211a46f999fe529bc1ac49c8c4975559d95a548c203d9427e3f82d62e934ba3cd1be6f734f9b9405b2a26477be4ed33
set flags arch

function prepare
    sed -e "s|@PKGVER@|$pkgver|" -i lmdb.pc; or return
end

function build
    cd openldap/libraries/liblmdb; or return
    make CFLAGS="$CFLAGS" CPPFLAGS="$CPPFLAGS" LDFLAGS="$LDFLAGS" prefix=/usr; or return
end

function check
    cd openldap/libraries/liblmdb; or return
    make test; or return
end

function package
    cd openldap/libraries/liblmdb; or return
    install -dm755 "$pkgdir"/usr/{bin,lib,include,man/man1,share}; or return
    make DESTDIR="$pkgdir" prefix=/usr install; or return
    mv "$pkgdir"/usr/man "$pkgdir"/usr/share/man; or return
    install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/; or return
    install -Dm644 "$srcdir"/lmdb.pc -t "$pkgdir"/usr/lib/pkgconfig/; or return
end
