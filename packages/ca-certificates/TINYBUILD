function package_ca-certificates-utils
    set pkgdesc "$pkgdesc (utilities)"
    set depends bash coreutils findutils p11-kit
    set provides ca-certificates ca-certificates-java
    set conflicts ca-certificates-java
    set replaces ca-certificates-java
    set install ca-certificates-utils.install

    install -Dt "$pkgdir/usr/bin" update-ca-trust; or return
    install -Dt "$pkgdir/usr/share/man/man8" -m644 update-ca-trust.8; or return
    install -Dt "$pkgdir/usr/share/libalpm/hooks" -m644 *.hook; or return

    set -l etcdir "$pkgdir/etc/$pkgbase"
    set -l ssldir "$pkgdir/etc/ssl"
    set -l usrdir "$pkgdir/usr/share/$pkgbase"

    # Trust source directories
    install -Dm644 README.etc "$etcdir/README"; or return
    install -Dm644 README.src "$etcdir/trust-source/README"; or return
    install -Dm644 README.usr "$usrdir/trust-source/README"; or return
    install -d {$etcdir,$usrdir}/trust-source/{anchors,blocklist}; or return

    # Directories used by update-ca-trust (aka "trust extract-compat")
    install -Dm644 README.etcssl "$ssldir/README"; or return
    install -Dm644 README.java "$ssldir/certs/java/README"; or return
    install -Dm644 README.extr "$etcdir/extracted/README"; or return

    # Compatibility link for OpenSSL using /etc/ssl as CAdir
    # Used in preference to the individual links in /etc/ssl/certs
    ln -sr "$etcdir/extracted/tls-ca-bundle.pem" "$ssldir/cert.pem"; or return

    # Compatibility link for legacy bundle (Debian)
    ln -sr "$etcdir/extracted/tls-ca-bundle.pem" "$ssldir/certs/ca-certificates.crt"; or return

    # Compatibility link for legacy bundle (RHEL/Fedora)
    ln -sr "$etcdir/extracted/tls-ca-bundle.pem" "$ssldir/certs/ca-bundle.crt"; or return

    # FIXME: Make "$ssldir/certs/java/cacerts" a packaged symlink, too
end

function package_ca-certificates
    set pkgdesc "$pkgdesc - default providers"
    set depends ca-certificates-mozilla
    set conflicts 'ca-certificates-cacert<=20140824-4'
    set replaces $conflicts
end
