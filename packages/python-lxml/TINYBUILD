set pkgname python-lxml
set pkgver 6.1.3_1
set pkgrel 1
set pkgdesc 'Python binding for the libxml2 and libxslt libraries'
set arch i686 x32
set url https://lxml.de/
set nvchecker source=git git=https://github.com/lxml/lxml.git prefix=lxml- from_pattern=- to_pattern=_ 'exclude_regex=.*(a|b).*'
set license BSD-3-Clause MIT MIT-CMU GPL-2.0-only LicenseRef-RNG2Schtrn LicenseRef-XSD2Schtrn
set depends glibc python libxslt libxml2
set makedepends git python-build python-installer python-setuptools python-wheel python-pygments cython
set checkdepends python-cssselect python-html5lib python-beautifulsoup4 python-lxml-html-clean
set optdepends 'python-beautifulsoup4: support for beautifulsoup parser to parse not well formed HTML' 'python-cssselect: support for cssselect' 'python-html5lib: support for html5lib parser' 'python-lxml-docs: offline docs' 'python-lxml-html-clean: enable htmlclean feature'
set source 'python-lxml::git+https://github.com/lxml/lxml#tag=lxml-6.1.3-1'
set sha256sums 743887cea8810ac288d6543f3652a6478000777806ca28b15d588a7b2571d400
set flags arch

function prepare
    cd "$pkgbase"; or return
    set -gx LC_CTYPE en_US.UTF-8
    sed -n '/^<!--/,/^-->/p' src/lxml/isoschematron/resources/rng/iso-schematron.rng >iso-schematron.rng.license; or return
    sed -n '/^The MIT License/,/^THE SOFTWARE\./p' src/lxml/isoschematron/resources/xsl/iso-schematron-xslt1/iso_abstract_expand.xsl >iso_abstract_expand.xsl.license; or return
    sed -n '/LEGAL INFORMATION/,/3\./p' src/lxml/isoschematron/resources/xsl/iso-schematron-xslt1/iso_dsdl_include.xsl >iso_dsdl_include.xsl.license; or return
    sed -n '/Copyright/,/3\./p' src/lxml/isoschematron/resources/xsl/iso-schematron-xslt1/iso_schematron_message.xsl >iso_schematron_message.xsl.license; or return
    sed -n '/LEGAL INFORMATION/,/3\./p' src/lxml/isoschematron/resources/xsl/iso-schematron-xslt1/iso_schematron_skeleton_for_xslt1.xsl >iso_schematron_skeleton_for_xslt1.xsl.license; or return
    sed -n '/Copyright/,/3\./p' src/lxml/isoschematron/resources/xsl/iso-schematron-xslt1/iso_svrl_for_xslt1.xsl >iso_svrl_for_xslt1.xsl.license; or return
    sed -n '/^<!--/,/^-->/p' src/lxml/isoschematron/resources/xsl/RNG2Schtrn.xsl >RNG2Schtrn.xsl.license; or return
    sed -n '/^<!--/,/^-->/p' src/lxml/isoschematron/resources/xsl/XSD2Schtrn.xsl >XSD2Schtrn.xsl.license; or return
end

function build
    cd "$pkgbase"; or return
    python -m build --wheel --no-isolation --skip-dependency-check; or return
end

function package_python-lxml
    cd "$pkgbase"; or return
    python -m installer --destdir="$pkgdir" dist/*.whl; or return
    install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSES.txt doc/licenses/BSD.txt doc/licenses/elementtree.txt ./*.license; or return
end

function package_python-lxml-docs
    set pkgdesc "Python binding for the libxml2 and libxslt libraries (docs)"
    set depends
    set options docs
    cd "$pkgbase"; or return
    install -d "$pkgdir"/usr/share/doc/$pkgbase; or return
    cp -r doc/html "$pkgdir"/usr/share/doc/$pkgbase; or return
    install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSES.txt doc/licenses/BSD.txt doc/licenses/elementtree.txt ./*.license; or return
end
