set pkgbase pygobject
set pkgname python-gobject python-gobject-docs
set pkgver 3.58.1
set pkgrel 1
set pkgdesc 'Python bindings for GLib/GObject/GIO/GTK'
set url https://pygobject.gnome.org/
set nvchecker source=git git=https://gitlab.gnome.org/GNOME/pygobject.git 'include_regex=\d+\.\d*[02468]\.\d+'
set arch i686 x32
set license LGPL-2.1-or-later
set depends glib2 glibc gobject-introspection-runtime libffi python
# No Sphinx: the documentation is not built
set makedepends git gobject-introspection meson python-cairo python-setuptools
set optdepends 'python-cairo: Cairo bindings'
set source "git+https://gitlab.gnome.org/GNOME/pygobject.git?signed#tag=$pkgver" \
    git+https://gitlab.gnome.org/GNOME/gobject-introspection-tests.git#commit=53e6bc978d5011f22d0a27cca49a94b19816ca7d \
    git+https://github.com/python/pythoncapi-compat#commit=22811c3f0e69908894d2bd724f572b32667f2141
set b2sums cc70d9ed246773858ac1d856c02c8d3c1be35c789979d1e7283acab280ed274695d7d66265c25b2b298ddcca831741751dc0a7566e2cfbcc7297abe6c1c12046 \
    331ab5a17f2f113ea8f95e5c202e0cfca0d37e9d4029a81f352506a8444f45de539d12711dbee8ef3d4f355d9cef9bf281515c558008fd880d7644d1d9fc0356 \
    6ff1699812c68bbfe129906da84cec73102d9f1a83975a13a8325341808a71fc73b75e0a8cb532b68dbb7f174bca6d0fb83d48f834e72e74b28fb71a51a8491b
set flags arch

function build
    # Inject subprojects
    set -lx MESON_PACKAGE_CACHE_DIR "$srcdir"
    arch-meson pygobject build; or return
    meson compile -C build; or return
end

# No check(): it needs gtk4 and xvfb

function package_python-gobject
    set provides "pygobject-devel=$pkgver"
    set conflicts pygobject-devel
    set replaces 'pygobject-devel<=3.36.1-1'
    meson install -C build --destdir "$pkgdir"; or return
    python -m compileall -d /usr/lib "$pkgdir/usr/lib"; or return
    python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"; or return
end

function package_python-gobject-docs
    # The documentation needs Sphinx, which is not used
    echo 'No documentation'
end
