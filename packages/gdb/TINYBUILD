set pkgname gdb
set pkgver 18.1
set pkgrel 1
set pkgdesc 'GNU debugger, without Python'
set arch i686 x32 x86_64 aarch64
set url https://www.sourceware.org/gdb/
set license GPL-3.0-or-later
set depends expat gmp mpfr ncurses readline zlib
set source "https://ftp.gnu.org/gnu/gdb/gdb-$pkgver.tar.xz"
set sha256sums cd9fc3fe2b47743840e42c1592d3d87f8302eb18639c0b8b4ba0898002e2348f

function build
    mkdir -p build; or return
    cd build; or return
    ../gdb-$pkgver/configure --prefix=/usr --disable-nls --disable-werror --disable-sim --disable-gdbserver --disable-gprofng \
        --disable-binutils --disable-ld --disable-gas --disable-gold --disable-gprof --disable-inprocess-agent \
        --without-python --without-guile --without-babeltrace --without-debuginfod --without-intel-pt \
        --disable-source-highlight --without-xxhash --with-system-readline --with-system-zlib --with-expat \
        MAKEINFO=true; or return
    make MAKEINFO=true all-gdb; or return
end

function package
    cd build; or return
    make MAKEINFO=true DESTDIR="$pkgdir" install-gdb; or return
    rm -rf $pkgdir/usr/{share/info,include,lib}; or return
    install -Dm644 "$srcdir/gdb-$pkgver/COPYING3" "$pkgdir/usr/share/licenses/$pkgname/COPYING3"; or return
end
