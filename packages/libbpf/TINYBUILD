set pkgname libbpf
set pkgver 1.7.0
set pkgrel 1
set pkgdesc 'Library for loading eBPF programs and reading and manipulating eBPF objects from user-space'
set url https://github.com/libbpf/libbpf
set arch i686 x32
set license 'LGPL-2.1-only OR BSD-2-Clause'
set depends glibc libelf linux-api-headers zlib
set makedepends git
set provides libbpf.so
set source "git+$url#tag=v$pkgver"
set sha512sums f623f39bec882c8a642bf8f1485d3ca028b393b73b1bb588be26b9b7f58040223b6ca778a098c2c7468cf60386cbc279d58c7f2c83836bf0fcebb87a69aa86f9
set b2sums 1315f3cdd336b57a70e2b0284d1f5a6ad32d1e3aabcca6fdccd50d51aa743f365c396ac240995e36d92f37f2d8bc0afb487e59a47638d0ae1f7999cc03cf0f5b
set flags arch

function build
    cd libbpf; or return
    make -C src; or return
end

function package
    cd libbpf; or return
    make -C src DESTDIR="$pkgdir" LIBSUBDIR=lib install; or return
    install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"; or return
    install -Dm 644 LICENSE.BSD-2-Clause -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
