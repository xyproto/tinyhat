set pkgname libbpf
set pkgver 1.7.0
set pkgrel 2
set pkgdesc 'Library for loading eBPF programs and reading and manipulating eBPF objects from user-space'
set url https://github.com/libbpf/libbpf
set nvchecker source=git git=https://github.com/libbpf/libbpf.git prefix=v
set arch i686 x32
set license 'LGPL-2.1-only OR BSD-2-Clause'
set depends glibc libelf linux-api-headers zlib
set makedepends git
set provides libbpf.so
set source "git+$url#tag=v$pkgver" libbpf-u128.patch
set sha512sums f623f39bec882c8a642bf8f1485d3ca028b393b73b1bb588be26b9b7f58040223b6ca778a098c2c7468cf60386cbc279d58c7f2c83836bf0fcebb87a69aa86f9 fad245822cb477682e6bb13889b2163babe66c833eabfc352e41e28201e36cfb33a1d0a2724cb1c5c28170073143bfd62ec91e55ea2e6521e3290bd373c09065
set b2sums 1315f3cdd336b57a70e2b0284d1f5a6ad32d1e3aabcca6fdccd50d51aa743f365c396ac240995e36d92f37f2d8bc0afb487e59a47638d0ae1f7999cc03cf0f5b 01c3e7e94be2a6f0600afcde7194883b796473b2b52bb30e16b54119b317ec5fb142145cc32a9945aec469740fea58540bfd67d3c10c865dcb14b15f1009a721
set flags arch

function prepare
    patch -Np1 -d $pkgname -i ../libbpf-u128.patch; or return
end

function build
    cd libbpf; or return
    make -C src; or return
end

function package
    cd libbpf; or return
    make -C src DESTDIR="$pkgdir" LIBSUBDIR=lib install; or return
    install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"; or return
    install -Dm 644 LICENSE.BSD-2-Clause -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
