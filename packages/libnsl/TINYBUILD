set pkgname libnsl
set pkgver 2.0.1
set pkgrel 2
set pkgdesc 'Public client interface library for NIS(YP)'
set arch i686 x32
set url https://github.com/thkukuk/libnsl
set license LGPL-2.1-only
set depends glibc libtirpc
set provides libnsl.so
set source "$url/archive/v$pkgver/$pkgname-v$pkgver.tar.gz"
set sha512sums 1d9290c3123c0933f156808c388654698f7d6994c625cbbc492cc07d656b996c62847048b14b93b8eda632945096ace418a3418ee1f40ff2cc748a3278f987a4
set b2sums 6988399a5c0f0dab89a47a026e8717f4a3276b0af7c7c507e7bcf1093951a258b54e84e09a679ff4e426ecffbcbb682c31ca393bde6cd92708e07d4709c203aa
set flags arch

function prepare
    cd $pkgname-$pkgver; or return
    autoreconf -fiv; or return
end

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr --disable-static; or return
    make; or return
end

function package
    make DESTDIR="$pkgdir" install -C $pkgname-$pkgver; or return
    install -vDm 644 $pkgname-$pkgver/{AUTHORS,NEWS,README} -t "$pkgdir/usr/share/doc/$pkgname/"; or return
end
