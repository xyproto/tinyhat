pkgname=tinyhat-ultrasnd
pkgver=20060219
pkgrel=1
pkgdesc="Gravis Ultrasound patches (ULTRASND) for DOSBox-X, made from FreePats"
arch=(any)
url="https://freepats.zenvoid.org/"
license=(GPL-2.0-or-later)
makedepends=(python)
source=("freepats_$pkgver.orig.tar.gz::https://deb.debian.org/debian/pool/main/f/freepats/freepats_$pkgver.orig.tar.gz"
        mkultrasnd.py)
sha256sums=('70bf8ca084df3903d6c9de43fe20539fc0a553d95cfba4d525da3fe66fda5f10'
            'SKIP')

prepare() {
  tar -xjf freepats-$pkgver/upstream/freepats-$pkgver.tar.bz2
}

package() {
  python3 mkultrasnd.py freepats "$pkgdir/usr/share/tinyhat/ultrasnd"
  install -Dm644 freepats/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 freepats/README "$pkgdir/usr/share/licenses/$pkgname/README"
}
