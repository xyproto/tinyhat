set pkgbase libxslt
set pkgname libxslt libxslt-docs
set pkgver 1.1.45
set pkgrel 2
set pkgdesc 'XML stylesheet transformation library'
set url https://gitlab.gnome.org/GNOME/libxslt/-/wikis/home
set arch i686 x32
set license MIT
set depends bash glibc libgcrypt libxml2 xz
set makedepends git python
set checkdepends docbook-xml
set source "git+https://gitlab.gnome.org/GNOME/libxslt.git#tag=v$pkgver" \
    0001-runtest-Print-output-causing-failure.patch
set b2sums 5370da9c8febd177b3a19e7b2e443674277b5b8e6c88a7563b789fba1c1dbc1ddcfaab5732d42cd8145a57665ee00968e8a3a7e704b4d2f9dcd6eab0791480b3 \
    23c696c4201d0227c71ec12fc19ed23e5997d235b5d001a52e41a3cc2da0f4ddf62f54652927fde460ccda82eaff23a4f23b2cece491c5b58cfd78ee3d93ce3f
set flags arch

function prepare
    cd libxslt; or return
    # Make test failures easier to fix
    git apply -3 ../0001-runtest-Print-output-causing-failure.patch; or return
    NOCONFIGURE=1 ./autogen.sh; or return
end

function build
    cd libxslt; or return
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --disable-static --with-python=/usr/bin/python; or return
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make; or return
end

function check
    cd libxslt; or return
    make check; or return
end

function package_libxslt
    set optdepends 'python: Python bindings'
    set provides lib{,e}xslt.so
    cd libxslt; or return
    make DESTDIR="$pkgdir" install; or return
    mkdir -p ../doc/usr/share; or return
    mv "$pkgdir"/usr/share/{doc,gtk-doc} -t ../doc/usr/share; or return
    install -Dm644 Copyright -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end

function package_libxslt-docs
    set pkgdesc "$pkgdesc (documentation)"
    set depends
    mv doc/* "$pkgdir"; or return
    install -Dm644 libxslt/Copyright -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
