set pkgname python-installer
set pkgver 1.1.0
set pkgrel 1
set pkgdesc 'Low-level library for installing a Python package from a wheel distribution'
set arch any
set url https://github.com/pypa/installer
set nvchecker source=git git=https://github.com/pypa/installer.git
set license MIT
set depends python
set makedepends python-flit-core
set source "python-installer-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz"
set sha512sums 8b237594ff4812c4718c72bf1eb1a0ef1cbdb40f601f9ed1df437733bdfcf2fe14fb9a9769aeda3ec8807d21f9d6aa8e6d418dad86d81102fec43f2eb50dba94
set flags arch

# Bootstrap: built with flit_core directly and installed by itself from src,
# because python-build needs packages that are installed with python-installer.

function build
    cd installer-$pkgver; or return
    python -m flit_core.wheel; or return
end

function package
    cd installer-$pkgver; or return
    PYTHONPATH=src python -m installer --destdir="$pkgdir" dist/*.whl; or return
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
    # Windows launcher executables
    find "$pkgdir" -type f -name '*.exe' -delete; or return
end
