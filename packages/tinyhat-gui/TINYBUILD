set pkgname tinyhat-gui
set pkgver 1
set pkgrel 9
set pkgdesc 'Tiny Hat backup, restore, file picker, media player, crash log and help dialogs, and the GL level probe'
set arch i686 x32
set url https://github.com/xyproto/tinyhat
set license BSD-3-Clause
set depends gtk4 libglvnd
set makedepends fontconfig tomlc17
set -g _progs tinyhat-backup tinyhat-restore tinyhat-pick tinyhat-crashlog-viewer tinyhat-help
set source $_progs.c tinyhat-glinfo.c
set sha256sums 09649e2a956680d0087c033764a3383d168cac618f2c74517efc81c4506a9569 \
    e947598941978ef52f65a87d19c8721066e0869efb8764311ef9fc1a672d1904 \
    45bcd0a4ad978650b42c835a904ce1dc4a1fa1a96ed56c5e68f86d5b0f7eecd8 \
    35c786a6daf43520c869b49042fdabcf918f335240077c55db91348d10c7c8f7 \
    9f3279a101bc8b8fcdc47560c771d3951d6ac3ff281cc4a45866fdda7a3da50c \
    b5ab8168cab0365fc1649140dba4c30f1e8586b690436befafc9967273ceb629

function build
    mkdir -p pc; or return
    for f in pango pangocairo pangoft2 pangoxft
        test -f /usr/lib/pkgconfig/$f.pc; and sed 's/>= *[0-9][0-9.]*//g' /usr/lib/pkgconfig/$f.pc >pc/$f.pc
    end
    set -lx PKG_CONFIG_PATH "$srcdir/pc"
    set -l cflags (pkg-config --cflags gtk4 libtomlc17 | string split -n ' '); or return
    set -l libs (pkg-config --libs gtk4 libtomlc17 | string split -n ' '); or return
    for p in $_progs
        cc $CFLAGS $cflags -o $p $p.c $LDFLAGS $libs; or return
    end
    cc $CFLAGS -o tinyhat-glinfo tinyhat-glinfo.c $LDFLAGS -lEGL; or return
end

function package
    for p in $_progs
        install -Dm755 $p "$pkgdir/usr/bin/$p"; or return
    end
    install -Dm755 tinyhat-glinfo "$pkgdir/usr/bin/tinyhat-glinfo"; or return
    install -Dm644 /usr/share/licenses/tomlc17/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.tomlc17"; or return
end
