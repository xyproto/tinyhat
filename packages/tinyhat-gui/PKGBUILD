pkgname=tinyhat-gui
pkgver=1
pkgrel=5
pkgdesc="Tiny Hat backup, restore, file picker and media player dialogs, and the GL level probe"
arch=(i686 x32)
url="https://github.com/xyproto/tinyhat"
license=(BSD-3-Clause)
depends=(gtk4 libglvnd)
makedepends=(fontconfig)
_progs=(tinyhat-backup tinyhat-restore tinyhat-pick)
source=("${_progs[@]/%/.c}" tinyhat-glinfo.c)
sha256sums=(SKIP SKIP SKIP SKIP)

build() {
  mkdir -p pc
  for f in pango pangocairo pangoft2 pangoxft; do
    [ -f /usr/lib/pkgconfig/$f.pc ] && sed 's/>= *[0-9][0-9.]*//g' /usr/lib/pkgconfig/$f.pc >pc/$f.pc
  done
  export PKG_CONFIG_PATH="$srcdir/pc"
  for p in "${_progs[@]}"; do
    cc $CFLAGS $(pkg-config --cflags gtk4) -o $p $p.c $LDFLAGS $(pkg-config --libs gtk4)
  done
  cc $CFLAGS -o tinyhat-glinfo tinyhat-glinfo.c $LDFLAGS -lEGL
}

package() {
  for p in "${_progs[@]}"; do
    install -Dm755 $p "$pkgdir/usr/bin/$p"
  done
  install -Dm755 tinyhat-glinfo "$pkgdir/usr/bin/tinyhat-glinfo"
}
