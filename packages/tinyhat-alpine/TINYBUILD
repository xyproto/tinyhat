function package
    set -l alparch x86
    set -l ldso ld-linux.so.2
    set -l ldsodir lib
    switch $CARCH
        case x86_64
            set alparch x86_64
            set ldso ld-linux-x86-64.so.2
            set ldsodir lib64
        case aarch64
            set alparch aarch64
            set ldso ld-linux-aarch64.so.1
    end
    mkdir -p $srcdir/apk-static; or return
    bsdtar -xf $srcdir/apk-static-x86_64.apk -C $srcdir/apk-static sbin/apk.static; or return
    set -l apk $srcdir/apk-static/sbin/apk.static

    set -l pv $srcdir/provides
    mkdir -p $pv/bin $pv/usr/sbin $pv/$ldsodir; or return
    ln -s /usr/lib/tinyhat-host/bin/bash $pv/bin/sh; or return
    ln -s /usr/lib/tinyhat-host/lib/$ldso $pv/$ldsodir/$ldso; or return
    install -m755 $srcdir/adduser $srcdir/addgroup $pv/usr/sbin/; or return
    $apk mkpkg --info name:tinyhat-provides --info version:0-r0 --info arch:noarch --info provider-priority:1 \
        --info 'description:Commands that Tiny Hat provides' --info license:BSD-3-Clause \
        --info 'provides:/bin/sh cmd:sh' --files $pv --output $srcdir/tinyhat-provides-0-r0.apk; or return

    set -l root $pkgdir/usr/lib/alpine
    mkdir -p $root; or return
    $apk --usermode --root $root --initdb --arch $alparch --no-scripts --no-network --allow-untrusted --no-cache \
        --force-non-repository add $srcdir/alpine-$alparch-*.apk $srcdir/tinyhat-provides-0-r0.apk; or return
    printf '' >$root/var/log/apk.log; or return
    printf '%s\n' alpine-baselayout alpine-keys alpine-release apk-tools ca-certificates-bundle tinyhat-provides \
        '!busybox-binsh' >$root/etc/apk/world; or return
    printf '%s\n' https://dl-cdn.alpinelinux.org/alpine/edge/{main,community,testing} >$root/etc/apk/repositories; or return
    echo $alparch >$root/etc/apk/arch; or return
    echo /usr/lib/tinyhat-host/lib >$root/etc/ld.so.conf; or return
    install -Dm644 $srcdir/tinyhat-host-fonts.conf $root/etc/fonts/conf.d/09-tinyhat-host-fonts.conf; or return
    mkdir -p $root/usr/lib/tinyhat-host $root/home $root/media $root/run $root/tmp; or return
    for f in resolv.conf hosts localtime machine-id
        test -e $root/etc/$f; or touch $root/etc/$f; or return
    end

    install -Dm755 $srcdir/tinyhat-alpine $pkgdir/usr/bin/tinyhat-alpine; or return
    install -Dm755 $srcdir/adduser $pkgdir/usr/share/tinyhat/alpine/adduser; or return
    install -Dm755 $srcdir/addgroup $pkgdir/usr/share/tinyhat/alpine/addgroup; or return
    install -Dm644 $srcdir/tinyhat-alpine.hook $pkgdir/usr/share/libalpm/hooks/zz-tinyhat-alpine.hook; or return
    install -Dm644 $srcdir/tinyhat-alpine-setup.service $pkgdir/usr/lib/systemd/system/tinyhat-alpine-setup.service; or return
    install -d $pkgdir/usr/lib/systemd/system/multi-user.target.wants; or return
    ln -s ../tinyhat-alpine-setup.service $pkgdir/usr/lib/systemd/system/multi-user.target.wants/tinyhat-alpine-setup.service; or return
end
