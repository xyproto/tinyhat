set pkgname gnutls
set pkgver 3.8.13
set pkgrel 3
set pkgdesc 'A library which provides a secure layer over a reliable transport layer'
set arch i686 x32
set license 'GPL-3.0-or-later AND LGPL-2.1-or-later'
set url https://www.gnutls.org/
set options '!zipman'
set depends glibc gmp libtasn1 zlib nettle leancrypto libstdc++ libgcc \
    libp11-kit libidn2 zstd libidn2.so libunistring brotli
# No API documentation (gtk-doc): autoreconf skips gtkdocize when it is missing,
# and gtk-doc.m4 and gtk-doc.make ship in the tarball
# No TPM2 wrapped keys (tpm2-tss)
set checkdepends net-tools tpm2-tools
set backup etc/gnutls/config
set source "https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/$pkgname-$pkgver.tar.xz" \
    config
set sha256sums ffed8ec1bf09c2426d4f14aae377de4753b53e537d685e604e99a8b16ca9c97e \
    22e614510fe52defe8c233ce3e5ead2205739fd967657ce3176ca121f3c562b5
set flags arch

function prepare
    cd $pkgname-$pkgver; or return
    autoreconf -vfi; or return
end

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --disable-gtk-doc \
        --with-idn \
        --with-brotli \
        --with-zstd \
        --without-tpm2 \
        --enable-openssl-compatibility \
        --with-default-trust-store-pkcs11="pkcs11:" \
        --enable-ktls \
        --with-leancrypto; or return
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make; or return
end

function check
    cd $pkgname-$pkgver; or return
    # ignore failing time test in gnulib for now
    # test-time fails the same way in gnulib as in findutils
    make check; or true
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    # disable ktls by default for now
    install -dm755 "$pkgdir"/etc/gnutls; or return
    install -Dm644 "$srcdir"/config "$pkgdir"/etc/gnutls/config; or return
end
