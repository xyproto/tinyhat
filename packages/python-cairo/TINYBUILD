set pkgbase python-cairo
set pkgname python-cairo
set pkgver 1.29.2
set pkgrel 1
set pkgdesc 'Python bindings for the cairo graphics library'
set url https://pycairo.readthedocs.io/en/latest/
set arch i686 x32
set license LGPL2.1 MPL
set depends cairo python
# No documentation (python-sphinx, python-sphinx_rtd_theme)
set makedepends meson
set checkdepends python-pytest
set source "https://github.com/pygobject/pycairo/releases/download/v$pkgver/pycairo-$pkgver.tar.gz"
set sha256sums 3e69fff74fe64f5ba2dfa31f67c6bdf26413342574047437d2ac520d35e9a489
set flags arch

# upstream git revision: ffd14d9096bfeb3097fbd5e6baa1414d596593cf (v1.29.1)

function build
    arch-meson pycairo-$pkgver build; or return
    meson compile -C build; or return
end

function check
    meson test -C build --print-errorlogs; or return
end

function package_python-cairo
    meson install -C build --destdir="$pkgdir"; or return

    # compile Python bytecode
    python -m compileall -d /usr/lib "$pkgdir/usr/lib"; or return
    python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"; or return
end
