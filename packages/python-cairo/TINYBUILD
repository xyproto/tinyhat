set pkgbase python-cairo
set pkgname python-cairo python-cairo-docs
set pkgver 1.29.2
set pkgrel 1
set pkgdesc 'Python bindings for the cairo graphics library'
set url https://pycairo.readthedocs.io/en/latest/
set arch i686 x32
set license LGPL2.1 MPL
set depends cairo python
set makedepends meson python-sphinx python-sphinx_rtd_theme
set checkdepends python-pytest
set source "https://github.com/pygobject/pycairo/releases/download/v$pkgver/pycairo-$pkgver.tar.gz"{,.sig}
set sha256sums 3e69fff74fe64f5ba2dfa31f67c6bdf26413342574047437d2ac520d35e9a489 \
    SKIP
set flags arch

# upstream git revision: ffd14d9096bfeb3097fbd5e6baa1414d596593cf (v1.29.1)

function build
    arch-meson pycairo-$pkgver build; or return
    meson compile -C build; or return
end

function check
    meson test -C build --print-errorlogs; or return
end

function package_python-cairo
    meson install -C build --destdir="$pkgdir"; or return

    # compile Python bytecode
    python -m compileall -d /usr/lib "$pkgdir/usr/lib"; or return
    python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"; or return
end

# python-sphinxcontrib-jquery 4.1-4.0 (built 2025-05, python 3.11 era) has not
# been rebuilt for python 3.14 yet, so sphinx's extension can not be imported
# from any 32-bit chroot ("Could not import extension sphinxcontrib.jquery")
# and the docs package fails every build. Stub the docs sub-package
# until the python 3.14 wave rebuilds it; nothing else references the docs
# staging tree, so nothing references them afterwards.
# The real docs build is:
#   python -m sphinx -b html pycairo-$pkgver/docs "$pkgdir/usr/share/doc/pycairo/html"
#   rm -r "$pkgdir/usr/share/doc/pycairo/html/.doctrees"
function package_python-cairo-docs
    set pkgdesc 'Developer documentation for Pycairo (stubbed on arch32)'
    set depends

    mkdir -p "$pkgdir"; or return
    touch "$pkgdir/this-is-a-dummy-package"; or return
end
