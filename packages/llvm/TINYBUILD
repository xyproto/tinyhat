set pkgbase llvm
set pkgname llvm-libs llvm clang lld
set pkgver 23.1.5
set pkgrel 1
set arch i686 x32
set url https://llvm.org/
set license 'Apache-2.0 WITH LLVM-exception'
set makedepends cmake ninja python libffi zlib zstd libxml2 ncurses
set source "https://github.com/llvm/llvm-project/releases/download/llvmorg-$pkgver/llvm-project-$pkgver.src.tar.xz"
set sha256sums fb50b1eac93ddeb3aa8dab4cfe324dff74f4a9c2bdee6160c9e36188f8d06a6e

function build
    cmake -S llvm-project-$pkgver.src/llvm -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="-Os -DNDEBUG" \
        -DCMAKE_CXX_FLAGS_RELEASE="-Os -DNDEBUG" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DCMAKE_BUILD_RPATH='$ORIGIN/../lib' \
        -DLLVM_TARGETS_TO_BUILD="X86;AMDGPU" \
        -DLLVM_ENABLE_PROJECTS="clang;clang-tools-extra;lld" \
        -DLLVM_BUILD_LLVM_DYLIB=ON \
        -DLLVM_LINK_LLVM_DYLIB=ON \
        -DLLVM_ENABLE_RTTI=ON \
        -DLLVM_ENABLE_EH=ON \
        -DLLVM_INCLUDE_TESTS=OFF \
        -DLLVM_INCLUDE_EXAMPLES=OFF \
        -DLLVM_INCLUDE_BENCHMARKS=OFF \
        -DLLVM_INCLUDE_DOCS=OFF \
        -DLLVM_PARALLEL_LINK_JOBS=2; or return
    ninja $NINJAFLAGS -C build; or return
end

function package_llvm-libs
    set pkgdesc 'LLVM runtime libraries, built for X86 and AMDGPU'
    set depends gcc-libs zlib zstd libffi libxml2 ncurses
    set provides libLLVM.so
    set -l major (string split -f1 . -- $pkgver)
    mkdir -p "$pkgdir/usr/lib"; or return
    cp -a build/lib/libLLVM*.so* build/lib/libLTO*.so* build/lib/libRemarks*.so* "$pkgdir/usr/lib/"; or return
    cd "$pkgdir/usr/lib"; or return
    set -l real (ls -S libLLVM*.so* | head -1)
    test -e "libLLVM-$major.so"; or ln -sf "$real" "libLLVM-$major.so"; or return
    test -e libLLVM.so; or ln -sf "$real" libLLVM.so; or return
    install -Dm644 "$srcdir/llvm-project-$pkgver.src/llvm/LICENSE.TXT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.TXT"; or return
end

function package_llvm
    set pkgdesc 'LLVM development files and tools'
    set depends "llvm-libs=$pkgver"
    set -l major (string split -f1 . -- $pkgver)
    DESTDIR="$pkgdir" cmake --install build; or return
    set -l files "$pkgdir"/usr/lib/lib{LLVM,LTO,Remarks,clang-cpp}*.so* "$pkgdir"/usr/lib/liblld*.a
    rm -f $files
    rm -rf "$pkgdir/usr/lib/clang"
    rm -f "$pkgdir"/usr/bin/{clang,"clang-$major",clang++,clangd,clang-format}
    rm -f "$pkgdir"/usr/bin/{lld,ld.lld,ld64.lld,lld-link,wasm-ld}
    rm -rf "$pkgdir"/usr/include/lld "$pkgdir"/usr/lib/cmake/lld
    install -Dm644 "$srcdir/llvm-project-$pkgver.src/llvm/LICENSE.TXT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.TXT"; or return
end

function package_clang
    set pkgdesc 'C and C++ compiler with clangd and clang-format, built for X86 and AMDGPU'
    set depends "llvm-libs=$pkgver" gcc
    set -l major (string split -f1 . -- $pkgver)
    mkdir -p "$pkgdir/usr/bin" "$pkgdir/usr/lib"; or return
    cp -a build/lib/libclang-cpp*.so* "$pkgdir/usr/lib/"; or return
    cp -a build/lib/clang "$pkgdir/usr/lib/"; or return
    for b in clang "clang-$major" clang++ clangd clang-format
        if test -e "build/bin/$b"
            cp -a "build/bin/$b" "$pkgdir/usr/bin/"; or return
        end
    end
    cd "$pkgdir/usr/lib/clang"; or return
    rm -rf analyze-c++ analyze-cc ccc-analyzer intercept-cc
    set -l files */include/arm* */include/riscv* */include/hexagon* */include/hvx* \
        */include/msa.h */include/htm* */include/vecintrin.h */include/s390intrin.h */include/velintrin* \
        */include/wasm* */include/__clang_cuda* */include/__clang_hip* */include/cuda_wrappers \
        */include/openmp_wrappers */include/ppc_wrappers */include/llvm_libc_wrappers */include/altivec.h
    rm -rf $files
    install -Dm644 "$srcdir/llvm-project-$pkgver.src/clang/LICENSE.TXT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.TXT"; or return
end

function package_lld
    set pkgdesc 'Linker from the LLVM project, with its static libraries for programs that embed it'
    set depends "llvm-libs=$pkgver"
    set -l root "$srcdir/lld-install"
    rm -rf "$root"
    DESTDIR="$root" cmake --install build; or return
    mkdir -p "$pkgdir/usr/bin" "$pkgdir/usr/lib/cmake" "$pkgdir/usr/include"; or return
    for b in lld ld.lld ld64.lld lld-link wasm-ld
        if test -e "$root/usr/bin/$b"; or test -L "$root/usr/bin/$b"
            cp -a "$root/usr/bin/$b" "$pkgdir/usr/bin/"; or return
        end
    end
    cp -a "$root"/usr/lib/liblld*.a "$pkgdir/usr/lib/"; or return
    cp -a "$root/usr/lib/cmake/lld" "$pkgdir/usr/lib/cmake/"; or return
    cp -a "$root/usr/include/lld" "$pkgdir/usr/include/"; or return
    rm -rf "$root"
    install -Dm644 "$srcdir/llvm-project-$pkgver.src/lld/LICENSE.TXT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.TXT"; or return
end
