pkgbase = llvm
	pkgver = 23.1.5
	pkgrel = 1
	url = https://llvm.org/
	arch = i686
	arch = x32
	license = Apache-2.0 WITH LLVM-exception
	makedepends = cmake
	makedepends = ninja
	makedepends = python
	makedepends = libffi
	makedepends = zlib
	makedepends = zstd
	makedepends = libxml2
	makedepends = ncurses
	source = https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.5/llvm-project-23.1.5.src.tar.xz
	sha256sums = fb50b1eac93ddeb3aa8dab4cfe324dff74f4a9c2bdee6160c9e36188f8d06a6e

pkgname = llvm-libs
	pkgdesc = LLVM runtime libraries, built for X86 and AMDGPU
	depends = gcc-libs
	depends = zlib
	depends = zstd
	depends = libffi
	depends = libxml2
	depends = ncurses
	provides = libLLVM.so

pkgname = llvm
	pkgdesc = LLVM development files and tools
	depends = llvm-libs=23.1.5

pkgname = clang
	pkgdesc = C and C++ compiler with clangd and clang-format, built for X86 and AMDGPU
	depends = llvm-libs=23.1.5
	depends = gcc

pkgname = lld
	pkgdesc = Linker from the LLVM project, with its static libraries for programs that embed it
	depends = llvm-libs=23.1.5
