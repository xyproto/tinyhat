set pkgbase orc
set pkgname orc
set pkgver 0.4.44
set pkgrel 1
set pkgdesc 'Optimized Inner Loop Runtime Compiler'
set url https://gstreamer.freedesktop.org/modules/orc.html
set nvchecker source=git git=https://gitlab.freedesktop.org/gstreamer/orc.git
set arch i686 x32
set license BSD-3-Clause
set depends glibc
# No documentation (hotdoc) and no valgrind (only an optional header check)
set makedepends clang git llvm meson
set flags arch
set source "git+https://gitlab.freedesktop.org/gstreamer/orc.git?signed#tag=$pkgver"
set b2sums 9a8a076322f2d3933bd731f21b0bf5b7c0aeec4426fdaa92b8e74d625c495aab2a0f976a58cbc7e1fbbae901999c9f27088ea3bd2b5d024f4e079c4874484c74

# No check(): the suite dies with SIGILL in the avx test vectors on the 32-bit builders
# (error log 2026-09-13 pentium4, 7/43 FAILs incl. test-accsadubl / exec_opcodes_sys), the compiled library itself works.

function build
    # No documentation (hotdoc)
    arch-meson orc build -D hotdoc=disabled; or return
    meson compile -C build; or return
end

function package_orc
    set provides liborc{,-test}-(string replace -r '\.[^.]*$' '' -- $pkgver).so

    meson install -C build --destdir "$pkgdir"; or return
    install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 orc/COPYING; or return
end
