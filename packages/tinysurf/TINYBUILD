set pkgname tinysurf
set pkgver 1.1.8
set pkgrel 2
set pkgdesc 'Lightweight and fast web browser, forked from NetSurf'
set arch i686 x32
set url https://github.com/xyproto/tinysurf
set license GPL-2.0-only MIT
set depends bubblewrap curl expat gtk4 libjpeg-turbo libpng libwebp openssl quickjs-ng zlib
set makedepends cmake ninja perl
set makedepends_build bison flex
set provides netsurf netsurfy
set conflicts netsurf netsurfy
set replaces netsurf netsurfy
set source "$pkgname-$pkgver.tar.gz::https://github.com/xyproto/tinysurf/archive/refs/tags/v$pkgver.tar.gz" \
    tinysurf-sandbox
set sha256sums 5f2167b96f1b674a3ed7130623b18a803207d31494f1e7126d56f9ff07f7d4b8 \
    f97a39c330ef9bb2103efda24ab664fe1a85f0091d3583d523c88ce453b378f6
set b2sums 8a8d4f4c402ff03b7369ea88e859ac0a475e68f9e0f4054560d5eea3a82dca1fd9dd86a2c29f61d03602fada9e4788d646aedf5c98400e8a2b90093e477cb668 \
    07c546b4c9f73647435b9c8f114022ec5841c3b489c377a4e710ac937678164c4eb63ef092c62e0a2bb1b83daa6e02baa2663243ceaee916b2d39ecfc7052587

function build
    set -l cross
    set -l clean
    if string match -q -- '*-gcc' $CC
        set cross -DCMAKE_TOOLCHAIN_FILE=$CMAKE_TOOLCHAIN_FILE -DNETSURFY_HOST_C_COMPILER=(command -s $CC_FOR_BUILD) \
            "-DCMAKE_C_FLAGS=$CFLAGS" "-DCMAKE_EXE_LINKER_FLAGS=$LDFLAGS" "-DCMAKE_SHARED_LINKER_FLAGS=$LDFLAGS"
        set clean -u CMAKE_TOOLCHAIN_FILE -u CC -u CFLAGS -u CPPFLAGS -u LDFLAGS
    end
    env $clean cmake -B build -S $pkgname-$pkgver -G Ninja $cross \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=None \
        -DBUILD_TESTING=OFF \
        -DNETSURFY_BUILD_HEADLESS=ON \
        -DNETSURFY_FETCH_QUICKJS=OFF; or return
    env $clean cmake --build build; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
    install -Dm755 "$pkgdir/usr/bin/$pkgname" "$pkgdir/usr/lib/$pkgname/$pkgname"; or return
    install -Dm755 tinysurf-sandbox "$pkgdir/usr/bin/$pkgname"; or return
    # tinysurf-headless: the same browser without a window, driven on stdin and stdout (no install rule upstream)
    install -Dm755 build/tinysurf-headless "$pkgdir/usr/bin/tinysurf-headless"; or return
    cd $pkgname-$pkgver; or return
    install -Dm644 img/gtk/$pkgname.xpm "$pkgdir/usr/share/pixmaps/$pkgname.xpm"; or return
    install -Dm644 src/frontends/gtk/res/$pkgname.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"; or return
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
