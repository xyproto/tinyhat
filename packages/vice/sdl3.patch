+#  define SDL_ENABLE 1
+#  define SDL_SetWindowData(w, key, p) SDL_SetPointerProperty(SDL_GetWindowProperties(w), (key), (p))
+#  define SDL_GetWindowData(w, key) SDL_GetPointerProperty(SDL_GetWindowProperties(w), (key), NULL)
+#  define SDL_WINDOW_FULLSCREEN_DESKTOP SDL_WINDOW_FULLSCREEN
+#  define SDL_DISABLE 0
+#  define SDL_QUERY -1
+static inline SDL_JoystickID vice_sdl3_joystick_id(int index)
+{
+    int count = 0;
+    SDL_JoystickID id = 0;
+    SDL_JoystickID *ids = SDL_GetJoysticks(&count);
+    if (ids != NULL && index >= 0 && index < count) {
+        id = ids[index];
+    }
+    SDL_free(ids);
+    return id;
+}
+static inline int SDL_NumJoysticks(void)
+{
+    int count = 0;
+    SDL_free(SDL_GetJoysticks(&count));
+    return count;
