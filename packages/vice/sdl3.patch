+static void sdl_stream_callback(void *userdata, SDL_AudioStream *stream, int additional, int total)
+{
+    Uint8 buf[4096];
+
+    while (additional > 0) {
+        int len = additional < (int)sizeof(buf) ? additional : (int)sizeof(buf);
+        len &= ~1;
