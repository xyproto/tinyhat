pkgname=vice
pkgver=3.10
pkgrel=2
pkgdesc="Commodore 64 emulator (x64sc) with the SDL UI, ported to SDL3"
arch=(i686 x32)
url="https://vice-emu.sourceforge.io/"
license=(GPL-2.0-or-later)
depends=(sdl3 sdl3_image libpng zlib)
makedepends=(flex xa autoconf automake)
source=("vice-$pkgver.tar.gz::https://sourceforge.net/projects/vice-emu/files/releases/vice-$pkgver.tar.gz/download"
        sdl3.patch)
sha256sums=('8e5bac18cbcb9f192380ad3ef881f8790f5b75c41d7b3da65d831985d864d6d1'
            'c49f4647af7502d46d0e60aaa2ca044ee3b0190f2281bc2433cb20c756bfbbda')

prepare() {
  cd vice-$pkgver
  patch -p1 -i "$srcdir/sdl3.patch"
  autoreconf -fi
  sed -i 's/if ((log_to_file) || (!log_colorize)) {/if ((log_to_file) || (!log_colorize) || (log_to_stdout)) {/' src/log.c
  mkdir -p "$srcdir/bin"
  printf '#!/bin/sh\nfor f; do sed -i "s/\\r$//" "$f"; done\n' >"$srcdir/bin/dos2unix"
  chmod 755 "$srcdir/bin/dos2unix"
}

build() {
  cd vice-$pkgver
  export PATH="$srcdir/bin:$PATH"
  CFLAGS="$CFLAGS -O3"
  CXXFLAGS="$CXXFLAGS -O3"
  export CFLAGS CXXFLAGS
  ./configure --prefix=/usr --enable-sdl2ui --with-sdlsound --without-alsa --without-pulse \
    --disable-html-docs --disable-pdf-docs --without-flac --without-vorbis --without-mpg123 --without-lame \
    --disable-ffmpeg --disable-ethernet --disable-catweasel --disable-hardsid --disable-parsid --disable-midi
  make
}

package() {
  cd vice-$pkgver
  make DESTDIR="$pkgdir" install
  cd "$pkgdir/usr"
  find bin -type f ! -name x64sc ! -name x64 ! -name c1541 -delete
  find bin -type l -delete
  install -Dm755 bin/x64sc lib/vice/x64sc
  rm bin/x64sc
  install -Dm755 /dev/stdin bin/x64sc <<'EOF'
#!/bin/sh
set -- -autostartprgmode 1 -autostart-warp "$@"
if tinyhat-slow; then
	set -- -sidengine 0 -soundrate 22050 -VICIIfilter 0 "$@"
fi
exec /usr/lib/vice/x64sc "$@"
EOF
  rm -rf share/doc share/man share/info share/applications share/icons share/metainfo
  cd share/vice
  rm -rf C128 C64DTV CBM-II PET PLUS4 SCPU64 VIC20 GLSL
  rm -f C64/gtk3_*.vkm common/*.svg common/*.ttf common/icon1024x1024.png common/Icon-128@2x.png
  find common -name '*.png' ! -name 'C64_*' -delete
  install -Dm644 "$srcdir/vice-$pkgver/COPYING" "$srcdir/vice-$pkgver/README" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
