# Oils (OSH and YSH): Tiny Hat's script shell. osh is also /usr/bin/sh and /usr/bin/bash, so this package provides sh
# and bash, and Tiny Hat has no bash, dash or busybox sh. Built without readline: fish is the interactive shell.
# Ported from Arch's oils-for-unix 0.38.0-1
set pkgname oils-for-unix
set pkgver 0.38.0
set pkgrel 1
set pkgdesc 'Oils for Unix: OSH and YSH shells, also sh and bash on Tiny Hat'
set arch i686 x32 x86_64 aarch64
set url https://oils.pub/
set license Apache-2.0
set depends glibc libgcc libstdc++
set makedepends_build bash
set provides sh bash
set conflicts bash
set replaces osh oil
set install oils-for-unix.install
set source "$url/download/oils-for-unix-$pkgver.tar.gz"
set noextract oils-for-unix-$pkgver.tar.gz
set sha512sums 27ad5bf6446b9b3918344776c42e190d1640df74bda01da692818b588e5fdfa4d4650eacd53ac5674d02f61232f83e199dfc36d6a65ee34d37c962ce936ee23d
set flags arch

function prepare
    # The build calls c++ and strip by those names: c++ gets the build flags, and strip is left to makep
    mkdir -p path; or return
    printf '%s\n' '#!/bin/sh' 'exec g++ $CXXFLAGS $LDFLAGS -fPIC "$@"' >path/c++; or return
    printf '%s\n' '#!/bin/sh' 'exec cp -p "$3" "$2"' >path/strip; or return
    chmod +x path/c++ path/strip; or return
    # tar, not bsdtar: the tarball has hard links that point to themselves
    tar -xf oils-for-unix-$pkgver.tar.gz; or return
end

function build
    cd oils-for-unix-$pkgver; or return
    ./configure --prefix=/usr --datarootdir=/usr/share --without-readline; or return
    env PATH="$srcdir/path:$PATH" _build/oils.sh; or return
end

function package
    cd oils-for-unix-$pkgver; or return
    env DESTDIR="$pkgdir" ./install; or return
    # osh is the system shell: sh, and bash for scripts that ask for it
    ln -s osh "$pkgdir"/usr/bin/sh; or return
    ln -s osh "$pkgdir"/usr/bin/bash; or return
end
