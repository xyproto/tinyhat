set pkgbase zlib
set pkgname zlib zlib-static minizip
set epoch 1
set pkgver 1.3.2
set pkgrel 4
set pkgdesc 'Compression library implementing the deflate compression method found in gzip and PKZIP'
set arch i686 x32
set license Zlib
set url https://www.zlib.net/
set nvchecker source=git git=https://github.com/madler/zlib.git prefix=v ignored=v1.3.1.2
set source "https://github.com/madler/zlib/releases/download/v$pkgver/$pkgbase-$pkgver.tar.xz" \
    "36ff1be48ef696cc67b0855f7c8537ce0276210d.patch::https://github.com/madler/zlib/commit/36ff1be48ef696cc67b0855f7c8537ce0276210d.patch?full_index=1" \
    "$pkgbase-1.3.2-CVE-2026-85091.patch::https://github.com/madler/zlib/commit/df84af25dc1942490e1d1c899a07619152a46148.patch?full_index=1"
set sha512sums cf3d49fbabddc57cca99858feeca8f910e9de42a16014cddd406814d2d24ee33fee2af3805d7efbb1b04b05f55818092b000daf82502b675df65f2512c353f73 \
    ba1a3d38a1e376d54ecce52994c98daf0a5fffc45ed7a94144ba937b874ab2a765a767a5e476010eeb2f78cccaa1b0b1fcd9a653fd3bc3ac1062ceef5445f125 \
    a8cca9039ff9f09f92fa7fbcf5c6744615e8cd71a033784c0b996ee931af0dfa69f5b6efb67243693d418b9b3e1f7dadc178335bd407b72b0d72bdc4679da9ff
set b2sums fd3a6e4c275a925f4814de487075c136e28421ea34ca7f93141781e7a414b392cd849fbf96cfcb24e825441df5f3c64be54276c0f617dc2d5c865d4ab260e83c \
    1b209ef0971d45fd2135482835f32e09b40c255e2ca6461edb52f92060e2589939798437c61b9846528c2c37b157a54672a44c2032de945aad598fefd9c1f074 \
    9c677876fadbd9f0db7c3a6238ed3597960f94723d47956c6ffe44dda38cdec7e08a72b4b601d313c59d1d0fe46536196be8bf0b6d03ba8aff1060e1aaa2bf2b
set flags arch

function prepare
    # Fix missing header
    patch -Np1 -d $pkgbase-$pkgver -i "$srcdir"/36ff1be48ef696cc67b0855f7c8537ce0276210d.patch; or return
    patch -Np1 -d $pkgbase-$pkgver -i ../$pkgbase-1.3.2-CVE-2026-85091.patch; or return
    cd $pkgbase-$pkgver/contrib/minizip; or return
    cp Makefile Makefile.orig; or return
    cp ../README.contrib readme.txt; or return
    autoreconf -fiv; or return
    # NOTE: We are not running autoreconf for the top-level project, because `configure` is a custom script.
end

function build
    cd $pkgbase-$pkgver; or return
    set -a CFLAGS -ffat-lto-objects
    ./configure --prefix=/usr; or return
    make; or return
    cd contrib/minizip; or return
    ./configure --prefix=/usr --enable-static=no; or return
    make; or return
end

function check
    make test -C $pkgbase-$pkgver; or return
    make -f Makefile.orig test -C $pkgbase-$pkgver/contrib/minizip; or return
end

# Move files (relative to the current directory, or under $pkgdir) to $srcdir/NAME
function _pick
    set -l p $argv[1]
    for f in $argv[2..-1]
        set -l rel $f
        string match -q -- "$pkgdir/*" $f; and set rel (string sub -s (math (string length -- $pkgdir) + 2) -- $f)
        set -l d "$srcdir/$p/$rel"
        mkdir -p (dirname $d); or return
        mv $f $d; or return
        rmdir -p --ignore-fail-on-non-empty (dirname $f); or return
    end
end

function package_zlib
    set depends glibc
    set provides libz.so
    make install DESTDIR="$pkgdir" -C $pkgbase-$pkgver; or return
    install -D -m644 $pkgbase-$pkgver/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
    cd "$pkgdir"; or return
    _pick $pkgbase-static usr/lib/libz.a; or return
end

function package_zlib-static
    set pkgdesc "$pkgdesc - static library"
    set depends glibc zlib
    set options staticlibs
    mv -v $pkgbase-static/* "$pkgdir"; or return
    install -vDm 644 $pkgbase-$pkgver/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end

function package_minizip
    set pkgdesc 'Mini zip and unzip based on zlib'
    set depends glibc zlib
    make install DESTDIR="$pkgdir" -C $pkgbase-$pkgver/contrib/$pkgname; or return
    install -D -m644 $pkgbase-$pkgver/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
    # https://github.com/madler/zlib/pull/229
    rm "$pkgdir/usr/include/minizip/crypt.h"; or return
end
