set pkgname libsoxr
set pkgver 0.1.3
set pkgrel 5
set pkgdesc 'The SoX Resampler library that aims to give fast and high quality results for any constant resampling ratio'
set arch i686 x32
set url https://sourceforge.net/p/soxr/wiki/Home/
set nvchecker source=git git=https://github.com/chirlu/soxr.git
set license LGPL-2.1-only LicenseRef-soxr
set depends glibc libgcc libgomp
set makedepends git cmake ninja
set source "git+https://github.com/chirlu/soxr.git#tag=$pkgver"
set b2sums bb252500db2c2909fecdd1df7ab3c42c8930bd5c4e41734449edef7eaf16787418a6b4377b26051d3bbe74b79264e2a8193cbb1095bf58c665c706e2b265e6ac
set flags arch

function build
    cmake -S soxr -B build -G Ninja -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_EXAMPLES=OFF \
        -DBUILD_SHARED_LIBS=ON -DWITH_AVFFT=ON -DWITH_LSR_BINDINGS=ON -DWITH_OPENMP=ON -DWITH_PFFFT=ON \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5; or return
    cmake --build build; or return
end

function check
    ctest --test-dir build; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
    rm -rf "$pkgdir"/usr/share/doc; or return
    install -Dm 644 soxr/LICENCE -t "$pkgdir"/usr/share/licenses/libsoxr/; or return
end
