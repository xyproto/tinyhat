# Directories that are not owned by root:root (makefish builds without root, the package archive gets these owners)
# vsftpd won't run with write perms on /srv/ftp; allow setgid games (gid 50) to write scores
set owners 'srv/ftp 0:11' 'var/games 0:50'
set flags arch

function package
    # directories and their mode, all paths are relative to the root directory /
    # (the owner is root:root, or the one given in owners)
    set -l directories \
        boot:755 \
        dev:755 \
        etc:755 \
        etc/ld.so.conf.d:755 \
        etc/profile.d:755 \
        etc/skel:755 \
        home:755 \
        mnt:755 \
        opt:755 \
        proc:555 \
        root:0750 \
        run:755 \
        srv/http:755 \
        srv/ftp:555 \
        sys:555 \
        tmp:1777 \
        usr:755 \
        usr/bin:755 \
        usr/include:755 \
        usr/lib:755 \
        usr/lib/ld.so.conf.d:755 \
        usr/local/bin:755 \
        usr/local/etc:755 \
        usr/local/games:755 \
        usr/local/include:755 \
        usr/local/lib:755 \
        usr/local/man:755 \
        usr/local/sbin:755 \
        usr/local/share:755 \
        usr/local/src:755 \
        usr/share/factory/etc:755 \
        usr/share/man/man1:755 \
        usr/share/man/man2:755 \
        usr/share/man/man3:755 \
        usr/share/man/man4:755 \
        usr/share/man/man5:755 \
        usr/share/man/man6:755 \
        usr/share/man/man7:755 \
        usr/share/man/man8:755 \
        usr/share/misc:755 \
        usr/share/pixmaps:755 \
        usr/src:755 \
        var:755 \
        var/cache:755 \
        var/empty:755 \
        var/games:775 \
        var/lib/misc:755 \
        var/local:755 \
        var/log/old:755 \
        var/opt:755 \
        var/spool/mail:1777 \
        var/tmp:1777

    # symlink names and their respective targets, all paths are relative to the root directory /
    set -l symlinks \
        bin:usr/bin \
        etc/mtab:../proc/self/mounts \
        lib:usr/lib \
        sbin:usr/bin \
        usr/local/share/man:../man \
        usr/sbin:bin \
        var/lock:../run/lock \
        var/mail:spool/mail \
        var/run:../run
    if test $CARCH = x86_64
        set -a symlinks lib64:usr/lib usr/lib64:lib
    end

    # target files, their source file and file mode (owned by root:root)
    set -l files \
        etc/arch-release:arch-release:644 \
        etc/crypttab:crypttab:600 \
        etc/fstab:fstab:644 \
        etc/group:group:644 \
        etc/gshadow:gshadow:600 \
        etc/host.conf:host.conf:644 \
        etc/hosts:hosts:644 \
        etc/issue:issue:644 \
        etc/ld.so.conf:ld.so.conf:644 \
        etc/nsswitch.conf:nsswitch.conf:644 \
        etc/passwd:passwd:644 \
        etc/profile:profile:644 \
        etc/profile.d/locale.sh:locale.sh:644 \
        etc/resolv.conf:resolv.conf:644 \
        etc/securetty:securetty:644 \
        etc/shells:shells:644 \
        etc/shadow:shadow:600 \
        etc/subgid:subgid:644 \
        etc/subuid:subuid:644 \
        usr/lib/os-release:os-release:644 \
        usr/lib/sysctl.d/10-arch.conf:sysctl:644 \
        usr/lib/sysusers.d/arch.conf:sysusers:644 \
        usr/lib/tmpfiles.d/arch.conf:tmpfiles:644 \
        usr/lib/systemd/system-environment-generators/10-arch:env-generator:755 \
        usr/share/factory/etc/arch-release:arch-release:644 \
        usr/share/factory/etc/crypttab:crypttab:600 \
        usr/share/factory/etc/fstab:fstab:644 \
        usr/share/factory/etc/group:group:644 \
        usr/share/factory/etc/gshadow:gshadow:600 \
        usr/share/factory/etc/host.conf:host.conf:644 \
        usr/share/factory/etc/hosts:hosts:644 \
        usr/share/factory/etc/issue:issue:644 \
        usr/share/factory/etc/ld.so.conf:ld.so.conf:644 \
        usr/share/factory/etc/nsswitch.conf:nsswitch.conf:644 \
        usr/share/factory/etc/passwd:passwd:644 \
        usr/share/factory/etc/profile:profile:644 \
        usr/share/factory/etc/profile.d/locale.sh:locale.sh:644 \
        usr/share/factory/etc/resolv.conf:resolv.conf:644 \
        usr/share/factory/etc/securetty:securetty:644 \
        usr/share/factory/etc/shadow:shadow:600 \
        usr/share/factory/etc/shells:shells:644 \
        usr/share/factory/etc/subgid:subgid:644 \
        usr/share/factory/etc/subuid:subuid:644 \
        usr/share/pixmaps/archlinux-logo.png:archlinux-logo.png:644 \
        usr/share/pixmaps/archlinux-logo.svg:archlinux-logo.svg:644 \
        usr/share/pixmaps/archlinux-logo-text.svg:archlinux-logo-text.svg:644 \
        usr/share/pixmaps/archlinux-logo-text-dark.svg:archlinux-logo-text-dark.svg:644

    cd "$pkgdir"; or return

    for entry in $directories
        set -l f (string split : -- $entry)
        install -vdm $f[2] $f[1]; or return
    end

    for entry in $symlinks
        set -l f (string split : -- $entry)
        ln -sv $f[2] $f[1]; or return
    end

    for entry in $files
        set -l f (string split : -- $entry)
        install -vDm $f[3] "$srcdir/$f[2]" $f[1]; or return
    end

    install -vDm 644 "$srcdir/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
