set pkgname go-tinyhat
set pkgver 1.27.3
set pkgrel 1
set -g _chain 1.22.12 1.24.13 $pkgver
set pkgdesc 'Go toolchain for building Tiny Hat packages, bootstrapped from source'
set arch i686
set url https://go.dev/
set license BSD-3-Clause
set makedepends go
# !elfcheck: Go's source tree has ELF files for other architectures on purpose (test data, race detector and
# BoringCrypto objects), which are never linked into i686 programs
set options '!strip' '!buildflags' '!elfcheck'
set source "https://go.dev/dl/go$_chain[1].src.tar.gz" \
    "https://go.dev/dl/go$_chain[2].src.tar.gz" \
    "https://go.dev/dl/go$_chain[3].src.tar.gz"
set noextract (string replace -r '.*/' '' -- $source)
set sha256sums 012a7e1f37f362c0918c1dfa3334458ac2da1628c4b9cf4d9ca02db986e17d71 \
    639a6204c2486b137df1eb6e78ee3ed038f9877d0e4b5a465e796a2153f858d7 \
    6e7749035cf360f06b2575d162ea79df9fda8ef671889e5c375f8e50777f26bb

function prepare
    for v in $_chain
        rm -rf "go$v"; or return
        mkdir "go$v"; or return
        tar --no-same-owner -xf "go$v.src.tar.gz" -C "go$v" --strip-components=1; or return
    end
end

function build
    set -lx GOCACHE "$srcdir/gocache"
    set -lx GOPATH "$srcdir/gopath"
    set -lx GOTOOLCHAIN local
    set -lx GOARCH 386
    set -lx GO386 softfloat
    set -lx CGO_ENABLED 0
    set -l boot /usr/lib/go
    for v in $_chain
        env -C "go$v/src" GOROOT_BOOTSTRAP="$boot" ./make.bash; or return
        set boot "$srcdir/go$v"
    end
end

function package
    mkdir -p "$pkgdir/usr/lib"; or return
    cp -a "go$pkgver" "$pkgdir/usr/lib/go-tinyhat"; or return
    set -l gitfiles "$pkgdir/usr/lib/go-tinyhat"/.git*
    rm -rf "$pkgdir/usr/lib/go-tinyhat"/{test,pkg/obj} $gitfiles; or return
    install -Dm644 "go$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
