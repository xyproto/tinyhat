set pkgname cups-filters
set pkgver 2.0.1
set pkgrel 3
set pkgdesc 'OpenPrinting CUPS Filters'
set arch i686 x32
set url https://wiki.linuxfoundation.org/openprinting/cups-filters
set license 'Apache-2.0 WITH LLVM-exception'
set depends libcups libppd libcupsfilters glibc sh
set makedepends ghostscript mupdf-tools
set optdepends 'ghostscript: for non-PDF printers (preferred)' \
    'poppler: for non-PDF printers' \
    'mupdf-tools: for non-PDF printers'
# cups-filters-gcc15.patch::https://github.com/OpenPrinting/cups-filters/pull/618/changes/44f59a1aa74c48515d8feba5a61b7ea3aaa592c4.patch
set source "https://github.com/OpenPrinting/$pkgname/releases/download/$pkgver/$pkgname-$pkgver.tar.xz" \
    0001-Fix-build-failure-with-GCC-15-and-std-c23.patch
set sha256sums 39e71de3ce06762b342749f1dc7cba6817738f7bf4d322c1bb9ab10b8569ab80 \
    2f47e871e44c51c1d6ac5a4c09117eb99c52e787263a91b80af38900daf7c1a6
set flags arch

function prepare
    cd $pkgname-$pkgver; or return
    patch -Np1 -i ../0001-Fix-build-failure-with-GCC-15-and-std-c23.patch; or return
end

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr --sysconfdir=/etc --sbindir=/usr/bin --localstatedir=/var \
        --enable-individual-cups-filters --disable-universal-cups-filter --enable-avahi; or return
    make; or return
end

function check
    cd $pkgname-$pkgver; or return
    make check; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir/" install; or return
    # license
    mkdir -p "$pkgdir"/usr/share/licenses/$pkgname; or return
    install -m644 "$srcdir"/$pkgname-$pkgver/{COPYING,NOTICE} "$pkgdir"/usr/share/licenses/$pkgname/; or return
end
