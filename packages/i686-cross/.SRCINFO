pkgbase = i686-cross
	pkgdesc = Cross toolchain from x86_64 to i686 (binutils, gcc and a bootstrap glibc), to build Tiny Hat for i686 without prebuilt i686 packages
	pkgver = 16.2.0
	pkgrel = 2
	url = https://gcc.gnu.org/
	arch = x86_64
	license = GPL-3.0-or-later WITH GCC-exception-3.1
	license = GPL-3.0-or-later
	license = LGPL-2.1-or-later
	makedepends = python
	makedepends = bison
	depends = gmp
	depends = mpfr
	depends = libmpc
	depends = libisl
	depends = zlib
	depends = zstd
	options = !buildflags
	options = !strip
	options = !elfcheck
	options = staticlibs
	source = https://ftp.gnu.org/gnu/gcc/gcc-16.2.0/gcc-16.2.0.tar.xz
	source = https://ftp.gnu.org/gnu/binutils/binutils-2.47.tar.bz2
	source = https://ftp.gnu.org/gnu/glibc/glibc-2.44.tar.xz
