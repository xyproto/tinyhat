set pkgname libedit
set pkgver 20260512_3.1
set pkgrel 1
set pkgdesc 'Command line editor library providing generic line editing, history, and tokenization functions'
set arch i686 x32
set url https://thrysoee.dk/editline/
set nvchecker source=regex url=https://thrysoee.dk/editline/ 'regex=libedit-([0-9\.\-]+).tar.gz' 'from_pattern=\-' to_pattern=_
set license BSD-3-Clause
set depends glibc libncursesw.so ncurses
set source https://thrysoee.dk/editline//libedit-20260512-3.1.tar.gz
set sha256sums 432d5e7ea8b0116dd39f2eca7bc11d0eed77faa6b77ea526ace89907c23ea4a0
set flags arch
set -g _pkgver 20260512-3.1

function build
    cd $pkgname-$_pkgver; or return
    ./configure --prefix=/usr; or return
    make V=1; or return
end

function package
    set provides libedit.so
    cd $pkgname-$_pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    install -Dm 644 ChangeLog -t "$pkgdir/usr/share/doc/$pkgname"; or return
    install -Dm 644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
