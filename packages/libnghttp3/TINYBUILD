set pkgname libnghttp3
set pkgver 1.18.0
set pkgrel 2
set pkgdesc 'HTTP/3 library written in C'
set url https://github.com/ngtcp2/nghttp3
set nvchecker source=git git=https://github.com/ngtcp2/nghttp3.git prefix=v
set arch i686 x32
set license MIT
set depends glibc
set makedepends git
set provides libnghttp3.so
set source "git+https://github.com/ngtcp2/nghttp3.git?signed#tag=v$pkgver" \
    git+https://github.com/ngtcp2/munit.git#commit=11e8e3466b2d6a8bdfd4b05a3d1ee7805c5d3442 \
    git+https://github.com/ngtcp2/sfparse.git#commit=4b313cfd2e1b389ae632b36dcd50402307289af2
set sha256sums 5e0c2de58014f949291cf70cba926c6435658652d681eee085226274b26e5062 \
    368aef912d78fce711c761532aaa5dd211fea0a3856b0d52e428e9af395abff8 \
    453f60ce638384871bc1bc6a73e899a39df30dd478a872c822cf290bd2b9875d
set flags arch

function prepare
    cd nghttp3/; or return
    git config --file=.gitmodules submodule.tests/munit.url ../munit/; or return
    git config --file=.gitmodules submodule.lib/sfparse.url ../sfparse/; or return
    git submodule init; or return
    git -c protocol.file.allow=always submodule update; or return
    autoreconf -i; or return
end

function build
    cd nghttp3/; or return
    ./configure \
        --prefix=/usr; or return
    make; or return
end

function check
    cd nghttp3/; or return
    make check; or return
end

function package
    cd nghttp3/; or return
    make DESTDIR="$pkgdir" install; or return
    install -D -m0644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
