set pkgname grep
set pkgver 3.12
set pkgrel 2
set pkgdesc 'A string search utility'
set arch i686 x32
set url https://www.gnu.org/software/grep/
set license GPL3
set depends glibc pcre2
set makedepends gperf python
set source "https://ftp.gnu.org/gnu/grep/grep-$pkgver.tar.xz"
set sha256sums 2649b27c0e90e632eadcd757be06c6e9a4f48d941de51e7c0f83ff76408a07b9
set flags arch

function prepare
    true
end

function build
    cd "$pkgname-$pkgver"; or return
    ./configure --prefix=/usr; or return
    make; or return
end

function package
    cd "$pkgname-$pkgver"; or return
    make DESTDIR="$pkgdir" install; or return
end
