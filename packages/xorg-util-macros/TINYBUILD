set pkgname xorg-util-macros
set pkgver 1.20.2
set pkgrel 1
set pkgdesc 'X.Org Autotools macros'
set arch any
set url https://xorg.freedesktop.org/
set nvchecker source=gitlab gitlab=xorg/util/macros host=gitlab.freedesktop.org use_max_tag=true 'include_regex=.*util-macros-.*' prefix=util-macros-
set license 'HPND-sell-variant AND MIT'
set source "https://xorg.freedesktop.org/releases/individual/util/util-macros-$pkgver.tar.xz"
set sha512sums 7d5ae8dbb6c1977e40c024f63d1405e7d5a40a38b90b01208d8dc1f1548e309734d1dec177b68bbf342a4d7d56ab0cfb4c8c36575c6a774b5a76a88d926c6d7b
set flags arch

function build
    cd util-macros-$pkgver; or return
    ./configure --prefix=/usr; or return
    make; or return
end

function package
    cd util-macros-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"; or return
end
