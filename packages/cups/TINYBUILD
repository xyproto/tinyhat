set pkgbase cups
set pkgname libcups cups
set pkgver 2.4.20
set pkgrel 1
set epoch 2
set arch i686 x32
set license 'Apache-2.0 WITH LLVM-exception AND BSD-3-Clause AND Zlib AND BSD-2-Clause'
set url https://openprinting.github.io/cups/
set makedepends acl pam gnutls colord libusb systemd libpaper
set source https://github.com/OpenPrinting/cups/releases/download/v$pkgver/cups-$pkgver-source.tar.gz \
    cups.logrotate \
    cups.pam \
    cups.sysusers \
    cups-2.4.0-statedir.patch \
    cups-freebind.patch \
    guid.patch
set sha256sums ab4d9cd7f3e58060091d2b24972223d6401675f11c49b65abf4f6ef31dea22ff \
    d87fa0f0b5ec677aae34668f260333db17ce303aa1a752cba5f8e72623d9acf9 \
    57dfd072fd7ef0018c6b0a798367aac1abb5979060ff3f9df22d1048bb71c0d5 \
    5324bd933385713e0dfd0b20cf5f861d1401bdeb693c5be7edc3ca4404e78e2b \
    f0b15192952c151b1843742c87850ff3a7d0f3ba5dd236ed16623ef908472ad7 \
    3385047b9ac8a7b13aeb8f0ca55d15f793ce7283516db0155fe28a67923c592d \
    8becc2ad17787ef755fb77f83a87cf52f1a38154c5dde0f4a0051e06a0583fb9
set flags arch

# avahi and cups-filters only on i686 (from archlinux32)
switch $CARCH
    case i686
        set -a makedepends avahi cups-filters
end

function prepare
    cd "$pkgbase-$pkgver"; or return
    # move /var/run -> /run for pid file
    patch -Np1 -i "$srcdir"/cups-2.4.0-statedir.patch; or return
    # https://github.com/OpenPrinting/cups/issues/53
    # use IP_FREEBIND, because cupsd cannot bind to not yet existing IP address
    patch -Np1 -i "$srcdir"/cups-freebind.patch; or return
    # FS#56818 - https://github.com/apple/cups/issues/5236
    patch -Np1 -i "$srcdir"/guid.patch; or return
    # Rebuild configure script
    aclocal -I config-scripts; or return
    autoconf -I config-scripts; or return
end

function build
    cd "$pkgbase-$pkgver"; or return
    # The build system uses only DSOFLAGS but not LDFLAGS to build some libraries.
    set -lx DSOFLAGS "$LDFLAGS"
    # use fixed cups user (id 209) since systemd adds "lp" group without a fixed id
    ./configure --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --sbindir=/usr/bin \
        --libdir=/usr/lib \
        --with-logdir=/var/log/cups \
        --with-docdir=/usr/share/cups/doc \
        --with-exe-file-perm=0755 \
        --with-cups-user=209 \
        --with-cups-group=209 \
        --with-max-log-size=0 \
        --enable-pam=yes \
        --enable-raw-printing \
        --enable-dbus=yes \
        --with-tls=gnutls \
        --with-dbusdir=/usr/share/dbus-1 \
        --enable-relro \
        --enable-libpaper \
        --with-optim="$CFLAGS"; or return
    make; or return
end

# don't run tests - they take ages

function package_libcups
    set pkgdesc 'OpenPrinting CUPS - client libraries and headers'
    # avahi only on i686 (from archlinux32)
    set depends gnutls glibc zlib sh (test $CARCH = i686; and echo avahi)
    cd $pkgbase-$pkgver; or return
    make BUILDROOT="$pkgdir" install-headers install-libs; or return
    # put this into the libs pkg to make other software find the libs(no pkg-config file included)
    mkdir -p "$pkgdir"/usr/bin; or return
    install -m755 "$srcdir/$pkgbase-$pkgver"/cups-config "$pkgdir"/usr/bin/cups-config; or return
    # add license + exception
    install -m644 -Dt "$pkgdir/usr/share/licenses/$pkgname" {LICENSE,NOTICE}; or return
end

function package_cups
    set pkgdesc 'OpenPrinting CUPS - daemon package'
    set install cups.install
    set backup etc/cups/cupsd.conf etc/cups/snmp.conf etc/cups/printers.conf etc/cups/classes.conf etc/cups/cups-files.conf etc/cups/subscriptions.conf etc/logrotate.d/cups etc/pam.d/cups
    set depends acl pam "libcups>=$pkgver" cups-filters dbus systemd systemd-libs libpaper hicolor-icon-theme glibc libstdc++ libgcc avahi gnutls
    set optdepends 'cups-browsed: to browse the network for remote CUPS queues and IPP network printers' 'libusb: for usb printer backend' 'ipp-usb: allows to send HTTP requests via a USB connection on devices without Ethernet or WiFi connections' 'xdg-utils: xdg .desktop file support' 'colord: for ICC color profile support' 'logrotate: for logfile rotation support'
    cd "$pkgbase-$pkgver"; or return
    make BUILDROOT="$pkgdir" install-data install-exec; or return
    # this one we ship in the libcups pkg
    rm -f "$pkgdir"/usr/bin/cups-config
    # kill the sysv stuff
    rm -rf "$pkgdir"/etc/rc*.d
    rm -rf "$pkgdir"/etc/init.d
    install -D -m644 ../cups.logrotate "$pkgdir"/etc/logrotate.d/cups; or return
    install -D -m644 ../cups.pam "$pkgdir"/etc/pam.d/cups; or return
    # fix perms on /var/spool and /etc
    chmod 755 "$pkgdir"/var/spool; or return
    chmod 755 "$pkgdir"/etc; or return
    # use cups group FS#36769
    install -Dm644 "$srcdir"/cups.sysusers "$pkgdir/usr/lib/sysusers.d/$pkgname.conf"; or return
    sed -i "s:#User 209:User 209:" "$pkgdir"/etc/cups/cups-files.conf{,.default}; or return
    sed -i "s:#Group 209:Group 209:" "$pkgdir"/etc/cups/cups-files.conf{,.default}; or return
    # install ssl directory where to store the certs, solves some samba issues
    install -dm700 -g 209 "$pkgdir"/etc/cups/ssl; or return
    # remove directory from package, it will be recreated at each server start
    rm -rf "$pkgdir"/run
    # install some more configuration files that will get filled by cupsd
    touch "$pkgdir"/etc/cups/printers.conf; or return
    touch "$pkgdir"/etc/cups/classes.conf; or return
    touch "$pkgdir"/etc/cups/subscriptions.conf; or return
    chgrp -R 209 "$pkgdir"/etc/cups; or return
    # fix .desktop file
    sed -i 's|^Exec=htmlview http://localhost:631/|Exec=xdg-open http://localhost:631/|g' "$pkgdir"/usr/share/applications/cups.desktop; or return
    # compress some driver files, adopted from Fedora
    find "$pkgdir"/usr/share/cups/model -name "*.ppd" | xargs gzip -n9f; or return
    # remove client.conf man page
    rm -f "$pkgdir"/usr/share/man/man5/client.conf.5
    # comment out removed filters that are now part of cups-filters
    sed -i -E 's:^(.*\s+bannertops\s*)$:#\1:' "$pkgdir"/usr/share/cups/mime/mime.convs; or return
    # comment out unnecessary PageLogFormat entry
    sed -i -e 's:PageLogFormat:#PageLogFormat:' "$pkgdir"/etc/cups/cupsd.conf*; or return
    # no more xinetd support
    rm -rf "$pkgdir"/etc/xinetd.d
    # add license + exception
    install -m644 -Dt "$pkgdir/usr/share/licenses/$pkgname" {LICENSE,NOTICE}; or return
end
