set pkgname ncdu
set pkgver 1.22
set pkgrel 1
set pkgdesc 'Disk usage analyzer with an ncurses interface'
set arch i686 x32
set url https://dev.yorhel.nl/ncdu
set nvchecker source=git git=https://code.blicky.net/yorhel/ncdu.git prefix=v
set license MIT
set depends ncurses glibc
set source "https://dev.yorhel.nl/download/ncdu-$pkgver.tar.gz"
set sha256sums 0ad6c096dc04d5120581104760c01b8f4e97d4191d6c9ef79654fa3c691a176b
set flags arch

function build
    cd "$pkgname-$pkgver"; or return
    ./configure --prefix=/usr; or return
    make; or return
end

function package
    cd "$pkgname-$pkgver"; or return
    make DESTDIR="$pkgdir" install; or return
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"; or return
end
