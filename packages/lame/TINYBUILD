set pkgname lame
set pkgver 4.0
set pkgrel 1
set pkgdesc 'A high quality MPEG Audio Layer III (MP3) encoder'
set arch i686 x32
set url http://lame.sourceforge.net/
set license LGPL-2.0-only
set depends glibc mpg123 ncurses
set makedepends nasm
set provides libmp3lame.so
set source "https://sourceforge.net/projects/lame/files/lame/$pkgver/lame-$pkgver.tar.gz" \
    lame-symbols.patch \
    lame-cbr-abr-quality-settings-clamp.patch
set b2sums 9e05275c28bc6d086011362f211edc2e2cd831429ca4d2daa1bc0ae7084ebd9bec3c3db93e1cab638570a9f624468372b9ff39f3dc9e7d0b105dbba7f248b2df \
    c8cc00f560515231dba1bf9393d056ecb11c2268bafae4923e8c2594b92de473b94e6e5cbef1e52b4843ddd36bb4e06ea6b24ac4a18aa682b2ab7c5ef6deb73c \
    217cf6611f13cb91997856c3af9c30b7c23fa3744126d27f71768001b6799a4a100c9c0baec34beb656fee1c8c519c86b1a9c549e2ea6befe197eb930f70caaa
set flags arch

function prepare
    cd lame-$pkgver; or return
    patch -Np1 -i ../lame-symbols.patch; or return
    patch -Np1 -i ../lame-cbr-abr-quality-settings-clamp.patch; or return
    autoreconf -fiv -I /usr/share/gettext/m4; or return
end

function build
    cd lame-$pkgver; or return
    set -a CFLAGS -Wno-implicit-function-declaration -Wno-incompatible-pointer-types
    ./configure \
        --prefix=/usr \
        --enable-nasm \
        --enable-mp3rtp \
        --enable-shared; or return
    make; or return
end

function check
    make test -C lame-$pkgver; or return
end

function package
    make DESTDIR="$pkgdir" install -C lame-$pkgver; or return
end
