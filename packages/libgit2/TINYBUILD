set pkgname libgit2
# NOTE: add the following packages to rebuild TODOs on soname change (although they do not link against libgit2.so):
# julia
set epoch 1
set pkgver 1.9.7
set pkgrel 1
set pkgdesc 'A linkable library for Git'
set arch i686 x32
set url https://github.com/libgit2/libgit2
set nvchecker source=git git=https://github.com/libgit2/libgit2 'include_regex=v\d+\.\d+\.\d+' prefix=v
set license LicenseRef-GPL-2.0-only-with-linking-exception
set depends libgcc glibc llhttp zlib
set makedepends cmake libssh2 openssl pcre2 python
set provides libgit2.so
set flags arch
set source "$url/archive/v$pkgver/$pkgname-v$pkgver.tar.gz"
set sha512sums 96924a4fd87669ad91d40669946cd249b646f3ce85380fc12b553b6c20338ff3c1df5faa6f168b2ca12ed20c8309116a05021f9710ee7ff61e5b8a249172b0ba
set b2sums 37b8a9ee8da6cb54df2d8b7209d813572cb5afaa6796cee80424f0fbe30c10bae0a4400c18bdda37aae109b473c2541e0be66899b58fbbc4674d275f23f6af68

function build
    set -l cmake_options \
        -B build \
        -D CMAKE_BUILD_TYPE=None \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D REGEX_BACKEND=pcre2 \
        -D USE_HTTP_PARSER=llhttp \
        -D USE_SSH=ON \
        -S $pkgname-$pkgver \
        -W no-dev
    cmake $cmake_options; or return
    cmake --build build --verbose; or return
end

function check
    set -l ignored_tests \
        'auth_clone|' \
        'invasive|' \
        'online|' \
        'network_url_parse__hostname_implied_root_empty_port|' \
        'network_url_parse__hostname_empty_port|' \
        'network_url_parse__ipv4_implied_root_empty_port|' \
        'network_url_parse__ipv4_empty_port|' \
        'network_url_parse__ipv6_implied_root_empty_port|' \
        'network_url_parse__ipv6_empty_port|' \
        'proxy|' \
        'proxy_auto_not_detected|' \
        ssh
    # NOTE: disable tests requiring the internet, relying on non-existent
    # resources, or those that are only compatible with the (modified) vendored
    # version of http-parser, but not with upstream http-parser
    ctest --test-dir build --output-on-failure -E (string join '' -- $ignored_tests); or return
end

function package
    set -a depends libssh2 libssh2.so openssl libcrypto.so libssl.so pcre2 libpcre2-8.so

    DESTDIR="$pkgdir" cmake --install build; or return
    install -vDm 644 $pkgname-$pkgver/{AUTHORS,README.md} -t "$pkgdir/usr/share/doc/$pkgname/"; or return
    install -vDm 644 $pkgname-$pkgver/COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
