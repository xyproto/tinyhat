pkgname=x32-binutils
pkgver=2.47
pkgrel=1
pkgdesc="Binutils for the x86_64-pc-linux-gnux32 toolchain"
arch=(i686)
url="https://www.gnu.org/software/binutils/"
license=(GPL-3.0-or-later)
depends=(zlib zstd)
options=(!buildflags !strip)
source=("https://ftp.gnu.org/gnu/binutils/binutils-$pkgver.tar.xz")
sha256sums=('154ab23b60070e8f27013c22977f1129425d67d1e8acd6e13010e617811e4cff')

build() {
  mkdir -p build
  cd build
  ../binutils-$pkgver/configure --target=x86_64-pc-linux-gnux32 --prefix=/usr --with-sysroot=/ \
    --disable-nls --disable-werror --disable-multilib --disable-sim --disable-gdb --disable-gprofng \
    --disable-shared --enable-plugins --enable-deterministic-archives --with-system-zlib
  make
}

package() {
  cd build
  make DESTDIR="$pkgdir" install
  rm -rf "$pkgdir"/usr/{share,include,lib}
}
