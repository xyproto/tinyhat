# Maintainer: Bruno Pagani <archange@archlinux.org>

pkgname=libxmlb
pkgver=0.3.29
pkgrel="1"
pkgdesc="Library to help create and query binary XML blobs"
arch=(i686 x32)
url="https://github.com/hughsie/libxmlb"
license=(LGPL-2.1-only)
depends=(glib2
         glibc
         libgcc
         libstemmer
         xz
         zstd)
makedepends=(git
             gobject-introspection
             gtk-doc
             meson)
checkdepends=(shared-mime-info)
source=(git+https://github.com/hughsie/libxmlb#tag=$pkgver?signed)
sha256sums=('5d40444befbcc3c938bed35413eb9a76c5446ee38887a76a2cf25b3ac935b684')
validpgpkeys=(163EB50119225DB3DF8F49EA17ACBA8DFA970E17) # Richard Hughes <richard@hughsie.com>

build() {
  arch-meson $pkgname build -D stemmer=true
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  rm -r "$pkgdir"/usr/{lib,share}/installed-tests/
}

makedepends=($(printf '%s\n' "${makedepends[@]}" | grep -v -x -E 'gobject-introspection|vala'))
eval "$(declare -f build | sed -E 's/ -D ?(introspection|vapi|gir|vala|vapigen)=[A-Za-z]+//g; s/arch-meson /arch-meson -D introspection=false /')"

unset -f pkgver
