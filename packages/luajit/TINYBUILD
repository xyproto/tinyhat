set pkgname luajit
# The commit that archlinux32's x87 patch applies to (2.1.1753364724, 2025-07-24): later commits conflict with it, and
# without it LuaJIT needs SSE2 on x86. Built without -msse as well, so that it runs on a Pentium II (tested in
# qemu-i386 -cpu pentium2); the JIT compiler is off on i686, LuaJIT runs as an interpreter
set pkgver 2.1.1753364724+871db2c
set pkgrel 1
set pkgdesc 'Just-in-time compiler and drop-in replacement for Lua 5.1'
set arch i686
set url https://luajit.org/
set license MIT
set depends glibc libgcc
# c7815e1a1b49871e645252bb12e722fb4879df11.patch is applied on i686 only (see prepare)
set source LuaJIT-871db2c.tar.gz::https://github.com/LuaJIT/LuaJIT/archive/871db2c84ecefd70a850e03a6c340214a81739f0.tar.gz \
    c7815e1a1b49871e645252bb12e722fb4879df11.patch
set sha256sums ab3f16d82df6946543565cfb0d2810d387d79a3a43e0431695b03466188e2680 \
    e59a3fa37e9fa7505193fde2a668eaa66caed39e77502868f12691cf0ee4e8a5
set flags arch
set -g _commit 871db2c

switch $CARCH
    case x32 x86_64 aarch64
        functions -e prepare
    case '*'
        function prepare
            cd "LuaJIT-$_commit"*/; or return
            patch -p1 -i "$srcdir/c7815e1a1b49871e645252bb12e722fb4879df11.patch"; or return
        end
end

function build
    cd "LuaJIT-$_commit"*/; or return
    set -l ccopt
    # No SSE in the C code on i686 (LuaJIT's Makefile has -msse -mfpmath=sse for x86)
    test $CARCH = i686; and set ccopt CCOPT_x86=-march=i686
    make amalg PREFIX=/usr BUILDMODE=dynamic TARGET_STRIP=" @:" $ccopt; or return
end

function package
    cd "LuaJIT-$_commit"*/; or return
    make install DESTDIR="$pkgdir" PREFIX=/usr; or return
    install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"; or return
end
