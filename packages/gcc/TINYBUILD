set pkgbase gcc
set pkgname gcc gcc-d gcc-fortran gcc-gcobol gcc-go gcc-libs gcc-m2 gcc-objc gcc-rust libasan libatomic libgcc libgccjit libgcobol libgfortran libgm2 libgo libgomp libgphobos libhwasan libitm liblsan libobjc libquadmath libstdc++ libtsan libubsan lto-dump
set pkgver 16.2.1+r23+gd564253eb6c8
set pkgrel 1
set pkgdesc 'The GNU Compiler Collection'
set arch i686
set url https://gcc.gnu.org
set license 'GPL-3.0-or-later WITH GCC-exception-3.1' GFDL-1.3-or-later
switch $CARCH
    case x32 x86_64 aarch64
        set -g makedepends binutils gcc-d git glibc libisl libmpc python zstd
    case '*'
        set -g makedepends binutils gcc-d git glibc libisl libmpc python zstd rust
end
set checkdepends dejagnu expect inetutils python-pytest tcl
set options '!emptydirs' '!lto'
set source 'git+https://forge.sourceware.org/gcc/gcc#commit=d564253eb6c859e266d3cae18e82fb4db9a88316' \
    c89 \
    c99 \
    gcc-ada-repro.patch \
    tune_branch_prediction_cost.patch
set sha256sums c4def1816bc86f2bb981deb958a572ca63eb0ef784418f0414f1071a4efee44d \
    7b09ec947f90b98315397af675369a1e3dfc527fa70013062e6e85c4be0275ab \
    44ea973558842f3f4bd666bdaf6e810fd7b7c7bd36b5cc4c69f93d2cd0124fc7 \
    1773f5137f08ac1f48f0f7297e324d5d868d55201c03068670ee4602babdef2f \
    838e14d4ef76079107a5373316598025915eaf747a10522ec9f8842125ca9a8e
set flags arch
set -g _commit d564253eb6c859e266d3cae18e82fb4db9a88316
set -g _libdir usr/lib/gcc//16

function prepare
    if test ! -d gcc
        ln -s gcc-$(string replace -- '+' '-' "$pkgver") gcc; or return
    end
    cd gcc; or return
    patch -Np0 < "$srcdir"/gcc-ada-repro.patch; or return
    patch -Np1 < ../tune_branch_prediction_cost.patch; or return
    mkdir -p "$srcdir"/gcc-build; or return
    mkdir -p "$srcdir"/libgccjit-build; or return
end

function build
    set -l _confflags --prefix=/usr --libdir=/usr/lib --libexecdir=/usr/lib --mandir=/usr/share/man --infodir=/usr/share/info --with-bugurl=https://bugs.archlinux32.org/ --with-build-config=bootstrap-lto --with-gcc-major-version-only --with-linker-hash-style=gnu --with-system-zlib --disable-cet --enable-checking=release --enable-clocale=gnu --enable-default-pie --enable-default-ssp --enable-gnu-indirect-function --enable-gnu-unique-object --enable-libstdcxx-backtrace --enable-link-serialization=1 --enable-linker-build-id --enable-lto --disable-multilib --build=$CHOST --enable-plugin --enable-shared --enable-threads=posix --disable-fixincludes --disable-libssp --disable-libstdcxx-pch --disable-werror
    cd gcc-build; or return
    set CFLAGS $(string replace -- '-Werror=format-security' '' "$CFLAGS")
    set CXXFLAGS $(string replace -- '-Werror=format-security' '' "$CXXFLAGS")
    ../gcc/configure --enable-languages=c,c++,d,fortran,go,lto,m2,objc,obj-c++,rust --enable-bootstrap $_confflags; or return
    make -O STAGE1_CFLAGS="-O2" BOOT_CFLAGS="$CFLAGS" BOOT_LDFLAGS="$LDFLAGS" LDFLAGS_FOR_TARGET="$LDFLAGS" bootstrap; or return
    cd "$srcdir"/libgccjit-build; or return
    ../gcc/configure --enable-languages=jit --disable-bootstrap --enable-host-shared $_confflags; or return
    make -O all-gcc; or return
    cp -a gcc/libgccjit.so* ../gcc-build/gcc/; or return
end

function _install_runtime_library_exception
    install -Dm644 "$srcdir"/gcc/COPYING.RUNTIME "$pkgdir"/usr/share/licenses/$pkgname/RUNTIME.LIBRARY.EXCEPTION; or return
end

function _pick
    set -l p "$argv[1]"
    set -l f
    set -l d
    set -e argv[1]
    for f in $argv
        set d "$srcdir/$p/$(string replace -r -- '^'(string escape --style=regex -- "$pkgdir")'/' '' "$f")"
        mkdir -vp "$(dirname "$d")"; or return
        mv -v "$f" "$d"; or return
        rmdir -vp --ignore-fail-on-non-empty "$(dirname "$f")"; or return
    end
end

function package_gcc
    set pkgdesc "The GNU Compiler Collection - C and C++ frontends"
    set depends "libasan=$pkgver" "libgcc=$pkgver" "libhwasan=$pkgver" "liblsan=$pkgver" "libstdc++=$pkgver" "libtsan=$pkgver" "libubsan=$pkgver" 'binutils>=2.28' 'glibc>=2.27' gmp libisl.so libmpc mpfr zlib zstd
    set optdepends 'gcc-libs: for generating code for 32-bit ABI'
    set provides
    set replaces
    set options !emptydirs staticlibs
    cd gcc-build; or return
    make DESTDIR="$pkgdir" install; or return
    make -C gcc DESTDIR="$pkgdir" jit.install-common jit.install-info; or return
    begin
        set -l __subshell_pwd $PWD
    cd "$pkgdir"; or return
        for _so in libatomic.so libstdc++.so libgdruntime.so libgphobos.so
            ln -srv usr/lib/$_so $_libdir/$_so; or return
        end
        _pick gcc-d usr/bin/{gdc,$CHOST-gdc}; or return
        _pick gcc-d $_libdir/d21; or return
        _pick gcc-d $_libdir/include/d/; or return
        _pick gcc-d $_libdir/libg{druntime,phobos}.so; or return
        _pick gcc-d usr/lib/libg{druntime,phobos}.a; or return
        _pick gcc-d usr/lib/libgphobos.spec; or return
        _pick gcc-d usr/share/info/gdc.info; or return
        _pick gcc-d usr/share/man/man1/gdc.1; or return
        _pick gcc-fortran usr/bin/{gfortran,$CHOST-gfortran}; or return
        _pick gcc-fortran $_libdir/finclude/; or return
        _pick gcc-fortran $_libdir/libcaf_{shmem,single}.a; or return
        _pick gcc-fortran $_libdir/f951; or return
        _pick gcc-fortran $_libdir/include/ISO_Fortran_binding.h; or return
        _pick gcc-fortran usr/lib/libgfortran.spec; or return
        _pick gcc-fortran usr/share/info/gfortran.info; or return
        _pick gcc-fortran usr/share/man/man1/gfortran.1; or return
        _pick gcc-go usr/bin/{gccgo,go,gofmt,$CHOST-gccgo}; or return
        _pick gcc-go $_libdir/{buildid,cgo,go1,test2json,vet}; or return
        _pick gcc-go usr/lib/go/; or return
        _pick gcc-go usr/lib/lib{go,gobegin,golibbegin}.a; or return
        _pick gcc-go usr/share/info/gccgo.info; or return
        _pick gcc-go usr/share/man/man1/{gccgo,go,gofmt}.1; or return
        _pick gcc-m2 usr/bin/{gm2,$CHOST-gm2}; or return
        _pick gcc-m2 $_libdir/cc1gm2; or return
        _pick gcc-m2 usr/share/info/m2.info; or return
        _pick gcc-m2 usr/share/man/man1/gm2.1; or return
        _pick gcc-objc $_libdir/include/objc/; or return
        _pick gcc-objc $_libdir/cc1obj*; or return
        _pick gcc-rust usr/bin/{gccrs,$CHOST-gccrs}; or return
        _pick gcc-rust $_libdir/crab1; or return
        _pick libasan usr/lib/libasan.{a,so*}; or return
        _pick libatomic usr/lib/libatomic.so*; or return
        _pick libatomic $_libdir/libatomic.so; or return
        _pick libgcc usr/lib/libgcc_s.so.*; or return
        _pick libgccjit usr/include/libgccjit*; or return
        _pick libgccjit usr/lib/libgccjit.so*; or return
        _pick libgccjit usr/share/info/libgccjit.info; or return
        _pick libgfortran usr/lib/libgfortran.{a,so*}; or return
        _pick libgm2 $_libdir/m2/; or return
        _pick libgm2 usr/lib/libm2{cor,iso,log,min,pim}.{a,so*}; or return
        _pick libgo usr/lib/libgo.so*; or return
        _pick libgomp usr/lib/libgomp.{a,so*}; or return
        _pick libgomp usr/share/info/libgomp.info; or return
        _pick libgphobos usr/lib/libgdruntime.so*; or return
        _pick libgphobos usr/lib/libgphobos.so*; or return
        _pick libitm usr/lib/libitm.{a,so*}; or return
        _pick libitm usr/share/info/libitm.info; or return
        _pick libobjc usr/lib/libobjc.{a,so*}; or return
        _pick libquadmath usr/lib/libquadmath.{a,so*}; or return
        _pick libquadmath usr/share/info/libquadmath.info; or return
        _pick libstdc++ usr/lib/libstdc++.so*; or return
        _pick libstdc++ usr/share/locale/{de,fr}/LC_MESSAGES/libstdc++.mo; or return
        _pick libubsan usr/lib/libubsan.{a,so*}; or return
        _pick lto-dump usr/bin/lto-dump; or return
        _pick lto-dump usr/share/man/man1/lto-dump.1; or return
        mv -v usr/lib/libgcc_s{,_asneeded}.so $_libdir/; or return
        mv -v usr/lib/libatomic{,_asneeded}.a usr/lib/libatomic_asneeded.so $_libdir/; or return
        mv -v usr/lib/*_preinit.o $_libdir/; or return
        mv -v usr/lib/*.spec $_libdir/; or return
        mv -v usr/lib/libstdc++{,exp,fs}.a $_libdir/; or return
        mv -v usr/lib/libsupc++.a $_libdir/; or return
        cd $__subshell_pwd
    end
    install -d "$pkgdir"/usr/share/gdb/auto-load/usr/lib; or return
    mv ../libstdc++/usr/lib/libstdc++.so.6.*-gdb.py "$pkgdir"/usr/share/gdb/auto-load/usr/lib/; or return
    install -dm755 "$pkgdir"/usr/lib/bfd-plugins/; or return
    ln -s /$_libdir/liblto_plugin.so "$pkgdir"/usr/lib/bfd-plugins/; or return
    ln -s gcc "$pkgdir"/usr/bin/cc; or return
    for binary in {c++,g++,gcc,gcc-ar,gcc-nm,gcc-ranlib}
        ln -s /usr/bin/"$binary" "$pkgdir"/usr/bin/$CARCH-linux-gnu-"$binary"; or return
    end
    install -Dm755 "$srcdir"/c89 "$pkgdir"/usr/bin/c89; or return
    install -Dm755 "$srcdir"/c99 "$pkgdir"/usr/bin/c99; or return
    python -m compileall "$pkgdir"/usr/share/gcc-$(string replace -r -- '(.*?)\..*$' '$1' "$pkgver")/; or return
    python -O -m compileall "$pkgdir"/usr/share/gcc-$(string replace -r -- '(.*?)\..*$' '$1' "$pkgver")/; or return
    _install_runtime_library_exception; or return
end

function package_gcc-d
    set pkgdesc "D frontend for GCC"
    set depends "gcc=$pkgver" 'glibc>=2.27' gmp libgphobos libisl.so libmpc mpfr zlib zstd
    set provides gdc
    set replaces gdc
    set options !emptydirs staticlibs
    mv -v $pkgname/* "$pkgdir"; or return
    mkdir -pv "$pkgdir"/$_libdir/32; or return
    mv -v "$pkgdir"/usr/lib/libg{druntime,phobos}.a "$pkgdir"/$_libdir/; or return
    mv -v "$pkgdir"/usr/lib/libgphobos.spec "$pkgdir"/$_libdir/; or return
    _install_runtime_library_exception; or return
end

