set pkgbase gcc
# C and C++ only: no Fortran, D, Go, Modula-2, Objective-C, Rust, COBOL or libgccjit, which nothing in Tiny Hat uses
set pkgname gcc gcc-libs libasan libatomic libgcc libgomp libhwasan libitm liblsan libquadmath libstdc++ libtsan libubsan lto-dump
set pkgver 16.2.1+r23+gd564253eb6c8
set pkgrel 3
set pkgdesc 'The GNU Compiler Collection'
set arch i686
set url https://gcc.gnu.org
set nvchecker source=git git=https://sourceware.org/git/gcc.git prefix=releases/gcc- 'include_regex=^releases/gcc-[.0-9]+$'
set license 'GPL-3.0-or-later WITH GCC-exception-3.1' GFDL-1.3-or-later
set makedepends binutils git glibc libisl libmpc python zstd
set checkdepends dejagnu expect inetutils python-pytest tcl
set options '!emptydirs' '!lto'
set source 'git+https://forge.sourceware.org/gcc/gcc#commit=d564253eb6c859e266d3cae18e82fb4db9a88316' \
    c89 \
    c99 \
    gcc-ada-repro.patch \
    tune_branch_prediction_cost.patch
set sha256sums c4def1816bc86f2bb981deb958a572ca63eb0ef784418f0414f1071a4efee44d \
    7b09ec947f90b98315397af675369a1e3dfc527fa70013062e6e85c4be0275ab \
    44ea973558842f3f4bd666bdaf6e810fd7b7c7bd36b5cc4c69f93d2cd0124fc7 \
    1773f5137f08ac1f48f0f7297e324d5d868d55201c03068670ee4602babdef2f \
    838e14d4ef76079107a5373316598025915eaf747a10522ec9f8842125ca9a8e
set flags arch
set -g _commit d564253eb6c859e266d3cae18e82fb4db9a88316

function prepare
    # gcc's private directory (usr/lib/gcc/TRIPLET/MAJOR), used by the package functions; CHOST is set only now
    set -g _libdir usr/lib/gcc/$CHOST/(string split -f1 . -- $pkgver)
    if test ! -d gcc
        ln -s gcc-$(string replace -- '+' '-' "$pkgver") gcc; or return
    end
    cd gcc; or return
    patch -Np0 <"$srcdir"/gcc-ada-repro.patch; or return
    patch -Np1 <../tune_branch_prediction_cost.patch; or return
    sed -i '/m64=/s/lib64/lib/' gcc/config/i386/t-linux64; or return
    mkdir -p "$srcdir"/gcc-build; or return
end

function build
    # Without libcc1 (gdb's "compile" command), which nothing in Tiny Hat uses
    set -l _confflags --prefix=/usr --libdir=/usr/lib --libexecdir=/usr/lib --mandir=/usr/share/man --infodir=/usr/share/info --with-bugurl=https://bugs.archlinux32.org/ --with-gcc-major-version-only --with-linker-hash-style=gnu --with-system-zlib --disable-cet --enable-checking=release --enable-clocale=gnu --enable-default-pie --enable-default-ssp --enable-gnu-indirect-function --enable-gnu-unique-object --enable-libstdcxx-backtrace --enable-link-serialization=1 --enable-linker-build-id --enable-lto --disable-multilib --enable-plugin --enable-shared --enable-threads=posix --disable-fixincludes --disable-libssp --disable-libstdcxx-pch --disable-werror --disable-libcc1
    cd gcc-build; or return
    set CFLAGS $(string replace -- '-Werror=format-security' '' "$CFLAGS")
    set CXXFLAGS $(string replace -- '-Werror=format-security' '' "$CXXFLAGS")
    if set -q TINYHAT_CROSS[1]
        # A cross build (scripts/buildpackage.sh --cross, on x86_64): a cross-native gcc, built on x86_64 for i686 by
        # the i686 cross toolchain, which also builds the target libraries. The cross toolchain's linker and its LTO
        # plugin are x86_64 programs, so they fit together, and the installed gcc uses the i686 ones. Without a
        # bootstrap: the compiler is built once, by gcc of the same version. The programs that run during the build
        # (build-x86_64-pc-linux-gnu) are x86_64 ones: the i686 flags are taken out of the environment, so that only
        # gcc itself (host) and its libraries (target) get them, explicitly
        # The target libraries are built by the cross compiler, with -nostdinc++ for C++: the libstdc++ being built must
        # not find the cross toolchain's own libstdc++ headers (its <fenv.h> wrapper would then never reach glibc's)
        set -l t $TINYHAT_CROSS
        # As gcc's own build does it: the new libstdc++'s headers instead of the cross toolchain's
        set -l lib "$srcdir"/gcc-build/$CHOST/libstdc++-v3
        set -l _stdinc -nostdinc++ -I$lib/include/$CHOST -I$lib/include -I"$srcdir"/gcc/libstdc++-v3/libsupc++
        # gcc also hands the host's CXXFLAGS to some of the x86_64 build-machine programs, so leave out -march and -mtune:
        # the i686 cross compiler has them as its defaults (--with-arch=i686 --with-tune=generic), and the other flags
        # suit both machines
        set -l host_cflags (string replace -ra -- ' ?-m(arch|tune)=[^ ]*' '' "$CFLAGS")
        set -l host_cxxflags (string replace -ra -- ' ?-m(arch|tune)=[^ ]*' '' "$CXXFLAGS")
        set -l host_ldflags $LDFLAGS
        set -e CFLAGS CXXFLAGS LDFLAGS CPPFLAGS
        env CFLAGS="$host_cflags" CXXFLAGS="$host_cxxflags" LDFLAGS="$host_ldflags" \
            CFLAGS_FOR_TARGET="$host_cflags" CXXFLAGS_FOR_TARGET="$host_cxxflags" \
            CC=$t-gcc CXX=$t-g++ AR=$t-ar AS=$t-as LD=$t-ld NM=$t-nm RANLIB=$t-ranlib STRIP=$t-strip \
            OBJCOPY=$t-objcopy OBJDUMP=$t-objdump READELF=$t-readelf \
            CC_FOR_TARGET=$t-gcc CXX_FOR_TARGET="$t-g++ $_stdinc" AR_FOR_TARGET=$t-ar \
            AS_FOR_TARGET=$t-as LD_FOR_TARGET=$t-ld NM_FOR_TARGET=$t-nm RANLIB_FOR_TARGET=$t-ranlib \
            STRIP_FOR_TARGET=$t-strip OBJCOPY_FOR_TARGET=$t-objcopy OBJDUMP_FOR_TARGET=$t-objdump \
            READELF_FOR_TARGET=$t-readelf CC_FOR_BUILD=/usr/bin/gcc CXX_FOR_BUILD=/usr/bin/g++ \
            CFLAGS_FOR_BUILD="-O2 -pipe" CXXFLAGS_FOR_BUILD="-O2 -pipe" LDFLAGS_FOR_BUILD= CPPFLAGS_FOR_BUILD= \
            ../gcc/configure --enable-languages=c,c++,lto --disable-bootstrap \
            --build=x86_64-pc-linux-gnu --host=$CHOST --target=$CHOST $_confflags; or return
        make -O LDFLAGS_FOR_TARGET="$host_ldflags"; or return
    else
        ../gcc/configure --enable-languages=c,c++,lto --enable-bootstrap --with-build-config=bootstrap-lto \
            --build=$CHOST $_confflags; or return
        make -O STAGE1_CFLAGS="-O2" BOOT_CFLAGS="$CFLAGS" BOOT_LDFLAGS="$LDFLAGS" LDFLAGS_FOR_TARGET="$LDFLAGS" bootstrap; or return
    end
end

function _install_runtime_library_exception
    install -Dm644 "$srcdir"/gcc/COPYING.RUNTIME "$pkgdir"/usr/share/licenses/$pkgname/RUNTIME.LIBRARY.EXCEPTION; or return
end

function _pick
    set -l p "$argv[1]"
    set -l f
    set -l d
    set -e argv[1]
    for f in $argv
        # info manuals are not built from the git sources without makeinfo
        test -e "$f" -o -L "$f"; or continue
        set d "$srcdir/$p/$(string replace -r -- '^'(string escape --style=regex -- "$pkgdir")'/' '' "$f")"
        mkdir -vp "$(dirname "$d")"; or return
        mv -v "$f" "$d"; or return
        rmdir -vp --ignore-fail-on-non-empty "$(dirname "$f")"; or return
    end
end

function package_gcc
    set pkgdesc "The GNU Compiler Collection - C and C++ frontends"
    set depends "libasan=$pkgver" "libgcc=$pkgver" "libhwasan=$pkgver" "liblsan=$pkgver" "libstdc++=$pkgver" "libtsan=$pkgver" "libubsan=$pkgver" 'binutils>=2.28' 'glibc>=2.27' gmp libisl.so libmpc mpfr zlib zstd
    set optdepends 'gcc-libs: for generating code for 32-bit ABI'
    set provides
    set replaces
    set options !emptydirs staticlibs
    cd gcc-build; or return
    make DESTDIR="$pkgdir" install; or return
    if set -q TINYHAT_CROSS[1]
        # The cross build cannot see glibc's limits.h where gcc looks for it (build != host), so its own limits.h does
        # not include glibc's (MB_LEN_MAX and the rest would be wrong): the limits.h that gcc makes when it does
        cat ../gcc/gcc/{limitx.h,glimits.h,limity.h} >"$pkgdir/$_libdir/include/limits.h"; or return
    end
    begin
        set -l __subshell_pwd $PWD
        cd "$pkgdir"; or return
        for _so in libatomic.so libstdc++.so
            ln -srv usr/lib/$_so $_libdir/$_so; or return
        end
        _pick libasan usr/lib/libasan.{a,so*}; or return
        _pick libatomic usr/lib/libatomic.so*; or return
        _pick libatomic $_libdir/libatomic.so; or return
        _pick libgcc usr/lib/libgcc_s.so.*; or return
        _pick libgomp usr/lib/libgomp.{a,so*}; or return
        _pick libgomp usr/share/info/libgomp.info; or return
        _pick libitm usr/lib/libitm.{a,so*}; or return
        _pick libitm usr/share/info/libitm.info; or return
        _pick libquadmath usr/lib/libquadmath.{a,so*}; or return
        _pick libquadmath usr/share/info/libquadmath.info; or return
        _pick libstdc++ usr/lib/libstdc++.so*; or return
        _pick libstdc++ usr/share/locale/{de,fr}/LC_MESSAGES/libstdc++.mo; or return
        _pick libubsan usr/lib/libubsan.{a,so*}; or return
        _pick lto-dump usr/bin/lto-dump; or return
        _pick lto-dump usr/share/man/man1/lto-dump.1; or return
        mv -v usr/lib/libgcc_s{,_asneeded}.so $_libdir/; or return
        mv -v usr/lib/libatomic{,_asneeded}.a usr/lib/libatomic_asneeded.so $_libdir/; or return
        mv -v usr/lib/*_preinit.o $_libdir/; or return
        mv -v usr/lib/*.spec $_libdir/; or return
        mv -v usr/lib/libstdc++{,exp,fs}.a $_libdir/; or return
        mv -v usr/lib/libsupc++.a $_libdir/; or return
        cd $__subshell_pwd
    end
    install -d "$pkgdir"/usr/share/gdb/auto-load/usr/lib; or return
    mv ../libstdc++/usr/lib/libstdc++.so.6.*-gdb.py "$pkgdir"/usr/share/gdb/auto-load/usr/lib/; or return
    install -dm755 "$pkgdir"/usr/lib/bfd-plugins/; or return
    ln -s /$_libdir/liblto_plugin.so "$pkgdir"/usr/lib/bfd-plugins/; or return
    ln -s gcc "$pkgdir"/usr/bin/cc; or return
    for binary in {c++,g++,gcc,gcc-ar,gcc-nm,gcc-ranlib}
        ln -s /usr/bin/"$binary" "$pkgdir"/usr/bin/$CARCH-linux-gnu-"$binary"; or return
    end
    install -Dm755 "$srcdir"/c89 "$pkgdir"/usr/bin/c89; or return
    install -Dm755 "$srcdir"/c99 "$pkgdir"/usr/bin/c99; or return
    python -m compileall -s "$pkgdir" -p / "$pkgdir"/usr/share/gcc-$(string replace -r -- '(.*?)\..*$' '$1' "$pkgver")/; or return
    python -O -m compileall -s "$pkgdir" -p / "$pkgdir"/usr/share/gcc-$(string replace -r -- '(.*?)\..*$' '$1' "$pkgver")/; or return
    _install_runtime_library_exception; or return
end

function package_gcc-libs
    set pkgdesc 'Runtime libraries shipped by GCC'
    set depends 'glibc>=2.27' libasan libatomic libgcc libgomp libhwasan liblsan libquadmath libstdc++ libtsan libubsan
    set provides
end

function package_libasan
    set pkgdesc 'Address Sanitizer runtime library shipped by GCC'
    set depends 'glibc>=2.27' libgcc libstdc++
    set provides libasan.so
    mv -v $pkgname/* "$pkgdir"; or return
    _install_runtime_library_exception; or return
end

