function package_libquadmath
    set pkgdesc 'GCC __float128 library'
    set depends 'glibc>=2.27' libgcc
    if count $pkgname/* >/dev/null
        set provides libquadmath.so
        mv -v $pkgname/* "$pkgdir"; or return
        _install_runtime_library_exception; or return
    else
        touch "$pkgdir/this-is-a-dummy-package"; or return
    end
end

