set pkgname libconfig
set pkgver 1.8.2
set pkgrel 2
set pkgdesc 'C/C++ Configuration File Library'
set arch i686 x32
set url https://github.com/hyperrealm/libconfig
set nvchecker source=git git=https://github.com/hyperrealm/libconfig.git prefix=v
set license LGPL-2.1-only
set depends libgcc libstdc++ glibc
# No documentation (texinfo), so no makedepends
set provides libconfig++.so libconfig.so
set source "$url/archive/v$pkgver/$pkgname-v$pkgver.tar.gz"
set sha512sums c3ed6c8f500b449c4d94976745a3acba1c7176f87497d5cb0deb05e62f2ff009ca0636c7c9848601f6d92dd113d82983cbd1132735f0f2d4e40b32d257f4aaa7
set b2sums c19561fcc0ae376567ba024e4da874fb6cfe27d509aa6ed84000867c8e849bceb9ac0a883446b445de29d852b4d1b6d1a9ad526c129645903105bc7d82bd35c9
set flags arch

function prepare
    cd $pkgname-$pkgver; or return
    autoreconf -fiv; or return
end

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr --disable-doc; or return
    # prevent excessive overlinking due to libtool
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make; or return
end

function package
    make DESTDIR="$pkgdir" install -C $pkgname-$pkgver; or return
    install -vDm 644 $pkgname-$pkgver/{AUTHORS,ChangeLog,NEWS,README,TODO} -t "$pkgdir/usr/share/doc/$pkgname/"; or return
end
