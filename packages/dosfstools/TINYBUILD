set pkgname dosfstools
set pkgver 4.2
set pkgrel 5
set pkgdesc 'DOS filesystem utilities'
set arch i686 x32
set url https://github.com/dosfstools/dosfstools
set license GPL-3.0-or-later
set depends glibc
set source "https://github.com/dosfstools/dosfstools/releases/download/v$pkgver/dosfstools-$pkgver.tar.gz" \
    "https://github.com/dosfstools/dosfstools/releases/download/v$pkgver/dosfstools-$pkgver.tar.gz.sig" \
    dosfstools-reproducible-mkfs.patch::https://github.com/dosfstools/dosfstools/commit/8da7bc93315cb0c32ad868f17808468b81fa76ec.patch
set sha256sums 64926eebf90092dca21b14259a5301b7b98e7b1943e8a201c7d726084809b527 \
    90f58a303fd7c55e02370357054f7207f05c3736f23d9a82cfb4a10acd7d55f9 \
    b9953dde3d755a6e9a31a28e2a7aebccd0b5ed9bcc664893bd55290945589b5b
set flags arch

function prepare
    cd $pkgname-$pkgver; or return
    patch -Np1 -i $srcdir/$pkgname-reproducible-mkfs.patch; or return
end

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr --libexecdir=/usr/lib --sbindir=/usr/bin --mandir=/usr/share/man --docdir=/usr/share/doc/dosfstools --enable-compat-symlinks; or return
    make; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
end
