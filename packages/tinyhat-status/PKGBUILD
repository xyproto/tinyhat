pkgname=tinyhat-status
pkgver=1
pkgrel=1
pkgdesc="Tiny Hat status bar text for dwl"
arch=(i686 x32)
url="https://github.com/xyproto/tinyhat"
license=(BSD-3-Clause)
depends=(glibc)
source=(tinyhat-status.c)
sha256sums=(SKIP)

build() {
  cc -std=c23 $CFLAGS -o tinyhat-status tinyhat-status.c $LDFLAGS
}

package() {
  install -Dm755 tinyhat-status "$pkgdir/usr/bin/tinyhat-status"
}
