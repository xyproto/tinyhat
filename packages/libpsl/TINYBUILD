set pkgname libpsl
set pkgver 0.21.5
set pkgrel 2
set pkgdesc 'Public Suffix List library'
set url https://github.com/rockdaboot/libpsl
set nvchecker source=git git=https://github.com/rockdaboot/libpsl.git
set arch i686 x32
set license MIT
set depends libidn2 libunistring
# No API documentation (gtk-doc), so no libpsl.3 man page either (it is generated from the gtk-doc XML)
set makedepends publicsuffix-list python
set provides libpsl.so
set flags arch
set source https://github.com/rockdaboot/libpsl/releases/download/$pkgver/$pkgname-$pkgver.tar.gz
set sha512sums c14d575cecc0f1693894dd79565b6b9220084ddfa43b908a1cefe16d147cdd5ec47796eb0c2135e2f829a951abaf39d8a371ab5c1352f57b36e610e25adf91f5
set b2sums a0076f622b85df99f866de6707850ac216b764bdb68c6d516f4603da42dac8eae3ee4c53d68dbb6af6f779c2c7f1b9caab74c8b558209b1f6823f95c13fc3ceb

function prepare
    cd $pkgname-$pkgver; or return
    rm -frv list; or return
    autoreconf -fiv; or return
end

function build
    cd $pkgname-$pkgver; or return
    ./configure \
        --prefix=/usr \
        --disable-static \
        --disable-dependency-tracking \
        --disable-man \
        --disable-gtk-doc \
        --enable-{builtin,runtime}=libidn2 \
        --with-psl-file=/usr/share/publicsuffix/effective_tld_names.dat \
        --with-psl-testfile=/usr/share/publicsuffix/test_psl.txt; or return
    LC_CTYPE=en_US.UTF-8 make; or return
end

function check
    cd $pkgname-$pkgver; or return
    make check; or return
end

function package
    set -a depends libidn2.so libunistring.so

    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    install -Dm 644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
