    9fc416a8ac86edaae58bc55513c4425e7887da20c7d5fdb6f7cfd527d4da13f5 \
    d1fe9084ce2526619f94b8a07b89fb0194e874beef9f202f8b974879d77f2e1a \
    8610959df6c01568ff478ca1eb4aac301f3ba1f5bd4739daaec072865e8be2d7 \
    5b017ba5eae77caa09fa5af6ecfa0df1e7e22776b2b13c8744c6cb7ecd7ad0e9 \
    cf3c3da9300d6ea70eab5b8dca724ce03a3651bd63fb0168594dcfeb35eec11c \
    7facb5c2abc71c9bfe01bf4db388306ed7b7abf6654009af336262839527f962 \
    755cd7062fe8495f6f62053ce664451c12ae65dba9fb5c75062a495fbe040fb1 \
    9a76f6f75a42485bc337163ba38068b09f7889bdc1a4e191408898f10de36662 \
    7e41e17e8cbc7287d6c3c9eb0a7b682cd8d3252030856b338050c21dff9bf05a \
    d7410d0ff89a15e2a100faf1546d730e043dde15c295974564144e00a93f03a3 \
    e16e051d17ead7e6457a479a1e2226160ca9aae3d607c0c25fa3677522aa9280 \
    7f2ce9e16ddcca1a55b32bddfd39c7f190eed9d8df4319bbd6b07e0a2607e662
set flags arch

set -g _targets bios

function prepare
    cd syslinux; or return

    git revert -n 458a54133ecdf1685c02294d812cb562fe7bf4c3; or return

    patch -p1 <../0002-gfxboot-menu-label.patch; or return
    patch -p1 <../0017-single-load-segment.patch; or return
    patch -p1 <../0016-strip-gnu-property.patch; or return
    patch -p1 <../0018-prevent-pow-optimization.patch; or return

    # TODO: use 'gnu-efi-libs' package instead of embedded sources
    # patch -p1 < ../0004-gnu-efi-from-arch.patch
    # patch -p1 < ../0005-gnu-efi-version-compatibility.patch

    patch -p1 <../0025-reproducible-build.patch; or return

    patch -p1 <../0005-Workaround-multiple-definition-of-symbol-errors.patch; or return
    patch -p1 <../0006-Replace-builtin-strlen-that-appears-to-get-optimized.patch; or return

    patch -p1 <../0026-add-missing-include.patch; or return
    patch -p1 <../0027-use-correct-type-for-size.patch; or return

    # do not swallow efi compilation output to make debugging easier
    sed 's|> /dev/null 2>&1||' -i efi/check-gnu-efi.sh; or return

    # disable debug and development flags to reduce bootloader size
    truncate --size 0 mk/devel.mk; or return
end

function build
    cd syslinux; or return
    set -lx LDFLAGS $LDFLAGS --no-dynamic-linker # workaround for binutils 2.28 http://www.syslinux.org/wiki/index.php?title=Building
    set -lx EXTRA_CFLAGS -fno-PIE # to fix gpxe build
    make PYTHON=python $_targets; or return
end

function package
    cd syslinux; or return
    make $_targets install INSTALLROOT="$pkgdir" SBINDIR=/usr/bin MANDIR=/usr/share/man AUXDIR=/usr/lib/syslinux; or return

    rm -r "$pkgdir"/usr/lib/syslinux/{com32,dosutil,syslinux.com}; or return
    install -D -m644 COPYING "$pkgdir"/usr/share/licenses/syslinux/COPYING; or return
    install -d "$pkgdir"/usr/share/doc; or return
    cp -ar doc "$pkgdir"/usr/share/doc/syslinux; or return

    install -d "$pkgdir"/usr/lib/syslinux/bios; or return
    mv "$pkgdir"/usr/lib/syslinux/{*.bin,*.c32,*.0,memdisk} "$pkgdir"/usr/lib/syslinux/bios; or return

    install -D -m0644 ../syslinux.cfg "$pkgdir"/usr/share/syslinux/syslinux.cfg; or return
    install -D -m0644 ../syslinux.hook "$pkgdir"/usr/share/libalpm/hooks/90-syslinux.hook; or return
    install -D -m0755 ../syslinux-install_update "$pkgdir"/usr/bin/syslinux-install_update; or return
end
