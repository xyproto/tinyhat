set pkgname syslinux
set pkgver 6.04.pre3.r3.g05ac953c
#set -g _tag syslinux-$pkgver
set -g _commit 05ac953c23f90b2328d393f7eecde96e41aed067
set pkgrel 5
set pkgdesc 'Collection of boot loaders that boot from FAT, ext2/3/4 and btrfs filesystems, from CDs and via PXE'
set url https://www.syslinux.org/
set arch i686 x32
set install syslinux.install
set license GPL-2.0-or-later
# syslinux build system is a mess of submakes that does not work with -jN
# efi32/com32 do not like Arch cflags/ldflags, though it would be nice to have the flags for userspace tools
set options '!makeflags' '!buildflags'
# Only the BIOS boot loaders: Tiny Hat uses memdisk (FreeDOS) from them, and boots with GRUB. No upx (it only
# compresses the DOS tools, and the build goes on without it) and no asciidoc (the man pages are prebuilt)
set makedepends git python nasm
# uuid/uuid.h (extlinux reads XFS superblocks)
set makedepends_host util-linux-libs
set optdepends 'perl-crypt-passwdmd5: For md5pass' \
    'perl-digest-sha1: For sha1pass' \
    'mtools: For mkdiskimage and syslinux support' \
    'gptfdisk: For GPT support' \
    'util-linux: For isohybrid' \
    'efibootmgr: For EFI support' \
    'dosfstools: For EFI support'

# The syslinux-install_update script is maintained at https://gist.github.com/pyther/772138
# Script not yet updated for syslinux-efi
set source "git+https://repo.or.cz/syslinux.git#commit=$_commit" \
    syslinux.cfg \
    syslinux.hook \
    syslinux-install_update \
    0002-gfxboot-menu-label.patch \
    0005-gnu-efi-version-compatibility.patch \
    0017-single-load-segment.patch \
    0004-gnu-efi-from-arch.patch \
    0016-strip-gnu-property.patch \
    0018-prevent-pow-optimization.patch \
    0025-reproducible-build.patch \
    0005-Workaround-multiple-definition-of-symbol-errors.patch \
    0006-Replace-builtin-strlen-that-appears-to-get-optimized.patch \
    0026-add-missing-include.patch \
    0027-use-correct-type-for-size.patch
set sha256sums deec61086a2cb73163d50e150d1ef32bd56c8a3faa1fc4322d11080ba0cbe63a \
    b9692be0cce43811c1b04053072ac50dd7b39bbc2ba7bcbe0e4387668af8df08 \
