set pkgname nettle
set pkgver 4.0
set pkgrel 1
set pkgdesc 'A low-level cryptographic library'
set arch i686 x32
set url 'https://www.lysator.liu.se/~nisse/nettle'
set license 'LGPL-3.0-or-later OR GPL-2.0-or-later'
set depends glibc gmp
set checkdepends valgrind
set provides libnettle.so libhogweed.so
set source "https://ftp.gnu.org/gnu/nettle/nettle-$pkgver.tar.gz"
set sha256sums 3addbc00da01846b232fb3bc453538ea5468da43033f21bb345cb1e9073f5094
set flags arch

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr --disable-static; or return
    make; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir/" install; or return
end
