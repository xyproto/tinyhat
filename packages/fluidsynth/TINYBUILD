set pkgname fluidsynth
set pkgver 2.6.2
set pkgrel 1
set -g _gcem 012ae73c6d0a2cb09ffe86475f5c6fba3926e200
set pkgdesc 'SoundFont synthesizer with PipeWire output'
set arch i686 x32
set url https://www.fluidsynth.org/
set license LGPL-2.1-or-later Apache-2.0
set depends alsa-lib glib2 libsndfile pipewire
set makedepends cmake ninja
set provides libfluidsynth.so
set source "fluidsynth-$pkgver.tar.gz::https://github.com/FluidSynth/fluidsynth/archive/refs/tags/v$pkgver.tar.gz" \
    "gcem-$_gcem.zip::https://github.com/kthohr/gcem/archive/$_gcem.zip"
set sha256sums ca376b42a3c1b186a4c8c248931789a455ac94a89b777394969d678010c2f91f \
    28159274c54e9640354852e172d10d88eb159f4e7f2fea42edbcd20105ed3526

function prepare
    rm -rf fluidsynth-$pkgver/gcem; or return
    cp -a gcem-$_gcem fluidsynth-$pkgver/gcem; or return
end

function build
    cmake -S fluidsynth-$pkgver -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DLIB_SUFFIX= \
        -Denable-sdl3=OFF -Denable-pulseaudio=OFF -Denable-pipewire=ON -Denable-jack=OFF -Denable-portaudio=OFF \
        -Denable-dbus=OFF -Denable-ladspa=OFF -Denable-network=OFF -Denable-readline=OFF -Denable-oss=OFF \
        -Denable-systemd=OFF -Denable-openmp=OFF -Denable-alsa=ON -Denable-libsndfile=ON -Denable-threads=ON; or return
    ninja -C build; or return
end

function package
    DESTDIR="$pkgdir" ninja -C build install; or return
    install -Dm644 fluidsynth-$pkgver/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
    install -Dm644 gcem-$_gcem/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.gcem"; or return
end
