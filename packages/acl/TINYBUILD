set pkgname acl
set pkgver 2.4.0
set pkgrel 1
set pkgdesc 'Access control list utilities, libraries and headers'
set arch i686 x32
set url https://savannah.nongnu.org/projects/acl
set nvchecker source=git git=https://git.savannah.gnu.org/git/acl.git prefix=v
set license 'LGPL-2.1-or-later AND GPL-2.0-or-later'
set depends glibc
set makedepends attr git
set provides libacl.so
set source "git+https://git.savannah.nongnu.org/git/$pkgname.git?signed#tag=v$pkgver"
set sha256sums 0637d58b5a2c1c595f679f297bd521f2b730a7315c6bc42ab30e2601c0fd2ba7
set flags arch

function prepare
    cd $pkgname; or return
    ./autogen.sh; or return
end

function build
    cd $pkgname; or return
    ./configure \
        --libdir=/usr/lib \
        --libexecdir=/usr/lib \
        --prefix=/usr; or return
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make; or return
end

function check
    cd $pkgname; or return
    make -k check; or return
end

function package
    cd $pkgname; or return
    make DESTDIR="$pkgdir" install; or return
end
