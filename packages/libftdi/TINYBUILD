set flags arch

function prepare
    cd {$pkgname}1-$pkgver; or return

    sed -i 's|LIB_SUFFIX 64|LIB_SUFFIX ""|' CMakeLists.txt; or return
    sed -i 's|MODE="0664", GROUP="plugdev"|TAG+="uaccess"|g' packages/99-libftdi.rules; or return

    patch -p1 -i "$srcdir/fix_includes_path.patch"; or return
    patch -p1 -i "$srcdir/libftdi-1.5-swig-4.3.patch"; or return
end

function build
    set -l cmake_options \
        -B build \
        -S {$pkgname}1-$pkgver \
        -G Ninja \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_SKIP_BUILD_RPATH=ON \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -D EXAMPLES=OFF \
        -D FTDI_EEPROM=ON \
        -D FTDIPP=ON \
        -D PYTHON_BINDINGS=ON \
        -D LINK_PYTHON_LIBRARY=ON \
        -W no-dev

    cmake $cmake_options; or return

    cmake --build build; or return
end

# needs yet unknown dependencies
#function check
#    cd $srcdir/{$pkgname}1-$pkgver/build; or return
#    make check; or return
#end

function package
    DESTDIR="$pkgdir" cmake --install build; or return

    cd {$pkgname}1-$pkgver; or return

    # udev rules
    install -Dm644 packages/99-libftdi.rules "$pkgdir/usr/lib/udev/rules.d/69-libftdi.rules"; or return

    # examples
    install -vd "$pkgdir/usr/share/libftdi/examples"; or return
    cp -r examples/* "$pkgdir/usr/share/libftdi/examples"; or return
end
