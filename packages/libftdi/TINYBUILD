set pkgname libftdi
set pkgver 1.5
set pkgrel 10
set pkgdesc 'A library to talk to FTDI chips'
set arch i686 x32
set url https://www.intra2net.com/en/developer/libftdi/
set nvchecker source=git git=git://developer.intra2net.com/libftdi prefix=v 'exclude_regex=.*(pre|release|weekly|rc|alpha|beta|dev).*'
set license GPL-2.0-only LGPL-2.1-only
set depends glibc libgcc libstdc++ sh libusb confuse
set makedepends boost cmake ninja swig python python-setuptools
set optdepends 'python: library bindings'
set source https://www.intra2net.com/en/developer/libftdi/download/{$pkgname}1-$pkgver.tar.bz2 \
    fix_includes_path.patch \
    https://src.fedoraproject.org/rpms/libftdi/raw/rawhide/f/libftdi-1.5-swig-4.3.patch
