set pkgname portaudio
set pkgver 19.7.0
set pkgrel 4
set epoch 1
set pkgdesc 'A free, cross-platform, open source, audio I/O library.'
set arch i686 x32
set url https://github.com/portaudio/portaudio/
set nvchecker source=git git=https://github.com/portaudio/portaudio.git prefix=v
set license MIT
set depends glibc libgcc libstdc++
set makedepends alsa-lib cmake jack
set provides libportaudio.so libportaudiocpp.so
set source "$url/archive/v$pkgver/$pkgname-v$pkgver.tar.gz"
set sha512sums 7e347a174109b661a685bcd617cc8fe00929c6fbf28f142fd7709a8ddbb9b5ed6e805be6647a44b4b9441b79e3474561de6f8e351b4ffc024952ed3e0e27ac1c
set b2sums db16882e97e60ab47b37c6d8851aa29e16e321531f3890f70390d89364aee2c1a9b42be09e7534f38d1c9ca48dd466b512874731049e42759a674571d6054220
set flags arch

function prepare
    cd $pkgname-$pkgver; or return
    pushd bindings/cpp; or return
    autoreconf -fiv; or return
    popd
    autoreconf -fiv; or return
end

function build
    set -l configure_options \
        --prefix=/usr \
        --enable-cxx
    cd $pkgname-$pkgver; or return
    ./configure $configure_options; or return
    # build breaks with multiple jobs when building C++ bindings:
    # https://github.com/PortAudio/portaudio/issues/540
    make -j1; or return
end

function package
    set -a depends alsa-lib libasound.so jack libjack.so
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    install -vDm 644 LICENSE.txt -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
    install -vDm 644 README.* -t "$pkgdir/usr/share/doc/$pkgname/"; or return
end
