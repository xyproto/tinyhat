set pkgname libtirpc
set pkgver 1.3.8
set pkgrel 2
set pkgdesc 'Transport Independent RPC library (SunRPC replacement)'
set arch i686 x32
set url 'http://git.linux-nfs.org/?p=steved/libtirpc.git;a=summary'
set license SISSL BSD-3-Clause
# No GSSAPI (Kerberos), which would pull in krb5 for pam
set depends glibc
set backup etc/netconfig
set flags arch
set source https://downloads.sourceforge.net/sourceforge/libtirpc/$pkgname-$pkgver.tar.bz2
set sha256sums 8839959bfcc7a0f4c609d8e4f53f1c67ae33de23775ec35beb39ff15adf11920

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr --sysconf=/etc --disable-gssapi; or return
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    install -D -m644 COPYING "$pkgdir"/usr/share/licenses/$pkgname/LICENSE; or return
end
