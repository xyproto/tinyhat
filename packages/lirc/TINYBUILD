set pkgname lirc
set -g _pkgver 0.10.2
if string match -qr '[a-z]$' -- $_pkgver
    set pkgver (string sub -e -1 -- $_pkgver).(string sub -s -1 -- $_pkgver)
else
    set pkgver $_pkgver
end
set pkgrel 6
set epoch 1
set pkgdesc 'Linux Infrared Remote Control utilities'
set arch i686 x32
set url https://www.lirc.org/
set license GPL-2.0-or-later
set depends alsa-lib libx11 libftdi libusb-compat
set makedepends help2man alsa-lib libx11 libxslt python python-setuptools \
    python-yaml systemd
set optdepends 'python: for lirc-setup, irdb-get and pronto2lirc' \
    'python-gobject: for lirc-setup and irdb-get' \
    'python-yaml: for lirc-setup and irdb-get'
set provides lirc-utils
set conflicts lirc-utils
set replaces lirc-utils
set backup etc/lirc/lirc_options.conf etc/lirc/lircd.conf etc/lirc/lircmd.conf
set flags arch
set source "https://prdownloads.sourceforge.net/$pkgname/$pkgname-$_pkgver.tar.bz2" \
    lirc.logrotate \
    lirc.tmpfiles
set sha256sums 3d44ec8274881cf262f160805641f0827ffcc20ade0d85e7e6f3b90e0d3d222a \
    bd13ca00e30d85ff9166c03b8f7a20195ef89794e66d7e54f04ba1d014a73e7d \
    b8eb6ff2a542a9a3b20fe259fe36aece941db8d309598d2eeb1815b779e2f838

function build
    cd lirc-$_pkgver; or return

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --enable-devinput \
        --enable-uinput; or return
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make; or return
end

function package
    cd lirc-$_pkgver; or return

    make DESTDIR="$pkgdir" install; or return

    install -Dm644 "$srcdir"/lirc.tmpfiles "$pkgdir"/usr/lib/tmpfiles.d/lirc.conf; or return
    install -Dm644 "$srcdir"/lirc.logrotate "$pkgdir"/etc/logrotate.d/lirc; or return

    rmdir "$pkgdir"/var/{run/lirc/,run/}; or return
end
