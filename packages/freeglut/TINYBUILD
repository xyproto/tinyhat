set pkgname freeglut
set pkgver 3.8.0
set pkgrel 1
set pkgdesc 'Free OpenGL Utility Toolkit'
set url https://freeglut.sourceforge.net/
set nvchecker source=git git=https://github.com/FreeGLUTProject/freeglut.git 'include_regex=v\d+(\.\d+)*' prefix=v 'from_pattern=-([a-z])' 'to_pattern=\1'
set arch i686 x32
set license X11
set depends glibc \
    glu \
    libgl \
    libx11 \
    libxi \
    libxrandr \
    libxxf86vm
# glu is required by headers
set makedepends cmake git mesa ninja
set provides glut
set conflicts glut
set source "git+https://github.com/FreeGLUTProject/freeglut#tag=v$(string replace -r -- '[a-z]' '-$0' $pkgver)"
set b2sums 2681b876d8867c6fb1f5a4242068434575c0c5ea14ce62b4754f1656bb5297821a95ce24eb14f326acccc929675211e908e6c702796a6d8c72b0f96e6503fbc0
set flags arch

function build
    set -l cmake_options \
        -D CMAKE_BUILD_TYPE=None \
        -D CMAKE_INSTALL_LIBDIR=lib \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D FREEGLUT_BUILD_STATIC_LIBS=OFF
    cmake -S freeglut -B build -G Ninja $cmake_options; or return
    cmake --build build; or return
end

function check
    ctest --test-dir build --output-on-failure --stop-on-failure -j(nproc); or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return

    ln -s glut.pc "$pkgdir/usr/lib/pkgconfig/freeglut.pc"; or return

    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" freeglut/COPYING; or return
end
