set pkgname faad2
set pkgver 2.11.4
set pkgrel 1
set pkgdesc 'Freeware Advanced Audio (AAC) Decoder'
set arch i686 x32
set url https://github.com/knik0/faad2
set nvchecker source=git git=https://github.com/knik0/faad2.git
set license GPL-2.0-or-later
set depends glibc
set makedepends cmake
set provides faad libfaad_drm.so libfaad.so
set source "$pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz"
set sha512sums 19f66bf811b3debf2230debba2f9978c06172444be5fbd8046112e4e01736a81ef302bde66221742d132fd06e4c8167bc79f76a1434a6e7ff16fcd13cf5ef9e7
set b2sums 7ee3c8a5407e03346600c1499dcabe39e41fb912b29050af3b9f75c07bddbf1258d9b34af5c474e2362090c83693b33220a49feda0c6f99afcd5fd236888b930
set flags arch

function build
    set -l cmake_options \
        -B build \
        -D CMAKE_BUILD_TYPE=None \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -S $pkgname-$pkgver \
        -W no-dev
    cmake $cmake_options; or return
    cmake --build build --verbose; or return
end

function check
    ctest --test-dir build --output-on-failure; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
    install -vDm 644 $pkgname-$pkgver/{AUTHORS,ChangeLog,README} -t "$pkgdir/usr/share/doc/$pkgname/"; or return
end
