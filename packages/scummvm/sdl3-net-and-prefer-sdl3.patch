+			NET_DestroyStreamSocket(accepted);
+			return;
+		}
+
+		_client[slot].open(nullptr, accepted);
+		++_clients;
+	}
+#else
 	if (!SDLNet_SocketReady(_serverSocket))
 		return;
 
