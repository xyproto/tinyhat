set pkgname gdbm
set pkgver 1.26
set pkgrel 2
set pkgdesc 'GNU database library'
set arch i686 x32
set url https://www.gnu.org/software/gdbm/gdbm.html
set nvchecker source=git git=https://git.gnu.org.ua/gdbm.git prefix=v
set license GPL-3.0-or-later
set depends glibc sh
set makedepends readline
set provides libgdbm_compat.so libgdbm.so
set source "https://ftp.gnu.org/gnu/gdbm/gdbm-$pkgver.tar.gz"
set sha512sums 44aafe254f0950a8f5215d8f1337674f07b19f2a375f6eb19a7e39690028c80c3774b705c2b76b470ae74042b21f2ca77d02f6f57aa2ee50296db801220a3352
set b2sums 9423ea16ee3e8f1ce57ea32371f49919e2a3819a206a61ce927676a08a71a6a495d3949714bff7be789dfce75bf0ab0ac76f07ec673b71a84ae32bd8cd483781
set flags arch

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr --enable-libgdbm-compat; or return
    make; or return
end

function check
    make check -C $pkgname-$pkgver; or return
end

function package
    set -a depends readline libreadline.so
    make DESTDIR="$pkgdir" install -C $pkgname-$pkgver; or return
    install -vDm 644 $pkgname-$pkgver/{NOTE-WARNING,AUTHORS,NEWS,README} -t "$pkgdir/usr/share/doc/$pkgname"; or return
end
