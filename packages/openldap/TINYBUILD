set pkgbase openldap
set pkgname openldap libldap
set pkgver 2.7.1
set pkgrel 1
set arch i686 x32
set url https://www.openldap.org/
set license custom
set makedepends libtool libsasl util-linux chrpath unixodbc libsodium systemd
set options '!makeflags' emptydirs '!lto'
set source "https://www.openldap.org/software/download/OpenLDAP/openldap-release/$pkgbase-$pkgver.tgz" \
    openldap.tmpfiles \
    openldap.sysusers
set sha256sums 253db80f301258ea69cda1184766d57395b836aaabf41157eb0316eb0fac1341 \
    0be46138e53ff2fa6d4b4c06bfbdd2100426e0bd2ed29bf3419ade6b5974e9a0 \
    e4af9009982808d04fd10bd5d9559cec193efc7a05c6807367473da33392edab
set flags arch

# extra modules found in contrib/slapd-modules
set -g _extra_modules \
    nssov \
    autogroup \
    lastbind \
    passwd/sha2 \
    allowed \
    noopsrch

function prepare
    cd $pkgbase-$pkgver; or return

    # change perms from 0644 to 0755
    sed -i 's|-m 644 $(LIBRARY)|-m 755 $(LIBRARY)|' libraries/{liblber,libldap}/Makefile.in; or return

    # change rundir to /run/openldap
    sed -i 's|#define LDAPI_SOCK LDAP_RUNDIR LDAP_DIRSEP "run" LDAP_DIRSEP "ldapi"|#define LDAPI_SOCK LDAP_DIRSEP "run" LDAP_DIRSEP "openldap" LDAP_DIRSEP "ldapi"|' include/ldap_defaults.h; or return
    sed -i 's|%LOCALSTATEDIR%/run|/run/openldap|' servers/slapd/slapd.{conf,ldif}; or return
    sed -i 's|-$(MKDIR) $(DESTDIR)$(localstatedir)/run|-$(MKDIR) $(DESTDIR)/run/openldap|' servers/slapd/Makefile.in; or return

    # modify upstream systemd service
    sed -i -e 's|EnvironmentFile.*|EnvironmentFile=-/etc/conf.d/slapd|' -e 's/slapd -d 0/\0 -u ldap -g ldap/' servers/slapd/slapd.service; or return
end

function build
    cd $pkgbase-$pkgver; or return
    autoconf; or return
    ./configure \
        --prefix=/usr \
        --libexecdir=/usr/lib \
        --sysconfdir=/etc \
        --localstatedir=/var/lib/openldap \
        --sbindir=/usr/bin \
        --enable-dynamic \
        --enable-syslog \
        --enable-ipv6 \
        --enable-local \
        --enable-crypt \
        --enable-spasswd \
        --enable-modules \
        --enable-backends \
        --enable-argon2 \
        --with-argon2=libsodium \
        --disable-wt \
        --enable-overlays=mod \
        --with-cyrus-sasl \
        --with-threads; or return

    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return

    make; or return

    # build extra modules
    for module in $_extra_modules
        make -C "contrib/slapd-modules/$module" \
            OPT="$CFLAGS $CPPFLAGS" \
            prefix=/usr \
            libexecdir=/usr/lib \
            sysconfdir=/etc/openldap; or return
    end
end

# No check(): getting all kind of test errors, also on 64-bit, ignoring for now

function package_libldap
    set pkgdesc 'Lightweight Directory Access Protocol (LDAP) client libraries'
    set depends libsasl
    set backup etc/openldap/ldap.conf

    cd $pkgbase-$pkgver; or return
    for dir in include libraries doc/man/man3
        make -C $dir DESTDIR="$pkgdir" install; or return
    end
    install -Dm644 -t "$pkgdir/usr/share/man/man5" doc/man/man5/ldap.conf.5; or return

    # remove duplicate conf files
    rm "$pkgdir"/etc/openldap/*.default; or return

    # shared library versioning
    ln -sf liblber.so "$pkgdir"/usr/lib/liblber.so.2; or return
    ln -sf libldap.so "$pkgdir"/usr/lib/libldap.so.2; or return

    # license
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE; or return
end

function package_openldap
    set pkgdesc 'Lightweight Directory Access Protocol (LDAP) client and server'
    set depends "libldap>=$pkgver" libtool unixodbc perl systemd-libs libsodium
    set backup etc/openldap/slapd.conf etc/openldap/slapd.ldif

    cd $pkgbase-$pkgver; or return
    for dir in clients servers doc/man/man{1,5,8}
        make -C $dir DESTDIR="$pkgdir" install STRIP_OPTS=; or return
    end

    # install extra modules
    for module in $_extra_modules
        make -C "contrib/slapd-modules/$module" \
            prefix=/usr \
            libexecdir=/usr/lib \
            sysconfdir=/etc/openldap \
            DESTDIR="$pkgdir" install; or return

        # passwd/sha2 has no man page, so skip it
        if test -f "contrib/slapd-modules/$module/slapo-$module.5"
            install -m644 -t "$pkgdir/usr/share/man/man5" \
                "contrib/slapd-modules/$module/slapo-$module.5"; or return
        end
    end

    # should be in libldap package
    rm "$pkgdir"/usr/share/man/man5/ldap.conf.5; or return

    # let systemd-tmpfiles generate this directory
    rm -r "$pkgdir"/run; or return

    # get rid of duplicate conf files
    rm "$pkgdir"/etc/openldap/*.default; or return

    ln -s ../lib/slapd "$pkgdir"/usr/bin/slapd; or return

    chown root:439 "$pkgdir"/etc/openldap/slapd.{conf,ldif}; or return
    chmod 640 "$pkgdir"/etc/openldap/slapd.{conf,ldif}; or return

    # systemd integration
    install -Dm644 "$srcdir"/openldap.tmpfiles "$pkgdir"/usr/lib/tmpfiles.d/openldap.conf; or return
    install -Dm644 "$srcdir"/openldap.sysusers "$pkgdir"/usr/lib/sysusers.d/openldap.conf; or return

    # license
    install -Dm644 -t "$pkgdir"/usr/share/licenses/$pkgname LICENSE; or return
end
