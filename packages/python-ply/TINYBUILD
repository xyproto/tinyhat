set pkgname python-ply
set pkgver 3.11
set pkgrel 17
set pkgdesc 'Implementation of lex and yacc parsing tools'
set arch any
set url https://www.dabeaz.com/ply/
set nvchecker source=pypi pypi=ply
set license BSD-3-Clause
set depends python
set makedepends git python-build python-installer python-setuptools python-wheel
set source "git+https://github.com/dabeaz/ply.git#tag=$pkgver" license-from-upstream
set sha512sums 9f96e8ee99908003633f198f155893652b508dbfb3f5d063eab087839a3a0d66ef8341037df5236a13a2161cb3800b8b16400505ef03e3cfe21b5d51b28ece1c \
    5cea085a23ed260afc9084380c1d59e3942c2385089a8eb2391a89c85cde4df2ceb7eed21bb8c4d0cad5b78e59742da69e4c5c78fd0e223f5c99c56e9296a075
set flags arch

function build
    cd ply; or return
    python -m build --wheel --no-isolation; or return
end

function package
    cd ply; or return
    python -m installer --destdir="$pkgdir" dist/*.whl; or return
    install -Dm644 ../license-from-upstream "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
