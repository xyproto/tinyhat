# Only the client library and tools (libpulse: pactl, paplay...): the sound server of Tiny Hat is pipewire-pulse, so
# no daemon and none of what only it needs (gtk3, Qt, jack2, gstreamer, X11, lirc, avahi, webrtc, libasyncns...). No
# documentation (doxygen), man pages (xmltoman) or tests (check, valgrind) either
set pkgbase pulseaudio
set pkgname libpulse
set pkgver 17.0+r134+g77d25a1e6
set pkgrel 1
set pkgdesc 'A featureful, general-purpose sound server (client library)'
set url https://www.freedesktop.org/wiki/Software/PulseAudio/
set arch i686 x32
set license LGPL-2.1-or-later
set makedepends dbus git glib2 glibc libsndfile meson
set flags arch
set -g _commit 77d25a1e613095bdf87a1d13b65e7c330565077a # master
set source "git+https://gitlab.freedesktop.org/pulseaudio/pulseaudio.git#commit=$_commit" \
    0001-alsa-ucm-Fix-segfault-from-recursion-due-to-too-many.patch
set b2sums 7bc8af3ccd517a340ef5e7ca3e835961c821b83c8912507087ac8e448494eade56c851ba317b0c691307acc5accef068aff62825b916e65c66d77d43466dc0bc \
    73f93801069b2c5b09646870269c0f42cefc2183a73b47c78fd160c978a841c11c5146b98351a11be24d4785181f361a455534e6f6ca2d977cf585044836f8ed

function prepare
    cd pulseaudio; or return

    # Freeze version before patching
    ./git-version-gen doesnt-exist >.tarball-version; or return

    # Crash fix
    # https://gitlab.archlinux.org/archlinux/packaging/packages/pulseaudio/-/issues/7
    # https://gitlab.freedesktop.org/pulseaudio/pulseaudio/-/merge_requests/838
    git apply -3 ../0001-alsa-ucm-Fix-segfault-from-recursion-due-to-too-many.patch; or return
end

function build
    # Every feature is set: arch-meson makes the ones left on auto required
    set -l meson_options \
        -D daemon=false \
        -D client=true \
        -D doxygen=disabled \
        -D man=false \
        -D tests=disabled \
        -D valgrind=disabled \
        -D database=simple \
        -D alsa=disabled \
        -D asyncns=disabled \
        -D avahi=disabled \
        -D bluez5=disabled \
        -D bluez5-gstreamer=disabled \
        -D bluez5-native-headset=false \
        -D bluez5-ofono-headset=false \
        -D consolekit=disabled \
        -D dbus=enabled \
        -D elogind=disabled \
        -D fftw=disabled \
        -D glib=enabled \
        -D gsettings=disabled \
        -D gstreamer=disabled \
        -D gtk=disabled \
        -D jack=disabled \
        -D lirc=disabled \
        -D openssl=disabled \
        -D orc=disabled \
        -D oss-output=disabled \
        -D samplerate=disabled \
        -D soxr=disabled \
        -D speex=disabled \
        -D systemd=disabled \
        -D tcpwrap=disabled \
        -D udev=disabled \
        -D x11=disabled \
        -D webrtc-aec=disabled \
        -D adrian-aec=false

    arch-meson pulseaudio build $meson_options; or return
    meson compile -C build; or return
end

function package
    set depends dbus glib2 glibc libsndfile
    set optdepends 'pulse-native-provider: PulseAudio backend'
    set provides libpulse-mainloop-glib.so libpulse-simple.so libpulse.so
    set backup etc/pulse/client.conf

    meson install -C build --destdir "$pkgdir"; or return
    # Superseded by socket activation
    sed -e '/autospawn/iautospawn = no' -i "$pkgdir/etc/pulse/client.conf"; or return
end
