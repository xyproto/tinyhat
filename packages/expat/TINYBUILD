set pkgname expat
set pkgver 2.9.0
set pkgrel 1
set pkgdesc 'An XML parser library'
set arch i686 x32
set url https://libexpat.github.io/
set nvchecker source=git git=https://github.com/libexpat/libexpat/ 'include_regex=(R_)([\d.*][_].*)' 'from_pattern=R_(\d)_(\d)_(\d)' 'to_pattern=\1.\2.\3'
set -g _url https://github.com/libexpat/libexpat
set license MIT
set depends glibc
set makedepends cmake git
set provides libexpat.so
set source "$pkgname::git+$_url?signed#tag=R_"(string replace -a . _ -- $pkgver)
set sha512sums 616b97ce5e783f8381b3db84636d240dd1ea240137baa150cdc37f25c60455db98b334b70dbf5bc54b1af5a08833e775f0f06d0ec4b86297d26ddd8f95540495
set b2sums 8d56cc7d6710081b9c44d7375d12f917eb13c7f5815cbedf813c893ffa185d6a3816e073b686ae3abe0ea53c211178d1e546048b167e99eb1f2649c728bf4d35
set flags arch

function build
    set -l cmake_options \
        -B build \
        -D CMAKE_BUILD_TYPE=None \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -S $pkgname/$pkgname \
        -W no-dev

    cmake $cmake_options; or return
    cmake --build build --verbose; or return
end

function check
    ctest --test-dir build --output-on-failure; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
    install -vDm 644 $pkgname/$pkgname/COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
    install -vDm 644 $pkgname/$pkgname/{AUTHORS,Changes,README.md} -t "$pkgdir/usr/share/doc/$pkgname/"; or return
end
