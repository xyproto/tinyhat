set pkgname xcb-proto
set pkgver 1.17.0
set pkgrel 4
set pkgdesc 'XML-XCB protocol descriptions'
set arch any
set url https://xcb.freedesktop.org/
set license X11-distribute-modifications-variant
set makedepends python
set source "https://xorg.freedesktop.org/archive/individual/proto/$pkgname-$pkgver.tar.xz"
set sha512sums 34c3795e5a48a66d89b72ee1777fb0bede489d5ec07018e6c9ef3c13bdd60b0358fc2c04a1f0ed0acb5b681aeeb92033db579036e4f5edd967fe56714c03acdf
set flags arch

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr; or return
    make; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"; or return
end
