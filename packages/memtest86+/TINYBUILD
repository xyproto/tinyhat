# Only the i586 build, for the BIOS menu entry (linux16 /boot/memtest86+/memtest.bin): it runs on 32-bit and 64-bit
# CPUs, while the x86_64 build needs a 64-bit CPU. No EFI files and no ISO image: no Tiny Hat image uses them
set pkgname memtest86+
set pkgver 9.00
set pkgrel 2
set pkgdesc 'Advanced memory diagnostic tool, legacy BIOS version'
set url https://www.memtest.org
set arch any
set license GPL-2.0-only
set makedepends git
set flags arch
set source "git+https://github.com/memtest86plus/memtest86plus.git#tag=v$pkgver" \
    60_memtest86+
set sha512sums aaee88ce56be1651b58339c670eb7168718596b85dcb76deb1a912eff9a5a823573dbfe40a09ceccd25938a3f18cae4db50f942dca1179f33397f5e8f0c59be9 \
    8abdd5ce13396de68905917060700a4e2da1813d08d3ea8012ad3d939635eadcebdb43e2a7ca40bbbb43260877d06726850b12dfcb355d8f8e1da6c0a54ded7c

function build
    cd memtest86plus/build/i586; or return
    make; or return
end

function package
    install -Dm644 memtest86plus/build/i586/mt86plus "$pkgdir/boot/memtest86+/memtest.bin"; or return
    install -Dm 755 "$srcdir/60_memtest86+" "$pkgdir/etc/grub.d/60_memtest86+"; or return
end
