set pkgname tig
set pkgver 2.6.1
set pkgrel 1
set pkgdesc 'Text-mode interface for Git.'
set arch i686 x32
set url https://jonas.github.io/tig/
set license GPL
set depends git ncurses libncursesw.so pcre2 libpcre2-posix.so libpcre2-8.so readline libreadline.so
set makedepends asciidoc xmlto
set backup etc/tigrc
set source "https://github.com/jonas/tig/releases/download/tig-$pkgver/tig-$pkgver.tar.gz"
set sha256sums 5adeabdcd93aa0423d618da8b878b53482bef6e0e9e1fe224acc0f18031fe91e
set flags arch

function build
    cd "$srcdir/$pkgname-$pkgver"; or return
    ./configure --prefix=/usr --sysconfdir=/etc; or return
    make; or return
end

function package
    cd "$srcdir/$pkgname-$pkgver"; or return
    make DESTDIR="$pkgdir" install install-doc-man; or return
    install -Dm0644 contrib/tig-completion.bash "$pkgdir/usr/share/bash-completion/completions/tig"; or return
end
