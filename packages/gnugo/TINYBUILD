set pkgname gnugo
set pkgver 3.8
set pkgrel 9
set pkgdesc 'Program that plays the game of Go'
set url https://www.gnu.org/software/gnugo/
set nvchecker source=regex url=https://ftp.gnu.org/gnu/gnugo/ 'regex=gnugo-([\d.]+)\.[a-z]'
set license GPL-3.0-or-later
set arch i686 x32
set depends glibc ncurses
set flags arch
set source "https://ftp.gnu.org/gnu/gnugo/$pkgname-$pkgver.tar.gz" \
    Wformat-security.patch
set sha256sums da68d7a65f44dcf6ce6e4e630b6f6dd9897249d34425920bfdd4e07ff1866a72 \
    c5c1c45ca30793a4c872aa6b2c5d2dc3ca201831c20a4bb595d82c8cf27eb20e

function prepare
    cd $pkgname-$pkgver; or return
    patch -p1 -i ../Wformat-security.patch; or return # Fix build with -Wformat-security
end

function build
    cd $pkgname-$pkgver; or return
    set -a CFLAGS -fcommon # https://wiki.gentoo.org/wiki/Gcc_10_porting_notes/fno_common
    set -l cross 0
    string match -q -- '*-gcc' $CC; and set cross 1
    if test $cross = 1
        rm -rf ../native; or return
        cp -a . ../native; or return
        pushd ../native; or return
        env -u CONFIG_SITE -u AR -u RANLIB -u NM -u LD -u OBJCOPY -u OBJDUMP -u READELF -u STRIP \
            CC=$CC_FOR_BUILD CFLAGS="-O2 -fcommon" CPPFLAGS= LDFLAGS= ./configure --without-readline; or return
        env -u AR -u RANLIB make CC=$CC_FOR_BUILD; or return
        popd; or return
    end
    ./configure \
        --prefix=/usr; or return
    if test $cross = 1
        sed -i -E 's#^\t\./(mkpat|joseki|mkeyes|uncompress_fuseki|mkmcpat) #\t'"$srcdir"'/native/patterns/\1 #' patterns/Makefile; or return
        grep -q "$srcdir/native/patterns/mkmcpat " patterns/Makefile; or return
    end
    make; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
end
