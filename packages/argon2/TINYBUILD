set pkgname argon2
set pkgver 20190702
set pkgrel 7
set pkgdesc 'A password-hashing function (reference C implementation)'
set arch i686 x32
set url https://github.com/P-H-C/phc-winner-argon2
set nvchecker source=git git=https://github.com/P-H-C/phc-winner-argon2.git
set license Apache custom:CC0
set depends glibc
set provides libargon2.so
set source "https://github.com/P-H-C/phc-winner-argon2/archive/$pkgver/argon2-$pkgver.tar.gz"
set sha256sums daf972a89577f8772602bf2eb38b6a3dd3d922bf5724d45e7f9589b5e830442c
set flags arch

function build
    cd "$srcdir/phc-winner-$pkgname-$pkgver"; or return
    make ARGON2_VERSION="$pkgver" OPTTARGET='none' LIBRARY_REL='lib'; or return
end

function package
    cd "$srcdir/phc-winner-$pkgname-$pkgver"; or return
    make ARGON2_VERSION="$pkgver" OPTTARGET='none' LIBRARY_REL='lib' DESTDIR="$pkgdir" install; or return
    install -D -m0644 LICENSE "$pkgdir/usr/share/licenses/argon2/LICENSE"; or return
end
