set pkgname meson
set pkgver 1.12.1
set pkgrel 2
set pkgdesc 'High productivity build system'
set arch any
set url https://mesonbuild.com/
set license Apache-2.0
set depends python ninja
set makedepends git
set source "git+https://github.com/mesonbuild/meson.git#tag=$pkgver"
set b2sums 4995b1a06b106c0cda8d3cbd2d09d4069422875abbeb0e7717579d477ea36714a08c92fab938114fa53d3e348f79ecf15a87a8aff0d5f4b0e0c6f07155c68701
set flags arch

function build
    cd meson; or return
    python -m build --wheel --no-isolation; or return
end

function package
    cd meson; or return
    python -m installer --destdir="$pkgdir" dist/*.whl; or return
    install -d "$pkgdir/usr/share/vim/vimfiles"; or return
    cp -rt "$pkgdir/usr/share/vim/vimfiles" data/syntax-highlighting/vim/*/; or return
    install -Dm644 data/shell-completions/bash/* -t "$pkgdir/usr/share/bash-completion/completions"; or return
    install -Dm644 data/shell-completions/zsh/* -t "$pkgdir/usr/share/zsh/site-functions"; or return
    install -d "$pkgdir/usr/bin"; or return
    printf '%s\n' \
        '#!/bin/bash -ex' \
        'exec meson setup \\' \
        '  --prefix        /usr \\' \
        '  --libexecdir    lib \\' \
        '  --sbindir       bin \\' \
        '  --buildtype     plain \\' \
        '  --auto-features enabled \\' \
        '  --wrap-mode     nodownload \\' \
        '  -D              b_pie=true \\' \
        '  -D              python.bytecompile=1 \\' \
        '  "$@"' >"$pkgdir/usr/bin/arch-meson"; or return
    chmod 755 "$pkgdir/usr/bin/arch-meson"; or return
end
