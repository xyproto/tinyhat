set pkgname libvdpau
set pkgver 1.5
set pkgrel 4
set pkgdesc 'Nvidia VDPAU library'
set arch i686 x32
set url https://www.freedesktop.org/wiki/Software/VDPAU/
set license MIT
set depends glibc libx11 libxext
set makedepends git meson xorgproto
set optdepends 'libvdpau-va-gl: driver using VAAPI' 'nvidia-utils: driver for NVIDIA'
set provides libvdpau.so
set source "git+https://gitlab.freedesktop.org/vdpau/libvdpau.git#tag=$pkgver"
set sha256sums 2f1b8ee2bed5efdf79dd4f5469237ac5394fcdab3b2b8d689772563a4f751eab
set flags arch

function build
    arch-meson $pkgname build; or return
    meson compile -C build; or return
end

function package
    meson install -C build --destdir "$pkgdir"; or return
    install -Dm644 libvdpau/COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
