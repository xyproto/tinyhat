function prepare
    cd $pkgname; or return
    for src in $source
        set src (string replace -r '::.*' '' -- $src)
        set src (string replace -r '.*/' '' -- $src)
        string match -q '*.patch' -- $src; or continue
        printf "Applying patch %s...\n" $src
        patch -Np1 <../$src; or return
    end
    sed -n '5, 28 p' COPYING.other >MIT.txt; or return
    sed -n '30, 60 p' COPYING.other >BSD-4-Clause.txt; or return
    sed -n '62, 92 p' COPYING.other >BSD-3-Clause.txt; or return
    sed -n '95, 125 p' COPYING.other >BSD-2-Clause.txt; or return
    sed -n '128, 160 p' COPYING.other >Unicode-TOU.txt; or return
    ./autogen.sh; or return
end

function build
    cd $pkgname; or return
    # --enable-large-secmem is needed for large RSA keys
    ./configure --enable-g13 --enable-large-secmem --enable-maintainer-mode --disable-doc --disable-ldap --disable-tpm2d \
        --libexecdir=/usr/lib/gnupg --prefix=/usr --sbindir=/usr/bin --sysconfdir=/etc; or return
    make; or return
end

function package
    set -a depends bzip2 libbz2.so libassuan libassuan.so npth libnpth.so readline libreadline.so
    cd $pkgname; or return
    make DESTDIR="$pkgdir" install; or return
    ln -s gpg "$pkgdir"/usr/bin/gpg2; or return
    ln -s gpgv "$pkgdir"/usr/bin/gpgv2; or return
    install -vDm 644 ../keyboxd.8 -t "$pkgdir/usr/share/man/man8/"; or return
    install -vDm 644 {BSD-{2,3,4}-Clause,MIT,Unicode-TOU}.txt -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
    set -l systemdir "$pkgdir/usr/lib/systemd/"
    set -l wantsdir "$systemdir"user/sockets.target.wants/
    install -vdm 755 $wantsdir; or return
    for unit in ../*.{service,socket}
        set -l name (path basename $unit)
        if string match -q '*@.*' -- $name
            install -vDm 644 $unit -t "$systemdir"system/; or return
            continue
        end
        if string match -q '*.socket' -- $name
            ln -sv ../$name -t $wantsdir; or return
        end
        install -vDm 644 $unit -t "$systemdir"user/; or return
    end
end
