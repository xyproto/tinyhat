set -g _target arm-none-eabi
set pkgname $_target-newlib
set pkgver 4.6.0.20260123
set pkgrel 1
set -g _upstream_ver $pkgver
set pkgdesc 'A C standard library implementation intended for use on embedded systems (ARM bare metal)'
set arch any
set url https://www.sourceware.org/newlib/
set license BSD
set makedepends $_target-gcc
set options '!emptydirs' '!strip'
set source "https://sourceware.org/pub/newlib/newlib-$_upstream_ver.tar.gz"
set sha256sums 6ff27e3bf022666f43f7802255be680eeff722ac181b1725d21e2e8318604ee3
set flags arch

function build
    rm -rf build-{newlib,nano}; or return
    mkdir build-{newlib,nano}; or return

    set -lx CFLAGS_FOR_TARGET '-g -O2 -ffunction-sections -fdata-sections'
    cd "$srcdir"/build-newlib; or return
    ../newlib-$_upstream_ver/configure \
        --target=$_target \
        --prefix=/usr \
        --enable-newlib-io-long-long \
        --enable-newlib-io-c99-formats \
        --enable-newlib-register-fini \
        --enable-newlib-retargetable-locking \
        --disable-newlib-supplied-syscalls \
        --disable-nls; or return
    make; or return

    set CFLAGS_FOR_TARGET '-g -Os -ffunction-sections -fdata-sections'
    cd "$srcdir"/build-nano; or return
    ../newlib-$_upstream_ver/configure \
        --target=$_target \
        --prefix=/usr \
        --disable-newlib-supplied-syscalls \
        --enable-newlib-reent-small \
        --enable-newlib-retargetable-locking \
        --disable-newlib-fvwrite-in-streamio \
        --disable-newlib-fseek-optimization \
        --disable-newlib-wide-orient \
        --enable-newlib-nano-malloc \
        --disable-newlib-unbuf-stream-opt \
        --enable-lite-exit \
        --enable-newlib-global-atexit \
        --enable-newlib-nano-formatted-io \
        --disable-nls; or return
    make; or return
end

function package
    cd "$srcdir"/build-nano; or return
    make DESTDIR="$pkgdir" install -j1; or return
    find "$pkgdir" -regex '.*/lib\(c\|g\|rdimon\)\.a' -exec rename .a _nano.a '{}' \;; or return
    install -d "$pkgdir"/usr/$_target/include/newlib-nano; or return
    install -m644 -t "$pkgdir"/usr/$_target/include/newlib-nano "$pkgdir"/usr/$_target/include/newlib.h; or return

    cd "$srcdir"/build-newlib; or return
    make DESTDIR="$pkgdir" install -j1; or return

    find "$pkgdir"/usr/$_target/lib \( -name '*.a' -or -name '*.o' \) -exec $_target-objcopy --strip-debug -R .comment -R .note '{}' \;; or return

    install -d "$pkgdir"/usr/share/licenses/$pkgname/; or return
    install -m644 -t "$pkgdir"/usr/share/licenses/$pkgname/ "$srcdir"/newlib-$_upstream_ver/COPYING*; or return

    # https://gitlab.archlinux.org/archlinux/packaging/packages/riscv64-elf-newlib/-/issues/1
    rm "$pkgdir/usr/share/info/porting.info"; or return
end
