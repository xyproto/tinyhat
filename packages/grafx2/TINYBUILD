set pkgname grafx2
set -g _commit 678a0f54ea7f3eeebc3fa4135213ea63f45a28bd
set pkgver 0+678a0f54
set pkgrel 2
set -g _lua 5.4.9
set pkgdesc 'Pixel art paint program, ported to SDL3'
set arch i686 x32
set url http://grafx2.eu/
set license GPL-2.0-only MIT GPL-2.0-or-later GPL-3.0-or-later
set options sstrip
set makedepends_build elfkickers
set depends sdl3 sdl3_image sdl3_ttf fontconfig libpng
set source "https://gitlab.com/GrafX2/grafx2/-/archive/$_commit/grafx2-$_commit.tar.gz" \
    "https://www.lua.org/ftp/lua-$_lua.tar.gz" \
    https://downloads.sourceforge.net/project/recoil/recoil/6.4.5/recoil-6.4.5.tar.gz \
    https://github.com/redcode/6502/releases/download/v0.1/6502-v0.1.tar.xz \
    grafx2-sdl3.patch
set noextract recoil-6.4.5.tar.gz 6502-v0.1.tar.xz
set sha256sums 2970c992ab20ec476f94c98ddb2131a82b6f0f58b13f34ced8c07f99909729b4 \
    2335b6c582a52654f94612bf10d2f4672805d05329aa6568b1d8cd9e5c6fb8e6 \
    2259153957d52eae9d952b63826654752784bcc0bd4a89a13fa98b30d85755b1 \
    bba50f327163d40b1014f5affc8042137f37b200dae50a4f0fe56b5769b3940f \
    4b5c0ef598f2b5a756b632d5cb70ecdc4d99561b6e9dd1fb4c26be4c48dba785

function prepare
    cd grafX2-$_commit; or return
    mkdir -p 3rdparty/archives; or return
    cp "$srcdir/recoil-6.4.5.tar.gz" "$srcdir/6502-v0.1.tar.xz" 3rdparty/archives/; or return
    patch -Np1 -i ../grafx2-sdl3.patch; or return
end

function _grafx2_make
    make API=sdl3 NO_X11=1 OPTIM=3 LUACOPT="-I$srcdir/lua-$_lua/src" LUALOPT="$srcdir/lua-$_lua/src/liblua.a" \
        TTFCOPT="$(pkg-config --cflags sdl3-ttf)" TTFLOPT="$(pkg-config --libs sdl3-ttf fontconfig)" $argv
end

function build
    set -a CFLAGS -O3 -flto
    set -a LDFLAGS -flto
    set -l cross
    if string match -q -- '*-gcc' $CC
        set cross CC=$CC "AR=$CC-ar rcu" RANLIB=$CC-ranlib
    end
    make -C lua-$_lua/src liblua.a MYCFLAGS="$CFLAGS -DLUA_USE_LINUX" $cross; or return
    cd grafX2-$_commit/src; or return
    _grafx2_make $cross[1]; or return
end

function package
    cd grafX2-$_commit/src; or return
    set -l cross
    string match -q -- '*-gcc' $CC; and set cross CC=$CC
    _grafx2_make PREFIX=/usr DESTDIR="$pkgdir" install $cross; or return
    ln -sf grafx2-sdl3 "$pkgdir/usr/bin/grafx2"; or return
    set -l l "$pkgdir/usr/share/licenses/$pkgname"
    install -Dm644 ../LICENSE ../doc/gpl-2.0.txt -t "$l/"; or return
    install -Dm644 "$srcdir/lua-$_lua/doc/readme.html" "$l/lua-readme.html"; or return
    tar -xOf "$srcdir/recoil-6.4.5.tar.gz" --wildcards '*/COPYING' >"$l/COPYING.recoil"; or return
    tar -xOf "$srcdir/6502-v0.1.tar.xz" --wildcards '*/COPYING' >"$l/COPYING.6502"; or return
end
