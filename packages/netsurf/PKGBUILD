pkgname=netsurf
pkgver=3.12.0
pkgrel=1
pkgdesc='Lightweight and fast web browser'
arch=(i686 x32)
url='https://github.com/xyproto/netsurf'
license=(GPL-2.0-only MIT)
depends=(curl gtk4 'libcss>=0.9.2.r116' 'libdom>=0.4.2' 'libhubbub=0.3.8'
         libjpeg-turbo 'libnsbmp>=0.1.7' 'libnsgif>=1.0.0' 'libnsutils=0.1.1'
         'libsvgtiny>=0.1.8' 'libutf8proc>=2.9.0' 'libwapcaplet>=0.4.3' libwebp)
makedepends=(check 'nsgenbind>=0.9' perl-html-parser setconf tinyxxd icu69)
source=("$pkgname-$pkgver.tar.gz::https://github.com/xyproto/netsurf/archive/refs/tags/v$pkgver.tar.gz"
        netsurf.sh)
sha256sums=('5672908921f64d0e214273d57c280d0c8a6971acf4a9c617cc979ac1abd78ce5'
            'ad5090704ecfb8e396f76d0c59c821edde4dac8005a1478cff7a70d96b1646b6')
b2sums=('d06b28078c96c3eea0faee96fe0c749644c83e1e7520421223f7d025b77cb778ead2ff75168f862594016b9f84555cac49b60262889efbd8bf10df34247d301a'
        'ca468901b0bb70c86341e7f627b64a40729f995bd485d46f55a74f7efc214fb99558dfe79016e67eeddfdf5ebb10d871d52b36641d193f190a9a82773e2e1079')

prepare() {
  cd $pkgname-$pkgver
  setconf frontends/gtk/res/netsurf-gtk.desktop Exec '/usr/bin/netsurf %u'
  setconf frontends/gtk/res/netsurf-gtk.desktop Icon netsurf.xpm
}

build() {
  make \
    -C $pkgname-$pkgver \
    HOSTNAME=archlinux \
    INCLUDEDIR=include \
    LIBDIR=lib \
    NETSURF_UA_FORMAT_STRING='"Mozilla/5.0 (Arch Linux; %s) NetSurf/%d.%d"' \
    NETSURF_USE_JPEGXL=NO \
    NETSURF_USE_RSVG=NO \
    NETSURF_HOMEPAGE='"https://duckduckgo.com/"' \
    PREFIX=/usr \
    TARGET=gtk4
}

package() {
  make \
    -C $pkgname-$pkgver \
    DESTDIR="$pkgdir" \
    INCLUDEDIR=include \
    LIBDIR=lib \
    PREFIX=/usr \
    TARGET=gtk4 \
    install \
    HOSTNAME=archlinux

  install -Dm755 $pkgname.sh "$pkgdir/usr/bin/$pkgname"
  cd $pkgname-$pkgver
  install -Dm644 frontends/gtk/res/$pkgname.xpm "$pkgdir/usr/share/pixmaps/$pkgname.xpm"
  install -Dm644 frontends/gtk/res/$pkgname-gtk.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
