# Maintainer: Alexander F. Rødseth <xyproto@archlinux.org>

pkgname=netsurfy
pkgver=1.1.3
pkgrel=1
pkgdesc='Lightweight and fast web browser, forked from NetSurf'
arch=(i686 x32)
url='https://github.com/xyproto/netsurfy'
license=(GPL-2.0-only MIT)
depends=(bubblewrap curl expat gtk4 libjpeg-turbo libpng libwebp openssl quickjs-ng zlib)
makedepends=(bison cmake flex ninja perl perl-html-parser)
provides=(netsurf)
conflicts=(netsurf)
replaces=(netsurf)
source=("$pkgname-$pkgver.tar.gz::https://github.com/xyproto/netsurfy/archive/refs/tags/v$pkgver.tar.gz"
        netsurfy-sandbox)
sha256sums=('f0ba6244043802acd661520ef9013de3b99961eddcd6ffe5154e6d97e3e3513e'
            'SKIP')
b2sums=('a9c1afca92f214668bdb8cb829973bcad2cd07e08e3e2462aab0d1cab461325c665de38538780106e8748818b4ce9fbc13cf25833f20c795a3af9550fed93a13'
        'SKIP')

build() {
  cmake -B build -S $pkgname-$pkgver -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=None \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm755 "$pkgdir/usr/bin/$pkgname" "$pkgdir/usr/lib/$pkgname/$pkgname"
  install -Dm755 netsurfy-sandbox "$pkgdir/usr/bin/$pkgname"
  cd $pkgname-$pkgver
  install -Dm644 src/frontends/gtk/res/$pkgname.xpm "$pkgdir/usr/share/pixmaps/$pkgname.xpm"
  install -Dm644 src/frontends/gtk/res/$pkgname.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
