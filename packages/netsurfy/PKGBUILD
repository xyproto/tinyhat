# Maintainer: Alexander F. Rødseth <xyproto@archlinux.org>

pkgname=netsurfy
pkgver=1.0.1
pkgrel=1
pkgdesc='Lightweight and fast web browser, forked from NetSurf'
arch=(i686 x32)
url='https://github.com/xyproto/netsurfy'
license=(GPL-2.0-only MIT)
depends=(curl gtk4 'libcss>=0.9.2.r116' 'libdom>=0.4.2' 'libhubbub=0.3.8'
         libjpeg-turbo 'libnsbmp>=0.1.7' 'libnsgif>=1.0.0' 'libnsutils=0.1.1'
         'libsvgtiny>=0.1.8' 'libutf8proc>=2.9.0' 'libwapcaplet>=0.4.3.r10' libwebp)
makedepends=(check 'nsgenbind>=0.9' perl-html-parser tinyxxd icu69)
provides=(netsurf)
conflicts=(netsurf)
replaces=(netsurf)
source=("$pkgname-$pkgver.tar.gz::https://github.com/xyproto/netsurfy/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('74a53b15c5a8b9c37ddf91c1cf61164eb9d2143ae500d9c23fa5fd0358d7522a')
b2sums=('29f01fc2ba595f1cbab90412645ca48fc9f2f68a30972a53c9be9c65329cd2c29348d80426eba1ee367d226fc5f33edca670d3d1c4b7087efac41460dda08153')

build() {
  make -C $pkgname-$pkgver
}

package() {
  make -C $pkgname-$pkgver DESTDIR="$pkgdir" install
  cd $pkgname-$pkgver
  install -Dm644 frontends/gtk/res/$pkgname.xpm "$pkgdir/usr/share/pixmaps/$pkgname.xpm"
  install -Dm644 frontends/gtk/res/$pkgname.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
