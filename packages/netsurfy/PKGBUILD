# Maintainer: Alexander F. Rødseth <xyproto@archlinux.org>

pkgname=netsurfy
_commit=c7a9776222131e1dbafe8410e8974aaf701cc440
pkgver=1.0.4.r5.gc7a9776
pkgrel=3
pkgdesc='Lightweight and fast web browser, forked from NetSurf'
arch=(i686 x32)
url='https://github.com/xyproto/netsurfy'
license=(GPL-2.0-only MIT)
depends=(bubblewrap curl expat gtk4 libjpeg-turbo libpng libwebp openssl zlib)
makedepends=(bison cmake flex ninja perl perl-html-parser)
provides=(netsurf)
conflicts=(netsurf)
replaces=(netsurf)
source=("$pkgname-$_commit.tar.gz::https://github.com/xyproto/netsurfy/archive/$_commit.tar.gz"
        netsurfy-sandbox
        keys.patch)
sha256sums=('ef281e4e79f2e4b6ee9986a25742e8a1b3c5a425d5c77c19d7f1a479b8cac9b3'
            'SKIP'
            'a9cde2fbc7347657bc9b14dd8521e333abb9d96632638d1935846b15bf4424bf')
b2sums=('b6a56413da0f281220eac3b6838faa31d65a2391aea155c369f0296cf374cb91dd79e795a93ea25f9c0f794ea9ee107abdb26eab4ce80f6343d24c31df91844c'
        'SKIP'
        '3b035716a7116c3d875055a984fe034ccebbd6370b4d3f5cf7377c1f0bf9e32bdd70750491313a974828ecd5e7e1f86d1bbb6111838a975ac61b0ffc945a0e74')

prepare() {
  cd $pkgname-$_commit
  patch -Np1 -i ../keys.patch
}

build() {
  cmake -B build -S $pkgname-$_commit -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=None \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm755 "$pkgdir/usr/bin/$pkgname" "$pkgdir/usr/lib/$pkgname/$pkgname"
  install -Dm755 netsurfy-sandbox "$pkgdir/usr/bin/$pkgname"
  cd $pkgname-$_commit
  install -Dm644 src/frontends/gtk/res/$pkgname.xpm "$pkgdir/usr/share/pixmaps/$pkgname.xpm"
  install -Dm644 src/frontends/gtk/res/$pkgname.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
