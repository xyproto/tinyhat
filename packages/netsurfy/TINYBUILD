set pkgname netsurfy
set pkgver 1.1.6
set pkgrel 1
set pkgdesc 'Lightweight and fast web browser, forked from NetSurf'
set arch i686 x32
set url https://github.com/xyproto/netsurfy
set license GPL-2.0-only MIT
set depends bubblewrap curl expat gtk4 libjpeg-turbo libpng libwebp openssl quickjs-ng zlib
set makedepends bison cmake flex ninja perl
set provides netsurf
set conflicts netsurf
set replaces netsurf
set source "$pkgname-$pkgver.tar.gz::https://github.com/xyproto/netsurfy/archive/refs/tags/v$pkgver.tar.gz" \
    netsurfy-sandbox
set sha256sums 990e78d05a5f058a1f6ad4f6bf04848c095a87021ca259d5259afe201289a2de \
    ea5a5076aca2aa426835ae8ccd3b4afd0359de1052c50f01a20c4ea576fb6763
set b2sums a3c4ccfc9442decfba9415346d6faa9060e3a8ecabf4a5ce5f48d999abb1db1d4179fd0e6bb05fe3faf955f685eefee05f0185039791ea0379c377d95c9f644c \
    02289e48d8faa822a3e80a0bc34be200fbad9235252644339962d86e8fba79ee0481a803aaeec604274c43602f8a88920f1f4fef8931e12ded149e0be277ece1

function build
    cmake -B build -S $pkgname-$pkgver -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=None \
        -DBUILD_TESTING=OFF \
        -DNETSURFY_BUILD_HEADLESS=ON \
        -DNETSURFY_FETCH_QUICKJS=OFF; or return
    cmake --build build; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
    install -Dm755 "$pkgdir/usr/bin/$pkgname" "$pkgdir/usr/lib/$pkgname/$pkgname"; or return
    install -Dm755 netsurfy-sandbox "$pkgdir/usr/bin/$pkgname"; or return
    # netsurfy-headless: the same browser without a window, driven on stdin and stdout (no install rule upstream)
    install -Dm755 build/netsurfy-headless "$pkgdir/usr/bin/netsurfy-headless"; or return
    cd $pkgname-$pkgver; or return
    install -Dm644 src/frontends/gtk/res/$pkgname.xpm "$pkgdir/usr/share/pixmaps/$pkgname.xpm"; or return
    install -Dm644 src/frontends/gtk/res/$pkgname.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"; or return
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
