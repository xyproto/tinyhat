# Only the library: no demos (cairo, glib2, X11) and no documentation package. HarfBuzz is loaded when it is used
# (harfbuzz=dynamic), so freetype2 is built without it, and harfbuzz, which needs freetype2, has no cycle with it
set pkgname freetype2
set pkgver 2.15.0
set pkgrel 1
set pkgdesc 'Font rasterization library'
set arch i686 x32
set url https://www.freetype.org/
set license 'FTL OR GPL-2.0-or-later'
set depends brotli bzip2 glibc libpng zlib
set makedepends meson
set optdepends 'harfbuzz: Improved autohinting'
set provides libfreetype.so
set backup etc/profile.d/freetype2.sh
set source "https://download-mirror.savannah.gnu.org/releases/freetype/freetype-$pkgver.tar.xz" \
    freetype2.sh \
    0001-Enable-table-validation-modules.patch \
    0002-Enable-subpixel-rendering.patch \
    0003-Enable-long-PCF-family-names.patch
set sha256sums 93cd47eb719c325107f2d3cf087d06299e944c3b48a40b55537302304dea1dd5 \
    26474284e7bd08191fea23b97eb1f638dd91b1e15f1f06fbf46799ddfeebf4ff \
    5d8dc169e7f32391497ca29e253548bbe87999e1cebddcef3e87c4be63e8f82a \
    debdf00902ff6beb83be6f88952f5acd92e2c800896b9e8b617de4800dbf4909 \
    8d25c4d40d08eea74ed796224b8a89a4be913c1868b2a169ab46a3d8875c14ff
set flags arch

function prepare
    cd freetype-$pkgver; or return
    patch -Np1 -i ../0001-Enable-table-validation-modules.patch; or return
    patch -Np1 -i ../0002-Enable-subpixel-rendering.patch; or return
    patch -Np1 -i ../0003-Enable-long-PCF-family-names.patch; or return
end

function build
    arch-meson freetype-$pkgver build -D default_library=shared -D error_strings=true -D harfbuzz=dynamic \
        -D hvf=disabled; or return
    meson compile -C build; or return
end

function package
    meson install -C build --destdir="$pkgdir"; or return
    install -Dm644 freetype2.sh -t "$pkgdir/etc/profile.d"; or return
    install -Dm644 freetype-$pkgver/docs/FTL.TXT -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
