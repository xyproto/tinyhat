# Maintainer: Alexander F. Rødseth <xyproto@archlinux.org>

pkgname=tinyhat-play
pkgver=1.3.0
pkgrel=1
pkgdesc="Search for, download and launch homebrew games for classic gaming platforms"
arch=(i686 x32)
url="https://github.com/xyproto/tinyhat-play"
license=(BSD-3-Clause)
depends=(gtk4 curl libglvnd sdl3 libarchive)
makedepends=(fontconfig)
provides=(tinyhat-retro)
conflicts=(tinyhat-retro)
replaces=(tinyhat-retro)
source=("tinyhat-play-$pkgver.tar.gz::https://github.com/xyproto/tinyhat-play/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e0eb136df2492f11f5f6851255a46ff9e3390b0ba476485c97e667d4cf9a1909')

build() {
  make -C tinyhat-play-$pkgver
}

package() {
  make -C tinyhat-play-$pkgver DESTDIR="$pkgdir" PREFIX=/usr install
}
