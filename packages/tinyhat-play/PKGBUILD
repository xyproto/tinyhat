# Maintainer: Alexander F. Rødseth <xyproto@archlinux.org>

pkgname=tinyhat-play
pkgver=1.1.0
pkgrel=1
pkgdesc="Search for, download and launch homebrew games for classic gaming platforms"
arch=(i686 x32)
url="https://github.com/xyproto/tinyhat-play"
license=(BSD-3-Clause)
depends=(gtk4 curl libglvnd)
makedepends=(fontconfig)
source=("tinyhat-play-$pkgver.tar.gz::https://github.com/xyproto/tinyhat-play/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c9ab2952cd487577deb8df661cd7d2fabfc030d38d73225bc66c9c12355e489e')

build() {
  cd tinyhat-play-$pkgver
  cc $CFLAGS $(pkg-config --cflags gtk4 libcurl) -o tinyhat-play main.c $LDFLAGS $(pkg-config --libs gtk4 libcurl)
}

package() {
  cd tinyhat-play-$pkgver
  install -Dm755 tinyhat-play "$pkgdir/usr/bin/tinyhat-play"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
