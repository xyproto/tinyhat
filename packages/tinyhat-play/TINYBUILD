set pkgname tinyhat-play
set pkgver 1.3.5
set pkgrel 1
set pkgdesc 'Search for, download and launch homebrew games for classic gaming platforms'
set arch i686 x32
set url https://github.com/xyproto/tinyhat-play
set nvchecker source=github github=xyproto/tinyhat-play prefix=v use_max_tag=true
set license BSD-3-Clause
set depends gtk4 curl libglvnd sdl3 libarchive
set makedepends fontconfig
set provides tinyhat-retro
set conflicts tinyhat-retro
set replaces tinyhat-retro
set source "tinyhat-play-$pkgver.tar.gz::https://github.com/xyproto/tinyhat-play/archive/refs/tags/v$pkgver.tar.gz"
set sha256sums d8a269bb3511cec49bf732f6fc281e1e008cea3d98bad3896cf20421cfdbba87

function build
    make -C tinyhat-play-$pkgver; or return
end

function package
    make -C tinyhat-play-$pkgver DESTDIR="$pkgdir" PREFIX=/usr install; or return
end
