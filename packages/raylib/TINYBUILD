set pkgname raylib
set pkgver 6.2
set pkgrel 1
set pkgdesc 'raylib 6.0 on SDL3 and OpenGL 2.1'
set arch i686 x32
set url https://www.raylib.com/
set license Zlib
set depends sdl3
set makedepends cmake ninja mesa libglvnd
set source "raylib-$pkgver.tar.gz::https://github.com/raysan5/raylib/archive/refs/tags/$pkgver.tar.gz"
set sha256sums df7a13129b1bec9e73a6962efff170beba310ee6eab8f94cd000b7316b4db5ee

function build
    cmake -S raylib-$pkgver -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DPLATFORM=SDL -DOPENGL_VERSION=2.1 -DBUILD_SHARED_LIBS=ON -DBUILD_EXAMPLES=OFF; or return
    ninja -C build; or return
end

function package
    DESTDIR="$pkgdir" ninja -C build install; or return
    install -Dm644 raylib-$pkgver/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
