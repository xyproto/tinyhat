set pkgname krb5
set pkgver 1.22.2
set -g _pkgvermajor (string replace -r '\.[^.]*$' '' -- $pkgver)
string match -q '*.*' -- $_pkgvermajor; or set _pkgvermajor $pkgver
set pkgrel 2
set pkgdesc 'The Kerberos network authentication system'
set url https://web.mit.edu/kerberos/
set nvchecker source=git git=https://github.com/krb5/krb5.git prefix=krb5- 'include_regex=krb5\-(.*)\-final.*' 'from_pattern=(.*)-final.*' 'to_pattern=\1'
set arch i686 x32
set license custom
# No LDAP database for the KDC (servers only): no libldap, whose libsasl needs krb5
set depends bash e2fsprogs glibc keyutils libverto-module-base openssl lmdb \
    libcom_err.so libkeyutils.so libss.so libverto.so
set makedepends perl
set provides libgssapi_krb5.so libgssrpc.so libk5crypto.so libkadm5clnt_mit.so libkadm5srv_mit.so libkdb5.so \
    libkrad.so libkrb5.so libkrb5support.so
set backup etc/krb5.conf var/lib/krb5kdc/kdc.conf
set options '!emptydirs'
set source "https://web.mit.edu/kerberos/dist/krb5/$_pkgvermajor/$pkgname-$pkgver.tar.gz" \
    krb5-kadmind.service \
    krb5-kdc.service \
    krb5-kpropd.service \
    krb5-kpropd@.service \
    krb5-kpropd.socket \
    krb5-f5bbfa4821cf590a4748f96d0e016bc0485e95c4.patch \
    krb5-5e4e8452328804948d042235bbf58ca457795857.patch
set sha512sums 3237cacfb2019285107991a3211e0d74944c605942ab38a8b4b372703b8f02f5779fa2de80c4e201bd59703d557f37ac346bdc5ea14b986b0a0db23eb422fc6f \
