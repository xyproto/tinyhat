    b137ff0154f9af4891e9e78cec692af47ecfd92ca9ce6e00b40ef137d942ba04e8caf483fc5d464b9559ad4a5c4e75ec57b6eab7fc35181115ca1606c0b316c1 \
    b57bbe55c19c92a04cd3e8ad569adcc5aedd4246075b2e6dbcc363e523853332a3e7650be85098b91e495799f8b728ea550495ab303f46ccd9298a2260120b2f \
    a31ed42e988fed892dd3f1ca1942c3cd4bf391d894c9cebe5e91f52797392261e129727590ae06e2f727bb7b0f8d73a7aa35e8b983d6bad77f22a099091ee944 \
    4e7ae175425e0787a1d5ff959471a88bf5af4cd6e213dc6d4048902fab7547c1186a082370b523f9549f5096acfab1fb03b4839e42bd80dc539130ae4bb3ea55 \
    4323be131122c3d528766b4179d3b49fe98d9f9246a0263d916b7a87c063078544dfc86209fbe83f3675a65187e8cb0733cff23ac1a80795ec5df825da263814 \
    2eba6b1c7e775500d600dec01649cefeef3e36fc200016e2a7228e634394960de5b663be06ec015b4f7e31af916e6d7f3c2a16de3083162660b32d5d3461aae5
set flags arch

function prepare
    cd $pkgname-$pkgver; or return

    # FS#25384
    sed -i "/KRB5ROOT=/s/\/local//" src/util/ac_check_krb5.m4; or return
    patch -Np1 -i "$srcdir/krb5-f5bbfa4821cf590a4748f96d0e016bc0485e95c4.patch"; or return
    patch -Np1 -i "$srcdir/krb5-5e4e8452328804948d042235bbf58ca457795857.patch"; or return
end

function build
    cd $pkgname-$pkgver/src; or return
    set -a CFLAGS -fPIC -fno-strict-aliasing -fstack-protector-all -std=gnu17
    set -lx WARN_CFLAGS ''
    ./configure --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --localstatedir=/var/lib \
        --enable-shared \
        --with-system-et \
        --with-system-ss \
        --disable-rpath \
        --without-tcl \
        --enable-dns-for-realm \
        --without-ldap \
        --with-lmdb \
        --with-system-verto; or return
    make; or return
end

function package
    cd $pkgname-$pkgver/src; or return
    make DESTDIR="$pkgdir" EXAMPLEDIR=/usr/share/doc/$pkgname/examples install; or return

    install -Dpm 644 config-files/krb5.conf -t "$pkgdir/etc"; or return
    install -Dpm 644 config-files/kdc.conf -t "$pkgdir/var/lib/krb5kdc"; or return

    install -Dm 644 util/ac_check_krb5.m4 -t "$pkgdir/usr/share/aclocal"; or return

    install -Dm 644 "$srcdir"/$pkgname-$pkgver/NOTICE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return

    # systemd stuff
    install -Dm 644 "$srcdir"/krb5-{kadmind.service,kdc.service,kpropd.service,kpropd@.service,kpropd.socket} \
        -t "$pkgdir/usr/lib/systemd/system"; or return
end
