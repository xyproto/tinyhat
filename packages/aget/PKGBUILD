pkgname=aget
pkgver=1.4.3
pkgrel=1
pkgdesc="Minimalistic AUR helper"
arch=(i686)
url="https://github.com/xyproto/aget"
license=(BSD-3-Clause)
depends=(git)
makedepends=(go-tinyhat)
options=(!buildflags)
source=("aget-$pkgver.tar.gz::https://github.com/xyproto/aget/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b3ddd6abd2f6d935d26aa8a3c1e14d417be2d0658e8014ea04ace6f3cf1ebeab')

build() {
  cd aget-$pkgver
  export GOROOT=/usr/lib/go-tinyhat GOPATH="$srcdir/gopath" GOCACHE="$srcdir/gocache" GOTOOLCHAIN=local GOFLAGS=-mod=vendor CGO_ENABLED=0 GOARCH=386 GO386=softfloat
  [ "$CARCH" != aarch64 ] || export GOROOT=/usr/lib/go GOARCH=arm64
  [ "$CARCH" != x86_64 ] || export GOROOT=/usr/lib/go GOARCH=amd64
  export PATH="$GOROOT/bin:$PATH"
  go build -trimpath -buildvcs=false -ldflags "-s -w" -o aget
}

package() {
  install -Dm755 aget-$pkgver/aget "$pkgdir/usr/bin/aget"
  install -Dm644 aget-$pkgver/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
