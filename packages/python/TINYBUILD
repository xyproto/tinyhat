set pkgname python
set pkgver 3.14.10
set pkgrel 3
set -g _pybasever (string replace -r '\.[^.]*$' '' -- $pkgver)
set pkgdesc 'The Python programming language'
set arch i686 x32
set url https://www.python.org/
set nvchecker source=git git=https://github.com/python/cpython.git prefix=v 'exclude_regex=.*(a|b|rc).*'
set license PSF-2.0
set depends bzip2 expat gdbm libffi libnsl libxcrypt openssl zlib tzdata mpdecimal zstd sqlite
set provides "python3=$pkgver"
set source "https://www.python.org/ftp/python/$pkgver/Python-$pkgver.tar.xz" python-openssl4.patch python-abi.hook python-abi
set sha512sums 730ea64f7e8815a5e1a4280b1205d77719875de630e6807b3140987b44e7b91215918cf75ed77250cf6feb5de98ff4175555cbba96eaf32564d2f421e723994a \
    a21bd0012f52c4308cbe4ba025054174512d5f8179e995501c29906f0bfad0eb7b53a15467dfd058fe335fcb4400cd694b3b346134eddc58b7470c389a429d2e \
    b2ce2885d82d09fe3264e1a95bb7cf0be4ac953d547cc900bc90efd9feaba68afd814b3fbdcbf44664081c6cc7587491bbff9c88ca95cc9dfe9a7797c241f889 \
    1d000c550a6ebc382b002c971b9905084b02608ba6bf97168754075be42b847127ce3e557c25273577390957a71facc4398ed4f7a8cea3c131fe78950ab7b06b

function prepare
    cd Python-$pkgver; or return
    rm -r Modules/expat Modules/_decimal/libmpdec; or return
    patch -Np1 -i ../python-openssl4.patch; or return
end

function build
    cd Python-$pkgver; or return
    set -l cross
    string match -q -- '*-gcc' $CC; and set cross --with-build-python=python3.14 ac_cv_file__dev_ptmx=yes ac_cv_file__dev_ptc=no
    py_cv_module__tkinter=n/a ./configure --prefix=/usr $cross \
        --enable-shared \
        --with-computed-gotos \
        --enable-ipv6 \
        --with-system-expat \
        --with-dbmliborder=gdbm:ndbm \
        --with-system-libmpdec \
        --enable-loadable-sqlite-extensions \
        --without-ensurepip \
        --with-tzpath=/usr/share/zoneinfo; or return
    make; or return
end

function package
    cd Python-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    ln -s python3 "$pkgdir/usr/bin/python"; or return
    ln -s python3-config "$pkgdir/usr/bin/python-config"; or return
    ln -s pydoc3 "$pkgdir/usr/bin/pydoc"; or return
    ln -s python$_pybasever.1 "$pkgdir/usr/share/man/man1/python.1"; or return
    rm -rf "$pkgdir/usr/lib/python$_pybasever"/{test,idlelib,tkinter,turtledemo,turtle.py}; or return
    set -l lib "$pkgdir/usr/lib/python$_pybasever"
    for f in $lib/_sysconfigdata_*.py $lib/_sysconfig_vars_*.json $lib/config-$_pybasever-*/Makefile
        sed -i "s|$srcdir/Python-$pkgver|.|g" -- $f; or return
    end
    rm -f $lib/__pycache__/_sysconfigdata_*.pyc; or return
    rm -f "$pkgdir"/usr/bin/{idle,idle3,"idle$_pybasever"}; or return
    printf '%s\n' \
        '[externally-managed]' \
        "Error=To install Python packages, create a virtual environment" \
        " with 'python -m venv ~/venv'. Then use ~/venv/bin/python and" \
        ' ~/venv/bin/pip.' \
        '' >"$pkgdir/usr/lib/python$_pybasever/EXTERNALLY-MANAGED"; or return
    install -Dm644 ../python-abi.hook "$pkgdir/usr/share/libalpm/hooks/python-abi.hook"; or return
    install -Dm755 ../python-abi "$pkgdir/usr/share/libalpm/scripts/python-abi"; or return
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
