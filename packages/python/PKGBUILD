pkgname=python
pkgver=3.14.10
pkgrel=2
_pybasever=${pkgver%.*}
pkgdesc="The Python programming language"
arch=(i686 x32)
url="https://www.python.org/"
license=(PSF-2.0)
depends=(bzip2 expat gdbm libffi libnsl libxcrypt openssl zlib tzdata mpdecimal zstd sqlite)
provides=("python3=$pkgver")
source=("https://www.python.org/ftp/python/$pkgver/Python-$pkgver.tar.xz")
sha512sums=('730ea64f7e8815a5e1a4280b1205d77719875de630e6807b3140987b44e7b91215918cf75ed77250cf6feb5de98ff4175555cbba96eaf32564d2f421e723994a')

prepare() {
  cd Python-$pkgver
  rm -r Modules/expat Modules/_decimal/libmpdec
}

build() {
  cd Python-$pkgver
  py_cv_module__tkinter=n/a ./configure --prefix=/usr \
              --enable-shared \
              --with-computed-gotos \
              --enable-ipv6 \
              --with-system-expat \
              --with-dbmliborder=gdbm:ndbm \
              --with-system-libmpdec \
              --enable-loadable-sqlite-extensions \
              --without-ensurepip \
              --with-tzpath=/usr/share/zoneinfo
  make
}

package() {
  cd Python-$pkgver
  make DESTDIR="$pkgdir" install
  ln -s python3 "$pkgdir/usr/bin/python"
  ln -s python3-config "$pkgdir/usr/bin/python-config"
  ln -s pydoc3 "$pkgdir/usr/bin/pydoc"
  ln -s python$_pybasever.1 "$pkgdir/usr/share/man/man1/python.1"
  rm -rf "$pkgdir/usr/lib/python$_pybasever"/{test,idlelib,tkinter,turtledemo,turtle.py}
  rm -f "$pkgdir"/usr/bin/{idle,idle3,"idle$_pybasever"}
  cat >"$pkgdir/usr/lib/python$_pybasever/EXTERNALLY-MANAGED" <<'EOF'
[externally-managed]
Error=To install Python packages system-wide, try 'pacman -S
 python-xyz', where xyz is the package you are trying to
 install.

 If you wish to install a non-Arch-packaged Python package,
 create a virtual environment using 'python -m venv path/to/venv'.
 Then use path/to/venv/bin/python and path/to/venv/bin/pip.

 If you wish to install a non-Arch packaged Python application,
 it may be easiest to use 'pipx install xyz', which will manage a
 virtual environment for you. Make sure you have python-pipx
 installed via pacman.

EOF
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
