function prepare
    cd "$_systemd_src_dir"; or return
    if not git status >/dev/null 2>&1
        return 0
    end
    set -l _c
    set -l _l
    for _c in $_backports
        if string match -q -- '*..*' "$_c"
            set _l --reverse
        else
            set _l '--max-count=1'
        end
        git log --oneline "$_l" "$_c"; or return
        git cherry-pick --mainline 1 --no-commit "$_c"; or return
    end
    for _c in $_reverts
        if string match -q -- '*..*' "$_c"
            set _l --reverse
        else
            set _l '--max-count=1'
        end
        git log --oneline "$_l" "$_c"; or return
        git revert --mainline 1 --no-commit "$_c"; or return
    end
    patch -Np1 -i ../0001-Use-Arch-Linux-device-access-groups.patch; or return
end

function build
    set -l _timeservers (seq -f '%g.arch.pool.ntp.org' 0 3)
    set -l _nameservers '9.9.9.9#dns.quad9.net' '2620:fe::9#dns.quad9.net' '1.1.1.1#cloudflare-dns.com' '2606:4700:4700::1111#cloudflare-dns.com' '8.8.8.8#dns.google' '2001:4860:4860::8888#dns.google'
    set -l _meson_options -Dversion-tag="$_meson_version-arch" -Dvcs-tag=false -Dshared-lib-tag="$_meson_version" -Dmode=release -Dapparmor=disabled -Dbootloader=disabled -Dukify=disabled -Dopenssl=disabled -Dtests=false -Dcoredump=false -Dxenctrl=disabled -Dbpf-framework=disabled -Dima=false -Dinstall-tests=false -Dselinux=disabled -Dsshdprivsepdir=/usr/share/empty.sshd -Dsysupdated=disabled -Dvmlinux-h=disabled -Dcompat-sysv-interfaces=false -Ddbuspolicydir=/usr/share/dbus-1/system.d -Ddefault-dnssec=no -Ddefault-kill-user-processes=false -Ddefault-locale='C.UTF-8' -Dlocalegen-path=/usr/bin/locale-gen -Ddns-over-tls=false -Dfallback-hostname='archlinux' -Dnologin-path=/usr/bin/nologin -Dntp-servers="$_timeservers" -Ddns-servers="$_nameservers" -Drpmmacrosdir=no -Dbashcompletiondir=no -Dsbat-distro='arch' -Dsbat-distro-summary='Arch Linux' -Dsbat-distro-pkgname="$pkgname" -Dsbat-distro-version="$pkgver" -Dsbat-distro-url="https://archlinux.org/packages/core/x86_64/$pkgname/"
    set -l _feature
    for _feature in man seccomp polkit acl audit blkid kmod pam libcrypt libidn2 elfutils zlib bzip2 xz lz4 zstd xkbcommon pcre2 libmount
        set -a _meson_options -D$_feature=enabled
    end
    if not pkg-config --exists libsystemd
        mkdir -p "$srcdir/pc"; or return
        printf '%s\n' 'Name: libsystemd' 'Description: libsystemd, which this build makes' "Version: $pkgver" 'Cflags:' 'Libs:' >"$srcdir/pc/libsystemd.pc"; or return
        set -fx PKG_CONFIG_PATH "$srcdir/pc" $PKG_CONFIG_PATH
    end
    meson setup --prefix /usr --libexecdir lib --sbindir bin --buildtype plain --auto-features disabled --wrap-mode nodownload -D b_lto=true -D b_pie=true -D python.bytecompile=1 "$_systemd_src_dir" build $_meson_options $MESON_EXTRA_CONFIGURE_OPTIONS; or return
    meson compile -C build; or return
end

function package_systemd
    set pkgdesc 'system and service manager'
    set -a license 'CC0-1.0' 'GPL-2.0-or-later' MIT-0
    set depends "systemd-libs=$pkgver" acl bash dbus dbus-units glibc kbd kmod hwdata libxcrypt libidn2 lz4 pam libelf libgcc libseccomp util-linux xz pcre2 audit
    set provides nss-myhostname "systemd-tools=$pkgver" "udev=$pkgver"
    set replaces nss-myhostname systemd-tools udev
    set conflicts nss-myhostname systemd-tools udev
    set backup etc/systemd/homed.conf etc/systemd/journald.conf etc/systemd/journal-remote.conf etc/systemd/journal-upload.conf etc/systemd/logind.conf etc/systemd/networkd.conf etc/systemd/oomd.conf etc/systemd/pstore.conf etc/systemd/resolved.conf etc/systemd/sleep.conf etc/systemd/system.conf etc/systemd/timesyncd.conf etc/systemd/user.conf etc/udev/iocost.conf etc/udev/udev.conf
    set install systemd.install
    meson install -C build --no-rebuild --destdir "$pkgdir" --quiet; or return
    install -d -m0755 systemd-libs/lib/; or return
    mv "$pkgdir"/usr/lib/lib{nss,systemd,udev}*.so* systemd-libs/lib/; or return
    mv "$pkgdir"/usr/lib/pkgconfig systemd-libs/lib/pkgconfig; or return
    mv "$pkgdir"/usr/include systemd-libs/include; or return
    mv "$pkgdir"/usr/share/man/man3 systemd-libs/man3; or return
    install -d -m0755 systemd-libs/man8/; or return
    mv "$pkgdir"/usr/share/man/man8/*nss* systemd-libs/man8/; or return
    rm "$pkgdir"/usr/share/man/man1/init.1; or return
    rm "$pkgdir"/usr/share/man/man8/{halt,poweroff,reboot,shutdown}.8; or return
    rm "$pkgdir"/usr/bin/{halt,init,poweroff,reboot,shutdown}; or return
    rm "$pkgdir"/usr/{bin/resolvconf,share/man/man1/resolvconf.1}; or return
    rm "$pkgdir"/usr/share/factory/etc/{issue,nsswitch.conf}; or return
    sed -i -e '/^C \/etc\/nsswitch\.conf/d' -e '/^C \/etc\/issue/d' "$pkgdir"/usr/lib/tmpfiles.d/etc.conf; or return
    echo 'disable *' >"$pkgdir"/usr/lib/systemd/system-preset/99-default.preset; or return
    install -d -m 2755 "$pkgdir"/var/log/journal; or return
    install -D -m0644 arch.conf "$pkgdir"/usr/share/systemd/bootctl/arch.conf; or return
    install -D -m0644 loader.conf "$pkgdir"/usr/share/systemd/bootctl/loader.conf; or return
    install -D -m0644 splash-arch.bmp "$pkgdir"/usr/share/systemd/bootctl/splash-arch.bmp; or return
    install -D -m0755 systemd-hook "$pkgdir"/usr/share/libalpm/scripts/systemd-hook; or return
    install -D -m0644 -t "$pkgdir"/usr/share/libalpm/hooks *.hook; or return
    install -D -m0644 systemd-user.pam "$pkgdir"/usr/lib/pam.d/systemd-user; or return
    install -d -m0700 "$pkgdir"/etc/cryptsetup-keys.d; or return
    install -d -m0755 "$pkgdir/usr/share/licenses/$pkgbase"; or return
    ln -s -t "$pkgdir/usr/share/licenses/$pkgbase" /usr/share/doc/systemd/LICENSES/MIT-0.txt; or return
    ln -s kernel-install "$pkgdir"/usr/bin/installkernel; or return
    ln -s kernel-install.8.gz "$pkgdir"/usr/share/man/man8/installkernel.8.gz; or return
end

function package_systemd-libs
    set pkgdesc 'systemd client libraries'
    set depends glibc libgcc 'libgcc_s.so' libgcrypt lz4 xz zstd
    set -a license 'CC0-1.0' 'GPL-2.0-or-later WITH Linux-syscall-note'
    set provides libsystemd 'libsystemd.so' 'libudev.so'
    set conflicts libsystemd
    set replaces libsystemd
    install -d -m0755 "$pkgdir"/usr/share/man; or return
    mv systemd-libs/lib "$pkgdir"/usr/lib; or return
    mv systemd-libs/include "$pkgdir"/usr/include; or return
    mv systemd-libs/man3 "$pkgdir"/usr/share/man/man3; or return
    mv systemd-libs/man8 "$pkgdir"/usr/share/man/man8; or return
end

function package_systemd-resolvconf
    set pkgdesc 'systemd resolvconf replacement (for use with systemd-resolved)'
    set depends "systemd=$pkgver"
    set provides openresolv resolvconf
    set conflicts resolvconf
    install -d -m0755 "$pkgdir"/usr/bin; or return
    ln -s resolvectl "$pkgdir"/usr/bin/resolvconf; or return
    install -d -m0755 "$pkgdir"/usr/share/man/man1; or return
    ln -s resolvectl.1.gz "$pkgdir"/usr/share/man/man1/resolvconf.1.gz; or return
end

function package_systemd-sysvcompat
    set pkgdesc 'sysvinit compat for systemd'
    set conflicts sysvinit
    set depends "systemd=$pkgver"
    install -D -m0644 -t "$pkgdir"/usr/share/man/man1 build/man/init.1; or return
    install -D -m0644 -t "$pkgdir"/usr/share/man/man8 build/man/{halt,poweroff,reboot,shutdown}.8; or return
    install -d -m0755 "$pkgdir"/usr/bin; or return
    ln -s ../lib/systemd/systemd "$pkgdir"/usr/bin/init; or return
    for tool in halt poweroff reboot shutdown
        ln -s systemctl "$pkgdir"/usr/bin/$tool; or return
    end
end
