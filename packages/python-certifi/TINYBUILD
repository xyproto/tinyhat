set pkgname python-certifi
set pkgver 2026.10.23
set pkgrel 1
set pkgdesc "Python package for providing Mozilla's CA Bundle (using system CA store)"
set arch any
set url https://github.com/certifi/python-certifi
set nvchecker source=git git=https://github.com/certifi/python-certifi
set license MPL-2.0
set depends ca-certificates python
set makedepends git python-build python-installer python-setuptools python-wheel
set checkdepends python-pytest
set source "git+$url.git#tag=$pkgver"
set sha512sums 7dba3881c5130e5dc67f71f26da3f6459d82bcf03df9604ae7bc0737fd22569a2921aa17397721a1a3fa70023a603e27a1d7fdee5e53879e06f9b83894366842
set b2sums e717de20971f40f0351d1008adb7467a250cae933b123cd94b7e294ffca7cedff4c31e825bc223aac9d0d2f60bbf714efd478ef34d8308a1b668ca94eb1aca49
set flags arch

function prepare
    cd $pkgname; or return
    # Use system CA store. Replacing the copy in the source tree so the test
    # suite is actually run against it.
    ln -sf /etc/ssl/certs/ca-certificates.crt certifi/cacert.pem; or return
    # Our CA store has non-ASCII comments, but we are not packaging for JVM
    # https://github.com/certifi/python-certifi/issues/50
    sed -i 's/encoding="ascii"/encoding="utf-8"/' certifi/core.py; or return
end

function build
    cd $pkgname; or return
    python -m build --wheel --no-isolation; or return
end

function check
    cd $pkgname; or return
    pytest; or return
end

function package
    set -l site_packages (python -c "import site; print(site.getsitepackages()[0])"); or return

    cd $pkgname; or return
    python -m installer --destdir="$pkgdir" dist/*.whl; or return

    # Replace CA store here again because the symlink was installed as a file
    ln -sf /etc/ssl/certs/ca-certificates.crt "$pkgdir/$site_packages/certifi/cacert.pem"; or return

    install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/; or return
end
