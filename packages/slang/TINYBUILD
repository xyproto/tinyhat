set pkgname slang
set pkgver 2.3.3
set pkgrel 4
set pkgdesc 'S-Lang is a powerful interpreted language'
set arch i686 x32
set url https://www.jedsoft.org/slang/
set license GPL-2.0-or-later
set depends glibc zlib
set backup etc/slsh.rc
set flags arch
set source https://www.jedsoft.org/releases/slang/$pkgname-$pkgver.tar.bz2
set sha256sums f9145054ae131973c61208ea82486d5dd10e3c5cdad23b7c4a0617743c8f5a18

function build
    cd $pkgname-$pkgver; or return
    # Without the PNG, PCRE and Oniguruma modules: mc only uses the screen library
    ./configure --prefix=/usr --sysconfdir=/etc --without-png --without-pcre --without-onig; or return
    make; or return
end

function check
    cd $pkgname-$pkgver; or return

    if test $CARCH != i686
        make check; or return
    end
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install-all; or return
end
