+static uint32_t
+doodlepremul(uint32_t rgb, uint32_t a)
+{
+	return a << 24 | ((rgb >> 16 & 0xff) * a / 255) << 16 | ((rgb >> 8 & 0xff) * a / 255) << 8 | (rgb & 0xff) * a / 255;
+}
+
+static uint32_t
+doodlerand(void)
+{
+	doodle.seed ^= doodle.seed << 13;
+	doodle.seed ^= doodle.seed >> 17;
+	doodle.seed ^= doodle.seed << 5;
+	return doodle.seed;
+}
+
+static float
+doodlefrand(void)
+{
+	return (float)(doodlerand() & 0xffff) / 65535.0f;
+}
+
+static void
+doodlestop(void)
+{
+	if (doodle.timer)
+		wl_event_source_timer_update(doodle.timer, 0);
+	if (doodle.node) {
+		wlr_scene_node_destroy(&doodle.node->node);
+		doodle.node = NULL;
+	}
+	doodle.nparts = doodle.npoints = doodle.firstpoint = 0;
+}
+
+static void
+doodlepoint(float x, float y)
+{
+	int i;
+	if (doodle.npoints == FIREPOINTS) {
+		doodle.firstpoint = (doodle.firstpoint + 1) % FIREPOINTS;
+		doodle.npoints--;
+	}
+	i = (doodle.firstpoint + doodle.npoints++) % FIREPOINTS;
+	doodle.strokepoints = MIN(doodle.strokepoints + 1, doodle.npoints);
+	doodle.points[i].x = x;
+	doodle.points[i].y = y;
+	doodle.points[i].age = 0;
+}
+
+static void
+doodlespawn(void)
+{
+	int want = MIN(FIREPARTS / 3, doodle.npoints * 2 / 3 + 1);
+	if (!doodle.npoints)
+		return;
+	if (doodle.nparts + want > FIREPARTS) {
+		int drop = doodle.nparts + want - FIREPARTS;
+		memmove(doodle.part, doodle.part + drop, (size_t)(doodle.nparts - drop) * sizeof(*doodle.part));
+		doodle.nparts -= drop;
+	}
+	while (want-- > 0) {
+		int fresh = doodle.active && doodle.strokepoints > 0 && doodlerand() % 4 != 0;
+		int n = fresh ? MIN(doodle.strokepoints, doodle.npoints) : doodle.npoints;
+		int r = (int)(doodlerand() % n), i = (doodle.firstpoint + doodle.npoints - 1 - r * r / n) % FIREPOINTS;
+		FirePart *p = &doodle.part[doodle.nparts++];
+		float v = doodlefrand();
+		p->x = p->xo = doodle.points[i].x;
+		p->y = doodle.points[i].y;
+		p->life = 1;
+		p->fade = (v * 0.3f + 0.06f) * 0.33f;
+		p->size = 7;
+		p->grow = 2.5f * doodlefrand();
+		p->xi = (doodlefrand() * 20 - 10) * 0.2f;
+		p->yi = (doodlefrand() * 20 - 15) * 0.2f;
+		v = doodlefrand() / 1.7f;
+		p->r = 1 - v;
+		p->g = 0.5f - v * 0.5f;
+		p->b = 0.15f - v * 0.15f;
+	}
+}
+
+static int
+doodletick(void *data)
+{
+	float minx = 1e9f, miny = 1e9f, maxx = -1e9f, maxy = -1e9f, q = 3;
+	int bw, bh, n = 0, again;
+	WallBuffer *b;
+	float *acc;
+
+	again = 0;
+	for (int i = 0; i < doodle.npoints; i++) {
+		int k = (doodle.firstpoint + i) % FIREPOINTS;
+		doodle.points[k].age++;
+	}
+	while (doodle.npoints && doodle.points[doodle.firstpoint].age > 45) {
+		doodle.firstpoint = (doodle.firstpoint + 1) % FIREPOINTS;
+		doodle.npoints--;
+	}
+	doodle.strokepoints = MIN(doodle.strokepoints, doodle.npoints);
+	doodlespawn();
+	for (int i = 0; i < doodle.nparts; i++) {
+		FirePart p = doodle.part[i];
+		p.x += p.xi;
+		p.y += p.yi;
+		p.xi += (p.x < p.xo ? 1.0f : -1.0f) * 0.12f;
+		p.yi -= 0.25f;
+		p.life -= p.fade;
+		if (p.life > 0)
+			doodle.part[n++] = p;
+	}
+	doodle.nparts = n;
+	if (!doodle.nparts && !doodle.npoints) {
+		doodlestop();
+		return 0;
+	}
+	for (int i = 0; i < doodle.nparts; i++) {
+		FirePart *p = &doodle.part[i];
+		float r = p->size * (1 + p->grow * p->life);
+		minx = MIN(minx, p->x - r);
+		miny = MIN(miny, p->y - r);
+		maxx = MAX(maxx, p->x + r);
+		maxy = MAX(maxy, p->y + r);
+	}
+	if (!doodle.nparts) {
+		again = 1;
+		goto rearm;
+	}
+	bw = MAX(1, (int)((maxx - minx) / q) + 1);
+	bh = MAX(1, (int)((maxy - miny) / q) + 1);
+	if ((size_t)bw * bh * 3 > doodle.accsize) {
+		free(doodle.acc);
+		doodle.accsize = (size_t)bw * bh * 3;
+		doodle.acc = ecalloc(doodle.accsize, sizeof(float));
+	}
+	acc = doodle.acc;
+	memset(acc, 0, (size_t)bw * bh * 3 * sizeof(float));
+	for (int i = 0; i < doodle.nparts; i++) {
+		FirePart *p = &doodle.part[i];
+		float r = p->size * (1 + p->grow * p->life) / q, cx = (p->x - minx) / q, cy = (p->y - miny) / q;
+		float a = p->life * 0.35f;
+		int x0 = MAX(0, (int)(cx - r)), x1 = MIN(bw - 1, (int)(cx + r)), y0 = MAX(0, (int)(cy - r)), y1 = MIN(bh - 1, (int)(cy + r));
+		for (int y = y0; y <= y1; y++) {
+			float dy = (y + 0.5f - cy) / r;
+			for (int x = x0; x <= x1; x++) {
+				float dx = (x + 0.5f - cx) / r, d = dx * dx + dy * dy, w;
+				if (d >= 1)
+					continue;
+				w = (1 - d) * (1 - d) * a;
+				acc[(y * bw + x) * 3] += p->r * w;
+				acc[(y * bw + x) * 3 + 1] += p->g * w;
+				acc[(y * bw + x) * 3 + 2] += p->b * w;
+			}
+		}
+	}
+	b = wallbuffer(bw, bh, 0);
+	b->format = DRM_FORMAT_ARGB8888;
+	for (int y = 0; y < bh; y++) {
+		uint32_t *row = (uint32_t *)((char *)b->data + (size_t)y * b->stride);
+		for (int x = 0; x < bw; x++) {
+			float *c = &acc[(y * bw + x) * 3];
+			float r = MIN(1, c[0]), g = MIN(1, c[1]), bl = MIN(1, c[2]), al = MAX(r, MAX(g, bl));
+			row[x] = (uint32_t)(al * 255) << 24 | (uint32_t)(r * 255) << 16 | (uint32_t)(g * 255) << 8 | (uint32_t)(bl * 255);
+		}
+	}
+	if (doodle.node)
+		wlr_scene_node_destroy(&doodle.node->node);
+	doodle.node = wlr_scene_buffer_create(layers[LyrBottom], &b->base);
+	wlr_buffer_drop(&b->base);
+	if (doodle.node) {
+		wlr_scene_node_lower_to_bottom(&doodle.node->node);
+		wlr_scene_buffer_set_dest_size(doodle.node, (int)(bw * q), (int)(bh * q));
+		wlr_scene_node_set_position(&doodle.node->node, (int)minx, (int)miny);
+	}
+	again = 1;
+rearm:
+	if (again)
+		wl_event_source_timer_update(doodle.timer, 33);
+	return 0;
+}
