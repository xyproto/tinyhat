+static void
+doodlefire(void)
+{
+	double dx = cursor->x - doodle.px, dy = cursor->y - doodle.py, len = hypot(dx, dy);
+	int steps = MAX(1, (int)(len / 4));
+	for (int i = 1; i <= steps; i++)
+		doodlepoint((float)(doodle.px + dx * i / steps), (float)(doodle.py + dy * i / steps));
+	doodle.px = cursor->x;
+	doodle.py = cursor->y;
+	if (!doodle.seed)
+		doodle.seed = 0x9e3779b9u ^ (uint32_t)(size_t)&doodle;
+	if (!doodle.timer)
+		doodle.timer = wl_event_loop_add_timer(event_loop, doodletick, NULL);
+	if (!doodle.nparts)
+		wl_event_source_timer_update(doodle.timer, 1);
+}
+
+static void
+doodlespan(uint32_t *row, int w, int x0, int x1, uint32_t c)
+{
+	x0 = MAX(0, x0);
+	x1 = MIN(w, x1);
+	for (int x = x0; x < x1; x++)
+		row[x] = c;
+}
+
+static void
+doodleshape(void)
+{
+	Monitor *m = doodle.m;
+	double s = m->wlr_output->scale;
+	double x0 = MAX(m->m.x, MIN(doodle.x0, cursor->x)), y0 = MAX(m->m.y, MIN(doodle.y0, cursor->y));
+	double x1 = MIN(m->m.x + m->m.width, MAX(doodle.x0, cursor->x)), y1 = MIN(m->m.y + m->m.height, MAX(doodle.y0, cursor->y));
+	int w = (int)((x1 - x0) * s), h = (int)((y1 - y0) * s), lw;
+	uint32_t accent = colors[SchemeSel][ColBg] >> 8, line, fill;
+	WallBuffer *b;
+
+	if (w < 4 || h < 4) {
+		if (doodle.node) {
+			wlr_scene_node_destroy(&doodle.node->node);
+			doodle.node = NULL;
+		}
+		return;
+	}
+	if (doodle.node && w == doodle.lastw && h == doodle.lasth && (int)x0 == doodle.lastx && (int)y0 == doodle.lasty)
+		return;
+	doodle.lastw = w;
+	doodle.lasth = h;
+	doodle.lastx = (int)x0;
+	doodle.lasty = (int)y0;
+	lw = (int)MAX(2, 3 * s);
+	line = doodlepremul(accent, 0xff);
+	fill = doodlepremul(accent, 0x30);
+	b = wallbuffer(w, h, 0);
+	b->format = DRM_FORMAT_ARGB8888;
+	for (int y = 0; y < h; y++) {
+		uint32_t *row = (uint32_t *)((char *)b->data + (size_t)y * b->stride);
+		double yc = y + 0.5;
+		if (doodle.shape == 0) {
+			if (y < lw || y >= h - lw) {
+				doodlespan(row, w, 0, w, line);
+			} else {
+				doodlespan(row, w, 0, lw, line);
+				doodlespan(row, w, lw, w - lw, fill);
+				doodlespan(row, w, w - lw, w, line);
+			}
+		} else if (doodle.shape == 1) {
+			double hw = yc / h * w / 2, t = lw * hypot(w / 2.0, h) / h, l = w / 2.0 - hw, r = w / 2.0 + hw;
+			if (y >= h - lw || r - l <= 2 * t) {
+				doodlespan(row, w, (int)l, (int)ceil(r), line);
+			} else {
+				doodlespan(row, w, (int)l, (int)ceil(l + t), line);
+				doodlespan(row, w, (int)ceil(l + t), (int)(r - t), fill);
+				doodlespan(row, w, (int)(r - t), (int)ceil(r), line);
+			}
+		} else {
+			double rx = MAX(1, w / 2.0 - lw), ry = MAX(1, h / 2.0 - lw), mr = MIN(rx, ry), cx = w / 2.0;
+			double dy = (yc - h / 2.0) / ry, dout = 1 + lw / mr, din = 1 - lw / mr, xo, xi;
+			if (dy * dy >= dout * dout)
+				continue;
+			xo = rx * sqrt(dout * dout - dy * dy);
+			xi = din > 0 && dy * dy < din * din ? rx * sqrt(din * din - dy * dy) : 0;
+			if (xi > 0) {
+				doodlespan(row, w, (int)(cx - xo), (int)ceil(cx - xi), line);
+				doodlespan(row, w, (int)ceil(cx - xi), (int)(cx + xi), fill);
+				doodlespan(row, w, (int)(cx + xi), (int)ceil(cx + xo), line);
+			} else {
+				doodlespan(row, w, (int)(cx - xo), (int)ceil(cx + xo), line);
+			}
+		}
+	}
+	if (doodle.node)
+		wlr_scene_node_destroy(&doodle.node->node);
+	doodle.node = wlr_scene_buffer_create(layers[LyrBottom], &b->base);
+	wlr_buffer_drop(&b->base);
+	if (!doodle.node)
+		return;
+	wlr_scene_node_lower_to_bottom(&doodle.node->node);
+	wlr_scene_buffer_set_dest_size(doodle.node, (int)(x1 - x0), (int)(y1 - y0));
+	wlr_scene_node_set_position(&doodle.node->node, (int)x0, (int)y0);
+}
+
+static int
+doodleshapetick(void *data)
+{
+	doodle.shapepending = 0;
+	if (doodle.active && doodle.shape != 3)
+		doodleshape();
+	return 0;
+}
+
+static void
+doodledraw(void)
+{
+	if (doodle.shape == 3) {
+		doodlefire();
+		return;
+	}
+	if (!doodle.shapetimer)
+		doodle.shapetimer = wl_event_loop_add_timer(event_loop, doodleshapetick, NULL);
+	if (!doodle.shapepending) {
+		doodle.shapepending = 1;
+		wl_event_source_timer_update(doodle.shapetimer, 16);
+	}
+}
+
+static void
+doodleend(void)
+{
+	if (!doodle.active)
+		return;
+	doodle.active = 0;
+	if (doodle.shape == 3) {
+		doodle.count++;
+		return;
+	}
+	if (doodle.shapetimer)
+		wl_event_source_timer_update(doodle.shapetimer, 0);
+	doodle.shapepending = 0;
+	if (doodle.node) {
+		wlr_scene_node_destroy(&doodle.node->node);
+		doodle.node = NULL;
+		doodle.count++;
+	}
+}
