+/* Whether there is nothing but the background under (x, y) */
+int
+ondesktop(double x, double y)
+{
+	int layer;
+
+	for (layer = NUM_LAYERS - 1; layer > LyrBg; layer--)
+		if (wlr_scene_node_at(&layers[layer]->node, x, y, NULL, NULL))
+			return 0;
+	return 1;
