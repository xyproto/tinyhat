+static void
+confload(int applywall)
+{
+	char user[PATH_MAX], err[256] = "";
+	const char *bad = NULL;
+	Conf c, old;
+	int sys, usr;
+
+	confunset(&c);
+	confpath(user, sizeof(user), "/tinyhat/dwl.toml");
+	sys = !access(SYSCONFDIR "/tinyhat/dwl.toml", F_OK);
+	usr = !access(user, F_OK);
+	if ((sys && !confparse(&c, SYSCONFDIR "/tinyhat/dwl.toml", err, sizeof(err)) && (bad = SYSCONFDIR "/tinyhat/dwl.toml"))
+			|| (usr && !confparse(&c, user, err, sizeof(err)) && (bad = user))) {
+		const char *home = getenv("HOME");
+		size_t hl = home ? strlen(home) : 0;
+		conffree(&c);
+		if (hl && !strncmp(bad, home, hl) && bad[hl] == '/')
+			snprintf(notice, sizeof(notice), "~%s: %s", bad + hl, err);
+		else
+			snprintf(notice, sizeof(notice), "%s: %s", bad, err);
+		if (event_loop)
+			drawbars();
+		else
+			fprintf(stderr, "%s\n", notice);
+		return;
+	}
+	old = conf;
+	conf = c;
+	confloaded = sys || usr;
+	confsettings(&old);
+	conffree(&old);
+	for (int i = 0; i < conf.n; i++)
+		if (conf.keys[i].cmd && conf.keys[i].key.func == spawn)
+			memcpy(&conf.keys[i].key, &(Key){ conf.keys[i].key.mod, conf.keys[i].key.keysym, spawn,
+					{ .v = (conf.keys[i].argv[0] = "/bin/sh", conf.keys[i].argv[1] = "-c",
+						conf.keys[i].argv[2] = conf.keys[i].cmd, conf.keys[i].argv[3] = NULL, conf.keys[i].argv) } },
+					sizeof(Key));
+	for (int i = 0; i < conf.nlaunch; i++)
