+static void
+confunset(Conf *c)
+{
+	memset(c, 0, sizeof(*c));
+	c->layout = c->nmaster = c->border = c->gap = c->sloppy = c->showbar = c->topbar = -1;
+	c->rate = c->delay = c->maccel = c->mnatural = c->lefthanded = c->tap = c->tnatural = c->dwt = -1;
+	c->mfact = c->mspeed = c->tspeed = NAN;
+}
+
+static void
+conffree(Conf *c)
+{
+	for (int i = 0; i < c->n; i++) {
+		free(c->keys[i].cmd);
+		free(c->keys[i].desktop);
+		free(c->keys[i].hotkey);
+		free(c->keys[i].shown);
+		free(c->keys[i].description);
+	}
+	free(c->keys);
+	for (int i = 0; i < c->nlaunch; i++) {
+		free(c->launch[i].desktop);
+		free(c->launch[i].icon);
+		if (c->launch[i].img)
+			pixman_image_unref(c->launch[i].img);
+	}
+	for (int i = 0; i < c->nrules; i++) {
+		free(c->rules[i].appid);
+		free(c->rules[i].title);
+	}
+	free(c->rules);
+	free(c->kblayout);
+	free(c->kbvariant);
+	free(c->kboptions);
+	free(c->title);
+	free(c->footer);
+	for (int i = 0; i < c->nbgs; i++) {
+		free(c->bgs[i].wallpaper);
+		free(c->bgs[i].mode);
+	}
+	free(c->bgs);
+	confunset(c);
+}
+
+static char *
+tomlstr(toml_datum_t t, const char *key)
+{
+	toml_datum_t d = toml_get(t, key);
+	return d.type == TOML_STRING ? strdup(d.u.s) : NULL;
+}
+
+static void
+confreplace(char **dst, toml_datum_t t, const char *key)
+{
+	toml_datum_t d = toml_seek(t, key);
+	if (d.type == TOML_STRING) {
+		free(*dst);
+		*dst = strdup(d.u.s);
+	}
+}
+
+static void
+confint(int *dst, toml_datum_t t, const char *key)
+{
+	toml_datum_t d = toml_seek(t, key);
+	if (d.type == TOML_INT64)
+		*dst = (int)d.u.int64;
+	else if (d.type == TOML_BOOLEAN)
+		*dst = d.u.boolean;
+}
+
+static void
+confnum(double *dst, toml_datum_t t, const char *key)
+{
+	toml_datum_t d = toml_seek(t, key);
+	if (d.type == TOML_FP64)
+		*dst = d.u.fp64;
+	else if (d.type == TOML_INT64)
+		*dst = (double)d.u.int64;
+}
+
+static int
+confchoice(int *dst, toml_datum_t t, const char *key, const char *a, const char *b, char *err, size_t errlen)
+{
+	toml_datum_t d = toml_seek(t, key);
+	if (d.type == TOML_UNKNOWN)
+		return 1;
+	if (d.type == TOML_STRING && (!strcmp(d.u.s, a) || !strcmp(d.u.s, b))) {
+		*dst = !strcmp(d.u.s, b);
+		return 1;
+	}
+	snprintf(err, errlen, "line %d: %s must be \"%s\" or \"%s\"", d.lineno, key, a, b);
+	return 0;
+}
+
+static int
+confhotkey(const char *spec, uint32_t *mod, xkb_keysym_t *sym)
+{
+	char buf[128], *tok, *save = NULL, *last = NULL;
+	snprintf(buf, sizeof(buf), "%s", spec);
+	*mod = 0;
+	for (tok = strtok_r(buf, "+", &save); tok; tok = strtok_r(NULL, "+", &save)) {
+		if (last) {
+			if (!strcasecmp(last, "Ctrl") || !strcasecmp(last, "Control"))
+				*mod |= WLR_MODIFIER_CTRL;
+			else if (!strcasecmp(last, "Alt"))
+				*mod |= WLR_MODIFIER_ALT;
+			else if (!strcasecmp(last, "Shift"))
+				*mod |= WLR_MODIFIER_SHIFT;
+			else if (!strcasecmp(last, "Win") || !strcasecmp(last, "Super") || !strcasecmp(last, "Logo"))
+				*mod |= WLR_MODIFIER_LOGO;
+			else if (!strcasecmp(last, "AltGr"))
+				*mod |= WLR_MODIFIER_MOD5;
+			else
+				return 0;
+		}
+		last = tok;
+	}
+	if (!last)
+		return 0;
+	if (!strcasecmp(last, "Enter"))
+		last = "Return";
+	else if (!strcasecmp(last, "Esc"))
+		last = "Escape";
+	else if (!strcasecmp(last, "Del"))
+		last = "Delete";
+	else if (!strcasecmp(last, "PgUp"))
+		last = "Prior";
+	else if (!strcasecmp(last, "PgDn"))
+		last = "Next";
+	if (!(*sym = xkb_keysym_from_name(last, XKB_KEYSYM_NO_FLAGS)))
+		*sym = xkb_keysym_from_name(last, XKB_KEYSYM_CASE_INSENSITIVE);
+	*sym = xkb_keysym_to_lower(*sym);
+	return *sym != XKB_KEY_NoSymbol;
+}
+
+static void
+spawndesktop(const Arg *arg)
+{
+	const char *name = arg->v, *dirs = getenv("XDG_DATA_DIRS"), *home = getenv("XDG_DATA_HOME");
+	char path[PATH_MAX], line[1024], cmd[1024] = "", list[PATH_MAX * 4];
+	FILE *f = NULL;
+	int section = 0;
+
+	if (home && *home)
+		snprintf(list, sizeof(list), "%s:%s", home, dirs && *dirs ? dirs : "/usr/local/share:/usr/share");
+	else
+		snprintf(list, sizeof(list), "%s/.local/share:%s", getenv("HOME") ? getenv("HOME") : "",
+				dirs && *dirs ? dirs : "/usr/local/share:/usr/share");
+	for (char *save = NULL, *d = strtok_r(list, ":", &save); d && !f; d = strtok_r(NULL, ":", &save)) {
+		snprintf(path, sizeof(path), "%s/applications/%s", d, name);
+		f = fopen(path, "r");
+	}
+	if (!f) {
+		snprintf(notice, sizeof(notice), "dwl.toml: %s not found", name);
+		drawbars();
+		return;
+	}
+	while (fgets(line, sizeof(line), f)) {
+		line[strcspn(line, "\r\n")] = '\0';
+		if (line[0] == '[')
+			section = !strcmp(line, "[Desktop Entry]");
+		else if (section && !strncmp(line, "Exec=", 5)) {
+			size_t o = 0;
+			for (const char *s = line + 5; *s && o + 1 < sizeof(cmd); s++) {
+				if (*s == '%' && s[1]) {
+					if (s[1] == '%')
+						cmd[o++] = '%';
+					s++;
+				} else {
+					cmd[o++] = *s;
+				}
+			}
+			cmd[o] = '\0';
+			break;
+		}
+	}
+	fclose(f);
+	if (cmd[0])
+		spawn(&(Arg){ .v = (const char *[]){ "/bin/sh", "-c", cmd, NULL } });
+}
+
+static int
+confentry(ConfKey *k, toml_datum_t t, char *err, size_t errlen)
+{
+	toml_datum_t sep = toml_get(t, "separator"), act = toml_get(t, "action"), arg = toml_get(t, "arg");
+	void (*func)(const Arg *) = NULL;
+	Arg a = { 0 };
+	uint32_t mod = 0;
+	xkb_keysym_t sym = XKB_KEY_NoSymbol;
+
+	memset(k, 0, sizeof(*k));
+	if (sep.type == TOML_BOOLEAN && sep.u.boolean) {
+		k->separator = 1;
+		return 1;
+	}
+	k->hotkey = tomlstr(t, "hotkey");
+	k->shown = tomlstr(t, "shown");
+	k->description = tomlstr(t, "description");
+	k->cmd = tomlstr(t, "run");
+	k->desktop = tomlstr(t, "desktop");
+	if (k->hotkey && !confhotkey(k->hotkey, &mod, &sym)) {
+		snprintf(err, errlen, "line %d: unknown hotkey \"%s\"", t.lineno, k->hotkey);
+		return 0;
+	}
+	if (act.type == TOML_STRING) {
+		size_t i;
+		for (i = 0; i < LENGTH(confactions) && strcmp(confactions[i].name, act.u.s); i++);
+		if (i == LENGTH(confactions)) {
+			snprintf(err, errlen, "line %d: unknown action \"%s\"", t.lineno, act.u.s);
+			return 0;
+		}
+		func = confactions[i].func;
+		switch (confactions[i].type) {
+		case 'i':
+			a.i = arg.type == TOML_INT64 ? (int)arg.u.int64 : 1;
+			break;
+		case 'u':
+			a.ui = arg.type == TOML_INT64 ? (uint32_t)arg.u.int64 : 1;
+			break;
+		case 'f':
+			a.f = arg.type == TOML_FP64 ? (float)arg.u.fp64 : arg.type == TOML_INT64 ? (float)arg.u.int64 : 0.05f;
+			break;
+		case 't':
+			if (arg.type == TOML_INT64)
+				a.ui = arg.u.int64 <= 0 ? ~0u : 1u << (arg.u.int64 - 1);
+			break;
+		case 'l':
+			if (arg.type == TOML_STRING)
+				a.v = !strcmp(arg.u.s, "float") ? &layouts[0] : &layouts[LENGTH(layouts) - 1];
+			break;
+		case 'd':
+			a.i = arg.type == TOML_STRING && !strcmp(arg.u.s, "left") ? WLR_DIRECTION_LEFT : WLR_DIRECTION_RIGHT;
+			break;
+		}
+	} else if (k->cmd && *k->cmd) {
+		func = spawn;
+		k->argv[0] = "/bin/sh";
+		k->argv[1] = "-c";
+		k->argv[2] = k->cmd;
+		a.v = k->argv;
+	} else if (k->desktop && *k->desktop) {
+		func = spawndesktop;
+		a.v = k->desktop;
+	}
+	if (k->hotkey) {
+		k->bound = func != NULL;
+		k->removed = func == NULL;
+		memcpy(&k->key, &(Key){ mod, sym, func, a }, sizeof(Key));
+	} else if (func) {
+		snprintf(err, errlen, "line %d: an entry with an action needs a hotkey", t.lineno);
+		return 0;
+	}
+	return 1;
+}
+
+static int
+confsame(const ConfKey *a, const ConfKey *b)
+{
+	if (a->hotkey && b->hotkey)
+		return a->key.mod == b->key.mod && a->key.keysym == b->key.keysym;
+	if (!a->hotkey && !b->hotkey && a->shown && b->shown)
+		return !strcmp(a->shown, b->shown);
+	return 0;
+}
+
+static int
+confparse(Conf *c, const char *path, char *err, size_t errlen)
+{
+	toml_result_t r;
+	toml_datum_t list;
+	FILE *f;
+
+	if (!(f = fopen(path, "r")))
+		return 1;
+	r = toml_parse_file_named(f, path);
+	fclose(f);
+	if (!r.ok) {
+		snprintf(err, errlen, "%s", r.errmsg);
+		toml_free(r);
+		return 0;
+	}
+	confreplace(&c->title, r.toptab, "title");
+	confreplace(&c->footer, r.toptab, "help_footer");
+	list = toml_get(r.toptab, "background");
+	if (list.type == TOML_ARRAY) {
+		for (int i = 0; i < c->nbgs; i++) {
+			free(c->bgs[i].wallpaper);
+			free(c->bgs[i].mode);
+		}
+		free(c->bgs);
+		c->bgs = NULL;
+		c->nbgs = 0;
+		for (int i = 0; i < list.u.arr.size; i++) {
+			toml_datum_t t = list.u.arr.elem[i], col, help;
+			Background *b;
+			if (t.type != TOML_TABLE)
+				continue;
+			c->bgs = realloc(c->bgs, (c->nbgs + 1) * sizeof(*c->bgs));
+			b = &c->bgs[c->nbgs++];
+			b->wallpaper = tomlstr(t, "wallpaper");
+			b->mode = tomlstr(t, "mode");
+			col = toml_get(t, "color");
+			help = toml_get(t, "help");
+			b->color = col.type == TOML_STRING ? (uint32_t)strtoul(col.u.s + (col.u.s[0] == '#'), NULL, 16) & 0xffffff
+				: (uint32_t)(rootcolor[0] * 255) << 16 | (uint32_t)(rootcolor[1] * 255) << 8 | (uint32_t)(rootcolor[2] * 255);
+			b->help = help.type == TOML_BOOLEAN && help.u.boolean;
+		}
+	}
+	if (!confchoice(&c->layout, r.toptab, "windows.layout", "float", "tile", err, errlen)
+			|| !confchoice(&c->topbar, r.toptab, "bar.position", "bottom", "top", err, errlen)) {
+		toml_free(r);
+		return 0;
+	}
+	confnum(&c->mfact, r.toptab, "windows.master_size");
+	confint(&c->nmaster, r.toptab, "windows.master_count");
+	confint(&c->border, r.toptab, "windows.border");
+	confint(&c->gap, r.toptab, "windows.gap");
+	confint(&c->sloppy, r.toptab, "windows.focus_follows_mouse");
+	confint(&c->showbar, r.toptab, "bar.show");
+	confreplace(&c->kblayout, r.toptab, "keyboard.layout");
+	confreplace(&c->kbvariant, r.toptab, "keyboard.variant");
+	confreplace(&c->kboptions, r.toptab, "keyboard.options");
+	confint(&c->rate, r.toptab, "keyboard.repeat_rate");
+	confint(&c->delay, r.toptab, "keyboard.repeat_delay");
+	confnum(&c->mspeed, r.toptab, "mouse.speed");
+	confint(&c->maccel, r.toptab, "mouse.acceleration");
+	confint(&c->mnatural, r.toptab, "mouse.natural_scrolling");
+	confint(&c->lefthanded, r.toptab, "mouse.left_handed");
+	confnum(&c->tspeed, r.toptab, "touchpad.speed");
+	confint(&c->tap, r.toptab, "touchpad.tap_to_click");
+	confint(&c->tnatural, r.toptab, "touchpad.natural_scrolling");
+	confint(&c->dwt, r.toptab, "touchpad.disable_while_typing");
+	list = toml_get(r.toptab, "rule");
+	for (int i = 0; list.type == TOML_ARRAY && i < list.u.arr.size; i++) {
+		toml_datum_t t = list.u.arr.elem[i], fl, dk;
+		ConfRule *nr;
+		if (t.type != TOML_TABLE)
+			continue;
+		c->rules = realloc(c->rules, (c->nrules + 1) * sizeof(*c->rules));
+		nr = &c->rules[c->nrules++];
+		nr->appid = tomlstr(t, "app_id");
+		nr->title = tomlstr(t, "title");
+		fl = toml_get(t, "float");
+		dk = toml_get(t, "desktop");
+		nr->isfloating = fl.type == TOML_BOOLEAN ? fl.u.boolean : 0;
+		nr->tags = dk.type == TOML_INT64 && dk.u.int64 > 0 ? 1u << (dk.u.int64 - 1) : 0;
+	}
+	list = toml_get(r.toptab, "launcher");
+	if (list.type == TOML_ARRAY) {
+		for (int i = 0; i < c->nlaunch; i++) {
+			free(c->launch[i].desktop);
+			free(c->launch[i].icon);
+		}
+		c->nlaunch = 0;
+		for (int i = 0; i < list.u.arr.size; i++) {
+			toml_datum_t t = list.u.arr.elem[i];
+			char *desktop = t.type == TOML_TABLE ? tomlstr(t, "desktop") : NULL;
+			if (!desktop) {
+				snprintf(err, errlen, "line %d: a [[launcher]] needs a desktop file", t.lineno);
+				toml_free(r);
+				return 0;
+			}
+			if (c->nlaunch == LENGTH(c->launch)) {
+				free(desktop);
+				continue;
+			}
+			c->launch[c->nlaunch].desktop = desktop;
+			c->launch[c->nlaunch++].icon = tomlstr(t, "icon");
+		}
+	}
+	list = toml_get(r.toptab, "key");
+	for (int i = 0; list.type == TOML_ARRAY && i < list.u.arr.size; i++) {
+		ConfKey k;
+		int j;
+		if (list.u.arr.elem[i].type != TOML_TABLE || !confentry(&k, list.u.arr.elem[i], err, errlen)) {
+			if (!err[0])
+				snprintf(err, errlen, "line %d: [[key]] must be a table", list.u.arr.elem[i].lineno);
+			toml_free(r);
+			return 0;
+		}
+		for (j = 0; !k.separator && j < c->n && !(!c->keys[j].removed && confsame(&c->keys[j], &k)); j++);
+		if (!k.separator && j < c->n) {
+			ConfKey *old = &c->keys[j];
+			free(old->cmd);
+			free(old->desktop);
+			free(old->hotkey);
+			free(old->shown);
+			free(old->description);
+			memcpy(old, &k, sizeof(k));
+			if (!k.hotkey && (!k.description || !*k.description))
+				old->removed = 1;
+			continue;
+		}
+		c->keys = realloc(c->keys, (c->n + 1) * sizeof(*c->keys));
+		memcpy(&c->keys[c->n++], &k, sizeof(k));
+	}
+	toml_free(r);
+	return 1;
+}
+
+static void
+confhelp(void)
+{
+	size_t len = 0, cap = 4096;
+	int described = 0;
+	char *b = malloc(cap);
+
+	free(helptextbuf);
+	helptextbuf = NULL;
+	if (!b)
+		return;
+	b[0] = '\0';
+#define APPEND(...) do { \
+		int need = snprintf(NULL, 0, __VA_ARGS__); \
+		while (len + need + 1 > cap) \
+			b = realloc(b, cap *= 2); \
+		len += sprintf(b + len, __VA_ARGS__); \
+	} while (0)
+	if (conf.title)
+		APPEND("%s\n", conf.title);
+	for (int i = 0; i < conf.n; i++) {
+		ConfKey *k = &conf.keys[i];
+		if (k->removed)
+			continue;
+		if (k->separator)
+			APPEND("\n");
+		else if (k->description && *k->description) {
+			APPEND("%s\t%s\n", k->shown ? k->shown : k->hotkey ? k->hotkey : "", k->description);
+			described = 1;
+		}
+	}
+	if (conf.footer)
+		APPEND("%s%s", conf.footer, len && conf.footer[0] && conf.footer[strlen(conf.footer) - 1] != '\n' ? "\n" : "");
+#undef APPEND
+	if (described)
+		helptextbuf = b;
+	else
+		free(b);
+}
+
+static void
+bgstate(char *path, size_t len)
+{
+	const char *state = getenv("XDG_STATE_HOME"), *home = getenv("HOME");
+	if (state && *state)
+		snprintf(path, len, "%s/tinyhat/background", state);
+	else
+		snprintf(path, len, "%s/.local/state/tinyhat/background", home ? home : "");
+}
+
+static void
+bgapply(void)
+{
+	Background *b;
+	if (!conf.nbgs)
+		return;
+	bgindex = (bgindex % conf.nbgs + conf.nbgs) % conf.nbgs;
+	b = &conf.bgs[bgindex];
+	wallrgb = b->color;
+	if (b->wallpaper && *b->wallpaper) {
+		snprintf(wallmode, sizeof(wallmode), "%s", b->mode && *b->mode ? b->mode : "fill");
+		snprintf(wallpath, sizeof(wallpath), "%s", b->wallpaper);
+	} else {
+		wallmode[0] = wallpath[0] = '\0';
+	}
+	snprintf(helppath, sizeof(helppath), "%s", b->help ? "on" : "");
+}
+
+static void
+nextbackground(const Arg *arg)
+{
+	char path[PATH_MAX], dir[PATH_MAX];
+	FILE *f;
+	if (!conf.nbgs)
+		return;
+	bgindex++;
+	bgapply();
+	bgstate(path, sizeof(path));
+	snprintf(dir, sizeof(dir), "%s", path);
+	for (char *s = dir + 1; (s = strchr(s, '/')); s++) {
+		*s = '\0';
+		mkdir(dir, 0755);
+		*s = '/';
+	}
+	if ((f = fopen(path, "w"))) {
+		fprintf(f, "%d\n", bgindex);
+		fclose(f);
+	}
+	wallupdate();
+}
+
+static void
+confpath(char *path, size_t len, const char *rel)
+{
+	const char *xdg = getenv("XDG_CONFIG_HOME"), *home = getenv("HOME");
+	if (xdg && *xdg)
+		snprintf(path, len, "%s%s", xdg, rel);
+	else
+		snprintf(path, len, "%s/.config%s", home ? home : "", rel);
+}
+
+static int
+confkeymap(struct xkb_rule_names *names, char *buf, size_t len)
+{
+	char path[PATH_MAX], user[PATH_MAX], *variant;
+	const char *home = getenv("HOME");
+	struct stat kst, ust;
+	FILE *f;
+
+	*names = xkb_rules;
+	if (conf.kblayout && *conf.kblayout)
+		names->layout = conf.kblayout;
+	if (conf.kbvariant && *conf.kbvariant)
+		names->variant = conf.kbvariant;
+	if (conf.kboptions && *conf.kboptions)
+		names->options = conf.kboptions;
+	snprintf(path, sizeof(path), "%s/.config/tinyhat/keyboard", home ? home : "");
+	confpath(user, sizeof(user), "/tinyhat/dwl.toml");
+	if (stat(path, &kst) || (conf.kblayout && *conf.kblayout && !stat(user, &ust) && ust.st_mtime > kst.st_mtime) || !(f = fopen(path, "r")))
+		return 0;
+	if (!fgets(buf, (int)len, f))
+		buf[0] = '\0';
+	fclose(f);
+	buf[strcspn(buf, "\r\n")] = '\0';
+	if (!buf[0])
+		return 0;
+	names->variant = NULL;
+	if ((variant = strchr(buf, ' '))) {
+		*variant++ = '\0';
+		names->variant = variant;
+	}
+	names->layout = buf;
+	return 1;
+}
