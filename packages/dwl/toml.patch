+static void
+confsettings(const Conf *old)
+{
+	unsigned int oldborder = borderpx;
+	int barchanged, winchanged, kbchanged;
+	Monitor *m;
+	Client *c;
+	PointerDev *p;
+
+	sloppyfocus = conf.sloppy >= 0 ? conf.sloppy : confdef.sloppy;
+	borderpx = conf.border >= 0 ? (unsigned int)conf.border : (unsigned int)confdef.border;
+	gappx = conf.gap >= 0 ? (unsigned int)conf.gap : (unsigned int)confdef.gap;
+	barchanged = showbar != (conf.showbar >= 0 ? conf.showbar : confdef.showbar)
+		|| topbar != (conf.topbar >= 0 ? conf.topbar : confdef.topbar);
+	showbar = conf.showbar >= 0 ? conf.showbar : confdef.showbar;
+	topbar = conf.topbar >= 0 ? conf.topbar : confdef.topbar;
+	kbchanged = repeat_rate != (conf.rate >= 0 ? conf.rate : confdef.rate)
+		|| repeat_delay != (conf.delay >= 0 ? conf.delay : confdef.delay);
+	repeat_rate = conf.rate >= 0 ? conf.rate : confdef.rate;
+	repeat_delay = conf.delay >= 0 ? conf.delay : confdef.delay;
+	if (!kb_group)
+		return;
+	winchanged = old->layout != conf.layout || old->nmaster != conf.nmaster
+		|| (isnan(old->mfact) ? !isnan(conf.mfact) : old->mfact != conf.mfact);
+	wl_list_for_each(m, &mons, link) {
+		if (winchanged)
+			confmon(m);
+		if (barchanged)
+			wlr_scene_node_set_enabled(&m->scene_buffer->node, m->wlr_output->enabled ? showbar : 0);
+	}
+	if (oldborder != borderpx)
+		wl_list_for_each(c, &clients, link)
+			if (c->bw == oldborder)
+				c->bw = borderpx;
+	wl_list_for_each(m, &mons, link) {
+		arrangelayers(m);
+		arrange(m);
+	}
+	if (kbchanged)
+		wlr_keyboard_set_repeat_info(&kb_group->wlr_group->keyboard, repeat_rate, repeat_delay);
+	reloadkeymap(0, NULL);
+	wl_list_for_each(p, &pointerdevs, link)
+		configpointer(p->device);
+}
