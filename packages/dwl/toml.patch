+static void
+confmon(Monitor *m)
+{
+	if (conf.layout >= 0) {
+		m->lt[0] = &layouts[conf.layout ? LENGTH(layouts) - 1 : 0];
+		m->lt[1] = &layouts[conf.layout ? 0 : LENGTH(layouts) - 1];
+		m->sellt = 0;
+		strncpy(m->ltsymbol, m->lt[0]->symbol, sizeof(m->ltsymbol) - 1);
+	}
+	if (!isnan(conf.mfact))
+		m->mfact = (float)MAX(0.05, MIN(0.95, conf.mfact));
+	if (conf.nmaster >= 0)
+		m->nmaster = conf.nmaster;
+}
