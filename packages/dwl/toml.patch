+static void
+confwatch(void)
+{
+	char dir[PATH_MAX];
+	if (conffd < 0)
+		return;
+	inotify_add_watch(conffd, SYSCONFDIR "/tinyhat", IN_CLOSE_WRITE | IN_MOVED_TO | IN_DELETE | IN_CREATE);
+	confpath(dir, sizeof(dir), "");
+	inotify_add_watch(conffd, dir, IN_CREATE | IN_MOVED_TO | IN_ONLYDIR);
+	confpath(dir, sizeof(dir), "/tinyhat");
+	inotify_add_watch(conffd, dir, IN_CLOSE_WRITE | IN_MOVED_TO | IN_DELETE | IN_CREATE | IN_ONLYDIR);
+}
+
+static int
+confin(int fd, unsigned int mask, void *data)
+{
+	char buf[4096] __attribute__((aligned(__alignof__(struct inotify_event))));
+	ssize_t n;
+	int reload = 0;
+
+	while ((n = read(fd, buf, sizeof(buf))) > 0) {
+		for (char *p = buf; p < buf + n; p += sizeof(struct inotify_event) + ((struct inotify_event *)p)->len) {
+			struct inotify_event *e = (struct inotify_event *)p;
+			if (e->len && (!strcmp(e->name, "dwl.toml") || !strcmp(e->name, "tinyhat")))
+				reload = 1;
+		}
+	}
+	if (reload) {
+		confwatch();
+		confload(1);
+		wallupdate();
+		drawbars();
+	}
+	return 0;
+}
+
+static void
+confinit(void)
+{
+	char path[PATH_MAX];
+	FILE *f;
+
+	confunset(&conf);
+	wl_list_init(&pointerdevs);
+	confdef.sloppy = sloppyfocus;
+	confdef.border = (int)borderpx;
+	confdef.gap = (int)gappx;
+	confdef.showbar = showbar;
+	confdef.topbar = topbar;
+	confdef.rate = repeat_rate;
+	confdef.delay = repeat_delay;
+	bgstate(path, sizeof(path));
+	if ((f = fopen(path, "r"))) {
+		if (fscanf(f, "%d", &bgindex) != 1)
+			bgindex = 0;
+		fclose(f);
+	}
+	if ((conffd = inotify_init1(IN_NONBLOCK | IN_CLOEXEC)) >= 0) {
+		confwatch();
+		wl_event_loop_add_fd(event_loop, conffd, WL_EVENT_READABLE, confin, NULL);
+	}
+	confload(1);
+}
