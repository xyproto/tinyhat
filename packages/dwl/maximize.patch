 void
+taskmaximize(const Arg *arg)
+{
+	Client *c, *t = NULL;
+	wl_list_for_each(c, &clients, link)
+		if (c == arg->v)
+			t = c;
+	if (!t || t->isfullscreen)
+		return;
+	if (t->isminimized) {
+		restoreclient(t);
+		arrange(t->mon);
+	}
+	selmon = t->mon;
+	setmaximized(t, !t->ismaximized);
+	focusclient(t, 1);
+	drawbars();
+}
+
+void
+setmaximized(Client *c, int maximized)
+{
+	if (!c->mon || c->isfullscreen || client_is_unmanaged(c) || !maximized == !c->ismaximized)
+		return;
+	if (maximized) {
+		if (!c->issnapped)
+			c->presnap = c->geom;
+		c->maxfloating = c->isfloating;
+		c->issnapped = c->ismaximized = 1;
+		setfloating(c, 1);
+		resize(c, c->mon->w, 0);
+		wlr_scene_node_raise_to_top(&c->scene->node);
+	} else {
+		c->issnapped = c->ismaximized = 0;
+		resize(c, c->presnap, 0);
+		setfloating(c, c->maxfloating);
+	}
+	client_set_maximized(c, maximized);
+}
+
+void
+client_set_maximized(Client *c, int maximized)
+{
+#ifdef XWAYLAND
+	if (client_is_x11(c)) {
+		wlr_xwayland_surface_set_maximized(c->surface.xwayland, maximized, maximized);
+		return;
+	}
+#endif
+	wlr_xdg_toplevel_set_maximized(c->surface.xdg->toplevel, maximized);
+}
