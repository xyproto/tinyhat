+static void
+trayline(char *s)
+{
+	char name[128], path[192], icon[700];
+	int n = 0, i;
+
+	while (*s == ' ')
+		s++;
+	if (!*s) {
+		for (i = 0; i < ntrayicons; i++)
+			if (trayicons[i].img)
+				pixman_image_unref(trayicons[i].img);
+		ntrayicons = 0;
+		return;
+	}
+	if (sscanf(s, "%127s %191s %n", name, path, &n) < 2)
+		return;
+	for (i = 0; i < ntrayicons; i++)
+		if (!strncmp(trayicons[i].key, name, strlen(name)) && trayicons[i].key[strlen(name)] == ' '
+				&& !strcmp(trayicons[i].key + strlen(name) + 1, path))
+			break;
+	if (!n || sscanf(s + n, "%699s", icon) != 1) {
+		if (i < ntrayicons) {
+			if (trayicons[i].img)
+				pixman_image_unref(trayicons[i].img);
+			memmove(&trayicons[i], &trayicons[i + 1], (ntrayicons - i - 1) * sizeof(trayicons[0]));
+			ntrayicons--;
+		}
+		return;
+	}
+	if (i == ntrayicons) {
+		if (ntrayicons == (int)LENGTH(trayicons))
+			return;
+		ntrayicons++;
+		trayicons[i].img = NULL;
+		snprintf(trayicons[i].key, sizeof(trayicons[i].key), "%s %s", name, path);
+	}
+	if (trayicons[i].img)
+		pixman_image_unref(trayicons[i].img);
+	trayicons[i].img = strcmp(icon, "-") ? wallload(icon) : NULL;
+	s += n + strlen(icon);
+	while (*s == ' ')
+		s++;
+	snprintf(trayicons[i].title, sizeof(trayicons[i].title), "%s", s);
+}
+
+static int
+trayw(Monitor *m)
+{
+	return ntrayicons ? ntrayicons * iconw(m, 'G') + (int)drwl_font_getwidth(m->drw, "  ") : 0;
+}
+
+static int
+drawtray(Monitor *m, int x)
+{
+	m->ntray = ntrayicons;
+	for (int i = 0; i < ntrayicons; i++) {
+		m->trayx[i] = x;
+		if (trayicons[i].img)
+			drawpng(m, x, trayicons[i].img);
+		else
+			drawicon(m, x, 'G', 0);
+		if (trayicons[i].title[0] && m->ntips < (int)LENGTH(m->tips)) {
+			snprintf(m->tips[m->ntips], sizeof(m->tips[0]), "%s", trayicons[i].title);
+			m->tipx[m->ntips][0] = x;
+			m->tipx[m->ntips][1] = x + iconw(m, 'G');
+			m->ntips++;
+		}
+		x += iconw(m, 'G');
+	}
+	m->trayx[ntrayicons] = x;
+	return ntrayicons ? x + (int)drwl_font_getwidth(m->drw, "  ") : x;
+}
+
+static void
+trayclick(int i, uint32_t button)
+{
+	char name[128], path[192], xs[16], ys[16];
+	const char *which = button == BTN_RIGHT ? "right" : button == BTN_MIDDLE ? "middle" : "left";
+
+	if (sscanf(trayicons[i].key, "%127s %191s", name, path) != 2)
+		return;
+	snprintf(xs, sizeof(xs), "%d", (int)cursor->x);
+	snprintf(ys, sizeof(ys), "%d", (int)cursor->y);
+	spawn(&(Arg){.v = (const char *[]){ "tinyhat-notify", "click", which, name, path, xs, ys, NULL }});
+}
