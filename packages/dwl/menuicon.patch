+static void
+inkrect(Monitor *m, uint32_t color, int x0, int y0, int x1, int y1)
+{
+	uint32_t scheme[3] = { color, color, color };
+	if (x1 <= x0 || y1 <= y0)
+		return;
+	drwl_setscheme(m->drw, scheme);
+	drwl_rect(m->drw, x0, y0, x1 - x0, y1 - y0, 1, 0);
+}
+
+static void
+drawmenuicon(Monitor *m)
+{
+	static const char *flame[] = {
+		"...r...", "..rr...", "..rrr..", ".rror..", ".roorr.",
+		"rroyorr", "royyyor", "royyyor", ".royor.", "..rrr..",
+	};
+	static const int hat[][5] = {
+		{ 0, 8, 6, 24, 17 }, { 1, 8, 17, 24, 19 }, { 0, 8, 19, 24, 25 }, { 0, 2, 22, 30, 25 },
+	};
+	int h = m->b.height, s = h * 3 / 4, ox, oy, r, c;
+	if (live) {
+		int w = s * 7 / 10;
+		ox = (h - w) / 2;
+		oy = (h - s) / 2;
+		for (r = 0; r < 10; r++)
+			for (c = 0; c < 7; c++)
+				if (flame[r][c] != '.')
+					inkrect(m, flame[r][c] == 'r' ? 0xe0452aff : flame[r][c] == 'o' ? 0xff9e3bff : 0xffe066ff,
+						ox + c * w / 7, oy + r * s / 10, ox + (c + 1) * w / 7, oy + (r + 1) * s / 10);
+		return;
+	}
+	ox = (h - s) / 2;
+	oy = (h - 19 * s / 28) / 2;
+	for (r = 0; r < 4; r++)
+		inkrect(m, hat[r][0] ? 0x494949ff : 0x922424ff, ox + (hat[r][1] - 2) * s / 28, oy + (hat[r][2] - 6) * s / 28,
+			ox + (hat[r][3] - 2) * s / 28, oy + (hat[r][4] - 6) * s / 28);
+}
