+static void
+inkrect(Monitor *m, uint32_t color, int x0, int y0, int x1, int y1)
+{
+	uint32_t scheme[3] = { color, color, color };
+	if (x1 <= x0 || y1 <= y0)
+		return;
+	drwl_setscheme(m->drw, scheme);
+	drwl_rect(m->drw, x0, y0, x1 - x0, y1 - y0, 1, 0);
+}
+
+static void
+drawlogo(Monitor *m)
+{
+	static const int hat[][5] = {
+		{ 0, 8, 6, 24, 17 }, { 1, 8, 17, 24, 19 }, { 0, 8, 19, 24, 25 }, { 0, 2, 22, 30, 25 },
+	};
+	int h = m->b.height, s = h * 5 / 8, ox = (MENUW(m) - 28 * s / 19) / 2, oy = (h - s) / 2;
+	for (int r = 0; r < 4; r++)
+		inkrect(m, hat[r][0] ? 0x494949ff : 0x922424ff, ox + (hat[r][1] - 2) * s / 19, oy + (hat[r][2] - 6) * s / 19,
+			ox + (hat[r][3] - 2) * s / 19, oy + (hat[r][4] - 6) * s / 19);
+}
+
+static void
+drawflame(Monitor *m, int x, int w)
+{
+	static const char *flame[] = {
+		"...r...", "..rr...", "..rrr..", ".rror..", ".roorr.",
+		"rroyorr", "royyyor", "royyyor", ".royor.", "..rrr..",
+	};
+	int s = m->b.height * 5 / 8, fw = s * 7 / 10, ox = x + (w - fw) / 2, oy = (m->b.height - s) / 2;
+	for (int r = 0; r < 10; r++)
+		for (int c = 0; c < 7; c++)
+			if (flame[r][c] != '.')
+				inkrect(m, flame[r][c] == 'r' ? 0xe0452aff : flame[r][c] == 'o' ? 0xff9e3bff : 0xffe066ff,
+					ox + c * fw / 7, oy + r * s / 10, ox + (c + 1) * fw / 7, oy + (r + 1) * s / 10);
+}
+
+static char *
+flamesep(void)
+{
+	char *sep = NULL;
+	if (!live)
+		return NULL;
+	for (char *p = strstr(stext, " | "); p; p = strstr(p + 1, " | "))
+		sep = p;
+	return sep;
+}
+
+static int
+flamew(Monitor *m)
+{
+	return MAX((int)drwl_font_getwidth(m->drw, " | "), m->b.height * 5 / 8 * 7 / 10 + m->lrpad);
+}
+
+static int
+statusw(Monitor *m)
+{
+	char *sep = flamesep();
+	int w;
+	if (!sep)
+		return TEXTW(m, stext) - m->lrpad + 2;
+	*sep = '\0';
+	w = drwl_font_getwidth(m->drw, stext) + flamew(m) + drwl_font_getwidth(m->drw, sep + 3) + 2;
+	*sep = ' ';
+	return w;
+}
