pkgname=dwl
pkgver=0.9
pkgrel=10
_tomlc17=R261109
pkgdesc="dwm for Wayland, with the Tiny Hat patches"
arch=(i686 x32)
url="https://codeberg.org/dwl/dwl"
license=(GPL-3.0-only MIT CC0-1.0)
depends=(wlroots0.20 fcft libpng libinput libxcb libxkbcommon pixman wayland xcb-util-wm)
makedepends=(wayland-protocols tllist)
_patches=(bar borders notice gaps keys filter killclient floatsize trim center menubutton barline cursor altab snap resizecorner tasks panel title statuscolor taskclose layoutcmd menuicon rootcolor keysound rootclick volume wallpaper volumeclick statusicons menuclose xwaylandcleanup fullscreenx11 fullscreenoffset x11kill titlecolor iconsonly roundtag nomode toml statusitems)
source=("dwl-$pkgver.tar.gz::https://codeberg.org/dwl/dwl/archive/v$pkgver.tar.gz"
        "${_patches[@]/%/.patch}"
        config.h
        "tomlc17-$_tomlc17.tar.gz::https://github.com/cktan/tomlc17/archive/refs/tags/$_tomlc17.tar.gz")
