prepare() {
  cd dwl
  for p in "${_patches[@]}"; do
    patch -Np1 -i "../$p.patch"
  done
  cp ../config.h config.h
  cp ../tomlc17-$_tomlc17/src/tomlc17.[ch] .
}

build() {
  cd dwl
  make PREFIX=/usr CFLAGS="$CFLAGS -O3 -DWLR_USE_UNSTABLE -std=c11" XWAYLAND=-DXWAYLAND XLIBS="xcb xcb-icccm"
}

package() {
  cd dwl
  make PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dm644 LICENSE* -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 ../tomlc17-$_tomlc17/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.tomlc17"
}
