prepare() {
  cd dwl
  for p in "${_patches[@]}"; do
    patch -Np1 -i "../$p.patch"
  done
  cp ../config.h config.h
}

build() {
  cd dwl
  make PREFIX=/usr CFLAGS="$CFLAGS -O3 -DWLR_USE_UNSTABLE -std=c11"
}

package() {
  cd dwl
  make PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dm644 LICENSE* -t "$pkgdir/usr/share/licenses/$pkgname/"
}
