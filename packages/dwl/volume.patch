+static int
+speakerw(Monitor *m)
+{
+	return m->b.height * 5 / 8 * 11 / 10 + 2;
+}
+
+static void
+drawspeaker(Monitor *m, int x)
+{
+	static const char *speaker[] = {
+		"....#......", "...##....#.", "..###.#...#", "#####..#..#", "#####..#..#",
+		"#####..#..#", "#####..#..#", "..###.#...#", "...##....#.", "....#......",
+	};
+	int s = m->b.height * 5 / 8, oy = (m->b.height - s) / 2;
+	for (int r = 0; r < 10; r++)
+		for (int c = 0; c < 11; c++)
+			if (speaker[r][c] == '#')
+				inkrect(m, colors[SchemeStatus][0], x + c * s / 10, oy + r * s / 10, x + (c + 1) * s / 10, oy + (r + 1) * s / 10);
+}
+
+static int
+isvolume(const char *s, const char *p)
+{
+	return p[0] == 'V' && p[1] == ' ' && (p == s || (p - s >= 3 && !strncmp(p - 3, " | ", 3)));
+}
+
+static int
+stextw(Monitor *m, char *s)
+{
+	int w = 0;
+	char *seg = s;
+	for (char *p = s; *p; p++)
+		if (isvolume(s, p)) {
+			*p = '\0';
+			w += drwl_font_getwidth(m->drw, seg) + speakerw(m);
+			*p = 'V';
+			seg = p + 1;
+		}
+	return w + drwl_font_getwidth(m->drw, seg);
+}
+
+static int
+drawstext(Monitor *m, int x, char *s)
+{
+	char *seg = s;
+	for (char *p = s; *p; p++)
+		if (isvolume(s, p)) {
+			char *end = strstr(p, " | ");
+			*p = '\0';
+			if (*seg)
+				x = drwl_text(m->drw, x, 0, drwl_font_getwidth(m->drw, seg), m->b.height, 0, seg, 0);
+			*p = 'V';
+			m->volx0 = x;
+			drawspeaker(m, x);
+			drwl_setscheme(m->drw, colors[SchemeStatus]);
+			x += speakerw(m);
+			if (end)
+				*end = '\0';
+			m->volx1 = x + drwl_font_getwidth(m->drw, p + 1);
+			if (end)
+				*end = ' ';
+			seg = p + 1;
+		}
+	if (*seg)
+		x = drwl_text(m->drw, x, 0, drwl_font_getwidth(m->drw, seg), m->b.height, 0, seg, 0);
+	return x;
+}
