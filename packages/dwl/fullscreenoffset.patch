+void
+fsoffset(Client *c)
+{
+	struct wlr_surface *s = client_surface(c);
+	int x = c->bw, y = c->bw;
+
+	if (c->isfullscreen && s && s->current.width > 0 && s->current.height > 0) {
+		x = MAX(0, (c->geom.width - s->current.width) / 2);
+		y = MAX(0, (c->geom.height - s->current.height) / 2);
+	}
+	wlr_scene_node_set_position(&c->scene_surface->node, x, y);
+}
