+static uint32_t
+blendcolor(uint32_t a, uint32_t b, int cov)
+{
+	uint32_t out = 0;
+	for (int s = 0; s < 32; s += 8)
+		out |= ((((a >> s) & 0xff) * (16 - cov) + ((b >> s) & 0xff) * cov) / 16) << s;
+	return out;
+}
+
+void
+drawpill(Monitor *m, int x, int y, int w, int h, int r)
+{
+	uint32_t norm = colors[SchemeNorm][ColBg], sel = colors[SchemeSel][ColBg];
+	pixman_color_t clr = convert_color(sel);
+
+	r = MAX(0, MIN(r, MIN(w / 2, h)));
+	pixman_image_fill_rectangles(PIXMAN_OP_SRC, m->drw->image, &clr, 2, (pixman_rectangle16_t[2]){
+		{ x + r, y, w - 2 * r, r }, { x, y + r, w, h - r }});
+	for (int j = 0; j < r; j++)
+		for (int i = 0; i < r; i++) {
+			int cov = 0;
+			for (int sy = 0; sy < 4; sy++)
+				for (int sx = 0; sx < 4; sx++) {
+					float dx = r - i - (sx + 0.5f) / 4, dy = r - j - (sy + 0.5f) / 4;
+					cov += dx * dx + dy * dy <= (float)(r * r);
+				}
+			clr = convert_color(blendcolor(norm, sel, cov));
+			pixman_image_fill_rectangles(PIXMAN_OP_SRC, m->drw->image, &clr, 2, (pixman_rectangle16_t[2]){
+				{ x + i, y + j, 1, 1 }, { x + w - 1 - i, y + j, 1, 1 }});
+		}
+}
