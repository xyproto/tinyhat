+int
+reloadkeymap(int signo, void *data)
+{
+	char path[4096], line[256] = "", *variant;
+	const char *home = getenv("HOME");
+	struct xkb_rule_names names = xkb_rules;
+	struct xkb_context *context;
+	struct xkb_keymap *keymap;
+	FILE *f;
+
+	snprintf(path, sizeof(path), "%s/.config/tinyhat/keyboard", home ? home : "");
+	if ((f = fopen(path, "r"))) {
+		if (!fgets(line, sizeof(line), f))
+			line[0] = '\0';
+		fclose(f);
+	}
+	line[strcspn(line, "\r\n")] = '\0';
+	if ((variant = strchr(line, ' '))) {
+		*variant++ = '\0';
+		names.variant = variant;
+	}
+	if (line[0])
+		names.layout = line;
+	context = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+	if ((keymap = xkb_keymap_new_from_names(context, &names, XKB_KEYMAP_COMPILE_NO_FLAGS))) {
+		wlr_keyboard_set_keymap(&kb_group->wlr_group->keyboard, keymap);
+		xkb_keymap_unref(keymap);
+	}
+	xkb_context_unref(context);
+	return 0;
+}
+
+void
+unblocksignals(void)
+{
+	sigset_t set;
+	sigemptyset(&set);
+	sigprocmask(SIG_SETMASK, &set, NULL);
+}
+
