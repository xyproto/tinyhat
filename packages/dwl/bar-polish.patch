+static void
+drawtagpill(Monitor *m, int x, int w)
+{
+	int h = m->b.height - 1, pad = MAX(2, m->b.height / 8), d = h - 2 * pad;
+	double r = MIN(d, w) / 2.0;
+	pixman_color_t clr;
+
+	for (int j = 0; j < d; j++)
+		for (int i = 0; i < w; i++) {
+			int cov = 0;
+			for (int sy = 0; sy < 4; sy++)
+				for (int s = 0; s < 4; s++) {
+					double px = i + (s + 0.5) / 4, py = j + (sy + 0.5) / 4;
+					double cx = MAX(r, MIN(w - r, px));
+					cov += (px - cx) * (px - cx) + (py - r) * (py - r) <= r * r;
+				}
+			if (!cov)
+				continue;
+			clr = convert_color(blendcolor(colors[SchemeNorm][ColBg], tagcolor, cov));
+			pixman_image_fill_rectangles(PIXMAN_OP_SRC, m->drw->image, &clr, 1,
+				&(pixman_rectangle16_t){ x + i, pad + j, 1, 1 });
+		}
+}
