+static char voltip[128];
+
+static int
+volumeinfo(int *muted)
+{
+	char *item = stext, *next;
+	*muted = 0;
+	for (;;) {
+		if ((*item == 'V' || *item == 'M') && item[1] == ' ') {
+			*muted = *item == 'M';
+			return MAX(0, MIN(100, atoi(item + 2)));
+		}
+		if (!(next = strchr(item, '\t')))
+			return 40;
+		item = next + 1;
+	}
+}
+
+static struct wl_event_source *voltimer;
+static int volwant = -1, volwantmuted, volarmed;
+static long long volchanged, volapplied;
+
+static long long
+nowms(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (long long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static void
+volumeshow(int pct, int muted)
+{
+	char *item = stext, *next, *end, rest[sizeof stext];
+	for (;;) {
+		if ((*item == 'V' || *item == 'M') && item[1] == ' ') {
+			for (end = item + 2; *end >= '0' && *end <= '9'; end++);
+			snprintf(rest, sizeof rest, "%s", end);
+			snprintf(item, sizeof stext - (size_t)(item - stext), "%c %d%s", muted ? 'M' : 'V', pct, rest);
+			return;
+		}
+		if (!(next = strchr(item, '\t')))
+			return;
+		item = next + 1;
+	}
+}
+
+static void
+volumekeep(void)
+{
+	int muted, pct;
+	if (volwant < 0)
+		return;
+	pct = volumeinfo(&muted);
+	if ((pct == volwant && muted == volwantmuted && !volarmed) || nowms() - volchanged > 4000)
+		volwant = -1;
+	else
+		volumeshow(volwant, volwantmuted);
+}
+
+static int
+volumeapply(void *data)
+{
+	const char *runtime = getenv("XDG_RUNTIME_DIR");
+	char path[PATH_MAX];
+	FILE *f;
+	volarmed = 0;
+	volapplied = nowms();
+	if (volwant < 0)
+		return 0;
+	snprintf(path, sizeof path, "%s/tinyhat-volume.want", runtime && *runtime ? runtime : "/tmp");
+	if ((f = fopen(path, "w"))) {
+		fprintf(f, "%d %d\n", volwant, volwantmuted);
+		fclose(f);
+		spawn(&(Arg){.v = (const char *[]){ "tinyhat-volume", "apply", "--quiet", NULL }});
+	}
+	return 0;
+}
+
+static void
+volumehint(int pct, int muted)
+{
+	snprintf(voltip, sizeof voltip, "Volume %d%%%s", pct, muted ? " (muted)" : "");
+	volwant = pct;
+	volwantmuted = muted;
+	volchanged = nowms();
+	volumeshow(pct, muted);
+	drawbars();
+	tipupdate();
+	if (!voltimer)
+		voltimer = wl_event_loop_add_timer(event_loop, volumeapply, NULL);
+	if (voltimer && !volarmed) {
+		long long wait = 200 - (volchanged - volapplied);
+		volarmed = 1;
+		wl_event_source_timer_update(voltimer, (int)MAX(1, MIN(200, wait)));
+	}
+}
