 /* The color of the status icon at (x, y), in units of the icon height, or 0 where it is see-through */
+static double
+segdist(double x, double y, double x0, double y0, double x1, double y1)
+{
+	double vx = x1 - x0, vy = y1 - y0, t = ((x - x0) * vx + (y - y0) * vy) / (vx * vx + vy * vy);
+	t = MAX(0, MIN(1, t));
+	return hypot(x - x0 - t * vx, y - y0 - t * vy);
+}
