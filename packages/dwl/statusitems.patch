+static struct wlr_scene_buffer *tipnode;
+static char tipshown[128];
+
+void
+tipupdate(void)
+{
+	Monitor *m, *hm = NULL;
+	const char *text = NULL;
+	int ix0 = 0, ix1 = 0;
+
+	wl_list_for_each(m, &mons, link) {
+		int cx;
+		if (!m->wlr_output->enabled || !m->scene_buffer->node.enabled || m != selmon
+				|| cursor->x < m->m.x || cursor->x >= m->m.x + m->m.width
+				|| cursor->y < m->m.y + (topbar ? 0 : m->m.height - m->b.real_height)
+				|| cursor->y >= m->m.y + (topbar ? m->b.real_height : m->m.height))
+			continue;
+		cx = (int)((cursor->x - m->m.x) * m->wlr_output->scale);
+		for (int i = 0; i < m->ntips; i++)
+			if (cx >= m->tipx[i][0] && cx < m->tipx[i][1]) {
+				hm = m;
+				text = m->tips[i];
+				ix0 = m->tipx[i][0];
+				ix1 = m->tipx[i][1];
+			}
+	}
+	if (text && tipnode && !strcmp(text, tipshown))
+		return;
+	if (tipnode) {
+		wlr_scene_node_destroy(&tipnode->node);
+		tipnode = NULL;
+		tipshown[0] = '\0';
+	}
+	if (!text)
+		return;
+	{
+		double s = hm->wlr_output->scale;
+		int pad = hm->lrpad / 2, tw = (int)drwl_font_getwidth(hm->drw, text);
+		int bw = tw + 2 * pad + 2, bh = hm->b.height, x, y;
+		uint32_t scheme[3] = { colors[SchemeNorm][ColFg], colors[SchemeNorm][ColBg], colors[SchemeNorm][ColBorder] };
+		WallBuffer *b = wallbuffer(bw, bh, 0);
+		Drwl d = { 0 };
+		d.font = hm->drw->font;
+		drwl_setimage(&d, b->image);
+		drwl_setscheme(&d, (uint32_t[3]){ scheme[2], scheme[2], 0 });
+		drwl_rect(&d, 0, 0, bw, bh, 1, 0);
+		drwl_setscheme(&d, scheme);
+		drwl_text(&d, 1, 1, bw - 2, bh - 2, pad, text, 0);
+		x = MAX(0, MIN((ix0 + ix1) / 2 - bw / 2, hm->b.width - bw));
+		y = topbar ? hm->b.height : (int)(hm->m.height * s) - 2 * hm->b.height;
+		tipnode = wlr_scene_buffer_create(layers[LyrOverlay], &b->base);
+		wlr_buffer_drop(&b->base);
+		if (!tipnode)
+			return;
+		wlr_scene_buffer_set_dest_size(tipnode, (int)(bw / s + 0.5), (int)(bh / s + 0.5));
+		wlr_scene_node_set_position(&tipnode->node, hm->m.x + (int)(x / s), hm->m.y + (int)(y / s));
+		snprintf(tipshown, sizeof(tipshown), "%s", text);
+	}
+}
