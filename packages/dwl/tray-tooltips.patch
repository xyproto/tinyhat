+static void
+trayline(char *s)
+{
+	char name[128], path[192], icon[700];
+	int n = 0, i;
+
+	while (*s == ' ')
+		s++;
+	if (!*s) {
+		for (i = 0; i < ntrayicons; i++)
+			if (trayicons[i].img)
+				pixman_image_unref(trayicons[i].img);
+		ntrayicons = 0;
+		return;
+	}
+	if (sscanf(s, "%127s %191s %n", name, path, &n) < 2)
+		return;
+	for (i = 0; i < ntrayicons; i++)
+		if (!strncmp(trayicons[i].key, name, strlen(name)) && trayicons[i].key[strlen(name)] == ' '
+				&& !strcmp(trayicons[i].key + strlen(name) + 1, path))
+			break;
+	if (!n || sscanf(s + n, "%699s", icon) != 1) {
+		if (i < ntrayicons) {
+			if (trayicons[i].img)
+				pixman_image_unref(trayicons[i].img);
+			memmove(&trayicons[i], &trayicons[i + 1], (ntrayicons - i - 1) * sizeof(trayicons[0]));
+			ntrayicons--;
+		}
+		return;
+	}
+	if (i == ntrayicons) {
+		if (ntrayicons == (int)LENGTH(trayicons))
+			return;
+		ntrayicons++;
+		trayicons[i].img = NULL;
+		snprintf(trayicons[i].key, sizeof(trayicons[i].key), "%s %s", name, path);
+	}
+	if (trayicons[i].img)
+		pixman_image_unref(trayicons[i].img);
+	trayicons[i].img = strcmp(icon, "-") ? wallload(icon) : NULL;
+	s += n + strlen(icon);
+	while (*s == ' ')
+		s++;
+	snprintf(trayicons[i].title, sizeof(trayicons[i].title), "%s", s);
+}
