+int
+usablemode(struct wlr_output *wlr_output, struct wlr_output_state *state)
+{
+	static const int sizes[][2] = { { 1280, 800 }, { 1024, 768 }, { 800, 600 }, { 640, 480 } };
+	struct wlr_output_mode *preferred = wlr_output_preferred_mode(wlr_output), *mode;
+
+	if (preferred) {
+		wlr_output_state_set_mode(state, preferred);
+		if (wlr_output_test_state(wlr_output, state))
+			return 1;
+	}
+	wl_list_for_each(mode, &wlr_output->modes, link) {
+		if (mode == preferred)
+			continue;
+		wlr_output_state_set_mode(state, mode);
+		if (wlr_output_test_state(wlr_output, state))
+			return 1;
+	}
+	state->committed &= ~WLR_OUTPUT_STATE_MODE;
+	if (wlr_output->width > 0 && wlr_output->height > 0 && wlr_output_test_state(wlr_output, state))
+		return 1;
+	for (size_t i = 0; i < LENGTH(sizes); i++) {
+		wlr_output_state_set_custom_mode(state, sizes[i][0], sizes[i][1], 0);
+		if (wlr_output_test_state(wlr_output, state))
+			return 1;
+	}
+	return 0;
+}
