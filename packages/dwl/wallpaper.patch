+typedef struct {
+	struct wlr_buffer base;
+	uint32_t format;
+	size_t stride;
+	pixman_image_t *image;
+	void *data;
+} WallBuffer;
+
+static void
+wallbufdestroy(struct wlr_buffer *wlr_buffer)
+{
+	WallBuffer *b = wl_container_of(wlr_buffer, b, base);
+	pixman_image_unref(b->image);
+	free(b->data);
+	free(b);
+}
+
+static bool
+wallbufbegin(struct wlr_buffer *wlr_buffer, uint32_t flags, void **data, uint32_t *format, size_t *stride)
+{
+	WallBuffer *b = wl_container_of(wlr_buffer, b, base);
+	if (flags & WLR_BUFFER_DATA_PTR_ACCESS_WRITE)
+		return false;
+	*data = b->data;
+	*format = b->format;
+	*stride = b->stride;
+	return true;
+}
+
+static void
+wallbufend(struct wlr_buffer *wlr_buffer)
+{
+}
+
+static const struct wlr_buffer_impl wallbuf_impl = {
+	.destroy = wallbufdestroy,
+	.begin_data_ptr_access = wallbufbegin,
+	.end_data_ptr_access = wallbufend,
+};
+
+static WallBuffer *
+wallbuffer(int w, int h, int rgb565)
+{
+	WallBuffer *b = ecalloc(1, sizeof(*b));
+	b->stride = rgb565 ? ((size_t)w * 2 + 3) & ~(size_t)3 : (size_t)w * 4;
+	b->data = ecalloc(h, b->stride);
+	b->format = rgb565 ? DRM_FORMAT_RGB565 : DRM_FORMAT_XRGB8888;
+	b->image = pixman_image_create_bits_no_clear(rgb565 ? PIXMAN_r5g6b5 : PIXMAN_x8r8g8b8, w, h, b->data, b->stride);
+	wlr_buffer_init(&b->base, &wallbuf_impl, w, h);
+	return b;
+}
+
+static void
+wallplace(WallBuffer *b, Monitor *m, double x, double y)
+{
+	double s = m->wlr_output->scale;
+	struct wlr_scene_buffer *sb = wlr_scene_buffer_create(wall_tree, &b->base);
+	wlr_buffer_drop(&b->base);
+	if (!sb)
+		return;
+	wlr_scene_buffer_set_dest_size(sb, (int)(b->base.width / s + 0.5), (int)(b->base.height / s + 0.5));
+	wlr_scene_node_set_position(&sb->node, m->m.x + (int)(x / s), m->m.y + (int)(y / s));
+}
+
+static pixman_color_t
+wallcolor(uint32_t rgb)
+{
+	return (pixman_color_t){ (rgb >> 16 & 0xff) * 0x101, (rgb >> 8 & 0xff) * 0x101, (rgb & 0xff) * 0x101, 0xffff };
+}
+
+static void
+wallfreebits(pixman_image_t *image, void *data)
+{
+	free(data);
+}
+
+static pixman_image_t *
+wallload(const char *path)
+{
+	png_image png = { .version = PNG_IMAGE_VERSION };
+	pixman_image_t *image;
+	uint32_t *px;
+
+	if (!png_image_begin_read_from_file(&png, path))
+		return NULL;
+	png.format = PNG_FORMAT_BGRA;
+	if (!(px = malloc(PNG_IMAGE_SIZE(png)))) {
+		png_image_free(&png);
+		return NULL;
+	}
+	if (!png_image_finish_read(&png, NULL, px, 0, NULL)) {
+		free(px);
+		return NULL;
+	}
+	for (size_t i = 0; i < (size_t)png.width * png.height; i++) {
+		uint32_t p = px[i], a = p >> 24;
+		px[i] = a << 24 | ((p >> 16 & 0xff) * a / 255) << 16 | ((p >> 8 & 0xff) * a / 255) << 8 | (p & 0xff) * a / 255;
+	}
+	if (!(image = pixman_image_create_bits(PIXMAN_a8r8g8b8, png.width, png.height, px, png.width * 4))) {
+		free(px);
+		return NULL;
+	}
+	pixman_image_set_destroy_function(image, wallfreebits, px);
+	return image;
+}
+
+static void
+wallimage(Monitor *m, pixman_image_t *img)
+{
+	double s = m->wlr_output->scale, W = m->m.width * s, H = m->m.height * s;
+	double iw = pixman_image_get_width(img), ih = pixman_image_get_height(img);
+	double kx = 1, ky = 1, dx = 0, dy = 0, bx = 0, by = 0, bw = W, bh = H;
+	int rgb565 = 0, repeat = 0;
+	pixman_transform_t t;
+	pixman_color_t bg = wallcolor(wallrgb);
+	WallBuffer *b;
+
+	if (!strcmp(wallmode, "fill")) {
+		kx = ky = MAX(W / iw, H / ih);
+		dx = (W - iw * kx) / 2;
+		dy = (H - ih * ky) / 2;
+	} else if (!strcmp(wallmode, "fit")) {
+		kx = ky = MIN(W / iw, H / ih);
+		bw = iw * kx;
+		bh = ih * ky;
+		bx = (W - bw) / 2;
+		by = (H - bh) / 2;
+	} else if (!strcmp(wallmode, "stretch")) {
+		kx = W / iw;
+		ky = H / ih;
+	} else if (!strcmp(wallmode, "tile")) {
+		repeat = 1;
+		rgb565 = 1;
+	} else if (!strcmp(wallmode, "left")) {
+		kx = ky = MIN(1, MIN(H * 0.1 / ih, W * 0.1 / iw));
+		bw = iw * kx;
+		bh = ih * ky;
+		bx = W * 0.1;
+		by = H / 2 - bh / 2;
+		rgb565 = 1;
+	} else {
+		bw = MIN(iw, W);
+		bh = MIN(ih, H);
+		bx = (W - bw) / 2;
+		by = (H - bh) / 2;
+		dx = (bw - iw) / 2;
+		dy = (bh - ih) / 2;
+		rgb565 = 1;
+	}
+	if ((int)bw < 1 || (int)bh < 1)
+		return;
+	b = wallbuffer((int)bw, (int)bh, rgb565);
+	pixman_image_fill_rectangles(PIXMAN_OP_SRC, b->image, &bg, 1, &(pixman_rectangle16_t){ 0, 0, (int)bw, (int)bh });
+	pixman_transform_init_scale(&t, pixman_double_to_fixed(1 / kx), pixman_double_to_fixed(1 / ky));
+	pixman_image_set_transform(img, &t);
+	pixman_image_set_filter(img, kx == 1 && ky == 1 ? PIXMAN_FILTER_NEAREST : PIXMAN_FILTER_BILINEAR, NULL, 0);
+	pixman_image_set_repeat(img, repeat ? PIXMAN_REPEAT_NORMAL : PIXMAN_REPEAT_NONE);
+	pixman_image_composite32(PIXMAN_OP_OVER, img, NULL, b->image, (int)-dx, (int)-dy, 0, 0, 0, 0, (int)bw, (int)bh);
+	wallplace(b, m, bx, by);
+}
+
+static uint32_t
+wallmix(uint32_t a, uint32_t b, double t)
+{
+	uint32_t out = 0;
+	for (int sh = 0; sh <= 16; sh += 8)
+		out |= (uint32_t)((a >> sh & 0xff) * (1 - t) + (b >> sh & 0xff) * t + 0.5) << sh;
+	return out;
+}
+
+static void
+wallhelp(Monitor *m)
+{
+	char lines[48][160];
+	int n = 0;
+	double s = m->wlr_output->scale, W = m->m.width * s, H = m->m.height * s;
+	double size = MAX(9, H / 72), pad = size, gap = size * 1.5, margin = size * 2, r = size * 0.8;
+	double keyw = 0, descw = 0, headw = 0, w, pw, ph, x, y;
+	const char *names[] = { "JetBrains Mono NL" };
+	char attrs[32];
+	uint32_t panel = wallmix(wallrgb, 0x16161e, 0xd0 / 255.0);
+	Drwl d = { 0 };
+	WallBuffer *b;
+	FILE *f;
+	int bw, bh, lineh;
+
+	if (!(f = fopen(helppath, "r")))
+		return;
+	while (n < 48 && fgets(lines[n], sizeof(lines[n]), f)) {
+		lines[n][strcspn(lines[n], "\n")] = '\0';
+		n++;
+	}
+	fclose(f);
+	if (!n)
+		return;
+	snprintf(attrs, sizeof(attrs), "pixelsize=%d", (int)(size + 0.5));
+	if (!(d.font = fcft_from_name(1, names, attrs)))
+		return;
+	lineh = d.font->height;
+	for (int i = 0; i < n; i++) {
+		char *tab = strchr(lines[i], '\t');
+		if (tab) {
+			*tab = '\0';
+			keyw = MAX(keyw, drwl_font_getwidth(&d, lines[i]));
+			descw = MAX(descw, drwl_font_getwidth(&d, tab + 1));
+			*tab = '\t';
+		} else {
+			headw = MAX(headw, drwl_font_getwidth(&d, lines[i]));
+		}
+	}
+	w = MAX(keyw + gap + descw, headw);
+	pw = w + 2 * pad;
+	ph = n * lineh + 2 * pad;
+	x = MAX(margin, W - pw - margin);
+	y = margin * 1.5;
+	bw = (int)pw + 2;
+	bh = (int)ph + 2;
+	b = wallbuffer(bw, bh, 1);
+	for (int py = 0; py < bh; py++) {
+		uint16_t *row = (uint16_t *)((char *)b->data + py * b->stride);
+		for (int px = 0; px < bw; px++) {
+			double qx = fabs(px + 0.5 - bw / 2.0) - (pw / 2 - r), qy = fabs(py + 0.5 - bh / 2.0) - (ph / 2 - r);
+			double dist = hypot(MAX(qx, 0), MAX(qy, 0)) + MIN(MAX(qx, qy), 0) - r;
+			uint32_t c = wallmix(panel, wallrgb, MIN(1, MAX(0, dist + 0.5)));
+			c = wallmix(c, 0x1a9e96, MIN(1, MAX(0, 1.5 - fabs(dist))));
+			row[px] = (c >> 8 & 0xf800) | (c >> 5 & 0x07e0) | (c >> 3 & 0x001f);
+		}
+	}
+	drwl_setimage(&d, b->image);
+	for (int i = 0; i < n; i++) {
+		int ty = 1 + (int)pad + i * lineh;
+		char *tab = strchr(lines[i], '\t');
+		uint32_t key[3] = { 0x7dcfffff, panel << 8 | 0xff, 0 }, desc[3] = { 0xc0caf5ff, panel << 8 | 0xff, 0 };
+		uint32_t head[3] = { i == 0 ? 0x1a9e96ff : 0xa9b1d6ff, panel << 8 | 0xff, 0 };
+		if (tab) {
+			*tab = '\0';
+			drwl_setscheme(&d, key);
+			drwl_text(&d, 1 + (int)pad, ty, drwl_font_getwidth(&d, lines[i]) + 1, lineh, 0, lines[i], 0);
+			drwl_setscheme(&d, desc);
+			drwl_text(&d, 1 + (int)(pad + keyw + gap), ty, drwl_font_getwidth(&d, tab + 1) + 1, lineh, 0, tab + 1, 0);
+		} else if (lines[i][0]) {
+			drwl_setscheme(&d, head);
+			drwl_text(&d, 1 + (int)pad, ty, drwl_font_getwidth(&d, lines[i]) + 1, lineh, 0, lines[i], 0);
+		}
+	}
+	fcft_destroy(d.font);
+	wallplace(b, m, x - 1, y - 1);
+}
+
+static int
+wall565(void)
+{
+	return helppath[0] || (wallpath[0] && strcmp(wallmode, "fill") && strcmp(wallmode, "fit") && strcmp(wallmode, "stretch"));
+}
+
+void
+wallupdate(void)
+{
+	struct wlr_scene_node *node, *tmp;
+	pixman_image_t *img = NULL;
+	uint32_t c = wallrgb;
+	Monitor *m;
+
+	if (!wall_tree)
+		return;
+	if (wall565()) {
+		uint32_t r5 = c >> 19 & 0x1f, g6 = c >> 10 & 0x3f, b5 = c >> 3 & 0x1f;
+		c = (r5 << 3 | r5 >> 2) << 16 | (g6 << 2 | g6 >> 4) << 8 | (b5 << 3 | b5 >> 2);
+	}
+	wlr_scene_rect_set_color(root_bg, (float[4]){ (c >> 16 & 0xff) / 255.0f, (c >> 8 & 0xff) / 255.0f, (c & 0xff) / 255.0f, 1.0f });
+	wl_list_for_each_safe(node, tmp, &wall_tree->children, link)
+		wlr_scene_node_destroy(node);
+	if (wallpath[0])
+		img = wallload(wallpath);
+	wl_list_for_each(m, &mons, link) {
+		if (!m->wlr_output->enabled || m->m.width <= 0 || m->m.height <= 0)
+			continue;
+		if (img)
+			wallimage(m, img);
+		if (helppath[0])
+			wallhelp(m);
+	}
+	if (img)
+		pixman_image_unref(img);
+	malloc_trim(0);
+}
