 void
+drawlayout(Monitor *m, int x, int w)
+{
+	int s = m->b.height * 9 / 16, ix = x + (w - s) / 2, iy = (m->b.height - s) / 2;
+	int t = MAX(2, s / 5), ws = s * 2 / 3, hw = (s - 1) / 2, n = 2;
+	int win[4][4] = {{ix, iy, ws, ws}, {ix + s - ws, iy + s - ws, ws, ws}};
+
+	drwl_setscheme(m->drw, colors[SchemeNorm]);
+	drwl_rect(m->drw, x, 0, w, m->b.height, 1, 1);
+	if (m->lt[m->sellt]->arrange) {
+		n = 4;
+		t = MAX(1, hw / 3);
+		for (int i = 0; i < 4; i++) {
+			win[i][0] = ix + (i % 2) * (s - hw);
+			win[i][1] = iy + (i / 2) * (s - hw);
+			win[i][2] = win[i][3] = hw;
+		}
+	}
+	for (int i = 0; i < n; i++) {
+		drwl_rect(m->drw, win[i][0], win[i][1], win[i][2], win[i][3], 1, 1);
+		drwl_rect(m->drw, win[i][0], win[i][1], win[i][2], win[i][3], 0, 0);
+		drwl_rect(m->drw, win[i][0], win[i][1], win[i][2], t, 1, 0);
+	}
+}
+
+void
+drawtasks(Monitor *m, int x, int w)
+{
+	Client *t, *sel = focustop(m);
+	int n = 0, bw, gap = 3, pad = m->b.height / 8 + 1, bh = m->b.height - 2 * pad - 1;
+	int line = MAX(2, m->b.height / 12);
+
+	drwl_setscheme(m->drw, colors[SchemeNorm]);
+	drwl_rect(m->drw, x, 0, w, m->b.height, 1, 1);
+	wl_list_for_each_reverse(t, &clients, link)
+		if (t->mon == m && (t->tags & m->tagset[m->seltags]) && n < (int)LENGTH(m->tasks))
+			m->tasks[n++] = t;
+	m->ntasks = n;
+	if (!n)
+		return;
+	bw = MIN((w - gap) / n, m->b.height * 9);
+	for (int i = 0; i < n; i++) {
+		int bx, active;
+		t = m->tasks[i];
+		active = t == sel && !t->isminimized;
+		bx = m->taskx[i] = x + gap + i * bw;
+		drwl_setscheme(m->drw, colors[active ? SchemeTaskSel
+			: m->taskhover == i + 1 ? SchemeTaskHover
+			: t->isminimized ? SchemeTaskMin : SchemeTask]);
+		drwl_text(m->drw, bx, pad, bw - gap, bh, m->lrpad / 2, client_get_title(t), 0);
+		if (active) {
+			drwl_setscheme(m->drw, colors[SchemeSel]);
+			drwl_rect(m->drw, bx, pad + bh - line, bw - gap, line, 1, 1);
+		}
+		drwl_setscheme(m->drw, colors[SchemeNorm]);
+		drwl_rect(m->drw, bx, pad, 1, 1, 1, 1);
+		drwl_rect(m->drw, bx + bw - gap - 1, pad, 1, 1, 1, 1);
+		drwl_rect(m->drw, bx, pad + bh - 1, 1, 1, 1, 1);
+		drwl_rect(m->drw, bx + bw - gap - 1, pad + bh - 1, 1, 1, 1, 1);
+	}
+	m->taskx[n] = x + gap + n * bw;
+	if (sel && !sel->isminimized && x + w - m->taskx[n] > m->b.height * 3) {
+		const char *title = client_get_title(sel);
+		int tw = TEXTW(m, title), aw = x + w - m->taskx[n];
+		drwl_text(m->drw, m->taskx[n], 0, aw, m->b.height, tw < aw ? (aw - tw) / 2 + m->lrpad / 2 : m->lrpad / 2, title, 0);
+	}
+}
