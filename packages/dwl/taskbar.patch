+static void
+minimizeclient(Client *c)
+{
+	if (!c || c->isminimized)
+		return;
+	c->wasfullscreen = c->isfullscreen;
+	if (c->isfullscreen)
+		setfullscreen(c, 0);
+	c->isminimized = 1;
+}
+
+static void
+restoreclient(Client *c)
+{
+	if (!c->isminimized)
+		return;
+	c->isminimized = c->desktophidden = 0;
+	if (c->wasfullscreen) {
+		c->wasfullscreen = 0;
+		setfullscreen(c, 1);
+	}
+}
