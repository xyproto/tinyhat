+
+void
+showdesktop(const Arg *arg)
+{
+	Client *c;
+	int shown = 0;
+	if (!selmon)
+		return;
+	wl_list_for_each(c, &clients, link)
+		if (c->mon == selmon && (c->tags & selmon->tagset[selmon->seltags]) && !c->isminimized)
+			shown = 1;
+	wl_list_for_each(c, &clients, link) {
+		if (c->mon != selmon || !(c->tags & selmon->tagset[selmon->seltags]))
+			continue;
+		if (shown && !c->isminimized) {
+			minimizeclient(c);
+			c->desktophidden = 1;
+		} else if (!shown && c->desktophidden) {
+			restoreclient(c);
+		}
+	}
+	arrange(selmon);
+	focusclient(focustop(selmon), 1);
+	drawbars();
+}
+
+void
+taskclick(const Arg *arg)
+{
+	Client *c, *t = NULL;
+	wl_list_for_each(c, &clients, link)
+		if (c == arg->v)
+			t = c;
+	if (!t)
+		return;
+	if (t == focustop(t->mon) && !t->isminimized) {
+		minimizeclient(t);
+		arrange(t->mon);
+		focusclient(focustop(selmon), 1);
+		drawbars();
+		return;
+	}
+	restoreclient(t);
+	selmon = t->mon;
+	arrange(t->mon);
+	focusclient(t, 1);
+	drawbars();
+}
+
+void
+taskclose(const Arg *arg)
+{
+	Client *c;
+	wl_list_for_each(c, &clients, link)
+		if (c == arg->v) {
+			killclient(arg);
+			return;
+		}
+}
+
+void
+taskhover(void)
+{
+	Monitor *m;
+	int hover, cx;
+
+	wl_list_for_each(m, &mons, link) {
+		hover = 0;
+		if (m->scene_buffer->node.enabled && cursor->x >= m->m.x && cursor->x < m->m.x + m->m.width
