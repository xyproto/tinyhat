function prepare
    cd dwl; or return
    for p in $_patches
        patch -Np1 -i "../$p.patch"; or return
    end
    cp ../config.h config.h; or return
end

function build
    cd dwl; or return
    make PREFIX=/usr CFLAGS="$CFLAGS -O3 -DWLR_USE_UNSTABLE -std=c11"; or return
end

function package
    cd dwl; or return
    make PREFIX=/usr DESTDIR="$pkgdir" install; or return
    install -Dm644 LICENSE* -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
    install -Dm644 /usr/share/licenses/tomlc17/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.tomlc17"; or return
end
