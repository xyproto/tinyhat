+#include <errno.h>
 #include <fcntl.h>
 #include <getopt.h>
 #include <libinput.h>
@@ -2420,6 +2421,32 @@ keybinding(uint32_t mods, xkb_keysym_t sym)
 	return NULL;
 }
 
+static void
+keysound(xkb_keysym_t sym)
+{
+	static int fd = -1;
+	static time_t tried;
+	char c = sym == XKB_KEY_Return || sym == XKB_KEY_KP_Enter ? 'r'
+		: sym == XKB_KEY_BackSpace ? 'b' : sym == XKB_KEY_space ? 's' : 'k';
+	if (sym >= XKB_KEY_Shift_L && sym <= XKB_KEY_Hyper_R)
+		return;
+	if (fd < 0) {
+		char path[256];
+		const char *dir = getenv("XDG_RUNTIME_DIR");
+		time_t now = time(NULL);
+		if (now == tried)
+			return;
+		tried = now;
+		snprintf(path, sizeof(path), "%s/tinyhat-keys", dir ? dir : "/tmp");
+		if ((fd = open(path, O_WRONLY | O_NONBLOCK | O_CLOEXEC)) < 0)
+			return;
+	}
+	if (write(fd, &c, 1) < 0 && errno != EAGAIN) {
+		close(fd);
+		fd = -1;
+	}
+}
