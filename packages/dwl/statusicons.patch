+/* Status items that start with an icon: V/M volume (muted), B/C battery (charging), H too hot */
+static int
+iconkind(const char *s, const char *p)
+{
+	if (!*p || !strchr("VMBCH", *p) || !(p == s || (p - s >= 3 && !strncmp(p - 3, " | ", 3))))
+		return 0;
+	if (*p == 'H')
+		return !p[1] || !strncmp(p + 1, " | ", 3) ? 'H' : 0;
+	return p[1] == ' ' && p[2] >= '0' && p[2] <= '9' ? *p : 0;
 }
 
