+
+static double
+polydist(const double (*pt)[2], int n, double x, double y)
+{
+	double best = 1e9;
+	for (int i = 0, j = n - 1; i < n; j = i++) {
+		double ex = pt[i][0] - pt[j][0], ey = pt[i][1] - pt[j][1];
+		double t = ((x - pt[j][0]) * ex + (y - pt[j][1]) * ey) / (ex * ex + ey * ey);
+		t = t < 0 ? 0 : t > 1 ? 1 : t;
+		best = MIN(best, hypot(x - pt[j][0] - t * ex, y - pt[j][1] - t * ey));
+	}
+	return best;
 }
 
