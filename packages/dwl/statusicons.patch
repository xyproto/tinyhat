+/* Draw a status icon straight into the bar, antialiased with 4x4 samples per pixel */
+static void
+drawicon(Monitor *m, int x, int kind, int arg)
+{
+	pixman_image_t *img = m->drw->image;
+	uint32_t *data = pixman_image_get_data(img), bg = colors[SchemeStatus][1];
+	int stride = pixman_image_get_stride(img) / 4, iw = pixman_image_get_width(img), ih = pixman_image_get_height(img);
+	int s = m->b.height * 5 / 8, oy = (m->b.height - s) / 2, w = iconpx(m, kind);
+	for (int py = 0; py < s; py++)
+		for (int px = 0; px < w; px++) {
+			unsigned int r = 0, g = 0, b = 0;
+			if (x + px < 0 || x + px >= iw || oy + py < 0 || oy + py >= ih)
+				continue;
+			for (int i = 0; i < 16; i++) {
+				uint32_t c = iconpixel(kind, arg, (px + (i % 4 + 0.5) / 4) / s, (py + (i / 4 + 0.5) / 4) / s);
+				c = c ? c : bg;
+				r += c >> 24;
+				g += c >> 16 & 0xff;
+				b += c >> 8 & 0xff;
+			}
+			data[(oy + py) * stride + x + px] = 0xff000000 | (r / 16) << 16 | (g / 16) << 8 | b / 16;
+		}
+}
