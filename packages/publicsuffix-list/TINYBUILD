set pkgname publicsuffix-list
set _gitcommit ee780bcf233174cb23ba8575d54c4154d47508e1
set pkgver 20260507.2070.ee780bcf
set pkgrel 1
set pkgdesc 'Cross-vendor public domain suffix database'
set arch any
set url https://github.com/publicsuffix/list
set nvchecker source=manual
set license MPL-2.0
set source "$pkgname-$_gitcommit.tar.gz::https://github.com/publicsuffix/list/archive/$_gitcommit.tar.gz"
set sha256sums e8273a038785f7172cb7399e8063d02d6c02357775f280e4047ec4db6e51bd0f
set flags arch

function package
    cd list-$_gitcommit; or return
    install -Dm644 -t "$pkgdir/usr/share/publicsuffix" public_suffix_list.dat tests/test_psl.txt; or return
    ln -s public_suffix_list.dat "$pkgdir/usr/share/publicsuffix/effective_tld_names.dat"; or return
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE; or return
end
