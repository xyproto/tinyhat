set pkgname python-pyproject-hooks
set pkgver 1.3.3
set pkgrel 1
set pkgdesc 'A low-level library for calling build-backends in pyproject.toml-based project'
set arch any
set url https://github.com/pypa/pyproject-hooks
set license MIT
set depends python
set makedepends python-flit-core python-installer
set source "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
set sha512sums 866d7c9092202adddc3a6f19856fb34191daf0455bc1abf8bdbabb32d1fc386daa5eaf3a3c5124c5000e2b0b0c70cf51b97c9a02a31c853a7f0bf4ebed2eb1ea
set b2sums 1c3b4482ef5c89d04613927c689dd3cbe2d4f2b1980445b3b7a700a547d3131d1369058e3bcf0aab29d89c91e9a9eb759fd75a6579518c91e3a950e8cc734a24
set flags arch

# Bootstrap: built with flit_core directly, because python-build depends on python-pyproject-hooks

function build
    cd pyproject-hooks-$pkgver; or return
    python -m flit_core.wheel; or return
end

function package
    cd pyproject-hooks-$pkgver; or return
    python -m installer --destdir="$pkgdir" dist/*.whl; or return
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
