set pkgname libheif
set pkgver 1.23.6
set pkgrel 1
set pkgdesc 'An HEIF and AVIF file format decoder and encoder'
set arch i686 x32
set url https://github.com/strukturag/libheif
set nvchecker source=git git=https://github.com/strukturag/libheif.git 'exclude_regex=.*(beta|rc).*' prefix=v
set license LGPL-3.0-or-later
set depends aom libaom.so glibc libgcc_s.so libde265 libgcc libgcc_s.so libstdc++ libstdc++.so libwebp libsharpyuv.so openh264 libopenh264.so openh264 libopenh264.so x264 libx264.so x265 libx265.so
set makedepends cmake dav1d ffmpeg git libjpeg-turbo libpng libtiff openjpeg2 svt-av1
set optdepends 'libjpeg-turbo: for heif-dec and heif-enc' 'libpng: for heif-dec and heif-enc' 'libtiff: for heif-dec and heif-enc' 'dav1d: dav1d encoder' 'ffmpeg: hardware decode' 'openjpeg2: JPEG2000 decoder' 'rav1e: rav1e encoder' 'svt-av1: svt-av1 encoder'
set provides libheif.so
set source "git+https://github.com/strukturag/libheif#tag=v$pkgver"
set sha256sums 3a14caa51845aabc12da553bd0b19320e31e5fe02ad4f9aae2181d2068f6154f
set flags arch

function build
    cmake -B build -S $pkgname -DCMAKE_INSTALL_PREFIX=/usr -DWITH_DAV1D=ON -DWITH_RAV1E=OFF -DWITH_FFMPEG_DECODER=ON -DWITH_FFMPEG_DECODER_PLUGIN=ON -DWITH_SvtEnc=ON -DWITH_OpenJPEG_DECODER=ON -DWITH_GDK_PIXBUF=OFF -DWITH_EXAMPLE_HEIF_THUMB=OFF; or return
    cmake --build build; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
end
