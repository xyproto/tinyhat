set pkgname python-distro
set pkgver 1.9.0
set pkgrel 4
set pkgdesc 'Linux OS platform information API'
set url https://github.com/python-distro/distro
set arch any
set license Apache-2.0
set depends python
set makedepends python-sphinx python-build python-installer python-wheel python-setuptools
set checkdepends python-pytest
set options '!makeflags'
set source "$url/archive/v$pkgver/$pkgname-$pkgver.tar.gz"
set sha512sums 9ed033e9fb0a5a531a93d85d8d3c0afb67ec009b851146c76f819617cc13b28a6e6dc412899690baec2aa57d57389a347968c649eb99fefa6f782340166f83c4
set b2sums e50d91a9eba711a8196a6a8bb078c5d8611955fd042dea398aa40db238bbabda55e09d142dd95c769d4e7032425412eb1bacede67053d3e5f1c3892d998c0a20
set flags arch

function build
    cd distro-$pkgver; or return
    python -m build --wheel --no-isolation; or return
end

function check
    cd distro-$pkgver; or return
    PYTHONPATH=build/lib pytest; or return
end

function package
    cd distro-$pkgver; or return
    python -m installer --destdir="$pkgdir" dist/*.whl; or return
    install -Dm 644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname"; or return
end
