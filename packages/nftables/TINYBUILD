set pkgname nftables
set epoch 1
set pkgver 1.1.7
set pkgrel 3
set pkgdesc 'Netfilter tables userspace tools'
set arch i686 x32
set url https://netfilter.org/projects/nftables/
set nvchecker source=git git=https://git.netfilter.org/nftables prefix=v
set license GPL-2.0-only
set depends glibc gmp jansson libmnl libnftnl readline
set optdepends 'python: Python bindings' \
    'python-jsonschema: Python bindings'
# No man pages (asciidoc)
set makedepends python python-setuptools python-build \
    git python-installer python-wheel
set backup etc/nftables.conf
set source "git+https://git.netfilter.org/nftables.git?signed#tag=v$pkgver" \
    nftables.conf \
    nftables.service
set sha256sums f2e877f7cd67fb473f5ea4b3b1ab7c9227e939a00d64207979ee9236e1db6570 \
    fa2f984794025339cf2d26d329f9b0bf83a39b9fa310d06b4cc40a0c1b0c8f46 \
    deffeef36fe658867dd9203ec13dec85047a6d224ea63334dcf60db97e1809ea
set flags arch

function prepare
    cd $pkgname; or return
    autoreconf -fiv; or return
end

function build
    cd $pkgname; or return
    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/usr/share \
        --with-json \
        --with-cli=readline \
        --disable-python \
        --disable-debug \
        --disable-man-doc; or return
    make; or return
    # Building the Python module separately due to the automatic build resulting
    # in an incorrect directory structure and unimportable module (see FS#79229)
    cd py; or return
    python -m build --wheel --no-isolation; or return
end

function package
    pushd $pkgname; or return
    make DESTDIR="$pkgdir" install; or return
    python -m installer --destdir="$pkgdir" py/dist/*.whl; or return
    popd
    # basic safe firewall config
    install -Dm644 nftables.conf "$pkgdir/etc/nftables.conf"; or return
    # systemd
    install -Dm644 nftables.service "$pkgdir/usr/lib/systemd/system/nftables.service"; or return
end
