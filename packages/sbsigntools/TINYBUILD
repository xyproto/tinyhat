set pkgname sbsigntools
set pkgver 0.9.5
set -g _commit 8445b18f64e60137408a4867fbcbb9ba112c583a # refs/tags/v0.9.5
set pkgrel 4
set pkgdesc 'Tools to add signatures to EFI binaries and Drivers'
set arch i686 x32
set url https://git.kernel.org/pub/scm/linux/kernel/git/jejb/sbsigntools.git/about
set license GPL-3.0-or-later
set depends glibc openssl
set makedepends git gnu-efi help2man util-linux sed
set source "git+https://git.kernel.org/pub/scm/linux/kernel/git/jejb/sbsigntools.git#tag=$_commit?signed" \
    git+https://git.ozlabs.org/ccan
set sha256sums 18d476d5497cab8f7f8acb8710481bdd3de887f6109f2deeed9e6bd2571d3f9d \
    SKIP
set flags arch

function prepare
    cd $pkgname; or return
    git submodule init; or return
    git config submodule."lib/ccan.git".url "$srcdir/ccan"; or return
    git -c protocol.file.allow=always submodule update; or return
    ./autogen.sh; or return
end

function build
    set -l configure_options \
        --prefix=/usr \
        --bindir=/usr/bin \
        --sbindir=/usr/bin \
        --libexecdir=/usr/lib \
        --mandir=/usr/share/man \
        --sysconfdir=/etc

    cd $pkgname; or return
    CFLAGS="$CFLAGS -fshort-wchar -Wno-error" ./configure $configure_options; or return
    make; or return
end

function package
    set -a depends util-linux-libs libuuid.so

    make DESTDIR="$pkgdir" install -C $pkgname; or return
    install -vDm 644 $pkgname/{AUTHORS,ChangeLog,NEWS,README} -t "$pkgdir/usr/share/doc/$pkgname/"; or return
end
