set pkgname algernon
set pkgver 1.17.13.r5.g12ea2d9
set pkgrel 1
set -g _commit 12ea2d92720eb73ec2e70db2d403017a5f4b1f68
set pkgdesc 'Web server with Lua, Markdown, QUIC, Redis and PostgreSQL support'
set arch i686
set url https://algernon.roboticoverlords.org/
set license BSD-3-Clause
set makedepends git go-tinyhat
set depends glibc
set optdepends 'mariadb: For using the MariaDB/MySQL database backend' \
    'ollama: For using Ollama from Lua or .prompt files' \
    'postgresql: For using the PostgreSQL database backend' \
    'redis: For using the Redis database backend' \
    'valkey: For using the Redis database backend'
set options docs
set source "git+https://github.com/xyproto/algernon#commit=$_commit"
set b2sums SKIP
set flags arch

function prepare
    cd $pkgname; or return
    set -lx GOROOT /usr/lib/go-tinyhat
    set -lx GOPATH "$srcdir/gopath"
    set -lx GOCACHE "$srcdir/gocache"
    set -lx GOTOOLCHAIN local
    set -lx CGO_ENABLED 0
    set -lx GOARCH 386
    set -lx GO386 softfloat
    switch $CARCH
        case aarch64
            set GOROOT /usr/lib/go
            set GOARCH arm64
        case x86_64
            set GOROOT /usr/lib/go
            set GOARCH amd64
    end
    set -lx PATH $GOROOT/bin $PATH
    go build -buildvcs=false -ldflags "-s -w" -mod=readonly -modcacherw -trimpath; or return
end

function package
    cd $pkgname; or return
    install -Dm755 algernon "$pkgdir/usr/bin/algernon"; or return
    install -d "$pkgdir/usr/share/doc/$pkgname/samples"; or return
    cp -r samples "$pkgdir/usr/share/doc/$pkgname/samples"; or return
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"; or return

    cd system; or return
    install -Dm644 logrotate "$pkgdir/etc/logrotate.d/algernon"; or return
    install -Dm644 serverconf.lua "$pkgdir/etc/algernon/serverconf.lua"; or return
    install -Dm644 algernon.service "$pkgdir/usr/share/doc/$pkgname/algernon.service.example"; or return
    install -Dm644 algernon_dev.service "$pkgdir/usr/share/doc/$pkgname/algernon_dev.service.example"; or return

    cd ../desktop; or return
    install -Dm755 mdview "$pkgdir/usr/bin/mdview"; or return
    install -Dm644 algernon.desktop "$pkgdir/usr/share/applications/algernon.desktop"; or return
    install -Dm644 algernon_md.desktop "$pkgdir/usr/share/applications/algernon_md.desktop"; or return
    install -Dm644 markdown.png "$pkgdir/usr/share/pixmaps/markdown.png"; or return
end
