set pkgbase openmpi
set pkgname openmpi openmpi-docs
set pkgver 5.0.11
set pkgrel 1
set pkgdesc 'High performance message passing library (MPI)'
set arch i686 x32
set url https://www.open-mpi.org
set nvchecker source=git git=https://github.com/open-mpi/ompi prefix=v 'exclude_regex=.*(pre|rc|alpha|beta).*'
set license 'BSD-3-Clause AND LicenseRef-MPICH'
# nvidia-utils is for libcuda.so
# No valgrind: the memchecker (valgrind memory checks of MPI buffers, a debugging aid) is not built
set makedepends cuda nvidia-utils gcc-fortran glibc hip-runtime-amd hwloc libgcc libevent libfabric openpmix openucc \
    openucx prrte
set flags arch
set source "https://www.open-mpi.org/software/ompi/v"(string replace -r '\.[^.]*$' '' -- $pkgver)"/downloads/$pkgbase-$pkgver.tar.bz2"
set sha256sums e668a3c4acd50c41dc204c8a6dd98a611e0f26af89cf677577fa9be8a2698003
set b2sums 0e25f4ba8a8c94b3370e80d060d1bf21d631311cfea5ef30b55fad4e3a708d21342687a49edcb8ddcd2d63244db2c6cf278fcb1dba38c47ce1fb46c1bcf370a1

function _pick
    set -l p $argv[1]
    for f in $argv[2..-1]
        set -l d "$srcdir/$p/"(string replace -- "$pkgdir/" '' $f)
        mkdir -p (dirname $d); or return
        mv $f $d; or return
        rmdir -p --ignore-fail-on-non-empty (dirname $f); or return
    end
end

function prepare
    cd $pkgbase-$pkgver; or return
    # workaround for https://github.com/open-mpi/ompi/issues/12257
    sed -i 's|WRAPPER__FCFLAGS|WRAPPER_FCFLAGS|g' configure; or return
    sed -i 's|WRAPPER_EXTRA_FCFLAGS|WRAPPER_FCFLAGS|g' configure; or return
    sed -i 's|"-I/usr/include",||' opal/tools/wrappers/opal_wrapper.c; or return
end

function build
    # --with-cuda-libdir=/usr/lib tricks the configure script to look for /usr/lib/pkgconfig/cuda.pc
    # instead of /opt/cuda/lib/pkgconfig/cuda.pc.
    # All components that link to libraries provided by optdepends must be run-time loadable (--enable-mca-dso).
    # mpirun should not warn on MCA component load failures by default - usually caused by missing optdepends, which
    # is ok: https://docs.open-mpi.org/en/main/installing-open-mpi/configure-cli-options/installation.html
    set -l configure_options \
        --prefix=/usr \
        --enable-builtin-atomics \
        --enable-mpi-fortran=all \
        --enable-pretty-print-stacktrace \
        --libdir=/usr/lib \
        --sysconfdir=/etc/$pkgbase \
        --with-hwloc=external \
        --with-libevent=external \
        --with-pmix=external \
        --with-prrte=external \
        --with-ucc=/usr \
        --with-ucx=/usr \
        --with-cuda=/opt/cuda \
        --with-cuda-libdir=/usr/lib \
        --with-rocm=/opt/rocm \
        --enable-mca-dso=accelerator_cuda,accelerator_rocm,btl_smcuda,rcache_gpusm,rcache_rgpusm,coll_ucc,scoll_ucc \
        --with-show-load-errors='^accelerator,rcache,coll/ucc'
    cd $pkgbase-$pkgver; or return

    # set environment variables for reproducible build
    # see https://github.com/open-mpi/ompi/blob/main/docs/release-notes/general.rst
    set -lx HOSTNAME buildhost
    set -lx USER builduser

    ./configure $configure_options; or return
    # prevent excessive overlinking due to libtool
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make V=1; or return
end

function check
    make check -C $pkgbase-$pkgver; or return
end

function package_openmpi
    set depends glibc hwloc libgcc libevent libevent_{core,pthreads}-2.1.so libfabric openpmix libpmix.so openucx prrte
    set optdepends 'cuda: cuda support' 'hip-runtime-amd: ROCm support' 'gcc-fortran: fortran support'
    set -a optdepends 'openssh: for execution on remote hosts via plm_ssh_agent'
    set -a optdepends 'openucc: for UCC accelerated collectives'
    set provides libmpi.so libmpi_mpifh.so libmpi_usempi_ignore_tkr.so libmpi_usempif08.so libopen-pal.so liboshmem.so
    set backup etc/$pkgbase/$pkgbase-mca-params.conf

    make DESTDIR="$pkgdir" install -C $pkgbase-$pkgver; or return
    pushd "$pkgdir"; or return
    _pick $pkgbase-docs usr/share/doc
    set -l st $status
    popd
    test $st -eq 0; or return $st
    install -Dm 644 $pkgbase-$pkgver/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end

function package_openmpi-docs
    set pkgdesc "$pkgdesc - documentation"

    mv -v $pkgname/* "$pkgdir"; or return
    install -vDm 644 $pkgbase-$pkgver/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
