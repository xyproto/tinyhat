set pkgname libyuv
set pkgver r2921+644251f25
set pkgrel 1
set pkgdesc 'Library for YUV scaling'
set arch i686 x32
set url https://chromium.googlesource.com/libyuv/libyuv/
set license custom
set depends libgcc libstdc++ libjpeg-turbo
set makedepends cmake git
set -g _commit 644251f252a84bf8ce91ff0aca86a9b16b069ab8
set source "git+$url#commit=$_commit"
set b2sums 74989fbc19963857a4bd12d5ed6a19badf03ff2147c0a65bf23f0ff08a0ec074dd56b4c4051bcf33d783dab5d98622ef413cce2359802277ba94895990c9af1b
set flags arch

function prepare
    sed -i 's|yuvconvert ${JPEG_LIBRARY}|${ly_lib_shared} ${JPEG_LIBRARY}|' $pkgname/CMakeLists.txt; or return
end

function build
    cmake -B build -S $pkgname \
        -DCMAKE_INSTALL_PREFIX=/usr; or return
    make -C build; or return
end

function package
    make -C build DESTDIR="$pkgdir" install; or return
    install -Dm644 $pkgname/LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/; or return
end
