pkgname=nvi2
_commit=02acac8f6c8e44bd07297580bcd101c856d4c475
pkgver=2.2.2+02acac8
pkgrel=1
pkgdesc="Multibyte fork of the nvi editor for BSD, installed as vi"
arch=(i686 x32)
url="https://github.com/lichray/nvi2"
license=(BSD-3-Clause)
depends=(ncurses libbsd)
makedepends=(cmake)
source=("nvi2-$_commit.tar.gz::https://github.com/lichray/nvi2/archive/$_commit.tar.gz"
        "https://deb.debian.org/debian/pool/main/d/db1-compat/db1-compat_2.1.3.orig.tar.gz"
        "https://deb.debian.org/debian/pool/main/d/db1-compat/db1-compat_2.1.3-27.debian.tar.xz")
noextract=(db1-compat_2.1.3-27.debian.tar.xz)
sha256sums=('c364b0811a6597ae985113caf4a422ce5895b8cbe6e3ab99e00193db76dc72f6'
            'b01f560f00a67f921e678586d903969015b0c9cec6c18b1679b7e9fd6d27394e'
            'c659caf72b52f47bc90ebe8b7baa31511d208437601906425072769d164e4816')

prepare() {
  mkdir -p db1-debian
  tar -xJf db1-compat_2.1.3-27.debian.tar.xz -C db1-debian
  cd db
  for p in $(cat ../db1-debian/debian/patches/series); do
    patch -p1 -i ../db1-debian/debian/patches/$p
  done
}

build() {
  cd db
  printf 'libdb1.a: $(patsubst %%,%%.o,$(libdb1-routines))\n\tar rcs $@ $^\n' >static.mk
  make -f Makefile -f static.mk libdb1.a CFLAGS="$CFLAGS -Wno-implicit-function-declaration"
  cd ..
  cmake -S nvi2-$_commit -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_C_FLAGS="$CFLAGS -D_GNU_SOURCE" -DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS -L$srcdir/db" \
    -DDB_INCLUDE_DIR="$srcdir/db"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  for l in vi vim ex view; do
    ln -s nvi "$pkgdir/usr/bin/$l"
  done
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/tmpfiles.d/nvi2.conf" <<<'d /var/tmp/vi.recover 1777 root root -'
  install -Dm644 nvi2-$_commit/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 db1-debian/debian/copyright "$pkgdir/usr/share/licenses/$pkgname/db1-copyright"
}
