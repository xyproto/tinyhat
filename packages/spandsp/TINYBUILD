set pkgbase spandsp
set pkgname spandsp
set pkgver 3.1.1
set pkgrel 1
set pkgdesc 'Low-level signal processing library that modulates and demodulates signals commonly used in telephony'
set arch i686 x32
set url https://github.com/freeswitch/spandsp
set nvchecker source=github github=freeswitch/spandsp use_max_tag=true prefix=v
set license LGPL-2.1-only
set depends glibc libtiff
# No documentation package (docbook-xsl, doxygen)
set source "$pkgbase-$pkgver.tar.gz::https://github.com/freeswitch/spandsp/archive/refs/tags/v$pkgver.tar.gz"
set b2sums 5e9a6747555c93d7f6421b0799ae5d39ec33253e7fae2f3764286f86e2b174f3a6d4907e772f87bd612668c27627ca166b5c282bdb222a2a61b9adc0880e5042
set flags arch

function prepare
    cd $pkgbase-$pkgver; or return
    autoreconf -fi; or return
end

function build
    cd $pkgbase-$pkgver; or return
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var; or return
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make; or return
end

function package_spandsp
    set provides libspandsp.so

    cd $pkgbase-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
end
