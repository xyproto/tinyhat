set pkgname tllist
set pkgver 1.1.0
set pkgrel 2
set pkgdesc 'A typed linked list C header file only library'
set arch i686 x32
set url https://codeberg.org/dnkl/tllist
set license MIT
set makedepends meson
set source "tllist-$pkgver.tar.gz::https://codeberg.org/dnkl/tllist/archive/$pkgver.tar.gz"
set sha256sums 0e7b7094a02550dd80b7243bcffc3671550b0f1d8ba625e4dff52517827d5d23
set flags arch

function build
    arch-meson $pkgname build; or return
end

function package
    meson install -C build --destdir "$pkgdir"; or return
    install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$pkgname/LICENSE"; or return
end
