set pkgname wireless-regdb
set pkgver 2026.09.03
set pkgrel 1
set pkgdesc 'Central Regulatory Domain Database'
set arch any
set url https://wireless.wiki.kernel.org/en/developers/regulatory/wireless-regdb
set license LicenseRef-custom
set depends bash iw
set makedepends git
set replaces crda
set provides crda
set conflicts crda
set backup etc/conf.d/wireless-regdom
set source "git+https://git.kernel.org/pub/scm/linux/kernel/git/wens/wireless-regdb.git?signed#tag=master-$(string replace -a . - -- $pkgver)" \
    wireless-regdom \
    set-wireless-regdom \
    85-regulatory.rules
set b2sums 1f1d4a3aa557f39d777f1f3b44a6b27187d672dc165119880d2866ecaa38a2568b89b63c436aa5ef2bb6a1957cbb1b4756bf421ac48f82f157cf6d81519cb9a1 \
    4d470f76ba0ac3c9c25425cd2ce5c9cb93292e565ab3038e975aa837abaad83325f1340cef8ca73150a07f8e77cd542a485e35daef8c403d48c93814f1ccacea \
    0d245faf594f9051a9941fd5e1b6c02fd0668cf4241ca8bdaa2b2e56a805d5d013db59191b0899745f842974fe978ad4add1cad21c7f5a71bc58968c5d1c4be2 \
    50ff5e8d21db396f57b29677e65970f35433399a2268b22099a48d9dc45817734b544699e1efc6b0e4f4fa95e191e101b25226b4df02f6b7fa75f5036c94d2c0
set flags arch

function package
    install -Dm644 wireless-regdom -t "$pkgdir"/etc/conf.d; or return
    install -Dm644 85-regulatory.rules -t "$pkgdir"/usr/lib/udev/rules.d; or return
    install -Dm755 set-wireless-regdom -t "$pkgdir"/usr/bin; or return

    cd $pkgname; or return
    make install DESTDIR="$pkgdir" MANDIR=usr/share/man FIRMWARE_PATH=usr/lib/firmware; or return

    for dom in (grep ^country db.txt | cut -d' ' -f2 | sed 's|:||g')
        echo "#WIRELESS_REGDOM=\"$dom\"" >>"$pkgdir"/etc/conf.d/wireless-regdom.tmp; or return
    end
    sort -u "$pkgdir"/etc/conf.d/wireless-regdom.tmp >>"$pkgdir"/etc/conf.d/wireless-regdom; or return
    rm "$pkgdir"/etc/conf.d/wireless-regdom.tmp; or return

    install -D -m644 "$srcdir/$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
