set pkgname kbd
set pkgver 2.10.0
set pkgrel 1
set pkgdesc 'Keytable files and keyboard utilities'
set arch i686 x32
set url http://www.kbd-project.org
set nvchecker source=git git=https://git.kernel.org/pub/scm/linux/kernel/git/legion/kbd.git prefix=v
set license GPL-2.0-or-later
set depends glibc gzip pam
set makedepends check git
set source "git+https://git.kernel.org/pub/scm/linux/kernel/git/legion/kbd.git#tag=v$pkgver?signed" \
    fix-euro2.patch \
    vlock.pam
set backup etc/pam.d/vlock
set provides vlock
set conflicts vlock
set replaces vlock
set b2sums e98958b6bd29c1ffe9a22ad2e466db50edebf6f8fbe403b59e70f3a5c44adc11e3948d43a59859b13558107bcc1e63153be2b784bcd8616268fb08bf3f3a5e1d \
    d122ddb1a86e7a282df8e438903f94d697e3d18a24154d976334e6b54b8f1cf1df432cf8dbcd98daa55014ada462f284d0319fbf015554266e91f4d2a8bf812b \
    104543e72331a633572a26059e6dce1f25c3c8d6deabb855dd94bfffb72edf8a53a58c6ea7ef6806dd80bcd6ab0aa47cc1a45cc0cd90330be6514ff7591b5140
set flags arch

function prepare
    cd $pkgname; or return
    # rename keymap files with the same names
    # this is needed because when only name of keymap is specified
    # loadkeys loads the first keymap it can find, which is bad (see FS#13837)
    # this should be removed when upstream adopts the change
    mv data/keymaps/i386/qwertz/cz{,-qwertz}.map; or return
    mv data/keymaps/i386/olpc/es{,-olpc}.map; or return
    mv data/keymaps/i386/olpc/pt{,-olpc}.map; or return
    mv data/keymaps/i386/fgGIod/trf{,-fgGIod}.map; or return
    mv data/keymaps/i386/colemak/{en-latin9,colemak}.map; or return
    # fix euro2 #28213
    patch -Np1 -i ../fix-euro2.patch; or return
    autoreconf -if; or return
end

function build
    cd $pkgname; or return
    ./configure --prefix=/usr \
        --sysconfdir=/etc \
        --datadir=/usr/share/kbd \
        --mandir=/usr/share/man \
        --enable-optional-progs \
        --disable-tests; or return
    make KEYCODES_PROGS=yes RESIZECONS_PROGS=yes; or return
end

function package
    cd $pkgname; or return
    make KEYCODES_PROGS=yes RESIZECONS_PROGS=yes DESTDIR="$pkgdir" install; or return
    install -Dm644 ../vlock.pam "$pkgdir"/etc/pam.d/vlock; or return
end
