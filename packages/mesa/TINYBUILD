function package_vulkan-powervr
    set pkgdesc "Open-source Vulkan driver for PowerVR GPUs"
    set depends expat glibc libdisplay-info libdrm libgcc libstdc++ spirv-tools systemd-libs vulkan-icd-loader vulkan-mesa-implicit-layers wayland zlib zstd
    set optdepends "vulkan-mesa-layers: additional vulkan layers"
    set provides vulkan-driver
    mv vkpowrvr/* "$pkgdir"; or return
    install -Dm644 mesa-$_pkgver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end

