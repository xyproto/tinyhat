function _gencrates
    grep '^source_url' subprojects/*-rs.wrap | sed -r 's|.*crates/([^/]+)/([0-9.]+)/download|\1 \2|' | column -t -S 2 | sed 's/^/  /'; or return
end

function _pick
    set -l p "$argv[1]"
    set -l f
    set -l d
    set -e argv[1]
    for f in $argv
        set d "$srcdir/$p/$(string replace -r -- '^'(string escape --style=regex -- "$pkgdir")'/' '' "$f")"
        mkdir -p "$(dirname "$d")"; or return
        mv -v "$f" "$d"; or return
        rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"; or return
    end
end

function package_mesa
    set depends expat glibc libdrm libelf libgcc libglvnd libstdc++ llvm-libs lm_sensors spirv-tools wayland zlib zstd
    set optdepends "opengl-man-pages: for the OpenGL API man pages"
