    set conflicts 'libva-mesa-driver<1:24.2.7-1' 'mesa-libgl<17.0.1-2'
    set replaces 'libva-mesa-driver<1:24.2.7-1' 'mesa-libgl<17.0.1-2'
    meson install -C build --destdir "$pkgdir" --no-rebuild; or return
    begin
        set -l __subshell_pwd $PWD
    set -l libdir usr/lib
        cd "$pkgdir"; or return
        _pick vkasahi $libdir/libvulkan_asahi.so; or return
        _pick vkasahi usr/share/vulkan/icd.d/asahi_icd.json; or return
        _pick vkbrcom $libdir/libvulkan_broadcom.so; or return
        _pick vkbrcom usr/share/vulkan/icd.d/broadcom_icd.json; or return
        _pick vkd3d12 $libdir/libvulkan_dzn.so; or return
        _pick vkd3d12 $libdir/libspirv_to_dxil.*; or return
        _pick vkd3d12 usr/bin/spirv2dxil; or return
        _pick vkd3d12 usr/share/vulkan/icd.d/dzn_icd.json; or return
        _pick vkfdreno $libdir/libvulkan_freedreno.so; or return
        _pick vkfdreno usr/share/vulkan/icd.d/freedreno_icd.json; or return
        _pick vkgfxstr $libdir/libvulkan_gfxstream.so; or return
        _pick vkgfxstr usr/share/vulkan/icd.d/gfxstream_vk_icd.json; or return
        _pick vkintel $libdir/libvulkan_intel{,_hasvk}.so; or return
        _pick vkintel usr/share/vulkan/icd.d/intel{,_hasvk}_icd.json; or return
        _pick vkpfrost $libdir/libvulkan_panfrost.so; or return
        _pick vkpfrost usr/share/vulkan/icd.d/panfrost_icd.json; or return
        _pick vkpowrvr $libdir/libvulkan_powervr_mesa.so; or return
        _pick vkpowrvr usr/share/vulkan/icd.d/powervr_mesa_icd.json; or return
        _pick vkradeon $libdir/libvulkan_radeon.so; or return
        _pick vkradeon usr/share/drirc.d/00-radv-defaults.conf; or return
        _pick vkradeon usr/share/vulkan/icd.d/radeon_icd.json; or return
        _pick vkswrast $libdir/libvulkan_lvp.so; or return
        _pick vkswrast usr/share/vulkan/icd.d/lvp_icd.json; or return
        _pick vkvirtio $libdir/libvulkan_virtio.so; or return
        _pick vkvirtio usr/share/vulkan/icd.d/virtio_icd.json; or return
        _pick vkdevice $libdir/libVkLayer_MESA_anti_lag.so; or return
        _pick vkdevice $libdir/libVkLayer_MESA_device_select.so; or return
        _pick vkdevice usr/share/vulkan/implicit_layer.d; or return
        _pick vklayer $libdir/libVkLayer_*.so; or return
        _pick vklayer usr/bin/mesa-*-control.py; or return
