function prepare
    cd mesa-$_pkgver; or return
    set -l src
    for src in $source
        set src "$(string replace -r -- '(.*?)::.*$' '$1' "$src")"
        set src "$(string replace -r -- '^.*/' '' "$src")"
        set src "$(string replace -r -- '(.*)\.zst$' '$1' "$src")"
        if not string match -q -- '*.patch' $src
            continue
        end
        echo "Applying patch $src..."; or return
        patch -Np1 < "../$src"; or return
    end
    echo "$_pkgver-arch$epoch.$pkgrel" > VERSION; or return
end

