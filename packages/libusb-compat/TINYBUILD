set pkgname libusb-compat
set pkgver 0.1.9
set pkgrel 1
set pkgdesc 'Library to enable user space application programs to communicate with USB devices'
set arch i686 x32
set url http://libusb.sourceforge.net/
set nvchecker source=git git=https://github.com/libusb/libusb-compat-0.1.git prefix=v 'exclude_regex=.*(beta|rc).*'
set license LGPL-2.0-or-later
set depends libusb sh
set source "https://github.com/libusb/libusb-compat-0.1/releases/download/v$pkgver/libusb-compat-$pkgver.tar.gz"
set sha256sums b09aa33e943080352041ea3d5ac01fd90ea96e9337212865de0dda776886dbb9
set flags arch

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr --disable-static; or return
    make; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
end
