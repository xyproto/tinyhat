set pkgname gawk
set pkgver 5.4.1
set pkgrel 2
set pkgdesc 'GNU version of awk'
set arch i686 x32
set url https://www.gnu.org/software/gawk/
set nvchecker source=git git=https://git.savannah.gnu.org/git/gawk.git prefix=gawk-
set license GPL-3.0-or-later
set depends sh glibc mpfr
set source "https://ftp.gnu.org/pub/gnu/gawk/gawk-$pkgver.tar.gz"
set sha256sums 8b3b0ea83930311a3f30905d3ce898d32c6103c2fe20d6a90b40341171b174de
set flags arch

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr --libexecdir=/usr/lib --sysconfdir=/etc --without-libsigsegv; or return
    make; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    # /usr/bin/awk is nawk in Tiny Hat (packages/nawk), so that both can be installed
    rm "$pkgdir/usr/bin/awk"; or return
end
