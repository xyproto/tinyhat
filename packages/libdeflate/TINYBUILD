set pkgname libdeflate
set pkgver 1.26
set pkgrel 2
set pkgdesc 'Heavily optimized library for DEFLATE/zlib/gzip compression and decompression'
set arch i686 x32
set url https://github.com/ebiggers/libdeflate
set nvchecker source=git git=https://github.com/ebiggers/libdeflate.git prefix=v
set license MIT
set depends glibc
set makedepends cmake git ninja
set provides libdeflate.so
set source "git+https://github.com/ebiggers/libdeflate.git#tag=v$pkgver"
set sha256sums 38a3ffe3a56fba0e95138a5f57a764ffd5632c49dcd6a3515536f8a1ee907a9d
set flags arch

function build
    cmake -S libdeflate -B build -G Ninja -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr -DLIBDEFLATE_BUILD_STATIC_LIB=OFF -DLIBDEFLATE_BUILD_TESTS=OFF; or return
    cmake --build build; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
    install -Dm 644 libdeflate/COPYING -t "$pkgdir"/usr/share/licenses/libdeflate/; or return
end
