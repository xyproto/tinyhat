set pkgname pango
set pkgver 1.58.2
set pkgrel 1
set epoch 1
set pkgdesc 'A library for layout and rendering of text'
set arch i686 x32
set url https://www.pango.org/
set license LGPL-2.1-or-later
set depends libcairo.so 'fontconfig>=2:2.17.0' freetype2 fribidi 'glib2>=2.88' glibc 'harfbuzz>=11.0.0' libthai
set makedepends git glib2-devel gobject-introspection help2man meson glib2-introspection
set source "git+https://gitlab.gnome.org/GNOME/pango.git#tag=$pkgver"
set sha256sums e7d40762b02df495069444e7fe649c6203b8b2280c71498e40d41dc6266e7655
set flags arch
set -g BASH_REMATCH libxrender libxrender
set -g _d cairo 'fontconfig>=2:2.17.0' freetype2 fribidi 'glib2>=2.88' glibc 'harfbuzz>=11.0.0' libthai
set -g _p libthai

function prepare
    cd pango; or return
end

function build
    set -l meson_options -D documentation=false -D sysprof=disabled -D xft=disabled
    arch-meson pango build $meson_options; or return
    meson compile -C build; or return
end

function package_pango
    set provides libpango{,cairo,ft2,xft}-1.0.so
    meson install -C build --destdir "$pkgdir"; or return
end

function package_pango-docs
    set pkgdesc "$pkgdesc (documentation)"
    set depends
    mv doc/* "$pkgdir"; or return
end
