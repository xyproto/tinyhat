set pkgbase sof-bin
switch $CARCH
    case x86_64
        set pkgname sof-firmware sof-tools
    case '*'
        set pkgname sof-firmware
end
set pkgver 2026.09.2
set pkgrel 1
set pkgdesc 'Sound Open Firmware'
set url https://www.sofproject.org/
set nvchecker source=git git=https://github.com/thesofproject/sof-bin.git prefix=v
set arch i686 x32
set license 'BSD-3-Clause AND ISC'
set flags arch
set source https://github.com/thesofproject/sof-bin/releases/download/v$pkgver/sof-bin-$pkgver.tar.gz
set b2sums 141801c34c3c8fba9dcc556cbe629310f3fb501c86eda3eb77d43b4de050d10b3d117045b46af7ccfec8e0d75284212587652f7ad3a8b84523ed84e047b1bd21

function prepare
    cd sof-bin-$pkgver; or return
    sha256sum -c sha256sum.txt; or return
end

function package_sof-firmware
    set -a options '!strip'

    set -l fwdir "$pkgdir/usr/lib/firmware/intel"
    mkdir -p "$fwdir"; or return

    cd sof-bin-$pkgver; or return

    cp -at "$fwdir" sof*; or return

    install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 LICENCE* Notice*; or return
end

function package_sof-tools
    set pkgdesc "$pkgdesc - tools"
    set depends alsa-lib glibc python

    cd sof-bin-$pkgver; or return

    install -Dt "$pkgdir/usr/bin" tools/*; or return
    install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 LICENCE* Notice*; or return
end
