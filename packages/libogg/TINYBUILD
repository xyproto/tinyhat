set pkgname libogg
set pkgver 1.3.6
set pkgrel 1
set pkgdesc 'Ogg bitstream and framing library'
set arch i686 x32
set url https://www.xiph.org/ogg/
set nvchecker source=git git=https://github.com/xiph/ogg.git prefix=v
set license BSD
set depends glibc
set makedepends cmake git ninja
set provides libogg.so
set source "git+https://github.com/xiph/ogg.git?signed#tag=v$pkgver"
set sha256sums 2e83a0b16d3863e87f3d9372686b00fa0bf62a2641b458b929185103645fdf35
set flags arch

function prepare
    cd ogg; or return
end

function build
    cmake -S ogg -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_SHARED_LIBS=ON; or return
    cmake --build build; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
    install -Dm 644 ogg/COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/; or return
    install -Dm 644 ogg/ogg.m4 -t "$pkgdir"/usr/share/aclocal/; or return
end
