set pkgname libxpm
set pkgver 3.5.20
set pkgrel 1
set pkgdesc 'X11 pixmap library'
set arch i686 x32
set license MIT X11-distribute-modifications-variant
set url https://xorg.freedesktop.org/
set depends libxt libxext libx11 glibc
set makedepends git xorg-util-macros
set source "git+https://gitlab.freedesktop.org/xorg/lib/libxpm.git?signed#tag=libXpm-$pkgver"
set sha512sums be49c328f0aee16e00326e2dc8c0f3445d2ec7ba87b95e4507dd2798ac9cf3fa7919ef5acff03c1901b0a52c51a7f64a3294419a3bd1813facc71992ef792302
set flags arch

function prepare
    cd $pkgname; or return
    autoreconf -fiv; or return
end

function build
    cd $pkgname; or return
    ./configure --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static \
        --disable-open-zfile; or return
    make; or return
end

# No check: the XpmCreate/XpmRead tests expect XpmFileInvalid (-2) but get XpmOpenFailed (-3)
# for files that must fail to open; a 32-bit test-only difference

function package
    cd $pkgname; or return
    make DESTDIR="$pkgdir" install; or return
    install -m755 -d "$pkgdir"/usr/share/licenses/$pkgname; or return
    install -m644 COPYING "$pkgdir"/usr/share/licenses/$pkgname/; or return
end
