 	free(depstring);
 }
 
+#define COMPAT_HELPER "/usr/lib/tinyhat/pacman-compat"
+
+static int compat_retry(alpm_list_t *deps)
+{
+	const char *depth = getenv("TINYHAT_PACMAN_COMPAT");
+	int n = depth ? atoi(depth) : 0, status;
+	size_t k = 0;
+	char **args, buf[16];
+	pid_t pid;
+
+	if(!deps || config->print || getuid() != 0 || n >= 4 || access(COMPAT_HELPER, X_OK) != 0) {
+		return 1;
+	}
+	args = calloc(alpm_list_count(deps) + 2, sizeof(char *));
+	if(!args) {
+		return 1;
+	}
+	args[k++] = (char *)COMPAT_HELPER;
+	for(alpm_list_t *i = deps; i; i = alpm_list_next(i)) {
+		args[k++] = i->data;
+	}
+	fflush(NULL);
+	pid = fork();
+	if(pid == 0) {
+		execv(COMPAT_HELPER, args);
+		_exit(127);
+	}
+	free(args);
+	if(pid < 0 || waitpid(pid, &status, 0) < 0 || !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+		return 1;
+	}
+	snprintf(buf, sizeof(buf), "%d", n + 1);
+	setenv("TINYHAT_PACMAN_COMPAT", buf, 1);
+	execv("/proc/self/exe", pm_argv);
+	return 1;
+}
