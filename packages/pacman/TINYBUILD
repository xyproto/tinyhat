# No documentation and no man pages (asciidoc, doxygen): -Ddoc=disabled -Ddoxygen=disabled
set makedepends git meson
set checkdepends fakechroot python
set optdepends 'base-devel: required to use makepkg' \
    'perl-locale-gettext: translation support in makepkg-template'
set provides libalpm.so
set backup etc/pacman.conf etc/makepkg.conf etc/makepkg.conf.d/fortran.conf etc/makepkg.conf.d/rust.conf
# The last patch makes pacman detect the architecture automatically
set source "git+https://gitlab.archlinux.org/pacman/pacman.git?signed#tag=v$_git_tag" \
