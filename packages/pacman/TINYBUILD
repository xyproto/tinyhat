set pkgname pacman
set pkgver 7.1.0.r9.g54d9411
set pkgrel 3
set -g _git_tag 7.1.0
set -g _git_patch_level_commit 54d94116164b0b2202c6061c4a59c6f3e70820d8
set pkgdesc 'A library-based package manager with dependency support'
set arch i686 x32
set url https://www.archlinux.org/pacman/
set license GPL-2.0-or-later
set depends bash coreutils curl libcurl.so gawk gettext glibc gnupg gpgme libgpgme.so grep libarchive libarchive.so \
    openssl libcrypto.so pacman-mirrorlist systemd libmakepkg-dropins archlinux32-keyring
# doxygen is not a makedepend, the docs are disabled (broken Python/asciidoc)
set makedepends asciidoc git meson
set checkdepends fakechroot python
set optdepends 'base-devel: required to use makepkg' \
    'perl-locale-gettext: translation support in makepkg-template'
set provides libalpm.so
set backup etc/pacman.conf etc/makepkg.conf etc/makepkg.conf.d/fortran.conf etc/makepkg.conf.d/rust.conf
# The last patch makes pacman detect the architecture automatically
set source "git+https://gitlab.archlinux.org/pacman/pacman.git?signed#tag=v$_git_tag" \
    revertme-makepkg-remove-libdepends-and-libprovides.patch::https://gitlab.archlinux.org/pacman/pacman/-/commit/354a300cd26bb1c7e6551473596be5ecced921de.patch \
    patch-reproducible-builds.patch::https://gitlab.archlinux.org/pacman/pacman/-/commit/f4bdb77470528019aaba4d8b8f947e918c6db17d.patch \
    0001-libalpm-invalidate-curl-data-in-child.patch \
    0002-libalpm-use-curl-s-effective-url-without-authenticat.patch \
    pacman.conf \
    makepkg.conf \
    alpm.sysusers \
    fortran.conf \
    rust.conf \
    replace-i686-by-pentium4-when-architecture-is-auto.patch
set sha256sums 74cfd4b6d2b10c742f5a4a7cdaeffb01405ab897b11b80681a9063245113a308 \
    b3bce9d662e189e8e49013b818f255d08494a57e13fc264625f852f087d3def2 \
    de428b496a825772ef49ec5555a386a4b23ffa10b9dfd9907f0671d5c1dc2178 \
    9a734e5d75be603d58aa92e8d29a15466b3ac2af6b7d6f6728dd5c3e5ed8758d \
    021893dd44ec23251cfc0f2b81c12d832927ea60095d4d2956d9760e8bbfaa58 \
    b6a21497e35a65ff302e8fff46fac03cbdd386f568bbae9febb7d970f561d04f \
    cada9469c3b3832e8cfa1d2fb0e4ce4d2b5a28a480eb52135ab7aad2b75ee5ec \
    9c14afbc7dabee5a563202c833a043bd3b80c4522f8943c33d550641d7d1bbf1 \
    933b0b878fa611bf24b92f655040a3bcb4a1b67841d929013802abbb09b2ccf4 \
    6fe03e6ea3f69d99d59a48847a8ae97c2160fca847c7aedf7b89d05e4aa9386d \
    6a7906bd28a57cbcff58d856ffefbbb9096a163aaff79913b4fac69d75d0028a
set flags arch

function prepare
    cd $pkgname; or return
    # apply patch level commits on top of annotated tag
    if test -n "$_git_patch_level_commit"
        if test "v$_git_tag" != (git describe --tags --abbrev=0 $_git_patch_level_commit)
            echo "patch level commit $_git_patch_level_commit is not a descendant of v$_git_tag" >&2
            return 1
        end
        git rebase $_git_patch_level_commit; or return
    end
    # handle patches
    for entry in (string match -r -- '.*.patch.*' $source)
        set -l patch (string replace -r -- '::.*' '' $entry | string replace -r -- '.*/' '')
        if string match -q 'revertme-*' -- $patch
            echo "Reverting patch $patch..."
            patch -RNp1 <"../$patch"; or return
        else
            echo "Applying patch $patch..."
            patch -Np1 <"../$patch"; or return
        end
    end
end

function build
    cd $pkgname; or return
    # -Ddoc=disabled: broken Python/asciidoc
    meson --prefix=/usr \
        --buildtype=plain \
        -Ddoc=disabled \
        -Ddoxygen=disabled \
        -Dscriptlet-shell=/usr/bin/bash \
        -Dldconfig=/usr/bin/ldconfig \
        build; or return
    meson compile -C build; or return
end

function check
    cd $pkgname; or return
    meson test -C build; or return
end

function package
    cd $pkgname; or return
    DESTDIR="$pkgdir" meson install -C build; or return
    # install Arch specific stuff
    install -dm755 "$pkgdir/etc"; or return
    install -m644 "$srcdir/pacman.conf" "$pkgdir/etc"; or return
    install -m644 "$srcdir/makepkg.conf" "$pkgdir/etc"; or return
    if test $CARCH != i686
        # patch architecture where needed
        sed -i "s@i686@$CARCH@g; /^CHOST/ s/pentium4-/i686-/" "$pkgdir/etc/makepkg.conf"; or return
    end
    install -D -m644 "$srcdir/alpm.sysusers" "$pkgdir"/usr/lib/sysusers.d/alpm.conf; or return
    install -m644 "$srcdir/fortran.conf" "$pkgdir/etc/makepkg.conf.d"; or return
    install -m644 "$srcdir/rust.conf" "$pkgdir/etc/makepkg.conf.d"; or return
    set -l wantsdir "$pkgdir/usr/lib/systemd/system/sockets.target.wants"
    install -dm755 $wantsdir; or return
    for unit in dirmngr gpg-agent gpg-agent-{browser,extra,ssh} keyboxd
        ln -s "../$unit@.socket" "$wantsdir/$unit@etc-pacman.d-gnupg.socket"; or return
    end
end
