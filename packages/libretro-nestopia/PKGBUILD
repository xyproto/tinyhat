pkgname=libretro-nestopia
_commit=f1e02d12664834536edbf7352995a3d0cd1caef4
pkgver=20261031.005001.gf1e02d12664
pkgrel=1
epoch=1
pkgdesc='Nintendo Entertainment System core'
arch=(i686 x32 x86_64 aarch64)
url=https://github.com/libretro/nestopia
license=(GPL-2.0-only)
groups=(libretro)
depends=(glibc libgcc libretro-core-info libstdc++)
makedepends=(git)
source=("libretro-nestopia::git+https://github.com/libretro/nestopia.git#commit=$_commit"
        inline-peekbus.patch)
b2sums=('SKIP'
        'SKIP')

prepare() {
  cd libretro-nestopia
  patch -Np1 -i ../inline-peekbus.patch
}

build() {
  make -C libretro-nestopia/libretro
}

package() {
  install -Dm 644 libretro-nestopia/libretro/nestopia_libretro.so -t "${pkgdir}"/usr/lib/libretro/
  install -Dm 644 libretro-nestopia/COPYING -t "${pkgdir}"/usr/share/licenses/$pkgname/
}
