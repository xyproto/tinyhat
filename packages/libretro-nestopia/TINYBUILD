set pkgname libretro-nestopia
set -g _commit f1e02d12664834536edbf7352995a3d0cd1caef4
set pkgver 20261031.005001.gf1e02d12664
set pkgrel 1
set epoch 1
set pkgdesc 'Nintendo Entertainment System core'
set arch i686 x32 x86_64 aarch64
set url https://github.com/libretro/nestopia
set license GPL-2.0-only
set groups libretro
set depends glibc libgcc libretro-core-info libstdc++
set makedepends git
set source "libretro-nestopia::git+https://github.com/libretro/nestopia.git#commit=$_commit" inline-peekbus.patch
set b2sums SKIP SKIP

function prepare
    cd libretro-nestopia; or return
    patch -Np1 -i ../inline-peekbus.patch; or return
end

function build
    make -C libretro-nestopia/libretro; or return
end

function package
    install -Dm 644 libretro-nestopia/libretro/nestopia_libretro.so -t "$pkgdir"/usr/lib/libretro/; or return
    install -Dm 644 libretro-nestopia/COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/; or return
end
