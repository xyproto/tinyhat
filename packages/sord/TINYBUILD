set pkgbase sord
set pkgname sord sord-docs
set pkgver 0.16.22
set pkgrel 1
set pkgdesc 'A lightweight C library for storing RDF data in memory'
set arch i686 x32
set url https://drobilla.net/software/sord.html
set license ISC
set makedepends doxygen glibc meson pcre2 python-sphinx serd zix
set source "https://download.drobilla.net/$pkgbase-$pkgver.tar.xz"{,.sig}
set sha512sums 3821500f810e3b1cdbd763db419445c931d8b61de571f475646f11a5740c521c93c47ecab2e81a580a0d94bf432faa0de78fe3be1138c87bf9baca8fe23bb0cd \
    SKIP
set b2sums 82745bcaf18282c6aa4d36327f658191fcf61f8a3e9c822ecee1e98ae2e9c11c0654d42a4a0746e76a8ac72624a01fd47a14e9ccf14ee7e78728ee82cdcbdb0f \
    SKIP
set flags arch

function _pick
    set -l p $argv[1]
    for f in $argv[2..-1]
        set -l d "$srcdir/$p/"(string replace -r -- '^'(string escape --style=regex -- "$pkgdir/") '' $f)
        mkdir -p (dirname $d); or return
        mv $f $d; or return
        rmdir -p --ignore-fail-on-non-empty (dirname $f); or return
    end
end

function build
    arch-meson $pkgbase-$pkgver build; or return
    meson compile -C build; or return
end

function check
    meson test -C build; or return
end

function package_sord
    set depends glibc pcre2 serd libserd-0.so zix libzix-0.so
    set provides libsord-0.so
    set optdepends 'sord-docs: for developer documentation'

    meson install -C build --destdir "$pkgdir"; or return
    pushd $pkgdir; or return
    _pick $pkgname-docs usr/share/doc; or return
    popd
    install -vDm 644 $pkgname-$pkgver/LICENSES/*.txt -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
    install -vDm 644 $pkgname-$pkgver/{AUTHORS,NEWS,README.md} -t "$pkgdir/usr/share/doc/$pkgname/"; or return
end

function package_sord-docs
    set pkgdesc "$pkgdesc - documentation"

    mv -v $pkgname/* "$pkgdir"; or return
    mv -v "$pkgdir/usr/share/doc/"sord{-0,}; or return
end
