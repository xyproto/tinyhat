set pkgname libgpg-error
set pkgver 1.61
set pkgrel 1
set pkgdesc 'Support library for libgcrypt'
set arch i686 x32
set url https://www.gnupg.org
set nvchecker source=regex 'regex=libgpg-error-([\d.]+)\.' url=https://www.gnupg.org/download/integrity_check.html
set license LGPL-2.1-or-later 'BSD-3-Clause OR LGPL-2.1-or-later' FSFULLR GPL-2.0-or-later
set depends glibc sh
# https://git.gnupg.org/cgi-bin/gitweb.cgi?p=libgpg-error.git;a=summary
set source "https://www.gnupg.org/ftp/gcrypt/libgpg-error/$pkgname-$pkgver.tar.bz2"
# https://www.gnupg.org/download/integrity_check.html
set sha256sums 7a85413f2bc354f4f8aa832b718af122e48965e9e0eb9012ee659c13c6385c93
set flags arch

function prepare
    cd $pkgname-$pkgver; or return
    autoreconf -vfi; or return
end

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr; or return
    make; or return
end

function check
    cd $pkgname-$pkgver; or return
    make check; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir/" install; or return
    install -vDm 644 COPYING{,.LIB} -t "$pkgdir"/usr/share/licenses/$pkgname/; or return
end
