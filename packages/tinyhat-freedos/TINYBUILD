set pkgname tinyhat-freedos
set pkgver 1.4
set pkgrel 3
set pkgdesc 'FreeDOS 1.4 live boot disk with free DOS games, for the GRUB menu'
set arch any
set url https://www.freedos.org/
set license GPL-2.0-or-later BSD-2-Clause BSD-3-Clause MIT Unlicense LicenseRef-CWSDPMI LicenseRef-PSRINVAD
set makedepends mtools
