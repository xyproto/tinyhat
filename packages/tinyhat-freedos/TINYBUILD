set pkgname tinyhat-freedos
set pkgver 1.4
set pkgrel 4
set pkgdesc 'FreeDOS 1.4 live boot disk with free DOS games, EDIT, NASM and DEBUG, for the GRUB menu'
set arch any
set url https://www.freedos.org/
set license GPL-2.0-or-later GPL-2.0-only BSD-2-Clause BSD-3-Clause MIT LicenseRef-CWSDPMI LicenseRef-PSRINVAD
set makedepends mtools hattoss
set _games https://www.ibiblio.org/pub/micro/pc-stuff/freedos/files/repositories/1.4/games
set source FD14-FloppyEdition.zip::https://www.ibiblio.org/pub/micro/pc-stuff/freedos/files/distributions/$pkgver/FD14-FloppyEdition.zip \
    blkdrop-$pkgver.zip::$_games/blkdrop.zip \
    vitetris-$pkgver.zip::$_games/vitetris.zip \
    sudoku86-$pkgver.zip::$_games/sudoku86.zip \
    psrinvad-$pkgver.zip::$_games/psrinvad.zip \
    ctmouse-$pkgver.zip::https://www.ibiblio.org/pub/micro/pc-stuff/freedos/files/repositories/$pkgver/base/ctmouse.zip \
    edit-$pkgver.zip::https://www.ibiblio.org/pub/micro/pc-stuff/freedos/files/repositories/$pkgver/base/edit.zip \
    debug-$pkgver.zip::https://www.ibiblio.org/pub/micro/pc-stuff/freedos/files/repositories/$pkgver/base/debug.zip \
    nasm-$pkgver.zip::https://www.ibiblio.org/pub/micro/pc-stuff/freedos/files/repositories/$pkgver/devel/nasm.zip
set noextract FD14-FloppyEdition.zip blkdrop-$pkgver.zip vitetris-$pkgver.zip sudoku86-$pkgver.zip psrinvad-$pkgver.zip ctmouse-$pkgver.zip edit-$pkgver.zip debug-$pkgver.zip nasm-$pkgver.zip
