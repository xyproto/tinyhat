function _dosfile -a path
    string join \r\n -- $argv[2..] '' >$path
end

function build
    set -lx MTOOLS_SKIP_CHECK 1
    rm -rf floppy games
    mkdir -p floppy games; or return
    bsdtar -xf FD14-FloppyEdition.zip -C floppy --strip-components=1 144m/x86BOOT.img; or return
    set -l img floppy/x86BOOT.img
    set -l cr \r
    mtype -i $img ::/FDAUTO.BAT | while read -l line
        if string match -q 'if exist %DOSDIR%\\BIN\\FDBANNER.COM*' -- $line
            continue
        else if string match -q 'if exist SETUP.BAT CALL SETUP.BAT BOOT*' -- $line
            printf '%s\n' "CTMOUSE.EXE >NUL$cr" "call MENU.BAT$cr" "goto Done$cr"
        else
            printf '%s\n' $line
        end
    end >floppy/FDAUTO.BAT
    grep -q 'call MENU.BAT' floppy/FDAUTO.BAT; or return
    _dosfile floppy/FDCONFIG.SYS '!COUNTRY=001,858:\FREEDOS\BIN\COUNTRY.SYS' '!LASTDRIVE=Z' '!BUFFERS=20' '!FILES=40' \
        'SHELL=\FREEDOS\BIN\COMMAND.COM \FREEDOS\BIN /E:2048 /P=\FDAUTO.BAT'
    mcopy -o -i $img floppy/FDCONFIG.SYS ::/FDCONFIG.SYS; or return
    mcopy -o -i $img floppy/FDAUTO.BAT ::/FDAUTO.BAT; or return
    bsdtar -xf blkdrop-$pkgver.zip -C games GAMES/BLKDROP/BLKDROP.EXE GAMES/BLKDROP/README.TXT BATLINKS/BLKDROP.BAT SOURCE/BLKDROP/SOURCES.ZIP; or return
    bsdtar -xf games/SOURCE/BLKDROP/SOURCES.ZIP -C games/GAMES/BLKDROP LICENSE; or return
    rm -r games/SOURCE
    bsdtar -xf vitetris-$pkgver.zip -C games GAMES/VITETRIS/TETRIS.EXE GAMES/VITETRIS/CWSDPMI.EXE GAMES/VITETRIS/CWSDPMI.DOC GAMES/VITETRIS/LICENCE.TXT GAMES/VITETRIS/README.TXT GAMES/VITETRIS/VITETRIS.CFG; or return
    bsdtar -xf sudoku86-$pkgver.zip -C games GAMES/SUDOKU86/SUDOKU86.EXE GAMES/SUDOKU86/SUDOKU86.DAT GAMES/SUDOKU86/SUDOKU86.LEV GAMES/SUDOKU86/README.TXT; or return
    bsdtar -xf senet-$pkgver.zip -C games GAMES/SENET/SENET.EXE BATLINKS/SENET.BAT DOC/SENET/COPYING; or return
    mv games/DOC/SENET/COPYING games/GAMES/SENET/COPYING; or return
    _dosfile games/BATLINKS/TETRIS.BAT '@echo off' 'cd %DOSDRV%\GAMES\VITETRIS' 'CWSDPMI.EXE -p -s- >NUL' 'vcls /fGray /bBlack' 'TETRIS.EXE %1 %2 %3' 'CWSDPMI.EXE -u >NUL' 'cd \\'
    _dosfile games/BATLINKS/SUDOKU.BAT '@echo off' 'cd %DOSDRV%\GAMES\SUDOKU86' 'SUDOKU86.EXE %1 %2 %3' 'cd \\'
    bsdtar -xf psrinvad-$pkgver.zip -C games GAMES/PSRINVAD/INVADERS.COM GAMES/PSRINVAD/INVADERS.DOC APPINFO/PSRINVAD.LSM; or return
    rm -rf ow
    mkdir -p ow games/GAMES/HATTOSS; or return
    bsdtar -xf open-watcom-$_ow.tar.xz -C ow ./binl ./h ./lib286; or return
    cp hattoss.c games/GAMES/HATTOSS/HATTOSS.C; or return
    env WATCOM=$srcdir/ow INCLUDE=$srcdir/ow/h PATH=$srcdir/ow/binl:$PATH \
        wcl -q -bt=dos -ms -ox -fe=games/GAMES/HATTOSS/HATTOSS.EXE hattoss.c; or return
    rm -f hattoss.o
    _dosfile games/BATLINKS/HATTOSS.BAT '@echo off' 'cd %DOSDRV%\GAMES\HATTOSS' 'HATTOSS.EXE' 'cd \\'
    bsdtar -xf edit-$pkgver.zip -C games BIN/EDIT.EXE BIN/EDIT.HLP DOC/EDIT/COPYING; or return
    _dosfile games/BATLINKS/MENU.BAT '@echo off' ':Menu' 'vcursor hide' 'vcls /fBlue /bBlack /c0xb0' \
        'vframe /x22 /y1 /w36 /h3 /fYellow /bRed Single Shadow' "vecho /n /fYellow /bRed \"           FreeDOS $pkgver\"" \
        'vgotoxy /x17 /y22' 'vecho /fBlack /bCyan "    Use the arrow keys and Enter to choose    "' \
        'vframe /x18 /y5 /w44 /h15 /fLightCyan /bBlue Double Shadow' \
        'vecho /fYellow "  Choose a game"' 'vline hidden' \
        'vecho /fLightGreen "  Hat Toss"' 'vecho /fLightGreen "  Invaders"' 'vecho /fLightCyan "  Block Drop"' \
        'vecho /fLightCyan "  Tetris"' 'vecho /fLightCyan "  Sudoku"' 'vecho /fLightCyan "  Senet"' 'vecho /fYellow "  Text editor"' \
        'vecho /fYellow "  Install FreeDOS on a hard disk"' 'vecho /fYellow "  Return to DOS"' 'vecho /fYellow "  Restart the computer"' \
        'vchoice /fWhite /bRed /d1' \
        'if errorlevel 100 goto Prompt' 'if errorlevel 10 goto Restart' 'if errorlevel 9 goto Prompt' \
        'if errorlevel 8 goto Setup' 'if errorlevel 7 goto Edit' 'if errorlevel 6 set GAME=SENET' 'if errorlevel 6 goto Run' \
        'if errorlevel 5 set GAME=SUDOKU' 'if errorlevel 5 goto Run' 'if errorlevel 4 set GAME=TETRIS' 'if errorlevel 4 goto Run' \
        'if errorlevel 3 set GAME=BLKDROP' 'if errorlevel 3 goto Run' 'if errorlevel 2 set GAME=INVADERS' 'if errorlevel 2 goto Run' \
        'set GAME=HATTOSS' \
        ':Run' 'vcls /fGray /bBlack' 'vcursor small' 'call %GAME%.BAT' 'set GAME=' 'goto Menu' \
        ':Edit' 'vcls /fGray /bBlack' 'vcursor small' 'EDIT' 'goto Menu' \
        ':Setup' 'vcls /fGray /bBlack' 'vcursor small' 'cd \\' 'if exist %DOSDRV%\SETUP.BAT call %DOSDRV%\SETUP.BAT' 'goto Menu' \
        ':Restart' 'fdapm warmboot' \
        ':Prompt' 'vcls /fGray /bBlack' 'vcursor small' 'echo Type MENU to return to the menu.'
    _dosfile games/BATLINKS/INVADERS.BAT '@echo off' 'cd %DOSDRV%\GAMES\PSRINVAD' 'INVADERS.COM %1 %2 %3' 'cd \\'
    bsdtar -xf ctmouse-$pkgver.zip -C games BIN/CTMOUSE.EXE; or return
    mcopy -i $img games/BIN/CTMOUSE.EXE games/BIN/EDIT.EXE games/BIN/EDIT.HLP ::/FREEDOS/BIN/; or return
    rm -rf files
    mkdir files; or return
    mcopy -s -n -i $img '::*' files/; or return
    dd if=$img of=boot.bin bs=512 count=1 status=none; or return
    set -l disk floppy/freedos.img
    rm -f $disk
    mformat -C -i $disk -t 80 -h 2 -s 63 -v FREEDOS -N 54484154 -B boot.bin ::; or return
    mcopy -i $disk files/KERNEL.SYS ::; or return
    for f in files/*
        test (path basename -- $f) = KERNEL.SYS; and continue
        mcopy -s -i $disk $f ::; or return
    end
    mcopy -s -i $disk games/GAMES ::/; or return
    mcopy -i $disk games/BATLINKS/*.BAT ::/FREEDOS/BIN/; or return
    minfo -i $disk >/dev/null; or return
    mdir -i $disk ::/GAMES >/dev/null
end

function package
    install -Dm644 floppy/freedos.img $pkgdir/usr/share/tinyhat/freedos.img; or return
    install -Dm644 games/GAMES/BLKDROP/LICENSE $pkgdir/usr/share/licenses/$pkgname/BLKDROP; or return
    install -Dm644 games/GAMES/VITETRIS/LICENCE.TXT $pkgdir/usr/share/licenses/$pkgname/VITETRIS; or return
    install -Dm644 games/GAMES/SUDOKU86/README.TXT $pkgdir/usr/share/licenses/$pkgname/SUDOKU86; or return
    install -Dm644 games/GAMES/SENET/COPYING $pkgdir/usr/share/licenses/$pkgname/SENET; or return
    install -Dm644 games/GAMES/VITETRIS/CWSDPMI.DOC $pkgdir/usr/share/licenses/$pkgname/CWSDPMI; or return
    install -Dm644 games/APPINFO/PSRINVAD.LSM $pkgdir/usr/share/licenses/$pkgname/PSRINVAD; or return
    install -Dm644 games/DOC/EDIT/COPYING $pkgdir/usr/share/licenses/$pkgname/EDIT
end
