function _dosfile -a path
    string join \r\n -- $argv[2..] '' >$path
end

function build
    set -lx MTOOLS_SKIP_CHECK 1
    rm -rf floppy games
    mkdir -p floppy games; or return
    bsdtar -xf FD14-FloppyEdition.zip -C floppy --strip-components=1 144m/x86BOOT.img; or return
    set -l img floppy/x86BOOT.img
    set -l cr \r
    mtype -i $img ::/FDAUTO.BAT | while read -l line
        if string match -q 'if exist %DOSDIR%\\BIN\\FDBANNER.COM*' -- $line
            continue
        else if string match -q 'if exist SETUP.BAT CALL SETUP.BAT BOOT*' -- $line
            printf '%s\n' "CTMOUSE.EXE >NUL$cr" "alias exit=call MENU.BAT$cr" "call MENU.BAT$cr" "goto Done$cr"
        else
            printf '%s\n' $line
        end
    end >floppy/FDAUTO.BAT
    grep -q 'call MENU.BAT' floppy/FDAUTO.BAT; or return
    _dosfile floppy/FDCONFIG.SYS '!COUNTRY=001,858:\FREEDOS\BIN\COUNTRY.SYS' '!LASTDRIVE=Z' '!BUFFERS=20' '!FILES=40' \
        'SHELL=\FREEDOS\BIN\COMMAND.COM \FREEDOS\BIN /E:2048 /P=\FDAUTO.BAT'
    mcopy -o -i $img floppy/FDCONFIG.SYS ::/FDCONFIG.SYS; or return
    mcopy -o -i $img floppy/FDAUTO.BAT ::/FDAUTO.BAT; or return
    mkdir -p games/BATLINKS games/GAMES/DPACMAN games/GAMES/BANANOID; or return
    bsdtar -xf dpacman.zip -C games/GAMES/DPACMAN --exclude dpacman.bat --exclude dpacman.ico; or return
    unzip -q bananoid.zip -d games/GAMES/BANANOID; or return
    _dosfile games/BATLINKS/DPACMAN.BAT '@echo off' 'cd %DOSDRV%\GAMES\DPACMAN' 'LOADFIX PACMAN.EXE %1 %2 %3' 'cd \\'
    _dosfile games/BATLINKS/BANANOID.BAT '@echo off' 'cd %DOSDRV%\GAMES\BANANOID' 'BANANOID.EXE %1 %2 %3' 'cd \\'
    bsdtar -xf vitetris-$pkgver.zip -C games GAMES/VITETRIS/TETRIS.EXE GAMES/VITETRIS/CWSDPMI.EXE GAMES/VITETRIS/CWSDPMI.DOC GAMES/VITETRIS/LICENCE.TXT GAMES/VITETRIS/README.TXT GAMES/VITETRIS/VITETRIS.CFG; or return
    _dosfile games/BATLINKS/TETRIS.BAT '@echo off' 'cd %DOSDRV%\GAMES\VITETRIS' 'CWSDPMI.EXE -p -s- >NUL' 'vcls /fGray /bBlack' 'TETRIS.EXE %1 %2 %3' 'CWSDPMI.EXE -u >NUL' 'cd \\'
    bsdtar -xf psrinvad-$pkgver.zip -C games GAMES/PSRINVAD/INVADERS.COM GAMES/PSRINVAD/INVADERS.DOC APPINFO/PSRINVAD.LSM; or return
    mkdir -p games/GAMES/HATTOSS; or return
    cp /usr/share/tinyhat/dos/HATTOSS.EXE /usr/share/hattoss/HATTOSS.C games/GAMES/HATTOSS/; or return
    _dosfile games/BATLINKS/HATTOSS.BAT '@echo off' 'cd %DOSDRV%\GAMES\HATTOSS' 'HATTOSS.EXE' 'cd \\'
    bsdtar -xf edit-$pkgver.zip -C games BIN/EDIT.EXE BIN/EDIT.HLP DOC/EDIT/COPYING; or return
    bsdtar -xf debug-$pkgver.zip -C games BIN/DEBUG.COM; or return
    bsdtar -xf nasm-$pkgver.zip -C games DEVEL/NASM/nasm.exe DEVEL/NASM/ndisasm.exe DEVEL/NASM/cwsdpmi.exe DEVEL/NASM/LICENSE; or return
    _dosfile games/BATLINKS/MENU.BAT '@echo off' ':Menu' 'vcursor hide' 'vcls /fDarkGray /bBlack /c0xfa' \
        'vframe /x22 /y1 /w36 /h3 /fBlack /bCyan Single Shadow' "vecho /n /fBlack /bCyan \"           FreeDOS $pkgver\"" \
        'vgotoxy /x21 /y24' 'vecho /fDarkGray /bBlack "Use the arrow keys and Enter to choose"' \
        'vframe /x18 /y4 /w44 /h16 /fLightCyan /bBlue Double Shadow' \
        'vecho /fWhite "  Games"' 'vecho /fLightGreen "  Hat Toss"' 'vecho /fLightGreen "  Invaders"' \
        'vecho /fLightGreen "  Tetris"' 'vecho /fLightGreen "  Double Pacman"' \
        'vecho /fLightGreen "  Bananoid"' vecho 'vecho /fWhite "  System"' \
        'vecho /fLightCyan "  Text editor"' 'vecho /fLightCyan "  DOS Prompt"' \
        'vecho /fLightCyan "  Install FreeDOS on a hard disk"' 'vecho /fYellow "  Restart the computer"' \
        'vecho /fYellow "  Shutdown the computer"' \
        'if "%SEL%"=="" set SEL=2' ':Choose' 'vchoice /fBlack /bCyan /p %SEL%' 'if errorlevel 100 goto Moved' \
        'if errorlevel 12 goto Shutdown' 'if errorlevel 11 goto Restart' 'if errorlevel 10 goto Setup' \
        'if errorlevel 9 goto Prompt' 'if errorlevel 8 goto Edit' 'if errorlevel 7 goto Choose' \
        'if errorlevel 6 set GAME=BANANOID' 'if errorlevel 6 goto Run' \
        'if errorlevel 5 set GAME=DPACMAN' 'if errorlevel 5 goto Run' \
        'if errorlevel 4 set GAME=TETRIS' 'if errorlevel 4 goto Run' \
        'if errorlevel 3 set GAME=INVADERS' 'if errorlevel 3 goto Run' \
        'if errorlevel 2 set GAME=HATTOSS' 'if errorlevel 2 goto Run' \
        'goto Choose' ':Moved' \
        'if errorlevel 102 if not errorlevel 103 set SEL=2' \
        'if errorlevel 103 if not errorlevel 104 set SEL=3' \
        'if errorlevel 104 if not errorlevel 105 set SEL=4' \
        'if errorlevel 105 if not errorlevel 106 set SEL=5' \
        'if errorlevel 106 if not errorlevel 107 set SEL=6' \
        'if errorlevel 108 if not errorlevel 109 set SEL=8' \
        'if errorlevel 109 if not errorlevel 110 set SEL=9' \
        'if errorlevel 110 if not errorlevel 111 set SEL=10' \
        'if errorlevel 111 if not errorlevel 112 set SEL=11' \
        'if errorlevel 112 if not errorlevel 113 set SEL=12' \
        'if errorlevel 107 if not errorlevel 108 goto System' 'goto Choose' ':System' 'if "%SEL%"=="6" goto SysDown' \
        'set SEL=6' 'goto Choose' ':SysDown' 'set SEL=8' 'goto Choose' \
        ':Run' 'vcls /fGray /bBlack' 'vcursor small' 'call %GAME%.BAT' 'set GAME=' 'goto Menu' \
        ':Edit' 'vcls /fGray /bBlack' 'vcursor small' EDIT 'goto Menu' \
        ':Setup' 'vcls /fGray /bBlack' 'vcursor small' 'cd \\' 'if exist %DOSDRV%\SETUP.BAT call %DOSDRV%\SETUP.BAT' 'goto Menu' \
        ':Restart' 'vcls /fGray /bBlack' 'fdapm warmboot >NUL' \
        ':Shutdown' 'vcls /fGray /bBlack' 'fdapm poweroff >NUL' \
        ':Prompt' 'vcls /fGray /bBlack' 'vcursor small' 'echo Type MENU or EXIT to return to the menu.' \
        'echo Programming tools: EDIT (text editor), NASM (assembler) and DEBUG.'
    _dosfile games/BATLINKS/INVADERS.BAT '@echo off' 'cd %DOSDRV%\GAMES\PSRINVAD' 'INVADERS.COM %1 %2 %3' 'cd \\'
    bsdtar -xf ctmouse-$pkgver.zip -C games BIN/CTMOUSE.EXE; or return
    mcopy -i $img games/BIN/CTMOUSE.EXE games/BIN/EDIT.EXE games/BIN/EDIT.HLP games/BIN/DEBUG.COM ::/FREEDOS/BIN/; or return
    rm -rf files
    mkdir files; or return
    mcopy -s -n -i $img '::*' files/; or return
    dd if=$img of=boot.bin bs=512 count=1 status=none; or return
    set -l disk floppy/freedos.img
    rm -f $disk
    mformat -C -i $disk -t 200 -h 2 -s 63 -v FREEDOS -N 54484154 -B boot.bin ::; or return
    mcopy -i $disk files/KERNEL.SYS ::; or return
    for f in files/*
        test (path basename -- $f) = KERNEL.SYS; and continue
        mcopy -s -i $disk $f ::; or return
    end
    mcopy -s -i $disk games/GAMES ::/; or return
    mcopy -i $disk games/BATLINKS/*.BAT ::/FREEDOS/BIN/; or return
    mcopy -i $disk games/DEVEL/NASM/nasm.exe ::/FREEDOS/BIN/NASM.EXE; or return
    mcopy -i $disk games/DEVEL/NASM/ndisasm.exe ::/FREEDOS/BIN/NDISASM.EXE; or return
    mcopy -i $disk games/DEVEL/NASM/cwsdpmi.exe ::/FREEDOS/BIN/CWSDPMI.EXE; or return
    minfo -i $disk >/dev/null; or return
    mdir -i $disk ::/GAMES >/dev/null
end

function package_tinyhat-freedos
    install -Dm644 floppy/freedos.img $pkgdir/usr/share/tinyhat/freedos.img; or return
    _doslicenses
    install -Dm644 games/GAMES/VITETRIS/CWSDPMI.DOC $pkgdir/usr/share/licenses/$pkgname/CWSDPMI; or return
    install -Dm644 games/DEVEL/NASM/LICENSE $pkgdir/usr/share/licenses/$pkgname/NASM
end

function package_tinyhat-dosgames
    set pkgdesc 'Free DOS games and EDIT from the FreeDOS boot disk, with launchers that run them in DOSBox-X'
    set -l dos $pkgdir/usr/share/tinyhat/dos
    install -d $dos/GAMES; or return
    for g in PSRINVAD VITETRIS DPACMAN BANANOID
        cp -r games/GAMES/$g $dos/GAMES/; or return
    end
    install -Dm644 -t $dos games/BIN/EDIT.EXE games/BIN/EDIT.HLP; or return
    cp -a $startdir/root/. $pkgdir/; or return
    find $pkgdir -type d -exec chmod 755 '{}' +; or return
    find $pkgdir -type f -perm -u+x -exec chmod 755 '{}' +; or return
    find $pkgdir -type f ! -perm -u+x -exec chmod 644 '{}' +; or return
    _doslicenses
    install -Dm644 games/GAMES/VITETRIS/CWSDPMI.DOC $pkgdir/usr/share/licenses/$pkgname/CWSDPMI
end

function _doslicenses
    set -l l $pkgdir/usr/share/licenses/$pkgname
    install -Dm644 games/GAMES/DPACMAN/gpl-2.0.txt $l/DPACMAN; or return
    printf '%s\n' 'Bananoid (1989) by Banana Development, Inc. is freeware and may be copied freely.' >$l/BANANOID; or return
    install -Dm644 games/GAMES/VITETRIS/LICENCE.TXT $l/VITETRIS; or return
    install -Dm644 games/APPINFO/PSRINVAD.LSM $l/PSRINVAD; or return
    install -Dm644 games/DOC/EDIT/COPYING $l/EDIT
end
