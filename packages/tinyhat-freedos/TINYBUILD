    ctmouse-$pkgver.zip::https://www.ibiblio.org/pub/micro/pc-stuff/freedos/files/repositories/$pkgver/base/ctmouse.zip \
    edit-$pkgver.zip::https://www.ibiblio.org/pub/micro/pc-stuff/freedos/files/repositories/$pkgver/base/edit.zip \
    "open-watcom-$_ow.tar.xz::https://github.com/open-watcom/open-watcom-v2/releases/download/$_ow-Build/ow-snapshot.tar.xz" \
    hattoss.c
set noextract FD14-FloppyEdition.zip blkdrop-$pkgver.zip vitetris-$pkgver.zip sudoku86-$pkgver.zip senet-$pkgver.zip psrinvad-$pkgver.zip ctmouse-$pkgver.zip edit-$pkgver.zip open-watcom-$_ow.tar.xz
