set pkgver 1.4
set pkgrel 12
set pkgdesc 'FreeDOS 1.4 live boot disk with free DOS games, EDIT, NASM and DEBUG, for the GRUB menu'
set arch any
set url https://www.freedos.org/
set license GPL-2.0-or-later GPL-2.0-only BSD-2-Clause BSD-3-Clause MIT GPL-3.0-only LicenseRef-CWSDPMI LicenseRef-PSRINVAD LicenseRef-Bananoid
set makedepends mtools hattoss unzip
