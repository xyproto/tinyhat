set -g _name pmix
set pkgbase openpmix
set pkgname openpmix openpmix-docs
# NOTE: keep in sync with openmpi major versions
set pkgver 5.0.11
set pkgrel 1
set pkgdesc 'Extended version of the PMI standard'
set arch i686 x32
set url https://github.com/openpmix/openpmix
set license BSD-3-Clause
set makedepends glibc hwloc perl libevent python zlib
# openpmix does not support LTO https://github.com/openpmix/openpmix/pull/3383
set options '!lto'
set source $url/releases/download/v$pkgver/$_name-$pkgver.tar.gz
set sha512sums 86d096f3e169259a1e373b1757b5cb5c0dca8aee4598453fc49cb36da89164f62641107e02b7f47e338283e5310df5993578c9391fc6e98fe9f79c8acc4f702c
set b2sums dfa6f99debcde75563e9eae5701604e0a859486764d1355e469b83d13368590c512fb9043790d55956b5a4608dbd9b45d83351f6100d9d0aa45e8fa85c9612cc
set flags arch

function _pick
    set -l p $argv[1]
    for f in $argv[2..-1]
        set -l d "$srcdir/$p/"(string replace -- "$pkgdir/" '' $f)
        mkdir -p (dirname $d); or return
        mv $f $d; or return
        rmdir -p --ignore-fail-on-non-empty (dirname $f); or return
    end
end

function prepare
    cd $_name-$pkgver; or return
    ./autogen.pl; or return
end

function build
    # set environment variables for reproducible build
    # see https://docs.openpmix.org/en/latest/release-notes/general.html
    set -lx HOSTNAME buildhost
    set -lx USER builduser
    cd $_name-$pkgver; or return
    ./configure --prefix=/usr --sysconfdir=/etc/$pkgbase; or return
    # prevent excessive overlinking due to libtool
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make V=1; or return
end

function check
    make -k check -C $_name-$pkgver; or return
end

function package_openpmix
    set depends glibc hwloc libevent libevent_{core,pthreads}-2.1.so zlib
    set optdepends 'openpmix-docs: for documentation'
    set provides libpmix.so pmix
    set backup etc/openpmix/pmix-mca-params.conf
    make DESTDIR="$pkgdir" install -C $_name-$pkgver; or return
    cd "$pkgdir"; or return
    _pick $pkgbase-docs usr/share/doc/; or return
    cd "$srcdir"; or return
    install -vDm 644 $_name-$pkgver/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end

function package_openpmix-docs
    set pkgdesc "$pkgdesc - documentation"
    mv -v $pkgname/* "$pkgdir"; or return
    install -vDm 644 $_name-$pkgver/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
