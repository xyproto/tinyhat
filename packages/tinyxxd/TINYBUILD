set pkgname tinyxxd
set pkgver 1.3.17
set pkgrel 1
set pkgdesc 'Drop-in replacement and standalone version of the hex dump utility that comes with Vim'
set arch i686 x32
set url https://github.com/xyproto/tinyxxd
set license GPL-2.0-only MIT
set depends glibc
set provides xxd
set conflicts xxd
set source tinyxxd-$pkgver.tar.gz::https://github.com/xyproto/tinyxxd/archive/refs/tags/v$pkgver.tar.gz
set sha256sums d91cc4240c90cce4ada2b3f3d410cd916b6489495451a70a572908458180f955

function build
    cd tinyxxd-$pkgver; or return
    $CC -std=c99 -O2 -finline-functions -D_GNU_SOURCE -o tinyxxd main.c $LDFLAGS
end

function package
    cd tinyxxd-$pkgver; or return
    install -Dm755 tinyxxd $pkgdir/usr/bin/tinyxxd; or return
    ln -s tinyxxd $pkgdir/usr/bin/xxd; or return
    install -Dm644 tinyxxd.1 $pkgdir/usr/share/man/man1/tinyxxd.1; or return
    install -Dm644 LICENSE AUTHORS.md -t $pkgdir/usr/share/licenses/$pkgname/
end
