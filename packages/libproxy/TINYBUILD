set pkgbase libproxy
set pkgname libproxy
set pkgver 0.5.12
set pkgrel 1
set pkgdesc 'Automatic proxy configuration management library'
set arch i686 x32
set url https://libproxy.github.io/libproxy/
set nvchecker source=git git=https://github.com/libproxy/libproxy.git
set license LGPL-2.1-or-later
set depends curl duktape gcc-libs glib2 glibc
# No documentation (gi-docgen)
switch $CARCH
    case x32 aarch64
        set -g makedepends git gsettings-desktop-schemas meson
    case '*'
        set -g makedepends git gsettings-desktop-schemas meson webkit2gtk
end
switch $CARCH
    case x32 aarch64
        set -g optdepends
    case '*'
        set -g optdepends 'webkit2gtk: PAC proxy support (Webkit2gtk engine)'
end
set source "git+https://github.com/libproxy/libproxy#tag=$pkgver"
set sha256sums 48394e0740b7bb479af8ed7a1d2638dffac0e01403525ca9e7d93d73d24f5449
set flags arch
set -g _oifs '$\' \\t\\n\''

function prepare
    cd libproxy; or return
end

function build
    set -l meson_options -D docs=false -D release=true
    arch-meson -D introspection=false -D vapi=false libproxy build $meson_options; or return
    meson compile -C build; or return
end

function package_libproxy
    set provides libproxy.so
    set conflicts 'libproxy-webkit<0.5.0-1'
    meson install -C build --destdir "$pkgdir"; or return
end
