pkgname=libgrapheme
pkgver=2.0.2
pkgrel=1
pkgdesc='Unicode string library'
url='https://libs.suckless.org/libgrapheme/'
arch=(i686 x32)
license=(ISC)
depends=(glibc)
source=("https://dl.suckless.org/libgrapheme/libgrapheme-$pkgver.tar.gz")
sha256sums=('a68bbddde76bd55ba5d64116ce5e42a13df045c81c0852de9ab60896aa143125')
b2sums=('ade6c3ca8481bf3c3e1b1512a3c02caa9f7f2bcb3e9a59f0f3c5af7a1603c2ff2bf4f689d25e47e156d663d95c4e9e209e03504fcde27a9daf1791bc4954663e')

build() {
  cd $pkgname-$pkgver
  make PREFIX=/usr CC="${CC:-cc}" CFLAGS="$CFLAGS -std=c99" LDFLAGS="$LDFLAGS" \
    SOFLAGS='-shared -Wl,--soname=libgrapheme.so.$(VERSION_MAJOR).$(VERSION_MINOR)'
}

check() {
  cd $pkgname-$pkgver
  make PREFIX=/usr CC="${CC:-cc}" CFLAGS="$CFLAGS -std=c99" LDFLAGS="$LDFLAGS" \
    SOFLAGS='-shared -Wl,--soname=libgrapheme.so.$(VERSION_MAJOR).$(VERSION_MINOR)' test
}

package() {
  cd $pkgname-$pkgver
  make DESTDIR="$pkgdir" PREFIX=/usr LDCONFIG= install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
