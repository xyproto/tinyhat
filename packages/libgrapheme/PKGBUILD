pkgname=libgrapheme
pkgver=3.0.0
pkgrel="1"
pkgdesc='Unicode string library'
url='https://libs.suckless.org/libgrapheme/'
arch=(i686 x32)
license=(ISC)
depends=(glibc)
source=("https://dl.suckless.org/libgrapheme/libgrapheme-$pkgver.tar.gz")
sha256sums=('32585af73dda62fbcc0fed14f199aa1bc988ad01dad0bfbd06cf175d9cf3d68c')
b2sums=('f38706554bc97d73a09aaf3dfc0f0f04e883c3505b860c6d3629b04248f747c83f48adad6970cf0e3ccc85d3965e12fdbf5ad58fe60980b0a41f11d050bccaed')

build() {
  cd $pkgname-$pkgver
  make PREFIX=/usr CC="${CC:-cc}" CFLAGS="$CFLAGS -std=c99" LDFLAGS="$LDFLAGS" \
    SOFLAGS='-shared -Wl,--soname=libgrapheme.so.$(VERSION_MAJOR).$(VERSION_MINOR)'
}

check() {
  cd $pkgname-$pkgver
  make PREFIX=/usr CC="${CC:-cc}" CFLAGS="$CFLAGS -std=c99" LDFLAGS="$LDFLAGS" \
    SOFLAGS='-shared -Wl,--soname=libgrapheme.so.$(VERSION_MAJOR).$(VERSION_MINOR)' test
}

package() {
  cd $pkgname-$pkgver
  make DESTDIR="$pkgdir" PREFIX=/usr LDCONFIG= install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
