set pkgname alsa-topology-conf
set pkgver 1.2.5.1
set pkgrel 4
set pkgdesc 'ALSA topology configuration files'
set arch any
set url https://alsa-project.org/
set license BSD
set source "https://www.alsa-project.org/files/pub/lib/$pkgname-$pkgver.tar.bz2"
set sha512sums b34176b213e1afcb61fee19b569d6422a7692b62cf08b0ef651f2fbb1eefe49f25ca6386d0bfcec7152d4b5ed3daa84edb900181d40169e777751ae033125374
set b2sums 1f8bb172510d86bd0530f2ba437dd1132401c0bd436085c07c61e5ef296a6da6a1c24fb8d585572186fc0073172c82d40948c5c39fd293a01762d49c9c393662
set flags arch

function package
    cd $pkgname-$pkgver; or return
    for dir in topology/*
        install -vDm 644 $dir/*.conf -t "$pkgdir/usr/share/alsa/topology/"(basename $dir); or return
    end
    install -vDm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"; or return
    install -vDm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"; or return
end
