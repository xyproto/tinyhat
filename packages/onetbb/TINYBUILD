set pkgname onetbb
set pkgver 2023.1.0
set pkgrel 1
set pkgdesc 'oneAPI Threading Building Blocks - a high level abstract threading library'
set arch i686 x32
set url https://uxlfoundation.github.io/oneTBB/
set nvchecker source=git git=https://github.com/oneapi-src/oneTBB.git prefix=v 'exclude_regex=.*(pre|a|alpha|b|beta|rc).*'
set license Apache-2.0
set depends glibc hwloc libgcc libstdc++
# No Python module (swig, pip) and no test programs (the tests hang anyway, see below)
set makedepends cmake
set conflicts intel-tbb tbb
set provides intel-tbb=$pkgver tbb=$pkgver
set replaces intel-tbb tbb
set flags arch
set source "https://github.com/uxlfoundation/oneTBB/archive/v$pkgver/$pkgname-$pkgver.tar.gz" \
    010-onetbb-fix-linkage-of-test-malloc-pure-c.patch
set sha512sums c8e9b9100873d6f8514da18ca700165466a9c042d24a6ce9e8901c8996c348f2e58f0251b1eca47d33cc5f382783bfc7693bc6c451716540d4caa57339b3b535 \
    ea5480e7995f4c20ac66ca589ce1f98edb85e70eb1af498df04df09461c9a6175bcd2bf0dea7038f992528d8fd3e47932e16dedee0831436cb046c9fb23b4fb3

function prepare
    # https://github.com/uxlfoundation/oneTBB/issues/1735
    # https://gitlab.archlinux.org/archlinux/packaging/packages/onetbb/-/merge_requests/2
    patch -d "oneTBB-$pkgver" -Np1 -i "$srcdir/010-onetbb-fix-linkage-of-test-malloc-pure-c.patch"; or return
end

function build
    cmake -B build -S "oneTBB-$pkgver" \
        -G 'Unix Makefiles' \
        -DCMAKE_BUILD_TYPE:STRING=None \
        -DCMAKE_INSTALL_PREFIX:PATH=/usr \
        -DTBB_STRICT:BOOL=OFF \
        -DTBB4PY_BUILD:BOOL=OFF \
        -DTBB_TEST:BOOL=OFF \
        -Wno-author; or return
    cmake --build build; or return
end

# No check: the tests hang (test_partitioner on the build server, more on real old CPUs)

function package
    DESTDIR="$pkgdir" cmake --install build; or return
end
