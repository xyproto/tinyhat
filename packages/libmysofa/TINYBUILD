set pkgname libmysofa
set pkgver 1.3.5
set pkgrel 1
set pkgdesc 'C library to read HRTFs if they are stored in the AES69-2015 SOFA format'
set arch i686 x32
set url https://github.com/hoene/libmysofa/
set license BSD-3-Clause
set depends glibc zlib
# No tests (cunit), so no mysofa2json test tool either
set makedepends cmake git
set checkdepends nodejs
set provides libmysofa.so
set source "git+https://github.com/hoene/libmysofa.git#tag=v$pkgver"
set sha256sums c7590e8100409efc6fec52fdec7dbcd7add56fa4cde403a39be72219b284d9fa
set flags arch

function build
    cmake -G 'Unix Makefiles' -B libmysofa/build -S libmysofa -DCMAKE_BUILD_TYPE:STRING='None' -DCMAKE_INSTALL_PREFIX:PATH='/usr' -DBUILD_TESTS:BOOL='OFF' -DCODE_COVERAGE:BOOL='OFF' -Wno-author; or return
    cmake --build libmysofa/build; or return
end

function package
    DESTDIR="$pkgdir" cmake --install libmysofa/build; or return
    install -D -m644 libmysofa/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
