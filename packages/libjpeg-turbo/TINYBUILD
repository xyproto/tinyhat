set pkgname libjpeg-turbo
set pkgver 3.2.0
set pkgrel 4
set pkgdesc 'JPEG image codec with accelerated baseline compression and decompression'
set url https://libjpeg-turbo.org/
set nvchecker source=git git=https://github.com/libjpeg-turbo/libjpeg-turbo 'exclude_regex=.*(rc|RC|alpha|beta|90).*'
set -g _url https://github.com/libjpeg-turbo/libjpeg-turbo/
set arch i686 x32
set license BSD-3-Clause IJG
set depends glibc
set makedepends cmake ninja nasm
set provides libjpeg libjpeg.so libturbojpeg.so
set source "$_url/releases/download/$pkgver/$pkgname-$pkgver.tar.gz"
set sha512sums 13536db56c16e5364690ae2d31343a203e3b653c853c1f5314d36c8eb06700e92342737f1381f0171b3eb0223384c5fbcde91b55a46576952c4e75dc049cd045
set b2sums c50c985f8b870ab6467181f69e10f3ec2705cb349613b9178b293f136063e302087832d87f793b3d24ab721a2f5d76271760bd244d0766ab3b8cbe48ebf50cfa
set flags arch

function build
    set -l cmake_options \
        -B build \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_INSTALL_LIBDIR=lib \
        -D CMAKE_BUILD_TYPE=None \
        -D ENABLE_STATIC=OFF \
        -D WITH_JPEG8=ON \
        -G Ninja \
        -S $pkgname-$pkgver \
        -W no-dev

    cmake $cmake_options; or return
    cmake --build build -v; or return
end

function check
    ctest --test-dir build --output-on-failure --stop-on-failure -j(nproc); or return
end

function package
    DESTDIR="$pkgdir" cmake --install build -v; or return

    # header required by some dependents
    # https://bugs.archlinux.org/task/24787
    install -vDm 644 $pkgname-$pkgver/src/jpegint.h "$pkgdir/usr/include"; or return

    install -vDm 644 $pkgname-$pkgver/LICENSE.md -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
    install -vDm 644 $pkgname-$pkgver/README.ijg -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
