set pkgbase mtr
set pkgname mtr
set pkgver 0.96
set pkgrel 1
set pkgdesc 'Combines the functionality of traceroute and ping into one tool'
set url https://www.bitwizard.nl/mtr/
set arch i686 x32
set license GPL-2.0-only
set makedepends glibc jansson libcap ncurses
set install mtr.install
set source "https://github.com/traviscross/mtr/archive/v$pkgver/$pkgname-$pkgver.tar.gz"
set sha512sums 893c5f4623ba437bca309633ce1911c900e33a51252fce5f68ea8e74885302f744198e5616ba0155b4e09fb34eedba7e41ac4507403dc9d657e295ccf66c7d31
set b2sums c7dff18b6f6e48a648783d719a6cedd14b141fe2013b75031f3ee830e8c4fb9c93639259c860047c8108c21519df30740f7515256ed08552f7697a42e938257b
set flags arch

function prepare
    cd $pkgbase-$pkgver; or return
    echo $pkgver >.tarball-version; or return
    autoreconf -fiv; or return
end

function build
    cd $pkgbase-$pkgver; or return
    ./configure \
        --prefix=/usr \
        --without-gtk \
        --sbindir=/usr/bin; or return
    make; or return
end

function package_mtr
    set pkgdesc 'Combines the functionality of traceroute and ping into one tool (CLI version)'
    set depends glibc jansson libcap ncurses libncursesw.so
    set optdepends 'bash-completion: bash completion support'
    cd $pkgbase-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
end
