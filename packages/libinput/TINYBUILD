set pkgbase libinput
set pkgname libinput libinput-tools
set pkgver 1.32.0
set pkgrel 1
set pkgdesc 'Input device management and event handling library'
set arch i686 x32
set url https://wayland.freedesktop.org/libinput/doc/latest/
set license MIT
set depends glibc libevdev libgcc libwacom lua54 mtdev systemd-libs
set makedepends cairo check git glib2 meson python python-libevdev python-pyudev python-yaml wayland wayland-protocols
set checkdepends python-pytest
set source "git+https://gitlab.freedesktop.org/libinput/libinput.git?signed#tag=$pkgver"
set sha256sums SKIP
set flags arch

function build
    set -l meson_options -D documentation=false
    arch-meson -Ddebug-gui=false libinput build $meson_options; or return
    meson compile -C build; or return
end

function _pick
    set -l p "$argv[1]"
    set -l f
    set -l d
    set -e argv[1]
    for f in $argv
        set d "$srcdir/$p/$(string replace -r -- '^'(string escape --style=regex -- "$pkgdir")'/' '' "$f")"
        mkdir -p "$(dirname "$d")"; or return
        mv "$f" "$d"; or return
        rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"; or return
    end
end

function package_libinput
    set optdepends 'libinput-tools: debug utilities'
    set provides libinput.so
    meson install -C build --destdir "$pkgdir"; or return
    begin
        set -l __subshell_pwd $PWD
    cd "$pkgdir"; or return
        _pick tools usr/bin; or return
        _pick tools usr/lib/libinput; or return
        _pick tools usr/share/man; or return
        _pick tools usr/share/zsh; or return
        cd $__subshell_pwd
    end
    install -Dm644 libinput/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end

function package_libinput-tools
    set pkgdesc "$pkgdesc (debug utilities)"
    set depends cairo glib2 glibc libevdev libgcc libinput python python-libevdev python-pyudev python-yaml systemd-libs wayland
    mv tools/* "$pkgdir"; or return
    install -Dm644 libinput/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
