set pkgname x265
set pkgver 4.3
set pkgrel 1
set pkgdesc 'Open Source H265/HEVC video encoder'
set arch i686 x32
set url https://www.x265.org/
set nvchecker source=git git=https://github.com/Multicorewareinc/x265.git
set license GPL-2.0-or-later
set depends glibc libgcc libstdc++
set makedepends cmake git nasm ninja
set provides libx265.so
# 0003: thanks, debian: https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=910963 (repatched, 28.2.2019)
set source "git+https://github.com/Multicorewareinc/x265.git#tag=$pkgver" \
    0001-Fix-build-with-GCC-15.patch \
    0003-detect512-is-needed-on-all-architectures.patch
set b2sums bbbe9e0e595c1de114ddc08c4f13f6ce1e7490837749cb389682a9aaa28fe42707abcdea856aebb5fe805ea5c0500c4350c35afe90b7280fd1ea295fd5d469ab \
    af2ee0460c0c2f6f36e4f124a9ac16610e3884001262a6f08043fa1de4a85e2b5fd4fb12c64b8c94cfb59c3031bb7a1324e307fa2049e3378e2add9a58f5bd9e \
    62a8b7780cb75f8a3a46b7b057bbc630aaa02ae078d6fb31c58f6f1a606b84d068f93701338fdde0f22820e17af179177b55539c6cba66efc7f797e540688ee7
set flags arch

function prepare
    cd x265; or return
    patch -p1 -i "$srcdir/0003-detect512-is-needed-on-all-architectures.patch"; or return

    # Fix build with GCC 15
    git apply -3 ../0001-Fix-build-with-GCC-15.patch; or return
end

function build
    set -l common_options \
        -S x265/source \
        -G Ninja \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D ENABLE_HDR10_PLUS=TRUE \
        -W no-dev \
        # disabling assembly code as it seems to be non-32-bittish
        -DENABLE_ASSEMBLY=OFF \
        -DCMAKE_SYSTEM_PROCESSOR=i686
    set -l hdr_options $common_options \
        -D ENABLE_CLI=FALSE \
        -D ENABLE_SHARED=FALSE \
        -D EXPORT_C_API=FALSE \
        -D HIGH_BIT_DEPTH=TRUE
    set -l final_options $common_options \
        -D ENABLE_SHARED=TRUE \
        -D EXTRA_LIB='x265_main10.a;x265_main12.a' \
        -D EXTRA_LINK_FLAGS='-L .' \
        -D LINKED_10BIT=TRUE \
        -D LINKED_12BIT=TRUE

    cmake -B build-10 $hdr_options; or return
    cmake --build build-10; or return

    cmake -B build-12 $hdr_options -D MAIN12=TRUE; or return
    cmake --build build-12; or return

    cmake -B build $final_options; or return
    ln -sr build-10/libx265.a build/libx265_main10.a; or return
    ln -sr build-12/libx265.a build/libx265_main12.a; or return
    cmake --build build; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
end
