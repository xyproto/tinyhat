set pkgbase unrar
set pkgname libunrar unrar
set pkgver 7.3.1
set pkgrel 1
set epoch 1
set arch i686 x32
set url https://www.rarlab.com/rar_add.htm
set nvchecker source=regex url=https://www.rarlab.com/rar_add.htm 'regex=rar/unrarsrc-([\d.]+).tar.gz'
set depends glibc libgcc libstdc++
set license LicenseRef-UnRAR
set source "https://www.rarlab.com/rar/unrarsrc-$pkgver.tar.gz"
set sha256sums 634900842a3737d9cc15bbcc71d4c74cc713437e0bca296a573424fe5f2660ab
set flags arch

function prepare
    # Use system build flags
    sed -e '/CXXFLAGS=/d' -e '/LDFLAGS=/d' -i unrar/makefile; or return
end

function build
    cp -a unrar libunrar; or return
    set -a LDFLAGS -pthread
    make -C libunrar lib; or return
    make -C unrar -j1; or return
end

function package_unrar
    set pkgdesc 'The RAR uncompression program'
    cd unrar; or return
    install -Dm755 unrar -t "$pkgdir"/usr/bin/; or return
    # install license
    install -Dm644 license.txt "$pkgdir"/usr/share/licenses/$pkgname/LICENSE; or return
end

function package_libunrar
    set pkgdesc 'Library and header file for applications that use libunrar'
    cd libunrar; or return
    install -Dm755 libunrar.so -t "$pkgdir"/usr/lib/; or return
    install -Dm644 dll.hpp -t "$pkgdir"/usr/include/unrar/; or return
    # install license
    install -Dm644 license.txt "$pkgdir"/usr/share/licenses/$pkgname/LICENSE; or return
end
