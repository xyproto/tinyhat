function build
    cd $pkgname-$pkgver; or return
    ./configure \
        --prefix=/usr \
        --libexec=/usr/bin \
        --localstatedir=/var \
        --sysconfdir=/etc \
        --without-wrap \
        --with-pam \
        --enable-ftp \
        --enable-ftpd \
        --enable-telnet \
        --enable-telnetd \
        --enable-talk \
        --enable-talkd \
        --enable-rlogin \
        --enable-rlogind \
        --enable-rsh \
        --enable-rshd \
        --enable-rcp \
        --enable-hostname \
        --enable-dnsdomainname \
        --disable-rexec \
        --disable-rexecd \
        --disable-tftp \
        --disable-tftpd \
        --disable-ping \
        --disable-ping6 \
        --disable-logger \
        --disable-syslogd \
        --disable-inetd \
        --disable-whois \
        --disable-uucpd \
        --disable-ifconfig \
        --disable-traceroute; or return

    # fix tgetent from curses...
    sed -i '/HAVE_CURSES_TGETENT/c #define HAVE_CURSES_TGETENT 1' config.h; or return
    sed -i '/# include <curses.h>/a # include <term.h>' telnet/telnet.c telnetd/utility.c; or return

    make; or return
end

function check
    cd $pkgname-$pkgver; or return
    make check; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return

    chmod -s "$pkgdir"/usr/bin/{rcp,rlogin,rsh}; or return

    install -D -m644 "$srcdir/rlogin.pam" "$pkgdir/etc/pam.d/rlogin"; or return
    install -D -m644 "$srcdir/rsh.pam" "$pkgdir/etc/pam.d/rsh"; or return

    for f in ftpd.service rlogin@.service rlogin.socket rsh@.service rsh.socket talk.service talk.socket \
        telnet@.service telnet.socket
        install -D -m644 "$srcdir/$f" "$pkgdir/usr/lib/systemd/system/$f"; or return
    end

    install -vDm 644 ../$pkgname.sysusers "$pkgdir/usr/lib/sysusers.d/$pkgname.conf"; or return
end
