set pkgname tinyhat-system
set pkgver 1
set pkgrel 2
set pkgdesc 'Tiny Hat system services, boot and maintenance scripts, and their configuration'
set arch any
set url https://github.com/xyproto/tinyhat
set license BSD-3-Clause
set backup etc/iwd/main.conf etc/profile.d/pvsneslib.sh etc/profile.d/tinyhat-env.sh etc/security/limits.d/90-tinyhat-audio.conf etc/tinyhat-bootsplash/activate.d/50-tinyhat

function package
    cp -a $startdir/root/. $pkgdir/; or return
    find $pkgdir -type d -exec chmod 755 '{}' +; or return
    find $pkgdir -type f -perm -u+x -exec chmod 755 '{}' +; or return
    find $pkgdir -type f ! -perm -u+x -exec chmod 644 '{}' +; or return
end
