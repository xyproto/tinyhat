#!/bin/sh
command -v tinyhat-notify >/dev/null && tinyhat-notify send "$1" ${2:+"$2"} >/dev/null 2>&1 && exit 0
bar=${XDG_RUNTIME_DIR:-/tmp}/tinyhat-bar
stamp=${XDG_RUNTIME_DIR:-/tmp}/tinyhat-notice
[ -p "$bar" ] || exit 0
echo $$ >"$stamp"
printf 'notice %s\n' "$1" >"$bar"
[ -n "${2:-}" ] || exit 0
(sleep "$2"; [ "$(cat "$stamp" 2>/dev/null)" = $$ ] && printf 'notice \n' >"$bar") &
