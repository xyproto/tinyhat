set pkgbase graphite
set pkgname graphite
set pkgver 1.3.15
set pkgrel 1
set epoch 1
set arch i686 x32
set url https://graphite.sil.org/
set nvchecker source=github github=silnrsi/graphite use_max_tag=true
set pkgdesc 'a "smart font" system to handle the complexities of lesser-known languages of the world'
set license 'LGPL-2.1-or-later OR MPL-2.0 OR GPL-2.0-or-later'
set depends glibc libstdc++ libgcc
# No documentation package (doxygen, graphviz, asciidoc, TeX), and no freetype2: it is only for the comparison
# renderer of the tests (GRAPHITE2_COMPARE_RENDERER=OFF), and freetype2 is built with graphite (harfbuzz)
set makedepends cmake python
set checkdepends python-fonttools
set flags arch
# https://github.com/silnrsi/graphite/releases/download/1.3.14/graphite2-1.3.14.sha256sum
set source "https://github.com/silnrsi/graphite/releases/download/$pkgver/graphite2-$pkgver.tgz" \
    gcc15.patch
set sha256sums c6bc8b4252724665297f7cad0c55897285c673f9b8e6db3522ace833593fe0b1 \
    2296d1c189cfb129403f83e7a704a333147856b37475320965c463386ef9d8ef

function prepare
    cd graphite2-$pkgver; or return
    patch -Np1 -i ../gcc15.patch; or return # https://github.com/silnrsi/graphite/pull/97
end

function build
    set -l cmake_options \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DGRAPHITE2_COMPARE_RENDERER=OFF \
        -DGRAPHITE2_VM_TYPE=direct

    cmake -S graphite2-$pkgver -B build $cmake_options; or return
    cmake --build build; or return
end

function check
    cd build; or return
    ctest --output-on-failure --stop-on-failure -j(nproc); or return
end

function package_graphite
    set provides libgraphite2.so

    DESTDIR="$pkgdir" cmake --install build; or return

    # licenses
    install -Dm644 graphite2-$pkgver/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
