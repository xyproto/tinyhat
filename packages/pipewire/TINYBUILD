set pkgbase pipewire
set pkgname pipewire alsa-card-profiles libpipewire pipewire-alsa pipewire-audio pipewire-docs pipewire-ffado pipewire-jack pipewire-jack-client pipewire-netjack2 pipewire-pulse pipewire-system-services pipewire-v4l2 pipewire-zeroconf pipewire-session-manager pulse-native-provider
