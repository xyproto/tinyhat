set pkgrel 1
set epoch 1
set pkgdesc 'Low-latency audio/video router and processor'
set arch i686 x32 x86_64 aarch64
set url https://pipewire.org
set license MIT
set makedepends alsa-lib avahi bluez-libs dbus dconf doxygen fftw git glib2 glib2-devel graphviz jack2 libebur128 libfdk-aac libffado libfreeaptx libgcc liblc3 libldac libmysofa libpulse libsndfile libstdc++ libusb lilv meson ncurses opus python-docutils readline rtkit sbc spandsp systemd valgrind webrtc-audio-processing-1
set checkdepends desktop-file-utils openal
set source "git+https://gitlab.freedesktop.org/pipewire/pipewire.git#tag=$pkgver" \
    pipewire-sysusers.conf
set sha256sums SKIP \
    c053d98bbe1a156b72b6f0229efbe6c7aa0edda9ba5bb4e580f27bdaa9a773d9
set flags arch
set -g _pwname pipewire-0.3
set -g _spaname spa-0.2

function prepare
    cd pipewire; or return
end

function build
    set -l meson_options -D bluez5-codec-lc3plus=disabled -D onnxruntime=disabled -D roc=disabled -D bluez5-codec-ldac-dec=disabled -D docs=enabled -D jack-devel=true -D libjack-path=/usr/lib -D man=enabled -D rlimits-install=false -D selinux=disabled -D libcamera=disabled -D gstreamer=disabled -D gstreamer-device-provider=disabled -D libcanberra=disabled -D x11=disabled -D x11-xfixes=disabled -D sdl2=disabled -D session-managers=[] -D snap=disabled -D systemd-system-service=enabled -D udevrulesdir=/usr/lib/udev/rules.d
    arch-meson pipewire build $meson_options; or return
    meson compile -C build; or return
end

function _pick
    set -l p "$argv[1]"
    set -l f
    set -l d
    set -e argv[1]
    for f in $argv
        set d "$srcdir/$p/$(string replace -r -- '^'(string escape --style=regex -- "$pkgdir")'/' '' "$f")"
        mkdir -p "$(dirname "$d")"; or return
        mv "$f" "$d"; or return
        rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"; or return
    end
end

function package_alsa-card-profiles
    set pkgdesc "$pkgdesc - ALSA card profiles"
    set license LGPL-2.1-or-later
    mv acp/* "$pkgdir"; or return
end

