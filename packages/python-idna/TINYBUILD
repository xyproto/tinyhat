set pkgname python-idna
set pkgver 3.20
set pkgrel 1
set pkgdesc 'Internationalized Domain Names in Applications (IDNA)'
set arch any
set license BSD-3-Clause
set url https://github.com/kjd/idna
set nvchecker source=git git=https://github.com/kjd/idna.git prefix=v
set depends python
set makedepends git python-build python-installer python-flit-core
set checkdepends python-pytest python-hypothesis
set source "git+https://github.com/kjd/idna.git#tag=v$pkgver"
set sha512sums e44ea96a0fa917e0853092839288b8be89bfa757bb43b241d1f72ade49a3463acec0c0316b5d92b9fee5702093030cc0df44abb28819a8a4de3d89cae8a42f3f
set flags arch

function build
    cd idna; or return
    python -m build --no-isolation --wheel; or return
end

function check
    cd idna; or return
    pytest; or return
end

function package
    cd idna; or return
    python -m installer --destdir="$pkgdir" dist/*.whl; or return
    install -Dm644 LICENSE.md -t "$pkgdir"/usr/share/licenses/$pkgname/; or return
end
