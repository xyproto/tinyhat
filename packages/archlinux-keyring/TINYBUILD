set pkgname archlinux-keyring
set pkgver 20250807.1
set pkgrel 1
set pkgdesc 'Arch Linux PGP keyring'
set arch any
set url https://gitlab.archlinux.org/archlinux/archlinux-keyring/
set license GPL-3.0-or-later
set install $pkgname.install
set depends pacman
set makedepends git python sequoia-sq pkgconf systemd
set checkdepends python-coverage python-pytest
set source "archlinux-keyring::git+https://gitlab.archlinux.org/archlinux/archlinux-keyring.git#tag=$pkgver?signed"
set sha256sums bf610cf35ce803b2de7dd971797c5663d7f3ddeaaf5549fa1c2f7537447d5393
set flags arch

function build
    cd archlinux-keyring/; or return
    make build; or return
end

function check
    cd archlinux-keyring/; or return
    make check; or return
end

function package
    cd archlinux-keyring/; or return
    make PREFIX=/usr DESTDIR="$pkgdir" install; or return
end
