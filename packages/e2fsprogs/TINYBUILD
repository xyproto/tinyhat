set pkgbase e2fsprogs
set pkgname e2fsprogs fuse2fs
set pkgver 1.47.4
set pkgrel 1
set pkgdesc 'Ext2/3/4 filesystem utilities'
set arch i686 x32
set license GPL LGPL MIT
set url http://e2fsprogs.sourceforge.net
set makedepends git systemd util-linux fuse3
set flags arch
set source "git+https://git.kernel.org/pub/scm/fs/ext2/e2fsprogs.git#tag=v$pkgver?signed"
set sha256sums e738cbd6e437988248a5ed143458e33cdbfe17ebfa3818b7f6a6a66264895a66

function prepare
    cd "$srcdir/$pkgbase"; or return

    # Remove unnecessary init.d directory
    sed -i '/init\.d/s|^|#|' misc/Makefile.in; or return
end

function build
    cd "$srcdir/$pkgbase"; or return

    ./configure \
        --prefix=/usr \
        --with-root-prefix='' \
        --libdir=/usr/lib \
        --libexecdir=/usr/lib \
        --sbindir=/usr/bin \
        --enable-elf-shlibs \
        --disable-fsck \
        --disable-uuidd \
        --disable-libuuid \
        --disable-libblkid; or return
    make; or return

    # regenerate locale files
    find po/ -name '*.gmo' -delete; or return
    make -C po update-gmo; or return
end

function package_e2fsprogs
    set depends sh util-linux-libs
    set optdepends 'lvm2: for e2scrub' 'util-linux: for e2scrub' 'smtp-forwarder: for e2scrub_fail script'
    set provides libcom_err.so libe2p.so libext2fs.so libss.so
    set backup etc/mke2fs.conf etc/e2scrub.conf

    set -e MAKEFLAGS

    cd "$srcdir/$pkgbase"; or return

    make DESTDIR="$pkgdir" install install-libs; or return

    sed -i -e 's/^AWK=.*/AWK=awk/' "$pkgdir/usr/bin/compile_et"; or return

    # remove references to build directory
    sed -i -e 's#^DIR=.*#DIR="/usr/share/ss"#' "$pkgdir/usr/bin/mk_cmds"; or return
    sed -i -e 's#^DIR=.*#DIR="/usr/share/et"#' "$pkgdir/usr/bin/compile_et"; or return

    # remove static libraries with a shared counterpart
    rm $pkgdir/usr/lib/lib{com_err,e2p,ext2fs,ss}.a; or return

    # remove fuse2fs which will be packaged separately
    rm $pkgdir/usr/{bin/fuse2fs,share/man/man1/fuse2fs.1}; or return
end

function package_fuse2fs
    set pkgdesc 'Ext2/3/4 filesystem driver for FUSE'
    set depends fuse3 e2fsprogs

    cd "$srcdir/$pkgbase"; or return

    install -D -m0755 misc/fuse2fs "$pkgdir/usr/bin/fuse2fs"; or return
    install -D -m0644 misc/fuse2fs.1 "$pkgdir/usr/share/man/man1/fuse2fs.1"; or return
    mkdir -p "$pkgdir/usr/share/licenses"; or return
    ln -s "$pkgbase" "$pkgdir/usr/share/licenses/$pkgname"; or return
end
