set pkgname libraw1394
set pkgver 2.1.2
set pkgrel 4
set pkgdesc 'Provides an API to the Linux IEEE1394 (FireWire) driver'
set arch i686 x32
set url https://ieee1394.wiki.kernel.org/index.php/Main_Page
set license LGPL-2.1-only
set depends glibc
set makedepends pkgconfig
set source "https://www.kernel.org/pub/linux/libs/ieee1394/libraw1394-$pkgver.tar.xz"
set sha256sums 03ccc69761d22c7deb1127fc301010dd13e70e44bb7134b8ff0d07590259a55e
set flags arch

function build
    cd "$srcdir/$pkgname-$pkgver"; or return
    ./configure --prefix=/usr; or return
    make; or return
end

function package
    cd "$srcdir/$pkgname-$pkgver"; or return
    make DESTDIR="$pkgdir" install; or return
end
