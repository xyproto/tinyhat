set pkgname jemalloc
set pkgver 5.4.0
set pkgrel 1
set epoch 1
set pkgdesc 'General-purpose scalable concurrent malloc implementation'
set arch i686 x32
set url https://jemalloc.net/
set license BSD-2-Clause
set depends glibc libgcc libgcc_s.so libstdc++ libstdc++.so
set makedepends git
set provides libjemalloc.so
set source "git+https://github.com/jemalloc/jemalloc.git#tag=$pkgver"
set sha256sums 1013d73abb1820cd7c7a24b2270414c09f663474bdeb1c86c36a200f4f950ad6
set flags arch

function prepare
    cd "$pkgname"; or return
    autoreconf -fi; or return
end

function build
    cd "$pkgname"; or return
    ./configure --disable-prof --enable-autogen --disable-static --prefix=/usr; or return
    make; or return
end

function package
    cd "$pkgname"; or return
    make DESTDIR="$pkgdir" install_lib install_include; or return
    install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
