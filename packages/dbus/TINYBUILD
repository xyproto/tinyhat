set pkgbase dbus
set pkgname dbus dbus-daemon-units
set pkgver 1.16.2
set pkgrel 2
set pkgdesc 'Freedesktop.org message bus system'
set url https://www.freedesktop.org/wiki/Software/dbus/
set nvchecker source=git git=https://gitlab.freedesktop.org/dbus/dbus.git 'include_regex=dbus-\d+\.\d*[02468]\.\d+' prefix=dbus-
set arch i686 x32
set license 'AFL-2.1 OR GPL-2.0-or-later'
set depends audit expat glibc libcap-ng systemd-libs
set makedepends docbook-xsl git meson python systemd xmlto
# dbus and systemd need each other
set bootstrap_without systemd systemd-libs
set source "git+https://gitlab.freedesktop.org/dbus/dbus.git?signed#tag=dbus-$pkgver" \
    0001-Arch-Linux-tweaks.patch \
    dbus-reload.hook
set b2sums 669cd4203fbac908db3a20c5b51355d9e84b68c9cc94f8de52e35544a636c6d5d1df8ee2bbdfd6dead53a6bd9865db547aa4af0e913bac697b138c698840d3ce \
    fbbc5f312864d2c0e61cead42f578cf650ee8a103e9f6e21658d7406e00a9dfb2c70bc4db647f51eb959df1dad7e94ba52af078325c6a18dcd9d0d500fe15fac \
    9ac03e4dca00b2c31dc505db4c5da5b8498da21377b01abf186800c6da00492abc6a9a2058c3e3b0f282e3b28e0e4f3318114230db0418fe9754ad2420adb4bf
set flags arch

function prepare
    cd dbus; or return
    # Lock user account
    git cherry-pick -n 2cb5882dda27341011a034feb6d1d2b5a7c61a3a; or return
    git apply -3 ../0001-Arch-Linux-tweaks.patch; or return
end

function build
    set -l meson_options \
        -D apparmor=disabled \
        -D dbus_user=dbus \
        -D kqueue=disabled \
        -D launchd=disabled \
        -D relocation=disabled \
        -D selinux=disabled \
        -D x11_autolaunch=disabled \
        -D qt_help=disabled \
        -D doxygen_docs=disabled \
        -D ducktype_docs=disabled \
        -D modular_tests=disabled
    # Without libsystemd (the first build in a bootstrap, see bootstrap_without): no systemd support
    pkg-config --exists libsystemd; or set -a meson_options -D systemd=disabled -D user_session=false
    arch-meson dbus build $meson_options; or return
    meson compile -C build; or return
end

function check
    meson test -C build --print-errorlogs; or return
end

# Move files from $pkgdir to $srcdir/P, for the split package P
function _pick -a p
    for f in $argv[2..-1]
        set -l d "$srcdir/$p/"(string replace -- "$pkgdir/" '' $f)
        mkdir -p (dirname $d); or return
        mv $f $d; or return
        rmdir -p --ignore-fail-on-non-empty (dirname $f); or return
    end
end

function package_dbus
    set -a depends libaudit.so libcap-ng.so libexpat.so libsystemd.so
    set provides libdbus libdbus-1.so
    set conflicts libdbus
    set replaces libdbus
    meson install -C build --destdir "$pkgdir"; or return
    # Without systemd support (the first build in a bootstrap) there are no units
    if test -e "$pkgdir"/usr/lib/systemd/system/dbus.service
        _pick unit "$pkgdir"/usr/lib/systemd/{system,user}/dbus.service; or return
    end
    install -Dt "$pkgdir/usr/share/libalpm/hooks" -m644 *.hook; or return
    install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 \
        dbus/COPYING dbus/LICENSES/AFL-2.1.txt; or return
end

function package_dbus-daemon-units
    set pkgdesc "$pkgdesc - Service units"
    set depends dbus
    set provides dbus-units
    set conflicts dbus-broker-units
    if test -d unit
        mv unit/* "$pkgdir"; or return
    end
    mkdir -p "$pkgdir/usr/share/licenses"; or return
    ln -s dbus "$pkgdir/usr/share/licenses/$pkgname"; or return
end
