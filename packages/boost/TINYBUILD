# No Python/NumPy bindings and no MPI (python, mpi and the MPI-only graph_parallel libraries are not built), so python,
# python-numpy and the libs/mpi gcc 16 patch (it only touches the MPI Python bindings) are dropped
set pkgbase boost
set pkgname boost boost-libs
set pkgver 1.92.0
set pkgrel 2
set pkgdesc 'Free peer-reviewed portable C++ source libraries'
set arch i686 x32
set url https://www.boost.org/
set nvchecker source=git git=https://github.com/boostorg/boost.git prefix=boost- 'exclude_regex=.*beta.*'
set license BSL-1.0
# No ICU (Boost.Locale uses iconv, Boost.Regex without ICU): ICU is large, and Tiny Hat's image leaves it out
set makedepends bzip2 zlib zstd
set source "https://archives.boost.io/release/$pkgver/source/boost_1_92_0.tar.bz2"
set sha256sums 5c1d40cb8e19adbf740a4ec2da35b3e58f3f5804b1dce44deb53df72193cbc6c
set flags arch
set -g _srcname boost_1_92_0

function build
    set -l JOBS "$(printf '%s\n' $MAKEFLAGS | sed 's/.*\(-j *[0-9]\+\).*/\1/')"
    set -l cross
    string match -q -- '*-gcc' $CC; and set cross architecture=arm address-model=64 abi=aapcs binary-format=elf target-os=linux
    if not set -q cross[1]
        pushd $_srcname/tools/build; or return
        ./bootstrap.sh --cxxflags="$CXXFLAGS $LDFLAGS -DBOOST_STACKTRACE_LIBCXX_RUNTIME_MAY_CAUSE_MEMORY_LEAK"; or return
        ./b2 install --prefix="$srcdir"/fakeinstall; or return
        ln -s b2 "$srcdir"/fakeinstall/bin/bjam; or return
        popd; or return
    end
    cd $_srcname; or return
    env CXX=$CXX_FOR_BUILD CXXFLAGS= LDFLAGS= ./bootstrap.sh --with-toolset=gcc --without-icu --without-libraries=python,mpi,graph_parallel; or return
    if set -q cross[1]
        sed -i "s|^    using gcc ;|    using gcc : : $CXX ;|" project-config.jam; or return
        grep -qF "using gcc : : $CXX ;" project-config.jam; or return
    end
    install -dm755 "$srcdir"/fakeinstall/share/boostbook; or return
    cp -a tools/boostbook/{xsl,dtd} "$srcdir"/fakeinstall/share/boostbook/; or return
    ./b2 install variant=release debug-symbols=on threading=multi runtime-link=shared link=shared,static toolset=gcc $cross cxxstd=23 cflags="$CPPFLAGS $CFLAGS -fPIC -O3 -ffat-lto-objects -DBOOST_STACKTRACE_LIBCXX_RUNTIME_MAY_CAUSE_MEMORY_LEAK" cxxflags="$CPPFLAGS $CXXFLAGS -fPIC -O3 -ffat-lto-objects -DBOOST_STACKTRACE_LIBCXX_RUNTIME_MAY_CAUSE_MEMORY_LEAK" linkflags="$LDFLAGS" --layout=system $JOBS --prefix="$srcdir"/fakeinstall; or return
end

function package_boost
    set pkgdesc "$pkgdesc"' (development headers)'
    install -d "$pkgdir"/usr/lib; or return
    cp -a fakeinstall/lib/cmake "$pkgdir"/usr/lib; or return
    cp -a fakeinstall/{include,share} "$pkgdir"/usr/; or return
    if test -d fakeinstall/bin
        cp -a fakeinstall/bin "$pkgdir"/usr/; or return
    end
    find "$pkgdir"/usr/lib/cmake -name '*.cmake' -exec sed -i "s|$srcdir/fakeinstall|/usr|g" '{}' +; or return
end

function package_boost-libs
    set pkgdesc "$pkgdesc"' (runtime libraries)'
    set depends bzip2 glibc libgcc 'libstdc++' xz zlib zstd
    set options staticlibs
    set provides libboost_atomic.so libboost_charconv.so libboost_chrono.so libboost_cobalt.so libboost_container.so libboost_context.so libboost_contract.so libboost_coroutine.so libboost_date_time.so libboost_fiber.so libboost_filesystem.so libboost_graph.so libboost_iostreams.so libboost_json.so libboost_locale.so libboost_log.so libboost_log_setup.so libboost_math_c99.so libboost_math_c99f.so libboost_math_c99l.so libboost_math_tr1.so libboost_math_tr1f.so libboost_math_tr1l.so libboost_nowide.so libboost_prg_exec_monitor.so libboost_process.so libboost_program_options.so libboost_random.so libboost_regex.so libboost_serialization.so libboost_stacktrace_addr2line.so libboost_stacktrace_basic.so libboost_stacktrace_from_exception.so libboost_stacktrace_noop.so libboost_thread.so libboost_timer.so libboost_type_erasure.so libboost_unit_test_framework.so libboost_url.so libboost_wave.so libboost_wserialization.so
    install -dm755 "$pkgdir"/usr/lib; or return
    cp -a fakeinstall/lib/*.so* "$pkgdir"/usr/lib/; or return
    cp -a fakeinstall/lib/*.a "$pkgdir"/usr/lib/; or return
end
