set pkgname libassuan
set pkgver 3.0.0
set pkgrel 1
set pkgdesc 'IPC library used by some GnuPG related software'
set arch i686 x32
set url https://www.gnupg.org/related_software/libassuan/
set nvchecker source=git git=https://dev.gnupg.org/source/libassuan.git 'include_regex=libassuan-([\d.]+)' prefix=libassuan-
set license FSFULLR GPL-2.0-or-later LGPL-2.1-or-later
set depends glibc libgpg-error sh
set provides libassuan.so
set source "https://gnupg.org/ftp/gcrypt/$pkgname/$pkgname-$pkgver.tar.bz2"
set sha512sums 7c5c95c1b85bef2d4890c068a5a8ea8a1fe0d8def6ab09e5f34fc2746d8808bbb0fc168e3bd66d52ee5ed799dcf9f258f4125cda98c8384f6411bcad8d8b3139
set b2sums c86f7d62413c6f7a228deb47abe0388790a7c0e3c89b5ee7a7a72f72bea6502d5cbe199b10f06efc885af6fefab358dbe0e61a6f798493dcfcc63df0cfacdb55
set flags arch

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr; or return
    make; or return
end

function check
    make check -C $pkgname-$pkgver; or return
end

function package
    make DESTDIR="$pkgdir" install -C $pkgname-$pkgver; or return
    install -vDm 644 $pkgname-$pkgver/{AUTHORS,NEWS,README,ChangeLog} -t "$pkgdir/usr/share/doc/$pkgname/"; or return
end
