set pkgname alsa-utils
set pkgver 1.2.16
set pkgrel 1
set pkgdesc 'Advanced Linux Sound Architecture - Utilities'
set arch i686 x32
set url https://www.alsa-project.org
set nvchecker source=git git=https://github.com/alsa-project/alsa-utils prefix=v
set license GPL-2.0-or-later
set depends bash glibc libgcc pciutils psmisc
# No alsactl_init.7 man page (xmlto, docbook-xsl)
set makedepends alsa-lib fftw libsamplerate ncurses python-docutils systemd
set source $url/files/pub/utils/$pkgname-$pkgver.tar.bz2 \
    $pkgname.tmpfiles
set sha512sums 288c042f5acb8a7cf1b0a0c25327c74e0bce126124253bdb2d0dc2630b8bc80b5e5d694de97738d031377fd82d887db32af1c4b27c6d940357b318d0a3ef02cf \
    17ca2d760f383c02ccd00073d4fe73d6687ee58eb0ab5e458ad9d09845be7891cfe389e365bef00c7885e8afad45ea9ebf2925950f8d3fd8157feb818f986990
set b2sums 9a4d6daf4bcb5564661eb92b0d11b3077d209282c4826c96531590b2d987bd1e4cf92f2ee65a9c388235f540cbaaea108eb90987112ed528620eaecb1d0f0137 \
    24b8e44833c7e8b142162878a837b10e1c2a862568280f2ce16fcb81ecc1383802654dbe88930f2cc13c345635c5003cbc3712e121e589dffc2e25c540749ee3
set flags arch

function prepare
    cd $pkgname-$pkgver; or return
    autoreconf -fiv; or return
end

function build
    set -l configure_options \
        --prefix=/usr \
        --disable-alsaconf \
        --disable-xmlto \
        --sbindir=/usr/bin \
        --with-udev-rules-dir=/usr/lib/udev/rules.d \
        --with-systemdsystemunitdir=/usr/lib/systemd/system
    cd $pkgname-$pkgver; or return
    ./configure $configure_options; or return
    # prevent excessive overlinking due to libtool
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make; or return
end

function check
    make -k check -C $pkgname-$pkgver; or return
end

function package
    set -a depends alsa-lib libasound.so libatopology.so
    set -a depends fftw libfftw3f.so
    set -a depends ncurses libformw.so libmenuw.so libncursesw.so libpanelw.so
    set -a depends libsamplerate libsamplerate.so
    make DESTDIR="$pkgdir" install -C $pkgname-$pkgver; or return
    install -vDm 644 $pkgname-$pkgver/README.md -t "$pkgdir/usr/share/doc/$pkgname/"; or return
    install -vDm 644 $pkgname.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/$pkgname.conf"; or return
end
