set flags arch

function prepare
    cd "$pkgname-$_basever"; or return
    for _p in (seq $_patchlevel)
        set -l patch bash(string replace -a . '' -- $_basever)-(printf %03d $_p)
        patch -Np0 -i ../"$patch"; or return
    end
    # add patches from gentoo, fixing various upstream reported issues
    # https://gitweb.gentoo.org/repo/gentoo.git/tree/app-shells/bash/files
end

function build
    cd "$pkgname-$_basever"; or return
    set -a CFLAGS '-DDEFAULT_PATH_VALUE=\'"/usr/local/sbin:/usr/local/bin:/usr/bin"\'' \
        '-DSTANDARD_UTILS_PATH=\'"/usr/bin"\'' \
        '-DSYS_BASHRC=\'"/etc/bash.bashrc"\'' \
        '-DSYS_BASH_LOGOUT=\'"/etc/bash.bash_logout"\'' \
        -DNON_INTERACTIVE_LOGIN_SHELLS \
        -std=gnu17
    ./configure \
        --prefix=/usr \
        --with-curses \
        --enable-readline \
        --without-bash-malloc \
        --with-installed-readline; or return
    make; or return
end

function check
    make -C "$pkgname-$_basever" check; or return
end

function package
    make -C "$pkgname-$_basever" DESTDIR="$pkgdir" install; or return
    sed -i -E "s|$srcdir/$pkgname-$_basever|/usr/include/bash|g; s/ -f(file|debug|macro)-prefix-map=[^ ]*//g" "$pkgdir"/usr/lib/bash/Makefile.inc; or return
    not grep -q "$srcdir" "$pkgdir"/usr/lib/bash/Makefile.inc; or return
    ln -s bash "$pkgdir/usr/bin/sh"; or return
    ln -s bash "$pkgdir/usr/bin/rbash"; or return
    # system-wide configuration files
    install -Dm644 system.bashrc "$pkgdir/etc/bash.bashrc"; or return
    install -Dm644 system.bash_logout "$pkgdir/etc/bash.bash_logout"; or return
    # user configuration file skeletons
    install -dm755 "$pkgdir/etc/skel/"; or return
    install -m644 dot.bashrc "$pkgdir/etc/skel/.bashrc"; or return
    install -m644 dot.bash_profile "$pkgdir/etc/skel/.bash_profile"; or return
    install -m644 dot.bash_logout "$pkgdir/etc/skel/.bash_logout"; or return
end
