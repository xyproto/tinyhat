set pkgname bash
set -g _basever 5.3
set -g _patchlevel 20
set pkgver $_basever.$_patchlevel
set pkgrel 1
set pkgdesc 'The GNU Bourne Again shell'
set arch i686 x32
set license GPL-3.0-or-later
set url https://www.gnu.org/software/bash/bash.html
set nvchecker source=regex url=https://ftp.gnu.org/gnu/bash/ 'regex=bash-([\.\d]+)\.tar\.gz' 'exclude_regex=.*(pre|a|alpha|b|beta|r|rc|RC|BETA|ALPHA).*'
