set pkgbase libxcrypt
set pkgname libxcrypt libxcrypt-compat
set pkgver 4.5.2
set pkgrel 1
set pkgdesc 'Modern library for one-way hashing of passwords'
set arch i686 x32
set url https://github.com/besser82/libxcrypt/
set nvchecker source=git git=https://github.com/besser82/libxcrypt.git prefix=v
set license LGPL
set depends glibc
set provides libcrypt.so
set install libxcrypt.install
set source "https://github.com/besser82/libxcrypt//releases/download/v$pkgver/libxcrypt-$pkgver.tar.xz"
set sha256sums 71513a31c01a428bccd5367a32fd95f115d6dac50fb5b60c779d5c7942aec071
set flags arch

function build
    mkdir build-libxcrypt build-libxcrypt-compat; or return
    cd "$srcdir/build-libxcrypt/"; or return
    "$srcdir/$pkgbase-$pkgver"/configure --prefix=/usr --disable-static --enable-hashes=strong,glibc --enable-obsolete-api=no --disable-failure-tokens --disable-werror; or return
    make; or return
    cd "$srcdir/build-libxcrypt-compat/"; or return
    "$srcdir/$pkgbase-$pkgver"/configure --prefix=/usr --disable-static --enable-hashes=strong,glibc --enable-obsolete-api=glibc --disable-failure-tokens --disable-werror; or return
    make; or return
end

function package_libxcrypt
    cd build-libxcrypt/; or return
    make DESTDIR="$pkgdir" install; or return
end

function package_libxcrypt-compat
    set pkgdesc 'Modern library for one-way hashing of passwords - legacy API functions'
    set depends libxcrypt
    cd build-libxcrypt-compat/; or return
    make DESTDIR="$pkgdir" install; or return
    set -l dev "$pkgdir"/usr/{include,lib/{lib*.so,pkgconfig},share}
    rm -rf $dev; or return
end
