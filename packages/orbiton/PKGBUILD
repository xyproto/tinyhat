pkgname=orbiton
_commit=10496286403bc2ae5dad910e35611d29a2d82e5a
pkgver=2.74.6.r68.g1049628
pkgrel=1
pkgdesc="Editor and IDE"
arch=(i686 x86_64 aarch64)
url="https://github.com/xyproto/orbiton/"
license=(BSD-3-Clause)
depends=(glibc)
makedepends=(go-tinyhat)
options=(!buildflags)
source=("orbiton-$_commit.tar.gz::https://github.com/xyproto/orbiton/archive/$_commit.tar.gz")
sha256sums=('32ce86cdc486da15e34694e896fdcea332b454358186aef2404ec492b3e7b5c2')

build() {
  cd orbiton-$_commit/v2
  export GOROOT=/usr/lib/go-tinyhat GOPATH="$srcdir/gopath" GOCACHE="$srcdir/gocache" GOTOOLCHAIN=local GOFLAGS=-mod=vendor CGO_ENABLED=0 GOARCH=386 GO386=softfloat
  [ "$CARCH" != aarch64 ] || export GOROOT=/usr/lib/go GOARCH=arm64
  [ "$CARCH" != x86_64 ] || export GOROOT=/usr/lib/go GOARCH=amd64
  export PATH="$GOROOT/bin:$PATH"
  go build -trimpath -buildvcs=false -ldflags "-s -w" -o "$srcdir/o"
}

package() {
  install -Dm755 o "$pkgdir/usr/bin/o"
  for l in orbiton orbiton-nano nano feedgame obuild osudo vs; do
    ln -sf o "$pkgdir/usr/bin/$l"
  done
  install -Dm644 orbiton-$_commit/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  gzip -n -9 -c orbiton-$_commit/o.1 > o.1.gz
  install -Dm644 o.1.gz "$pkgdir/usr/share/man/man1/o.1.gz"
}
