set pkgname shared-mime-info
set pkgver 2.5.1
set pkgrel 2
set pkgdesc 'Freedesktop.org Shared MIME Info'
set arch i686 x32
set license GPL-2.0-or-later
set depends libxml2 glib2 glibc libstdc++ libgcc
# No HTML specification (xmlto, docbook-xsl)
set makedepends gettext meson
# https://gitlab.freedesktop.org/xdg/shared-mime-info
set url https://www.freedesktop.org/wiki/Specifications/shared-mime-info-spec/
set nvchecker source=git git=https://gitlab.freedesktop.org/xdg/shared-mime-info.git
set flags arch
set source "https://gitlab.freedesktop.org/xdg/shared-mime-info/-/archive/$pkgver/shared-mime-info-$pkgver.tar.bz2" \
    update-mime-database.hook \
    $pkgname-remove-cache.hook
set sha256sums b75b420da9b0be9a3d99b1bee6ed87957b56ab54583ac1a97fbd0dc98ddddb25 \
    f08efbcbac9d2bd18a805b8dcf3ed06d7763b97eca5935aa64d65593774b6501 \
    e67071897ecc61bae05a66874dedfb31d64f28f36e9fcf84bacc6e4dbd23636c
set options '!makeflags'

function build
    arch-meson $pkgname-$pkgver build \
        -D update-mimedb=false \
        -D build-tests=false \
        -D build-spec=false; or return

    # Print config
    meson configure build; or return
    # compile it
    ninja -C build; or return
end

function check
    # only test tranlations, avoid hacks for submodule - see AUR -git pkg
    meson test -C build --print-errorlogs; or return
end

function package
    DESTDIR="$pkgdir" meson install -C build; or return
    # use a prefix to run it early enough - other hooks may depend on it - FS#72858
    install -Dm644 update-mime-database.hook "$pkgdir"/usr/share/libalpm/hooks/30-update-mime-database.hook; or return
    install -vDm 644 $pkgname-remove-cache.hook -t "$pkgdir"/usr/share/libalpm/hooks/; or return
end
