set pkgname tinyhat-fan
set pkgver 1
set pkgrel 1
set pkgdesc 'Tiny Hat fan and CPU power modes: full, medium and chill'
set arch i686 x32
set url https://github.com/xyproto/tinyhat
set license BSD-3-Clause
set depends glibc
set source tinyhat-fand.c tinyhat-fan tinyhat-fan.service tinyhat-fan.preset fan-full.desktop fan-medium.desktop fan-chill.desktop
set sha256sums d48522dafacace54caa6c4fd8e71f6feb6d7238b1c49ad129676d0c0e7f986fa 3ddfb2d1f41370f20f916634a8221f83e273d33d8fee7941b452c17d96c31f31 44f18d0efa8e0ae9b18b0a44e5c5e5a2f97e3691c158875c1bea86afc1451fea 59855610f59d60ca93e15272fb07d39247ad8d9edf91a7d62060682543379463 680d2acb6dba4eced112cee1176c2a94a5c54362457d156681fe8ad2497fdd35 0d7063c254d5e5b326c2f5f4a2f182df26f0d8644146690b70b55e5801502d57 4c614710b04b89cab74785ce7a3d0040a2431b44fada79dd5748c8c3cd2cbac3

function build
    cc -std=c23 $CFLAGS -o tinyhat-fand tinyhat-fand.c $LDFLAGS; or return
end

function package
    install -Dm755 tinyhat-fand "$pkgdir/usr/bin/tinyhat-fand"; or return
    install -Dm755 tinyhat-fan "$pkgdir/usr/bin/tinyhat-fan"; or return
    install -Dm644 tinyhat-fan.service "$pkgdir/usr/lib/systemd/system/tinyhat-fan.service"; or return
    install -Dm644 tinyhat-fan.preset "$pkgdir/usr/lib/systemd/system-preset/80-tinyhat-fan.preset"; or return
    install -Dm644 fan-full.desktop fan-medium.desktop fan-chill.desktop -t "$pkgdir/usr/share/applications/"; or return
end
