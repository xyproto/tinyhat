diff -ruN a/src/mixer.cpp b/src/mixer.cpp
--- a/src/mixer.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/src/mixer.cpp	2026-11-26 10:49:46.493324332 +0100
@@ -0,0 +1,177 @@
+// The small part of the SDL_mixer API that SDL Sasteroids uses, on top of SDL3 audio streams:
+// each channel is an audio stream bound to one playback device, and SDL converts the sound formats.
+
+#include "mixer.h"
+
+struct Channel
+{
+  SDL_AudioStream *stream;
+  Mix_Chunk *loop;        // played again whenever the stream runs low, for loops < 0
+  Uint64 expire;          // stop the channel at this SDL_GetTicks() time, 0 for never
+  int volume;
+};
+
+static SDL_AudioDeviceID device;
+static Channel channels[64];
+static int numChannels, reserved;
+
+static void SDLCALL refill(void *userdata, SDL_AudioStream *stream, int additional, int total)
+{
+  Channel *c = (Channel *)userdata;
+  (void)total;
+  if (c->expire && SDL_GetTicks() >= c->expire) {
+    c->expire = 0;
+    c->loop = NULL;
+    SDL_ClearAudioStream(stream);
+    return;
+  }
+  if (c->loop && SDL_GetAudioStreamQueued(stream) < additional) {
+    SDL_PutAudioStreamData(stream, c->loop->data, (int)c->loop->len);
+  }
+}
+
+int Mix_OpenAudio(int frequency, SDL_AudioFormat format, int nchannels, int chunksize)
+{
+  SDL_AudioSpec spec;
+  (void)chunksize;
+  spec.freq = frequency;
+  spec.format = format;
+  spec.channels = nchannels;
+  device = SDL_OpenAudioDevice(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec);
+  return device ? 0 : -1;
+}
+
+void Mix_CloseAudio()
+{
+  for (int i = 0; i < numChannels; i++) {
+    SDL_DestroyAudioStream(channels[i].stream);
+    channels[i].stream = NULL;
+  }
+  numChannels = 0;
+  if (device) {
+    SDL_CloseAudioDevice(device);
+    device = 0;
+  }
+}
+
+int Mix_AllocateChannels(int numchans)
+{
+  if (!device) {
+    return 0;
+  }
+  SDL_AudioSpec spec;
+  SDL_GetAudioDeviceFormat(device, &spec, NULL);
+  if (numchans > (int)SDL_arraysize(channels)) {
+    numchans = (int)SDL_arraysize(channels);
+  }
+  for (; numChannels < numchans; numChannels++) {
+    Channel *c = &channels[numChannels];
+    c->stream = SDL_CreateAudioStream(&spec, &spec);
+    c->loop = NULL;
+    c->expire = 0;
+    c->volume = 128;
+    if (c->stream) {
+      SDL_SetAudioStreamGetCallback(c->stream, refill, c);
+      SDL_BindAudioStream(device, c->stream);
+    }
+  }
+  return numChannels;
+}
+
+int Mix_ReserveChannels(int num)
+{
+  reserved = num;
+  return num;
+}
+
+Mix_Chunk *Mix_LoadWAV(const char *file)
+{
+  Mix_Chunk *chunk = (Mix_Chunk *)SDL_calloc(1, sizeof(Mix_Chunk));
+  if (!chunk) {
+    return NULL;
+  }
+  if (!SDL_LoadWAV(file, &chunk->spec, &chunk->data, &chunk->len)) {
+    SDL_free(chunk);
+    return NULL;
+  }
+  return chunk;
+}
+
+void Mix_FreeChunk(Mix_Chunk *chunk)
+{
+  if (chunk) {
+    SDL_free(chunk->data);
+    SDL_free(chunk);
+  }
+}
+
+int Mix_PlayChannel(int channel, Mix_Chunk *chunk, int loops)
+{
+  if (!chunk || numChannels == 0) {
+    return -1;
+  }
+  if (channel < 0) {
+    // the first free channel that is not reserved, or the one that has the least left to play
+    int best = -1, least = 0;
+    for (int i = reserved; i < numChannels; i++) {
+      int queued = SDL_GetAudioStreamQueued(channels[i].stream);
+      if (best < 0 || queued < least) {
+        best = i;
+        least = queued;
+      }
+      if (queued == 0) {
+        break;
+      }
+    }
+    channel = best;
+  }
+  if (channel < 0 || channel >= numChannels || !channels[channel].stream) {
+    return -1;
+  }
+  Channel *c = &channels[channel];
+  SDL_LockAudioStream(c->stream);
+  SDL_ClearAudioStream(c->stream);
+  SDL_SetAudioStreamFormat(c->stream, &chunk->spec, NULL);
+  c->expire = 0;
+  c->loop = loops < 0 ? chunk : NULL;
+  for (int i = 0; i <= (loops > 0 ? loops : 0); i++) {
+    SDL_PutAudioStreamData(c->stream, chunk->data, (int)chunk->len);
+  }
+  SDL_UnlockAudioStream(c->stream);
+  return channel;
+}
+
+int Mix_ExpireChannel(int channel, int ticks)
+{
+  int first = channel < 0 ? 0 : channel, last = channel < 0 ? numChannels - 1 : channel;
+  for (int i = first; i <= last && i < numChannels; i++) {
+    Channel *c = &channels[i];
+    SDL_LockAudioStream(c->stream);
+    if (ticks <= 0) {
+      c->loop = NULL;
+      c->expire = 0;
+      SDL_ClearAudioStream(c->stream);
+    } else if (c->loop || SDL_GetAudioStreamQueued(c->stream) > 0) {
+      c->expire = SDL_GetTicks() + (Uint64)ticks;
+    }
+    SDL_UnlockAudioStream(c->stream);
+  }
+  return last - first + 1;
+}
+
+int Mix_Volume(int channel, int volume)
+{
+  int first = channel < 0 ? 0 : channel, last = channel < 0 ? numChannels - 1 : channel;
+  int old = numChannels > 0 && first < numChannels ? channels[first].volume : 128;
+  if (volume < 0) {
+    return old;
+  }
+  if (volume > 128) {
+    volume = 128;
+  }
+  for (int i = first; i <= last && i < numChannels; i++) {
+    channels[i].volume = volume;
+    SDL_SetAudioStreamGain(channels[i].stream, volume / 128.0f);
+  }
+  return old;
+}
