set pkgname firmware-raspberrypi
set pkgver 20261109
set pkgrel 1
set pkgdesc 'Additional firmware for Raspberry Pi'
set arch aarch64
set url https://github.com/RPi-Distro/firmware-nonfree
set license custom
set options '!strip'
set -g _firmcommit 5d2295b633d94641253e16ba90fc847436fc9d4a
set -g _bluezcommit cdf61dc691a49ff01a124752bd04194907f0f9cd
set -g _hcd BCM4345C5 BCM4343A2 BCM43430A1 BCM4345C0 BCM43430B0
set -g _bluez https://raw.githubusercontent.com/RPi-Distro/bluez-firmware/$_bluezcommit/debian/firmware/broadcom
set source "firmware-nonfree-$_firmcommit.tar.gz::https://github.com/RPi-Distro/firmware-nonfree/archive/$_firmcommit.tar.gz" \
    (for f in $_hcd; echo "bluez-firmware-$_bluezcommit-$f.hcd::$_bluez/$f.hcd"; end) \
    "bluez-firmware-$_bluezcommit-LICENSE.cypress::$_bluez/LICENSE.cypress" \
    RPi-WM8804.conf
set sha256sums a8fcbcd42240d3b127aa946514c3678332dbca94e350f1711cbf98a39ed07b36 \
    fb9f4ec2df5301bd35f416384e103c012c5983024c49aa72fbbaf90177512caa \
    5f7fb0a863f9ee8874e4ad37ccc69abbc751fdc0257cb3fdd0ba0e89378ff76a \
    c096ad4a5c3f06ed7d69eba246bf89ada9acba64a5b6f51b1e9c12f99bb1e1a7 \
    51c45e77ddad91a19e96dc8fb75295b2087c279940df2634b23baf71b6dea42c \
    338c2c6631131f516bfc7e64ef0872bd0402e1f98ef9d0c900eef0c814d90a25 \
    a92f031f19089fa63bd24ac4c5298ca1356670321b39c67024a961ee3285fff7 \
    f978fbc40db75ba3213a4472023496d0716706eb1a6f078f207ac027c5753f43

function package
    set -l fw firmware-nonfree-$_firmcommit/debian/added-firmware
    set -l dest "$pkgdir/usr/lib/firmware/updates"

    install -Dm644 bluez-firmware-$_bluezcommit-LICENSE.cypress "$pkgdir/usr/share/licenses/broadcom/cypress/LICENSE"; or return

    install -d "$dest/cypress"; or return
    install -m644 $fw/cypress/* "$dest/cypress/"; or return
    ln -s cyfmac43455-sdio-standard.bin "$dest/cypress/cyfmac43455-sdio.bin"; or return

    install -d "$dest/brcm"; or return
    for f in $_hcd
        install -m644 bluez-firmware-$_bluezcommit-$f.hcd "$dest/brcm/$f.hcd"; or return
    end
    install -Dm644 RPi-WM8804.conf "$pkgdir/usr/share/alsa/cards/RPi-WM8804.conf"; or return
    cp -r $fw/brcm/* "$dest/brcm/"; or return

    ln -s brcmfmac43456-sdio.txt "$dest/brcm/brcmfmac43456-sdio.pine64-pinephone-pro.txt"; or return
    ln -s BCM43430B0.hcd "$dest/brcm/BCM.hcd"; or return
end
