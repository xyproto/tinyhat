set pkgname compose-tables
set pkgver 1.8.13
set pkgrel 2
set pkgdesc "XKB Compose tables (dead keys and the Compose key) for libxkbcommon, from libX11's nls data"
set arch any
set url https://gitlab.freedesktop.org/xorg/lib/libx11
set license 'MIT AND X11'
set makedepends gcc
set source "https://www.x.org/releases/individual/lib/libX11-$pkgver.tar.xz"
set sha256sums 69606f485c2c07c14ef64f75b7bb326d48587af33795d9ab3e607c0b5f94f11c

function _magic
    LC_CTYPE=C sed -e '/^#  *[0-9][0-9]*  *.*$/d' -e '/^#line  *[0-9][0-9]*  *.*$/d' \
        -e '/^[	 ]*XCOMM$/s/XCOMM/#/' -e '/^[	 ]*XCOMM[^a-zA-Z0-9_]/s/XCOMM/#/' \
        -e '/^[	 ]*XHASH/s/XHASH/#/' -e 's,X11_LOCALEDATADIR,/usr/share/xkbcommon/locale,g' \
        -e '/@@$/s/@@$/\\\\/' -e '/^$/d'
end

function _pre
    cpp -undef -traditional -DWCHAR32=1 <$argv[1] | _magic
end

function build
    cd libX11-$pkgver/nls; or return
    mkdir -p out/en_US.UTF-8; or return
    for f in compose.dir locale.alias
        _pre $f.pre >out/$f.l1; or return
        LC_CTYPE=C sed -e '/^[^#][^	 ]*:/s/://' -e '/^[^#].*[	 ].*:/d' <out/$f.l1 >out/$f.l2; or return
        cat out/$f.l2 out/$f.l1 >out/$f; or return
    end
    _pre en_US.UTF-8/Compose.pre >out/en_US.UTF-8/Compose; or return
end

function package
    cd libX11-$pkgver; or return
    install -Dm644 -t "$pkgdir/usr/share/xkbcommon/locale" nls/out/compose.dir nls/out/locale.alias; or return
    install -Dm644 -t "$pkgdir/usr/share/xkbcommon/locale/en_US.UTF-8" nls/out/en_US.UTF-8/Compose; or return
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"; or return
end
