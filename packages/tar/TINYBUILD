set pkgbase tar
set pkgname tar tar-scripts
set pkgver 1.35
set pkgrel 5
set pkgdesc 'Utility used to store, backup, and transport files'
set arch i686 x32
set url https://www.gnu.org/software/tar/
set nvchecker source=git git=https://git.savannah.gnu.org/git/tar.git prefix=v
set license GPL-3.0-or-later
# From the release tarball (generated configure and translations): Arch builds from git with ./bootstrap, which needs
# autoconf, automake and makeinfo
set checkdepends attr
set options '!emptydirs'
set install tar.install
set source "https://ftp.gnu.org/gnu/tar/tar-$pkgver.tar.gz" \
    fix-libacl-conflicts.patch
set sha256sums 14d55e32063ea9526e057fbf35fcabd53378e769787eff7919c3755b02d2b57e \
    07c20fc924001f15e93e779588de8113a2ce683ce5b18431e797f7c242eaa33a
set flags arch

function prepare
    cd $pkgbase-$pkgver; or return
    # upstream commit doesn't cherry-pick cleanly to stable
    # 08c3fc2e9337094aff01a511170fd35fdb8f1ee3 Avoid acl_ prefix for functions
    patch -Np1 -i ../fix-libacl-conflicts.patch; or return
end

function build
    cd $pkgbase-$pkgver; or return
    ./configure --prefix=/usr --sbindir=/usr/bin --libexecdir=/usr/lib/tar --enable-backup-scripts; or return
    # -Werror is enabled by default and causes build failures
    make WERROR_CFLAGS=""; or return
end

# The following tests fail on 64-bit and 32-bit:
# 92: link mismatch                                   FAILED (difflink.at:19)
# 117: directory removed before reading                FAILED (dirrem01.at:37)
# 118: explicitly named directory removed before reading FAILED (dirrem02.at:34)
# 152: storing sparse files > 8G                       FAILED (sparse03.at:30)
# 154: listing sparse files bigger than 2^33 B         FAILED (sparse05.at:31)
# 155: storing sparse file using seek method           FAILED (sparse06.at:32)
# The following tests fail on 64-bit:
# 117: directory removed before reading                FAILED (dirrem01.at:37)
# 118: explicitly named directory removed before reading FAILED (dirrem02.at:34)
#
# at least bug 92 is known upstream: FS#57270
#
# => run the tests, but make tests not fail the build
function check
    cd $pkgbase-$pkgver; or return
    make check; or true
end

# Move files (relative to the current directory, or under $pkgdir) to $srcdir/NAME
function _pick
    set -l p $argv[1]
    for f in $argv[2..-1]
        set -l rel $f
        string match -q -- "$pkgdir/*" $f; and set rel (string sub -s (math (string length -- $pkgdir) + 2) -- $f)
        set -l d "$srcdir/$p/$rel"
        mkdir -p (dirname $d); or return
        mv $f $d; or return
        rmdir -p --ignore-fail-on-non-empty (dirname $f); or return
    end
end

function package_tar
    set depends glibc acl
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    # Pick backup and restore scripts for tar-scripts package
    cd $pkgdir; or return
    _pick tar-scripts usr/bin/{backup,restore} usr/lib/tar/{backup.sh,dump-remind}; or return
end

function package_tar-scripts
    set pkgdesc "$pkgdesc (scripts)"
    set depends sh tar
    mv -v $pkgname/* "$pkgdir"; or return
end
