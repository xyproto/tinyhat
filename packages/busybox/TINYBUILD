set pkgname busybox
set pkgver 1.36.1
set pkgrel 4
set pkgdesc 'Utilities for rescue and embedded systems'
set arch i686
set url https://www.busybox.net
set license GPL-2.0-only
set makedepends ncurses musl kernel-headers-musl
set source "https://www.busybox.net/downloads/busybox-$pkgver.tar.bz2" \
    "https://www.busybox.net/downloads/busybox-$pkgver.tar.bz2.sig" \
    config \
    extra_version.patch
set sha256sums b8cc24c9574d809e7279c3be349795c5d5ceb6fdf19ca709f80cde50e47de314 \
    7b1dc3e59fa767c0e0b216ffacb070b3587607655dfa0336ccf41a48ae32c3c1 \
    239001693b58e471c594952b9805c24b0d8174ba2cab245cd624e4423d993cd3 \
    0a8608fa4e633ebb4cfeadf29fd284b082e6f80c6393c10494bcb7f2cbebba27
set flags arch

function prepare
    cd "$srcdir/$pkgname-$pkgver"; or return
    patch -p1 < "$srcdir"/extra_version.patch; or return
end

switch $CARCH
    case aarch64
        function build
            cd "$srcdir/$pkgname-$pkgver"; or return
            cp "$srcdir"/config .config; or return
            set -gx KCONFIG_NOTIMESTAMP 1
            sed -i "s/^CONFIG_TC=y/# CONFIG_TC is not set/" .config; or return
            mkdir -p "$srcdir/noatomic"; or return
            ar rc "$srcdir/noatomic/libatomic_asneeded.a"; or return
            LDFLAGS="$LDFLAGS -L$srcdir/noatomic" make CC=musl-gcc BB_EXTRA_VERSION="-$pkgrel"; or return
        end
    case '*'
        function build
            cd "$srcdir/$pkgname-$pkgver"; or return
            cp "$srcdir"/config .config; or return
            set -gx KCONFIG_NOTIMESTAMP 1
            make CC=musl-gcc BB_EXTRA_VERSION="-$pkgrel"; or return
        end
end

function package
    cd "$srcdir/$pkgname-$pkgver"; or return
    install -Dm0755 busybox "$pkgdir"/usr/bin/busybox; or return
    install -Dm644 docs/busybox.1 "$pkgdir"/usr/share/man/man1/busybox.1; or return
    install -dm0755 "$pkgdir"/usr/share/doc/$pkgname; or return
    cp -a examples "$pkgdir"/usr/share/doc/$pkgname/; or return
    for doc in BusyBox.html BusyBox.txt
        install -Dm644 docs/$doc "$pkgdir"/usr/share/doc/$pkgname/$doc; or return
    end
end
