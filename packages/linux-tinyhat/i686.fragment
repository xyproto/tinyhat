CONFIG_LOCALVERSION="-tinyhat"
CONFIG_M686=y
CONFIG_X86_GENERIC=y
CONFIG_HIGHMEM4G=y
CONFIG_VMSPLIT_3G=y
CONFIG_NR_CPUS=8
CONFIG_CPU_SUP_CYRIX_32=y
CONFIG_CPU_SUP_TRANSMETA_32=y
CONFIG_X86_POWERNOW_K7=y
CONFIG_X86_SPEEDSTEP_ICH=y
CONFIG_X86_SPEEDSTEP_SMI=m
CONFIG_X86_LONGHAUL=m
CONFIG_X86_E_POWERSAVER=m
CONFIG_X86_LONGRUN=m
CONFIG_PCI_GOANY=y
CONFIG_EFI=n
CONFIG_AGP_AMD=y
CONFIG_AGP_ATI=y
CONFIG_AGP_NVIDIA=y
CONFIG_SND_ALS4000=m
# Drivers for hardware that only comes with 64-bit CPUs, so that tinyhat32.img leaves out their modules and
# (through scripts/fwprune.py) their firmware: SOF audio DSPs, Intel WiFi from the 7260 on (iwldvm and iwlegacy
# stay), ath10k/ath11k/ath12k, rtw89 and the PCIe MediaTek WiFi 6/7 cards (the USB ones stay)
CONFIG_SND_SOC_SOF_TOPLEVEL=n
CONFIG_SND_SOC_SOF_PCI=n
CONFIG_SND_SOC_SOF_ACPI=n
CONFIG_IWLMVM=n
CONFIG_IWLMLD=n
CONFIG_ATH10K=n
CONFIG_ATH10K_PCI=n
CONFIG_ATH11K=n
CONFIG_ATH11K_PCI=n
CONFIG_ATH12K=n
CONFIG_RTW89=n
CONFIG_RTW89_8851BE=n
CONFIG_RTW89_8851BU=n
CONFIG_RTW89_8852AE=n
CONFIG_RTW89_8852AU=n
CONFIG_RTW89_8852BE=n
CONFIG_RTW89_8852BU=n
CONFIG_RTW89_8852BTE=n
CONFIG_RTW89_8852CE=n
CONFIG_RTW89_8852CU=n
CONFIG_RTW89_8922AE=n
CONFIG_RTW89_8922AU=n
CONFIG_MT7921E=n
CONFIG_MT7925E=n
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=n
CONFIG_SND_SOC_SOF_SKYLAKE=n
CONFIG_SND_SOC_SOF_KABYLAKE=n
CONFIG_SND_SOC_SOF_APOLLOLAKE=n
CONFIG_SND_SOC_SOF_GEMINILAKE=n
CONFIG_SND_SOC_SOF_CANNONLAKE=n
CONFIG_SND_SOC_SOF_COFFEELAKE=n
CONFIG_SND_SOC_SOF_COMETLAKE=n
CONFIG_SND_SOC_SOF_ICELAKE=n
CONFIG_SND_SOC_SOF_JASPERLAKE=n
CONFIG_SND_SOC_SOF_TIGERLAKE=n
CONFIG_SND_SOC_SOF_ELKHARTLAKE=n
CONFIG_SND_SOC_SOF_ALDERLAKE=n
CONFIG_SND_SOC_SOF_METEORLAKE=n
CONFIG_SND_SOC_SOF_LUNARLAKE=n
CONFIG_SND_SOC_SOF_PANTHERLAKE=n
CONFIG_SND_SOC_SOF_NOVALAKE=n
CONFIG_SND_SOC_SOF_HDA_LINK=n
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=n
CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE=n
CONFIG_SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH=n
CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH=n
CONFIG_SND_SOC_INTEL_SOF_RT5682_MACH=n
