pkgname=libslirp
pkgver=4.9.7
pkgrel="1"
pkgdesc='General purpose TCP-IP emulator'
arch=(i686 x32)
url='https://gitlab.freedesktop.org/slirp/libslirp'
license=(BSD MIT)
depends=(glib2)
makedepends=(meson)
provides=('libslirp.so')
source=("${url}/-/archive/v${pkgver}/libslirp-v${pkgver}.tar.gz")
sha512sums=('e7ab5bae9696a5b3f9bc0a846757a5d7a9dd24407c04f1c3483730baa0b0269fb9574c5f26569f1718a4b51023a62a5c4b8826a82e5c44b8d14a1ede5fb7e566')
b2sums=('12df06926f2fbcb1cdb45c4e3b086e8df0d1c520646185eb608f6aa97e53a94bca43a182909470a806ff0f20da0e710212b9e9d82197422faf7d3da922544e29')

build() {
  arch-meson "$pkgname-v${pkgver}" build
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" meson install -C build
  install -vDm 644 "$pkgname-v${pkgver}"/COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

unset -f pkgver
