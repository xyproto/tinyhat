set pkgname python-pyxel
set pkgver 3.0.1
set pkgrel 3
set pkgdesc 'Retro game engine for Python, built with SDL3'
set arch i686 x32
set url https://github.com/kitao/pyxel
set license MIT
set depends glibc gcc-libs sdl3 python
set makedepends cargo clang llvm python
set source "pyxel-$pkgver.tar.gz::https://github.com/kitao/pyxel/archive/refs/tags/v$pkgver.tar.gz" \
    sdl3.patch
set sha256sums 068686e5dda57828a071cdb8ca877057f0ab28fa33a035bebf2087b667d3a6c8 \
    5426b5452a374b37d2a56393ccfdcce0f8b72b37099f5bd77717530abd0f8330
# network: cargo fetch downloads its crates in prepare (builds have no network access otherwise)
set -a options network

function prepare
    cd pyxel-$pkgver; or return
    patch -Np1 -i ../sdl3.patch; or return
    cd crates; or return
    cargo fetch --locked --target host-tuple; or return
end

function build
    cd pyxel-$pkgver/crates; or return
    set -l libclangs /usr/lib/libclang.so.*
    set -l libclang (printf '%s\n' $libclangs | string match -r '.*\.so\.[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1)
    LIBCLANG_PATH=$libclang PYO3_PYTHON=python3 CARGO_PROFILE_RELEASE_LTO=false cargo build --release --frozen -p pyxel-binding --no-default-features --features sdl3; or return
end

function package
    cd pyxel-$pkgver; or return
    set -l site "$pkgdir/usr/lib/python3.14/site-packages/pyxel"
    install -d "$site"; or return
    cp -r python/pyxel/. "$site/"; or return
    install -Dm755 crates/target/release/libpyxel_binding.so "$site/pyxel_binding.abi3.so"; or return
    printf '%s\n' '#!/usr/bin/python3' 'import sys' 'from pyxel.cli import cli' 'sys.exit(cli())' \
        | install -Dm755 /dev/stdin "$pkgdir/usr/bin/pyxel"; or return
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
