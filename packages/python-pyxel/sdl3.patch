--- a/crates/pyxel-core/build.rs
+++ b/crates/pyxel-core/build.rs
@@ -275,5 +275,42 @@ fn main() {
     println!("cargo::rustc-cfg=pyxel_core");
     if has_sdl2_feature() {
         Sdl2BindingsBuilder::new().build();
+    } else if var("CARGO_FEATURE_SDL3").is_ok() {
+        build_sdl3_bindings();
     }
 }
+
+#[cfg(not(test))]
+fn build_sdl3_bindings() {
+    let target = var("TARGET").unwrap();
+    let out_dir = var("OUT_DIR").unwrap();
+    let mut flags: Vec<String> = Vec::new();
+    if let Ok(out) = Command::new(var("PKG_CONFIG").unwrap_or_else(|_| "pkg-config".to_string()))
+        .args(["--cflags", "sdl3"])
+        .output()
+    {
+        flags.extend(
+            str::from_utf8(&out.stdout)
+                .unwrap_or("")
+                .split_whitespace()
+                .map(String::from),
+        );
+    }
+    println!("cargo::rustc-link-lib=SDL3");
+    println!("cargo::rerun-if-changed=wrapper_sdl3.h");
+    bindgen::Builder::default()
+        .header("wrapper_sdl3.h")
+        .allowlist_function("SDL_.*")
+        .allowlist_type("SDL_.*")
+        .allowlist_var("SDL_.*")
+        .allowlist_var("SDLK_.*")
+        .use_core()
+        .generate_comments(false)
+        .prepend_enum_name(false)
+        .clang_arg(format!("--target={target}"))
+        .clang_args(flags)
+        .generate()
+        .expect("Failed to generate SDL3 bindings")
+        .write_to_file(Path::new(&out_dir).join("bindings.rs"))
+        .unwrap();
+}
