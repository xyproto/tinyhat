diff --git a/crates/pyxel-core/src/platform/sdl3/platform_sdl3.rs b/crates/pyxel-core/src/platform/sdl3/platform_sdl3.rs
new file mode 100644
index 0000000..49f9441
--- /dev/null
+++ b/crates/pyxel-core/src/platform/sdl3/platform_sdl3.rs
@@ -0,0 +1,435 @@
+use std::ffi::{CStr, CString};
+use std::os::raw::{c_int, c_void};
+use std::ptr::{copy_nonoverlapping, null_mut};
+
+use glow::Context;
+
+use super::super::facade::GlProfile;
+use super::poll_events::{open_gamepad, GamepadSlot};
+#[allow(clippy::wildcard_imports)]
+use super::sdl3_sys::*;
+
+type AudioCallback = Box<dyn FnMut(&mut [i16])>;
+
+struct AudioState {
+    callback: AudioCallback,
+    buffer: Vec<i16>,
+}
+
+pub struct PlatformSdl3 {
+    initialized_subsystems: SDL_InitFlags,
+    pub window: *mut SDL_Window,
+    pub sdl_gl_context: SDL_GLContext,
+    pub gl_context: *mut Context,
+    pub audio_stream: *mut SDL_AudioStream,
+    pub audio_userdata: *mut c_void,
+    audio_subsystem_initialized: bool,
+    pub mouse_x: i32,
+    pub mouse_y: i32,
+    pub key_modifiers: SDL_Keymod,
+    pub is_wayland: bool,
+    pub gamepads: Vec<GamepadSlot>,
+    pub next_update_ms: Option<f64>,
+}
+
+fn sdl_error() -> String {
+    unsafe { CStr::from_ptr(SDL_GetError()) }
+        .to_string_lossy()
+        .into_owned()
+}
+
+impl PlatformSdl3 {
+    pub fn new() -> Self {
+        Self {
+            initialized_subsystems: 0,
+            window: null_mut(),
+            sdl_gl_context: null_mut(),
+            gl_context: null_mut(),
+            audio_stream: null_mut(),
+            audio_userdata: null_mut(),
+            audio_subsystem_initialized: false,
+            mouse_x: i32::MIN,
+            mouse_y: i32::MIN,
+            key_modifiers: SDL_KMOD_NONE as SDL_Keymod,
+            is_wayland: false,
+            gamepads: Vec::new(),
+            next_update_ms: None,
+        }
+    }
+
+    pub fn init(&mut self, headless: bool) {
+        if headless {
+            unsafe { SDL_Init(0) };
+            return;
+        }
+
+        let sdl_flags = SDL_INIT_VIDEO | SDL_INIT_GAMEPAD;
+        assert!(
+            unsafe { SDL_Init(sdl_flags) },
+            "Failed to initialize SDL3: {}",
+            sdl_error()
+        );
+        self.initialized_subsystems = sdl_flags;
+
+        let driver = unsafe { SDL_GetCurrentVideoDriver() };
+        self.is_wayland =
+            !driver.is_null() && unsafe { CStr::from_ptr(driver) }.to_bytes() == b"wayland";
+
+        self.close_gamepads();
+        let mut count: c_int = 0;
+        let ids = unsafe { SDL_GetGamepads(&raw mut count) };
+        if !ids.is_null() {
+            for i in 0..count as usize {
+                self.gamepads.push(open_gamepad(unsafe { *ids.add(i) }));
+            }
+            unsafe { SDL_free(ids.cast()) };
+        }
+    }
+
+    pub fn quit(&mut self) {
+        self.close_audio();
+        self.close_window();
+        unsafe { SDL_Quit() };
+        std::process::exit(0);
+    }
+
+    pub fn ticks(&self) -> u32 {
+        unsafe { SDL_GetTicks() as u32 }
+    }
+
+    pub fn export_browser_file(&self, _filename: &str) {}
+
+    pub fn init_window(&mut self, title: &str, width: u32, height: u32) {
+        let title = window_title_c_string(title);
+        unsafe {
+            SDL_GL_SetAttribute(
+                SDL_GL_CONTEXT_PROFILE_MASK,
+                SDL_GL_CONTEXT_PROFILE_CORE as c_int,
+            );
+            SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 2);
+            SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 1);
+
+            self.window = SDL_CreateWindow(
+                title.as_ptr(),
+                width as c_int,
+                height as c_int,
+                SDL_WINDOW_OPENGL | SDL_WINDOW_RESIZABLE,
+            );
+            assert!(
+                !self.window.is_null(),
+                "Failed to create window: {}",
+                sdl_error()
+            );
+
+            SDL_SetHint(
+                SDL_HINT_MOUSE_FOCUS_CLICKTHROUGH.as_ptr().cast(),
+                c"1".as_ptr(),
+            );
+
+            self.sdl_gl_context = SDL_GL_CreateContext(self.window);
+            if self.sdl_gl_context.is_null() {
+                SDL_GL_SetAttribute(
+                    SDL_GL_CONTEXT_PROFILE_MASK,
+                    SDL_GL_CONTEXT_PROFILE_ES as c_int,
+                );
+                SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 2);
+                SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
+                self.sdl_gl_context = SDL_GL_CreateContext(self.window);
+                assert!(
+                    !self.sdl_gl_context.is_null(),
+                    "Failed to create OpenGL context: {}",
+                    sdl_error()
+                );
+            }
+
+            self.gl_context = Box::into_raw(Box::new(Context::from_loader_function(|s| {
+                let name = CString::new(s).expect("GL function names have no NUL bytes");
+                match SDL_GL_GetProcAddress(name.as_ptr()) {
+                    Some(f) => f as *const c_void,
+                    None => std::ptr::null(),
+                }
+            })));
+
+            SDL_StartTextInput(self.window);
+            SDL_RaiseWindow(self.window);
+        }
+    }
+
+    fn close_window(&mut self) {
+        if !self.gl_context.is_null() {
+            unsafe { drop(Box::from_raw(self.gl_context)) };
+            self.gl_context = null_mut();
+        }
+        if !self.sdl_gl_context.is_null() {
+            unsafe { SDL_GL_DestroyContext(self.sdl_gl_context) };
+            self.sdl_gl_context = null_mut();
+        }
+        if !self.window.is_null() {
+            unsafe { SDL_DestroyWindow(self.window) };
+            self.window = null_mut();
+        }
+    }
+
+    pub fn window_pos(&self) -> (i32, i32) {
+        let (mut x, mut y) = (0, 0);
+        unsafe { SDL_GetWindowPosition(self.window, &raw mut x, &raw mut y) };
+        (x, y)
+    }
+
+    pub fn set_window_pos(&mut self, x: i32, y: i32) {
+        unsafe { SDL_SetWindowPosition(self.window, x, y) };
+    }
+
+    pub fn window_size(&self) -> (u32, u32) {
+        let (mut w, mut h) = (0, 0);
+        unsafe { SDL_GetWindowSize(self.window, &raw mut w, &raw mut h) };
+        (w as u32, h as u32)
+    }
+
+    pub fn set_window_size(&mut self, width: u32, height: u32) {
+        unsafe { SDL_SetWindowSize(self.window, width as c_int, height as c_int) };
+    }
+
+    pub fn set_window_title(&mut self, title: &str) {
+        let title = window_title_c_string(title);
+        unsafe { SDL_SetWindowTitle(self.window, title.as_ptr()) };
+    }
+
+    pub fn set_window_icon(&mut self, width: u32, height: u32, rgba: &[u8]) {
+        unsafe {
+            let surface = SDL_CreateSurface(width as c_int, height as c_int, SDL_PIXELFORMAT_RGBA32);
+            assert!(!surface.is_null(), "Failed to create icon surface");
+            let pixels = (*surface).pixels.cast::<u8>();
+            let size = (height * (*surface).pitch as u32) as usize;
+            assert!(rgba.len() >= size, "RGBA buffer too small for icon");
+            copy_nonoverlapping(rgba.as_ptr(), pixels, size);
+            SDL_SetWindowIcon(self.window, surface);
+            SDL_DestroySurface(surface);
+        }
+    }
+
+    pub fn is_fullscreen(&self) -> bool {
+        (unsafe { SDL_GetWindowFlags(self.window) } & SDL_WINDOW_FULLSCREEN) != 0
+    }
+
+    pub fn set_fullscreen(&mut self, enabled: bool) {
+        unsafe { SDL_SetWindowFullscreen(self.window, enabled) };
+    }
+
+    pub fn set_mouse_pos(&mut self, x: i32, y: i32) {
+        unsafe { SDL_WarpMouseInWindow(self.window, x as f32, y as f32) };
+    }
+
+    pub fn set_mouse_visible(&mut self, visible: bool) {
+        unsafe {
+            if visible {
+                SDL_ShowCursor();
+            } else {
+                SDL_HideCursor();
+            }
+        }
+    }
+
+    pub fn display_size(&self) -> (u32, u32) {
+        let mode = unsafe { SDL_GetCurrentDisplayMode(SDL_GetPrimaryDisplay()) };
+        assert!(!mode.is_null(), "Failed to get display size");
+        let mode = unsafe { &*mode };
+        (mode.w as u32, mode.h as u32)
+    }
+
+    pub fn start_audio<F: FnMut(&mut [i16]) + 'static>(
+        &mut self,
+        sample_rate: u32,
+        buffer_size: u32,
+        callback: F,
+    ) {
+        self.close_audio();
+
+        let frames = CString::new(buffer_size.to_string()).expect("number has no NUL bytes");
+        unsafe {
+            SDL_SetHint(
+                SDL_HINT_AUDIO_DEVICE_SAMPLE_FRAMES.as_ptr().cast(),
+                frames.as_ptr(),
+            )
+        };
+        if !unsafe { SDL_InitSubSystem(SDL_INIT_AUDIO) } {
+            println!("Failed to initialize audio device");
+            return;
+        }
+        self.audio_subsystem_initialized = true;
+
+        let userdata = Box::into_raw(Box::new(AudioState {
+            callback: Box::new(callback),
+            buffer: Vec::new(),
+        }))
+        .cast::<c_void>();
+        let spec = SDL_AudioSpec {
+            format: SDL_AUDIO_S16,
+            channels: 1,
+            freq: sample_rate as c_int,
+        };
+        self.audio_stream = unsafe {
+            SDL_OpenAudioDeviceStream(
+                SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK,
+                &raw const spec,
+                Some(audio_callback),
+                userdata,
+            )
+        };
+        if self.audio_stream.is_null() {
+            unsafe { drop(Box::from_raw(userdata.cast::<AudioState>())) };
+            unsafe { SDL_QuitSubSystem(SDL_INIT_AUDIO) };
+            self.audio_subsystem_initialized = false;
+            println!("Failed to initialize audio device");
+            return;
+        }
+        self.audio_userdata = userdata;
+        self.pause_audio(false);
+    }
+
+    pub fn close_audio(&mut self) {
+        if !self.audio_stream.is_null() {
+            unsafe { SDL_DestroyAudioStream(self.audio_stream) };
+            self.audio_stream = null_mut();
+        }
+        if !self.audio_userdata.is_null() {
+            unsafe { drop(Box::from_raw(self.audio_userdata.cast::<AudioState>())) };
+            self.audio_userdata = null_mut();
+        }
+        if self.audio_subsystem_initialized {
+            unsafe { SDL_QuitSubSystem(SDL_INIT_AUDIO) };
+            self.audio_subsystem_initialized = false;
+        }
+    }
+
+    pub fn pause_audio(&mut self, paused: bool) {
+        if !self.audio_stream.is_null() {
+            unsafe {
+                if paused {
+                    SDL_PauseAudioStreamDevice(self.audio_stream);
+                } else {
+                    SDL_ResumeAudioStreamDevice(self.audio_stream);
+                }
+            }
+        }
+    }
+
+    pub fn lock_audio(&self) {
+        if !self.audio_stream.is_null() {
+            unsafe { SDL_LockAudioStream(self.audio_stream) };
+        }
+    }
+
+    pub fn unlock_audio(&self) {
+        if !self.audio_stream.is_null() {
+            unsafe { SDL_UnlockAudioStream(self.audio_stream) };
+        }
+    }
+
+    pub fn run_frame_loop<F: FnMut(f32)>(fps: u32, mut callback: F) {
+        let frame_ms = 1000.0 / f64::from(fps);
+        let mut next_frame_ms = unsafe { SDL_GetTicks() } as f64;
+        let mut last_frame_ms = next_frame_ms;
+
+        loop {
+            loop {
+                let remaining_ms = next_frame_ms - unsafe { SDL_GetTicks() } as f64;
+                if remaining_ms <= 0.0 {
+                    break;
+                }
+                unsafe { SDL_Delay((remaining_ms as u32 / 2).max(1)) };
+            }
+
+            callback((next_frame_ms - last_frame_ms) as f32);
+            super::super::facade::swap_window();
+            last_frame_ms = next_frame_ms;
+
+            let ticks = unsafe { SDL_GetTicks() } as f64;
+            while next_frame_ms <= ticks {
+                next_frame_ms += frame_ms;
+            }
+        }
+    }
+
+    pub fn step_frame(&mut self, fps: u32) {
+        let frame_ms = 1000.0 / f64::from(fps);
+        let mut next_frame_ms = self
+            .next_update_ms
+            .unwrap_or(unsafe { SDL_GetTicks() } as f64);
+
+        loop {
+            let remaining_ms = next_frame_ms - unsafe { SDL_GetTicks() } as f64;
+            if remaining_ms <= 0.0 {
+                break;
+            }
+            unsafe { SDL_Delay((remaining_ms as u32 / 2).max(1)) };
+        }
+
+        self.swap_window();
+
+        let ticks = unsafe { SDL_GetTicks() } as f64;
+        while next_frame_ms <= ticks {
+            next_frame_ms += frame_ms;
+        }
+        self.next_update_ms = Some(next_frame_ms);
+    }
+
+    pub fn gl_profile(&self) -> GlProfile {
+        let mut value: c_int = 0;
+        unsafe { SDL_GL_GetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, &raw mut value) };
+        if value & SDL_GL_CONTEXT_PROFILE_CORE as c_int != 0 {
+            GlProfile::Gl
+        } else if value & SDL_GL_CONTEXT_PROFILE_ES as c_int != 0 {
+            GlProfile::Gles
+        } else {
+            GlProfile::None
+        }
+    }
+
+    pub fn swap_window(&self) {
+        if !self.window.is_null() {
+            unsafe { SDL_GL_SwapWindow(self.window) };
+        }
+    }
+
+    pub fn with_gl_context<T>(&mut self, f: impl FnOnce(&mut Context) -> T) -> T {
+        unsafe { f(&mut *self.gl_context) }
+    }
+}
+
+impl Drop for PlatformSdl3 {
+    fn drop(&mut self) {
+        self.close_gamepads();
+        self.close_audio();
+        self.close_window();
+        if self.initialized_subsystems != 0 {
+            unsafe { SDL_QuitSubSystem(self.initialized_subsystems) };
+        }
+    }
+}
+
+fn window_title_c_string(title: &str) -> CString {
+    CString::new(title.replace('\0', " ")).expect("window title NUL bytes are replaced")
+}
+
+unsafe extern "C" fn audio_callback(
+    userdata: *mut c_void,
+    stream: *mut SDL_AudioStream,
+    additional_amount: c_int,
+    _total_amount: c_int,
+) {
+    if additional_amount <= 0 {
+        return;
+    }
+    let state = unsafe { &mut *userdata.cast::<AudioState>() };
+    let samples = additional_amount as usize / 2;
+    state.buffer.resize(samples, 0);
+    (state.callback)(&mut state.buffer[..samples]);
+    unsafe {
+        SDL_PutAudioStreamData(
+            stream,
+            state.buffer.as_ptr().cast(),
+            (samples * 2) as c_int,
+        )
+    };
+}
diff --git a/crates/pyxel-core/src/platform/sdl3/poll_events.rs b/crates/pyxel-core/src/platform/sdl3/poll_events.rs
new file mode 100644
index 0000000..716de5d
--- /dev/null
+++ b/crates/pyxel-core/src/platform/sdl3/poll_events.rs
@@ -0,0 +1,271 @@
+use std::ffi::{c_char, CStr};
+use std::mem::zeroed;
+
+use super::super::event::Event;
+use super::super::key::{
+    Key, GAMEPAD1_AXIS_LEFTX, GAMEPAD1_AXIS_LEFTY, GAMEPAD1_AXIS_RIGHTX, GAMEPAD1_AXIS_RIGHTY,
+    GAMEPAD1_AXIS_TRIGGERLEFT, GAMEPAD1_AXIS_TRIGGERRIGHT, GAMEPAD1_BUTTON_A, GAMEPAD1_BUTTON_B,
+    GAMEPAD1_BUTTON_BACK, GAMEPAD1_BUTTON_DPAD_DOWN, GAMEPAD1_BUTTON_DPAD_LEFT,
+    GAMEPAD1_BUTTON_DPAD_RIGHT, GAMEPAD1_BUTTON_DPAD_UP, GAMEPAD1_BUTTON_GUIDE,
+    GAMEPAD1_BUTTON_LEFTSHOULDER, GAMEPAD1_BUTTON_LEFTSTICK, GAMEPAD1_BUTTON_RIGHTSHOULDER,
+    GAMEPAD1_BUTTON_RIGHTSTICK, GAMEPAD1_BUTTON_START, GAMEPAD1_BUTTON_X, GAMEPAD1_BUTTON_Y,
+    GAMEPAD_KEY_STRIDE, KEY_ALT, KEY_CTRL, KEY_GUI, KEY_LALT, KEY_LCTRL, KEY_LGUI, KEY_LSHIFT,
+    KEY_RALT, KEY_RCTRL, KEY_RGUI, KEY_RSHIFT, KEY_SHIFT, KEY_UNKNOWN, MOUSE_BUTTON_LEFT,
+    MOUSE_BUTTON_MIDDLE, MOUSE_BUTTON_RIGHT, MOUSE_BUTTON_X1, MOUSE_BUTTON_X2, MOUSE_POS_X,
+    MOUSE_POS_Y, MOUSE_WHEEL_X, MOUSE_WHEEL_Y,
+};
+use super::platform_sdl3::PlatformSdl3;
+#[allow(clippy::wildcard_imports)]
+use super::sdl3_sys::*;
+
+pub type GamepadSlot = Option<(SDL_JoystickID, *mut SDL_Gamepad)>;
+
+pub fn open_gamepad(instance_id: SDL_JoystickID) -> GamepadSlot {
+    let gamepad = unsafe { SDL_OpenGamepad(instance_id) };
+    if gamepad.is_null() {
+        return None;
+    }
+    Some((instance_id, gamepad))
+}
+
+fn close_gamepad(gamepad: &mut GamepadSlot) {
+    if let Some((_, handle)) = gamepad {
+        unsafe { SDL_CloseGamepad(*handle) };
+        *gamepad = None;
+    }
+}
+
+impl PlatformSdl3 {
+    pub(super) fn close_gamepads(&mut self) {
+        for gamepad in &mut self.gamepads {
+            close_gamepad(gamepad);
+        }
+        self.gamepads.clear();
+    }
+
+    pub fn poll_events(&mut self, pyxel_events: &mut Vec<Event>) {
+        let mut ev: SDL_Event = unsafe { zeroed() };
+        while unsafe { SDL_PollEvent(&raw mut ev) } {
+            let kind = unsafe { ev.type_ } as SDL_EventType;
+            match kind {
+                SDL_EVENT_WINDOW_SHOWN | SDL_EVENT_WINDOW_MAXIMIZED | SDL_EVENT_WINDOW_RESTORED => {
+                    pyxel_events.push(Event::WindowShown);
+                }
+                SDL_EVENT_WINDOW_HIDDEN | SDL_EVENT_WINDOW_MINIMIZED => {
+                    pyxel_events.push(Event::WindowHidden);
+                }
+
+                SDL_EVENT_DROP_FILE => {
+                    unsafe { SDL_RaiseWindow(self.window) };
+                    let data = unsafe { ev.drop.data };
+                    if !data.is_null() {
+                        let filename = unsafe { CStr::from_ptr(data) }.to_string_lossy().into_owned();
+                        pyxel_events.push(Event::FileDropped { filename });
+                    }
+                }
+
+                SDL_EVENT_QUIT => {
+                    pyxel_events.push(Event::Quit);
+                }
+
+                SDL_EVENT_KEY_DOWN | SDL_EVENT_KEY_UP => {
+                    let key = unsafe { ev.key.key } as Key;
+                    if !unsafe { ev.key.repeat } {
+                        let pressed = kind == SDL_EVENT_KEY_DOWN;
+                        push_key_event(pyxel_events, key, pressed);
+
+                        if let Some((unified_key, mask)) = key_to_virtual_key(key) {
+                            let modifiers = unsafe { ev.key.mod_ };
+                            let was_pressed = self.key_modifiers & mask != 0;
+                            let is_pressed = modifiers & mask != 0;
+                            if is_pressed != was_pressed {
+                                push_key_event(pyxel_events, unified_key, is_pressed);
+                            }
+                            self.key_modifiers = modifiers;
+                        }
+                    }
+                }
+
+                SDL_EVENT_TEXT_INPUT => {
+                    let text = unsafe { ev.text.text };
+                    if !text.is_null() {
+                        if let Ok(text) = unsafe { CStr::from_ptr(text.cast::<c_char>()) }.to_str() {
+                            pyxel_events.push(Event::TextInput {
+                                text: text.to_string(),
+                            });
+                        }
+                    }
+                }
+
+                SDL_EVENT_MOUSE_BUTTON_DOWN | SDL_EVENT_MOUSE_BUTTON_UP => {
+                    let key = mouse_button_to_key(u32::from(unsafe { ev.button.button }));
+                    if key != KEY_UNKNOWN {
+                        push_key_event(pyxel_events, key, kind == SDL_EVENT_MOUSE_BUTTON_DOWN);
+                    }
+                }
+
+                SDL_EVENT_MOUSE_WHEEL => {
+                    pyxel_events.push(Event::KeyValueChanged {
+                        key: MOUSE_WHEEL_X,
+                        value: unsafe { ev.wheel.integer_x },
+                    });
+                    pyxel_events.push(Event::KeyValueChanged {
+                        key: MOUSE_WHEEL_Y,
+                        value: unsafe { ev.wheel.integer_y },
+                    });
+                }
+
+                SDL_EVENT_GAMEPAD_ADDED => {
+                    let instance_id = unsafe { ev.gdevice.which };
+                    if self
+                        .gamepads
+                        .iter()
+                        .any(|g| matches!(g, Some((id, _)) if *id == instance_id))
+                    {
+                        continue;
+                    }
+                    if let Some(gamepad) = open_gamepad(instance_id) {
+                        match self.gamepads.iter_mut().find(|g| g.is_none()) {
+                            Some(slot) => *slot = Some(gamepad),
+                            None => self.gamepads.push(Some(gamepad)),
+                        }
+                    }
+                }
+
+                SDL_EVENT_GAMEPAD_REMOVED => {
+                    let instance_id = unsafe { ev.gdevice.which };
+                    if let Some(slot) = self
+                        .gamepads
+                        .iter_mut()
+                        .find(|g| matches!(g, Some((id, _)) if *id == instance_id))
+                    {
+                        close_gamepad(slot);
+                    }
+                }
+
+                SDL_EVENT_GAMEPAD_AXIS_MOTION => {
+                    if let Some(offset) = self.gamepad_key_offset(unsafe { ev.gaxis.which }) {
+                        let key = gamepad_axis_to_key(i32::from(unsafe { ev.gaxis.axis }));
+                        if key != KEY_UNKNOWN {
+                            pyxel_events.push(Event::KeyValueChanged {
+                                key: key + offset,
+                                value: i32::from(unsafe { ev.gaxis.value }),
+                            });
+                        }
+                    }
+                }
+
+                SDL_EVENT_GAMEPAD_BUTTON_DOWN | SDL_EVENT_GAMEPAD_BUTTON_UP => {
+                    if let Some(offset) = self.gamepad_key_offset(unsafe { ev.gbutton.which }) {
+                        let key = gamepad_button_to_key(i32::from(unsafe { ev.gbutton.button }));
+                        if key != KEY_UNKNOWN {
+                            push_key_event(
+                                pyxel_events,
+                                key + offset,
+                                kind == SDL_EVENT_GAMEPAD_BUTTON_DOWN,
+                            );
+                        }
+                    }
+                }
+
+                _ => {}
+            }
+        }
+
+        let (mouse_x, mouse_y) = if self.is_wayland {
+            let (mut x, mut y) = (0.0f32, 0.0f32);
+            unsafe { SDL_GetMouseState(&raw mut x, &raw mut y) };
+            (x as i32, y as i32)
+        } else {
+            let (mut gx, mut gy) = (0.0f32, 0.0f32);
+            unsafe { SDL_GetGlobalMouseState(&raw mut gx, &raw mut gy) };
+            let (wx, wy) = self.window_pos();
+            (gx as i32 - wx, gy as i32 - wy)
+        };
+
+        if mouse_x != self.mouse_x || mouse_y != self.mouse_y {
+            self.mouse_x = mouse_x;
+            self.mouse_y = mouse_y;
+            pyxel_events.push(Event::KeyValueChanged {
+                key: MOUSE_POS_X,
+                value: mouse_x,
+            });
+            pyxel_events.push(Event::KeyValueChanged {
+                key: MOUSE_POS_Y,
+                value: mouse_y,
+            });
+        }
+    }
+
+    fn gamepad_key_offset(&self, instance_id: SDL_JoystickID) -> Option<Key> {
+        self.gamepads
+            .iter()
+            .enumerate()
+            .find_map(|(index, slot)| match slot {
+                Some((id, _)) if *id == instance_id => Some(GAMEPAD_KEY_STRIDE * index as Key),
+                _ => None,
+            })
+    }
+}
+
+fn mouse_button_to_key(button: u32) -> Key {
+    match button {
+        SDL_BUTTON_LEFT => MOUSE_BUTTON_LEFT,
+        SDL_BUTTON_MIDDLE => MOUSE_BUTTON_MIDDLE,
+        SDL_BUTTON_RIGHT => MOUSE_BUTTON_RIGHT,
+        SDL_BUTTON_X1 => MOUSE_BUTTON_X1,
+        SDL_BUTTON_X2 => MOUSE_BUTTON_X2,
+        _ => KEY_UNKNOWN,
+    }
+}
+
+fn push_key_event(events: &mut Vec<Event>, key: Key, pressed: bool) {
+    events.push(if pressed {
+        Event::KeyPressed { key }
+    } else {
+        Event::KeyReleased { key }
+    });
+}
+
+fn key_to_virtual_key(key: Key) -> Option<(Key, SDL_Keymod)> {
+    match key {
+        KEY_LSHIFT | KEY_RSHIFT => Some((KEY_SHIFT, SDL_KMOD_SHIFT as SDL_Keymod)),
+        KEY_LCTRL | KEY_RCTRL => Some((KEY_CTRL, SDL_KMOD_CTRL as SDL_Keymod)),
+        KEY_LALT | KEY_RALT => Some((KEY_ALT, SDL_KMOD_ALT as SDL_Keymod)),
+        KEY_LGUI | KEY_RGUI => Some((KEY_GUI, SDL_KMOD_GUI as SDL_Keymod)),
+        _ => None,
+    }
+}
+
+fn gamepad_axis_to_key(axis: i32) -> Key {
+    match axis {
+        SDL_GAMEPAD_AXIS_LEFTX => GAMEPAD1_AXIS_LEFTX,
+        SDL_GAMEPAD_AXIS_LEFTY => GAMEPAD1_AXIS_LEFTY,
+        SDL_GAMEPAD_AXIS_RIGHTX => GAMEPAD1_AXIS_RIGHTX,
+        SDL_GAMEPAD_AXIS_RIGHTY => GAMEPAD1_AXIS_RIGHTY,
+        SDL_GAMEPAD_AXIS_LEFT_TRIGGER => GAMEPAD1_AXIS_TRIGGERLEFT,
+        SDL_GAMEPAD_AXIS_RIGHT_TRIGGER => GAMEPAD1_AXIS_TRIGGERRIGHT,
+        _ => KEY_UNKNOWN,
+    }
+}
+
+fn gamepad_button_to_key(button: i32) -> Key {
+    match button {
+        SDL_GAMEPAD_BUTTON_SOUTH => GAMEPAD1_BUTTON_A,
+        SDL_GAMEPAD_BUTTON_EAST => GAMEPAD1_BUTTON_B,
+        SDL_GAMEPAD_BUTTON_WEST => GAMEPAD1_BUTTON_X,
+        SDL_GAMEPAD_BUTTON_NORTH => GAMEPAD1_BUTTON_Y,
+        SDL_GAMEPAD_BUTTON_BACK => GAMEPAD1_BUTTON_BACK,
+        SDL_GAMEPAD_BUTTON_GUIDE => GAMEPAD1_BUTTON_GUIDE,
+        SDL_GAMEPAD_BUTTON_START => GAMEPAD1_BUTTON_START,
+        SDL_GAMEPAD_BUTTON_LEFT_STICK => GAMEPAD1_BUTTON_LEFTSTICK,
+        SDL_GAMEPAD_BUTTON_RIGHT_STICK => GAMEPAD1_BUTTON_RIGHTSTICK,
+        SDL_GAMEPAD_BUTTON_LEFT_SHOULDER => GAMEPAD1_BUTTON_LEFTSHOULDER,
+        SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER => GAMEPAD1_BUTTON_RIGHTSHOULDER,
+        SDL_GAMEPAD_BUTTON_DPAD_UP => GAMEPAD1_BUTTON_DPAD_UP,
+        SDL_GAMEPAD_BUTTON_DPAD_DOWN => GAMEPAD1_BUTTON_DPAD_DOWN,
+        SDL_GAMEPAD_BUTTON_DPAD_LEFT => GAMEPAD1_BUTTON_DPAD_LEFT,
+        SDL_GAMEPAD_BUTTON_DPAD_RIGHT => GAMEPAD1_BUTTON_DPAD_RIGHT,
+        _ => KEY_UNKNOWN,
+    }
+}
