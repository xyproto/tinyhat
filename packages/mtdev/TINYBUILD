set pkgname mtdev
set pkgver 1.1.7
set pkgrel 1
set pkgdesc 'A stand-alone library which transforms all variants of kernel MT events to the slotted type B protocol'
set arch i686 x32
set url https://bitmath.org/code/mtdev/
set nvchecker source=regex 'regex=mtdev v(\d+.\d+.\d+)' url=https://bitmath.org/code/mtdev/
set license MIT
set depends glibc
set source "https://bitmath.org/code/mtdev/mtdev-$pkgver.tar.bz2"
set sha256sums a107adad2101fecac54ac7f9f0e0a0dd155d954193da55c2340c97f2ff1d814e
set flags arch

function build
    cd "$pkgname-$pkgver"; or return
    ./configure --prefix=/usr --disable-static; or return
    make; or return
end

function package
    cd "$pkgname-$pkgver"; or return
    make DESTDIR="$pkgdir/" install; or return
    install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
