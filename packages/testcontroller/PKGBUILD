pkgname=testcontroller
pkgver=3.4.18
pkgrel=1
pkgdesc="SDL3 gamepad test program"
arch=(i686 x32)
url="https://libsdl.org/"
license=(Zlib)
depends=(sdl3)
source=("https://github.com/libsdl-org/SDL/releases/download/release-$pkgver/SDL3-$pkgver.tar.gz")
noextract=("SDL3-$pkgver.tar.gz")
sha256sums=('9c75cf16330322c217dedd2e0609f1124f1b54b8633e763467b4684d0f4334a3')

prepare() {
  tar --no-same-owner -xf SDL3-$pkgver.tar.gz --strip-components=1 SDL3-$pkgver/test SDL3-$pkgver/LICENSE.txt
}

build() {
  cc $CFLAGS -Itest -o testcontroller test/testcontroller.c test/gamepadutils.c test/testutils.c -lSDL3_test -lSDL3 -lm $LDFLAGS
}

package() {
  install -Dm755 testcontroller "$pkgdir/usr/bin/testcontroller"
  install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}
