set pkgname testcontroller
set pkgver 3.4.20
set pkgrel 1
set pkgdesc 'SDL3 gamepad test program'
set arch i686 x32
set url https://libsdl.org/
set nvchecker source=github github=libsdl-org/SDL prefix=release- use_max_tag=true 'include_regex=release-3\.\d*[02468]\.\d+'
set license Zlib
set depends sdl3
set source "https://github.com/libsdl-org/SDL/releases/download/release-$pkgver/SDL3-$pkgver.tar.gz"
set noextract "SDL3-$pkgver.tar.gz"
set sha256sums f3bb06f55bed9557227a700af2ea62e49497ebdf58037732a731a5fb3ef8581f

function prepare
    tar --no-same-owner -xf SDL3-$pkgver.tar.gz --strip-components=1 SDL3-$pkgver/test SDL3-$pkgver/LICENSE.txt; or return
end

function build
    set -l unwind
    nm ($CC -print-file-name=libSDL3_test.a) 2>/dev/null | string match -q '* U _UL*'; and set unwind -lunwind
    $CC $CFLAGS -Itest -o testcontroller test/testcontroller.c test/gamepadutils.c test/testutils.c -lSDL3_test -lSDL3 -lm $unwind $LDFLAGS; or return
end

function package
    install -Dm755 testcontroller "$pkgdir/usr/bin/testcontroller"; or return
    install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"; or return
end
