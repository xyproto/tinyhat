%rename link old_link

*link:
%(old_link) -T gba_cart.ld%s --gc-sections --no-warn-rwx-segments

*startfile:
gba_crt0%O%s crti%O%s crtbegin%O%s

%rename link_gcc_c_sequence gba_link_gcc_c_sequence

*link_gcc_c_sequence:
%(gba_link_gcc_c_sequence) --start-group %G %{!specs=nano.specs:-lc} %{specs=nano.specs:-lc_nano} -lgbasys --end-group
