set pkgname glib-networking
set pkgver 2.90.0
set pkgrel 1
set epoch 1
set pkgdesc 'Network extensions for GLib'
set arch i686 x32
set url https://gitlab.gnome.org/GNOME/glib-networking
set license LGPL-2.1-or-later
set depends glib2 glibc gnutls gsettings-system-schemas libproxy
set makedepends git gsettings-desktop-schemas meson
set checkdepends ca-certificates
set source "git+https://gitlab.gnome.org/GNOME/glib-networking.git#tag=$pkgver"
set sha256sums SKIP
set flags arch

function prepare
    cd $pkgname; or return
end

function build
    arch-meson $pkgname build; or return
    meson compile -C build; or return
end

function package
    meson install -C build --no-rebuild --destdir "$pkgdir"; or return
end
