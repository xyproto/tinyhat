# No libproxy support (libproxy=disabled): proxies come from GSettings (gnome_proxy) or the environment
set pkgname glib-networking
set pkgver 2.90.0
set pkgrel 1
set epoch 1
set pkgdesc 'Network extensions for GLib'
set arch i686 x32
set url https://gitlab.gnome.org/GNOME/glib-networking
set nvchecker source=git git=https://gitlab.gnome.org/GNOME/glib-networking.git 'include_regex=\d+\.\d*[02468]\.\d+' 'from_pattern=\.([a-z])' 'to_pattern=\1'
set license LGPL-2.1-or-later
set depends glib2 glibc gnutls gsettings-system-schemas
set makedepends git gsettings-desktop-schemas meson
set checkdepends ca-certificates
set source "git+https://gitlab.gnome.org/GNOME/glib-networking.git#tag=$pkgver"
set sha256sums c3c0dfb515834f4d12f57a1fac1f8df7de08a35a55fe6c40fe68d237d0ad6670
set flags arch

function prepare
    cd $pkgname; or return
end

function build
    arch-meson $pkgname build -D libproxy=disabled; or return
    meson compile -C build; or return
end

function package
    meson install -C build --no-rebuild --destdir "$pkgdir"; or return
end
