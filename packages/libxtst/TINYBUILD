set pkgname libxtst
set pkgver 1.2.6
set pkgrel 1
set pkgdesc 'library for XTEST & RECORD extensions'
set arch i686 x32
set url https://gitlab.freedesktop.org/xorg/lib/libxtst
set nvchecker source=gitlab gitlab=xorg/lib/libXtst host=gitlab.freedesktop.org 'include_regex=.*libXtst-.*' use_max_tag=true prefix=libXtst-
set license MIT-open-group HPND-sell-variant X11 HPND-doc HPND-doc-sell
set depends libxext libxi libx11 glibc xorgproto
set makedepends git xorg-util-macros
set source "git+https://gitlab.freedesktop.org/xorg/lib/libxtst.git?signed#tag=libXtst-$pkgver"
set sha512sums fd5e1e3c81d4876730f47b4051954d19ca9ffc42a5fa0b0381db1ae9e642a119440187ae4bb307f0c54b823a3ef591d6b87cb414aedc9d348f7f217a4cf97570
set flags arch

function prepare
    cd libxtst; or return
    autoreconf -fiv; or return
end

function build
    cd libxtst; or return
    ./configure --prefix=/usr --disable-static; or return
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make; or return
end

function package
    cd libxtst; or return
    make DESTDIR="$pkgdir" install; or return
    install -m755 -d "$pkgdir/usr/share/licenses/$pkgname"; or return
    install -m644 COPYING "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
