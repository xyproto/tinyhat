set pkgname fribidi
set pkgver 1.0.17
set pkgrel 2
set pkgdesc 'A Free Implementation of the Unicode Bidirectional Algorithm'
set url https://github.com/fribidi/fribidi
set nvchecker source=git git=https://github.com/fribidi/fribidi.git prefix=v
set arch i686 x32
set license LGPL-2.1-or-later
set depends glibc
set makedepends meson
set provides libfribidi.so
set source https://github.com/fribidi/fribidi/releases/download/v$pkgver/$pkgname-$pkgver.tar.xz
set sha256sums 6949dcde27d41cebad1fd741fcafc36d55a1020d2d872d4a6eb3914caabbada2
set flags arch

function build
    arch-meson $pkgname-$pkgver build -D docs=true; or return
    meson compile -C build; or return
end

function package
    meson install -C build --destdir "$pkgdir"; or return
end
