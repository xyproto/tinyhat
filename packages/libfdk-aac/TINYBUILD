set pkgname libfdk-aac
set pkgver 3.0.0
set pkgrel 2
set pkgdesc 'Fraunhofer FDK AAC codec library'
set arch i686 x32
set url https://sourceforge.net/projects/opencore-amr/
set nvchecker source=git git=https://github.com/mstorsjo/fdk-aac.git prefix=v
set license LicenseRef-Fraunhofer
set depends glibc
set makedepends git
set provides libfdk-aac.so
set source "git+https://github.com/mstorsjo/fdk-aac.git#tag=v$pkgver"
set sha256sums bb97dce7e1492fe9c1373896e3bcae221ad5f2b76f95b5ee568b90499461212e
set flags arch

function prepare
    cd fdk-aac; or return
    ./autogen.sh; or return
    sed -i "s/^static unsigned int fpuctrl_\(get\|set\)SSE_mxcsr/__attribute__((target(\"sse\"))) &/" xhe-aac/mathlib/src/opt/fpucontrol_opt.h; or return
end

function build
    cd fdk-aac; or return
    ./configure --prefix=/usr --disable-static; or return
    make; or return
end

function package
    cd fdk-aac; or return
    make DESTDIR="$pkgdir" install; or return
    install -Dm 644 NOTICE -t "$pkgdir"/usr/share/licenses/$pkgname/; or return
end
