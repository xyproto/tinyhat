set pkgname x32-gcc
set pkgver 16.2.0
set pkgrel 2
set pkgdesc 'C and C++ compiler for the x86_64-pc-linux-gnux32 toolchain'
set arch i686
set url https://gcc.gnu.org/
set license 'GPL-3.0-or-later WITH GCC-exception-3.1'
set depends x32-binutils gmp mpfr libmpc libisl zlib zstd
set makedepends glibc
set conflicts x32-gcc-stage1
set options '!buildflags' '!strip' staticlibs
set source "https://ftp.gnu.org/gnu/gcc/gcc-$pkgver/gcc-$pkgver.tar.xz"
set sha256sums e6738e29597f733270731aa90600f37ffdc045079dfc27ec7e8192cc81085c3e

function build
    mkdir -p build; or return
    cd build; or return
    ../gcc-$pkgver/configure --target=x86_64-pc-linux-gnux32 --prefix=/usr --libexecdir=/usr/lib \
        --with-sysroot=/ --with-build-sysroot=/usr/x86_64-pc-linux-gnux32/sysroot \
        --with-abi=mx32 --enable-multilib --with-multilib-list=mx32 \
        --with-gmp=/usr --with-mpfr=/usr --with-mpc=/usr --with-isl=/usr --with-system-zlib \
        --enable-languages=c,c++ --enable-shared --enable-threads=posix --enable-__cxa_atexit --enable-clocale=gnu \
        --enable-default-pie --enable-default-ssp --enable-linker-build-id --enable-lto --enable-plugin \
        --enable-gnu-unique-object --with-linker-hash-style=gnu --enable-checking=release \
        --disable-nls --disable-bootstrap --disable-werror --disable-libsanitizer --disable-libvtv \
        CFLAGS_FOR_TARGET="-O2 -pipe" CXXFLAGS_FOR_TARGET="-O2 -pipe"; or return
    make; or return
end

function package
    cd build; or return
    make DESTDIR="$pkgdir" install; or return
    rm -rf "$pkgdir/usr/share" "$pkgdir"/usr/lib/libcc1*
    set -l t x86_64-pc-linux-gnux32
    install -d "$pkgdir/usr/$t/bin"; or return
    for p in gcc:gcc gcc:cc cpp:cpp g++:g++ c++:c++ gcc-ar:gcc-ar gcc-nm:gcc-nm gcc-ranlib:gcc-ranlib
        set -l pair (string split -m1 : -- $p)
        ln -s ../../bin/$t-$pair[1] "$pkgdir/usr/$t/bin/$pair[2]"; or return
    end
    set -l libs "$pkgdir"/usr/lib/gcc/$t
    test -d "$pkgdir"/usr/$t/lib; and set -a libs "$pkgdir"/usr/$t/lib
    find $libs -type f \( -name '*.a' -o -name '*.o' -o -name '*.so.[0-9]*' \) -not -name '*.py' -exec $t-objcopy --strip-debug -R .comment '{}' \;; or return
end
