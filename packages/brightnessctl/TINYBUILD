set pkgname brightnessctl
set pkgver 0.5.1
set pkgrel 3
set pkgdesc 'Lightweight brightness control tool'
set arch i686 x32
set url https://github.com/Hummer12007/brightnessctl
set license MIT
set depends systemd-libs
set source "$pkgname-$pkgver.tar.gz::https://github.com/Hummer12007/brightnessctl/archive/$pkgver.tar.gz"
set sha512sums 41ac86357b3b5a3d54a043140a6bdb1fb68d5080a16e86692059ad58f4b9134a8532432a3f664c70c665a4ad73ea8a94cc9b88fa84abc28f0356b8b397aaebc7
set flags arch

function build
    cd "$pkgname-$pkgver"; or return
    make ENABLE_SYSTEMD=1; or return
end

function package
    cd "$pkgname-$pkgver"; or return
    make ENABLE_SYSTEMD=1 DESTDIR="$pkgdir" install; or return
    mkdir -p "$pkgdir/usr/share/licenses/$pkgname"; or return
    install -m 0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
