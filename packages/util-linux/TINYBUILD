set pkgbase util-linux
set pkgname util-linux util-linux-libs
set pkgver 2.42.4
set pkgrel 1
set pkgdesc 'Miscellaneous system utilities for Linux'
set url https://github.com/util-linux/util-linux
set arch i686 x32
# No bash completions (Tiny Hat's shells are Oils and fish), no Python bindings to libmount (nothing uses them),
# and none of the optional features that need libraries Tiny Hat does not have or use (see build)
set makedepends_host libcap-ng libxcrypt sqlite systemd
# util-linux and systemd need each other: without systemd (the first build in a bootstrap), util-linux has no
# systemd support and installs no units
set bootstrap_without systemd systemd-libs
set makedepends_build asciidoctor git meson
set license BSD-2-Clause BSD-3-Clause BSD-4-Clause-UC GPL-2.0-only GPL-2.0-or-later GPL-3.0-or-later ISC \
    LGPL-2.1-or-later LicenseRef-PublicDomain
set options strip
set source "git+https://github.com/util-linux/util-linux?signed#tag=v"(string replace -- rc -rc $pkgver) \
    "$pkgbase-BSD-2-Clause.txt::https://raw.githubusercontent.com/Cyan4973/xxHash/f035303b8a86c1db9be70cbb638678ef6ef4cb2d/LICENSE" \
    {login,common,remote,runuser,su}.pam \
    util-linux.sysusers \
    60-rfkill.rules \
    rfkill-unblock_.service \
    rfkill-block_.service
set sha256sums 9f065d81ff7d1e7a18f875fd72fa88f5f69e8a0910fbaaca76e34dd757c18cca \
    6ffedbc0f7878612d2b23589f1ff2ab15633e1df7963a5d9fc750ec5500c7e7a \
    ee917d55042f78b8bb03f5467e5233e3e2ddc2fe01e302bc53b218003fe22275 \
    57e057758944f4557762c6def939410c04ca5803cbdd2bfa2153ce47ffe7a4af \
    8bfbee453618ba44d60ba7fb00eced6c62edebfc592f2e75dede08e769ed8931 \
    48d6fba767631e3dd3620cf02a71a74c5d65a525d4c4ce4b5a0b7d9f41ebfea1 \
    5f4d36be03cc980930ba0a0e109d6b5625201f88a4ae7f913d632f5ab5866b87 \
    4a0b3dd8aa6d34dd29e1d153f396cacf908b0d64f7218276cbcab684587c0a0a \
    7423aaaa09fee7f47baa83df9ea6fef525ff9aec395c8cbd9fe848ceb2643f37 \
    8ccec10a22523f6b9d55e0d6cbf91905a39881446710aa083e935e8073323376 \
    a22e0a037e702170c7d88460cc9c9c2ab1d3e5c54a6985cd4a164ea7beff1b36
set flags arch

set -g _backports
set -g _reverts

function prepare
    cd $pkgbase; or return
    set -l _l
    for _c in $_backports
        if string match -q '*..*' -- $_c
            set _l --reverse
        else
            set _l --max-count=1
        end
        git log --oneline $_l $_c; or return
        git cherry-pick --mainline 1 --no-commit $_c; or return
    end
    for _c in $_reverts
        if string match -q '*..*' -- $_c
            set _l --reverse
        else
            set _l --max-count=1
        end
        git log --oneline $_l $_c; or return
        git revert --mainline 1 --no-commit $_c; or return
    end
    # do not mark dirty
    sed -i '/dirty=/c dirty=' tools/git-version-gen; or return
end

function build
    set -l _meson_options \
        -Dfs-search-path=/usr/bin:/usr/local/bin \
        -Dlibuser=disabled \
        -Dlibutempter=disabled \
        -Dncurses=disabled \
        -Dncursesw=enabled \
        -Deconf=disabled \
        -Dbuild-chfn-chsh=enabled \
        -Dbuild-line=disabled \
        -Dbuild-mesg=enabled \
        -Dbuild-newgrp=enabled \
        -Dbuild-vipw=enabled \
        -Dbuild-write=enabled \
        -Dbuild-bash-completion=disabled \
        -Dbuild-python=disabled \
        -Dbuild-pylibmount=disabled \
        -Dcryptsetup=disabled \
        -Dcryptsetup-dlopen=disabled \
        -Dslang=disabled \
        -Dselinux=disabled \
        -Dsmack=disabled \
        -Dsysvinit=disabled \
        -Dbtrfs=disabled \
        -Dtranslate-docs=disabled
    # Without libsystemd (the first build in a bootstrap, see bootstrap_without): no systemd support. arch-meson makes
    # auto features required, so it must be turned off
    pkg-config --exists libsystemd; or set -a _meson_options -Dsystemd=disabled
    arch-meson $pkgbase build $_meson_options; or return
    meson compile -C build; or return
end

function check
    cd build; or return
    ../util-linux/tests/run.sh --show-diff; or return
end

function package_util-linux
    set conflicts rfkill hardlink
    set provides rfkill hardlink
    set replaces rfkill hardlink
    set depends "util-linux-libs=$pkgver" coreutils file libmagic.so glibc libcap-ng libgcc libgcc_s.so libxcrypt libcrypt.so ncurses libncursesw.so pam readline shadow systemd-libs libsystemd.so libudev.so zlib
    set optdepends 'words: default dictionary for look'
    set backup etc/pam.d/chfn etc/pam.d/chsh etc/pam.d/login etc/pam.d/remote etc/pam.d/runuser etc/pam.d/runuser-l etc/pam.d/su etc/pam.d/su-l

    DESTDIR="$pkgdir" meson install -C build; or return

    # remove static libraries
    rm "$pkgdir"/usr/lib/lib*.a*; or return

    # setuid chfn and chsh
    chmod 4755 "$pkgdir"/usr/bin/{newgrp,ch{sh,fn}}; or return

    # install PAM files for login-utils
    install -Dm0644 common.pam "$pkgdir/etc/pam.d/chfn"; or return
    install -Dm0644 common.pam "$pkgdir/etc/pam.d/chsh"; or return
    install -Dm0644 login.pam "$pkgdir/etc/pam.d/login"; or return
    install -Dm0644 remote.pam "$pkgdir/etc/pam.d/remote"; or return
    install -Dm0644 runuser.pam "$pkgdir/etc/pam.d/runuser"; or return
    install -Dm0644 runuser.pam "$pkgdir/etc/pam.d/runuser-l"; or return
    install -Dm0644 su.pam "$pkgdir/etc/pam.d/su"; or return
    install -Dm0644 su.pam "$pkgdir/etc/pam.d/su-l"; or return

    # TODO(dreisner): offer this upstream?
    if test -e "$pkgdir/usr/lib/systemd/system/uuidd.socket"
        sed -i '/ListenStream/ aRuntimeDirectory=uuidd' "$pkgdir/usr/lib/systemd/system/uuidd.socket"; or return
    end

    # runtime libs are shipped as part of util-linux-libs
    install -d -m0755 util-linux-libs/lib/; or return
    mv "$pkgdir"/usr/lib/lib*.so* util-linux-libs/lib/; or return
    mv "$pkgdir"/usr/lib/pkgconfig util-linux-libs/lib/pkgconfig; or return
    mv "$pkgdir"/usr/include util-linux-libs/include; or return
    if test -d "$pkgdir"/usr/share/man/man3
        mv "$pkgdir"/usr/share/man/man3 util-linux-libs/man3; or return
    end

    # install systemd-sysusers
    install -Dm0644 util-linux.sysusers \
        "$pkgdir/usr/lib/sysusers.d/util-linux.conf"; or return

    install -Dm0644 60-rfkill.rules \
        "$pkgdir/usr/lib/udev/rules.d/60-rfkill.rules"; or return

    install -Dm0644 rfkill-unblock_.service \
        "$pkgdir/usr/lib/systemd/system/rfkill-unblock@.service"; or return
    install -Dm0644 rfkill-block_.service \
        "$pkgdir/usr/lib/systemd/system/rfkill-block@.service"; or return

    install -vDm 644 $pkgbase/Documentation/licenses/COPYING.{BSD*,ISC} -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
    install -vDm 644 $pkgbase-BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end

function package_util-linux-libs
    set pkgdesc 'util-linux runtime libraries'
    set depends glibc sqlite
    set provides libutil-linux libblkid.so libfdisk.so libmount.so libsmartcols.so libuuid.so
    set conflicts libutil-linux
    set replaces libutil-linux

    install -d -m0755 "$pkgdir"/usr/lib "$pkgdir"/usr/share/man; or return
    mv util-linux-libs/lib/* "$pkgdir"/usr/lib/; or return
    mv util-linux-libs/include "$pkgdir"/usr/include; or return
    if test -d util-linux-libs/man3
        mv util-linux-libs/man3 "$pkgdir"/usr/share/man/man3; or return
    end

    install -vDm 644 $pkgbase/Documentation/licenses/COPYING.{BSD*,ISC} -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
    install -vDm 644 $pkgbase-BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
