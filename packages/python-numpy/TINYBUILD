set pkgname python-numpy
set pkgver 2.5.4
set pkgrel 1
set pkgdesc 'Scientific tools for Python'
set arch i686 x32
set license custom
set url https://www.numpy.org/
set depends cblas lapack python
set optdepends 'blas-openblas: faster linear algebra'
set makedepends git python-build python-installer meson-python cmake gcc-fortran cython
set checkdepends python-pytest python-hypothesis
set source "git+https://github.com/numpy/numpy#tag=v$pkgver" \
    numpy-meson::git+https://github.com/numpy/meson.git \
    numpy-highway::git+https://github.com/google/highway.git \
    numpy-x86-simd-sort::git+https://github.com/intel/x86-simd-sort \
    numpy-pocketfft::git+https://github.com/mreineck/pocketfft \
    numpy-svml::git+https://github.com/numpy/SVML.git \
    numpy-pythoncapi-compat::git+https://github.com/python/pythoncapi-compat
set sha512sums 7d90b5988780cd6441400c0ff000490f66fc83b74c770dc16b65a1fc39f83d108e444d017eb8360a13154ee7be23a29aed4d824bcb664e80613c1c45c49da1ba \
    SKIP SKIP SKIP SKIP SKIP SKIP
set flags arch

function prepare
    cd numpy; or return
    git submodule init; or return
    git submodule set-url vendored-meson/meson "$srcdir"/numpy-meson; or return
    git submodule set-url numpy/_core/src/highway "$srcdir"/numpy-highway; or return
    git submodule set-url numpy/_core/src/npysort/x86-simd-sort "$srcdir"/numpy-x86-simd-sort; or return
    git submodule set-url numpy/fft/pocketfft "$srcdir"/numpy-pocketfft; or return
    git submodule set-url numpy/_core/src/umath/svml "$srcdir"/numpy-svml; or return
    git submodule set-url numpy/_core/src/common/pythoncapi-compat "$srcdir"/numpy-pythoncapi-compat; or return
    git -c protocol.file.allow=always submodule update vendored-meson/meson numpy/_core/src/highway \
        numpy/_core/src/npysort/x86-simd-sort numpy/fft/pocketfft numpy/_core/src/umath/svml \
        numpy/_core/src/common/pythoncapi-compat; or return
end

function build
    cd numpy; or return
    set -lx CFLAGS $CFLAGS -ffat-lto-objects
    set -lx CXXFLAGS $CXXFLAGS -ffat-lto-objects
    python -m build --wheel --no-isolation -Csetup-args=-Dblas=cblas -Csetup-args=-Dlapack=lapack \
        -Csetup-args=-Denable-openmp=true -Csetup-args=-Dcpu-baseline=NONE; or return
end

function check
    set -l site_packages (python -c "import site; print(site.getsitepackages()[0])"); or return
    cd numpy; or return
    python -m installer --destdir="$PWD/tmp_install" dist/*.whl; or return
    cd "$PWD/tmp_install"; or return
    PATH="$PWD/usr/bin:$PATH" PYTHONPATH="$PWD/$site_packages:$PYTHONPATH" python -c 'import numpy; numpy.test()'; or return
end

function package
    cd numpy; or return
    python -m installer --destdir="$pkgdir" dist/*.whl; or return
    # Symlink license file
    set -l site_packages (python -c "import site; print(site.getsitepackages()[0])"); or return
    install -d "$pkgdir"/usr/share/licenses/$pkgname; or return
    ln -s "$site_packages"/numpy-$pkgver.dist-info/LICENSE.txt \
        "$pkgdir"/usr/share/licenses/$pkgname/LICENSE.txt; or return
end
