set pkgname npth
set pkgver 1.8
set pkgrel 1
set pkgdesc 'The new GNU portable threads library'
set arch i686 x32
set url https://www.gnupg.org/software/npth/index.html
set nvchecker source=git git=https://dev.gnupg.org/source/npth.git prefix=npth-
set license LGPL-2.1-or-later
set depends glibc sh
set provides libnpth.so
set source https://gnupg.org/ftp/gcrypt/$pkgname/$pkgname-$pkgver.tar.bz2
set sha512sums 34fdeea3d8a7a594d8fdbcc6d5d389b5c8e282e8e84c1491b1e51960c0fa007df6a1d62543f0107f0772f3215557d4b25c2a9c7067cb0ae2f8de7b4d63d09fb4
set b2sums 554620f6a45f57bb958d245f7464abffd565b592941f0c404ce384c854be57ee35754a78dcf6afac751ee87e1df230bf3d2b78fb37cb1ef3e5ea534ddfd4ef2a
set flags arch

function prepare
    cd $pkgname-$pkgver; or return
    autoreconf -fiv; or return
end

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr; or return
    make; or return
end

function check
    make check -C $pkgname-$pkgver; or return
end

function package
    make DESTDIR="$pkgdir" install -C $pkgname-$pkgver; or return
    install -vDm 644 $pkgname-$pkgver/{README,NEWS,ChangeLog} -t "$pkgdir/usr/share/doc/$pkgname/"; or return
end
