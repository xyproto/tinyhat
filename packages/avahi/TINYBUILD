set pkgbase avahi
set pkgname avahi
set pkgver 0.9rc5
set pkgrel 2
set epoch 1
set pkgdesc 'Service Discovery for Linux using mDNS/DNS-SD (compatible with Bonjour)'
set arch i686 x32
set url https://github.com/avahi/avahi
set nvchecker source=git git=https://github.com/avahi/avahi.git prefix=v 'from_pattern=-([a-z])' 'to_pattern=\1'
set license LGPL-2.1-or-later
set depends bash dbus expat gdbm glib2 glibc libcap libdaemon systemd-libs
# No man pages (xmltoman) and no Python tools (avahi-bookmarks split, avahi-discover, the python module and the
# python-built service-types.db): python-dbus, python-gobject, python-twisted and dbus-python are dropped
# No GObject introspection data (nothing in Tiny Hat uses avahi from it)
set makedepends git glib2-devel systemd
set source 'git+https://github.com/avahi/avahi#tag=v0.9-rc5' \
    0001-HACK-Install-fixes.patch
set sha256sums 24a152a2e1e3e9ef11dcfe94d59238479500888dc662af125aaa9a36652c2e54 \
    e5aac2341d746c2d1df5fdeb1f63ca581833eaa8732e230adc40877848c0f2a5
set flags arch

function prepare
    cd avahi; or return
    git apply -3 ../0001-HACK-Install-fixes.patch; or return
    NOCONFIGURE=1 ./autogen.sh; or return
end

function build
    set -l configure_options --prefix=/usr --sysconfdir=/etc --localstatedir=/var --sbindir=/usr/bin --runstatedir=/run --disable-gtk --disable-gtk3 --disable-introspection --disable-doxygen-doc --disable-manpages --disable-libevent --disable-mono --disable-qt5 --disable-python --disable-pygobject --disable-python-dbus --enable-compat-libdns_sd --with-autoipd-group=avahi --with-autoipd-user=avahi --with-avahi-priv-access-group=network --with-distro=archlinux --with-systemdsystemunitdir=/usr/lib/systemd/system with_dbus_sys=/usr/share/dbus-1/system.d
    cd avahi; or return
    ./configure $configure_options; or return
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make; or return
end

function package_avahi
    set -a depends libdbus-1.so
    set provides libavahi-{client,common,core,glib,gobject}.so libdns_sd.so
    set backup etc/avahi/{hosts,avahi-daemon.conf,avahi-{autoip,dnsconf}d.action}
    cd avahi; or return
    make DESTDIR="$pkgdir" install; or return
    echo 'u! avahi - "Avahi mDNS/DNS-SD daemon"' | install -Dm644 /dev/stdin "$pkgdir/usr/lib/sysusers.d/$pkgname.conf"; or return
    cd "$pkgdir"; or return
    # The GTK tools and their files, globs that match nothing are left out
    set -l gtk usr/bin/{avahi-discover{,-standalone},bshell,bssh,bvnc} usr/include/avahi-ui usr/lib/libavahi-ui-gtk3.* \
        usr/lib/pkgconfig/avahi-ui-gtk3.pc usr/share/applications \
        usr/share/avahi/interfaces usr/share/man/man1/{avahi-discover,bshell,bssh,bvnc}.1*
    rm -rf $gtk; or return
end
