function prepare
    rm -rf tic80; or return
    mkdir tic80; or return
    tar --no-same-owner -xf tic80-$pkgver.tar.gz -C tic80 --strip-components=1; or return
    cd tic80; or return
    for m in $_vendor
        set -l dir vendor/(string replace -r -- '-[^-]*$' '' $m)
        mkdir -p $dir; or return
        tar --no-same-owner -xf "../tic80-$m.tar.gz" --strip-components=1 -C $dir; or return
    end
    patch -p1 -i "$srcdir/sdl3.patch"; or return
end

function build
    set -a CFLAGS -fno-pie
    set -a LDFLAGS -no-pie
    cmake -S tic80 -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_STATIC=ON -DCMAKE_POSITION_INDEPENDENT_CODE=OFF \
        -DBUILD_WITH_ALL=OFF -DBUILD_WITH_LUA=ON -DBUILD_WITH_FENNEL=ON -DPREFER_SYSTEM_SDL2=ON \
        -DBUILD_SDLGPU=OFF -DBUILD_SURF=OFF -DBUILD_PLAYER=OFF -DBUILD_STUB=OFF; or return
    ninja -C build; or return
    if string match -q -- '*-gcc' $CC
        env -u CMAKE_TOOLCHAIN_FILE -u CFLAGS -u CXXFLAGS -u CPPFLAGS -u LDFLAGS -u PKG_CONFIG_LIBDIR -u PKG_CONFIG_SYSROOT_DIR \
            -u PKG_CONFIG_PATH -u PKG_CONFIG_FDO_SYSROOT_RULES CC=$CC_FOR_BUILD CXX=$CXX_FOR_BUILD \
            cmake -S tic80 -B build-native -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_STATIC=ON \
            -DBUILD_WITH_ALL=OFF -DBUILD_WITH_LUA=ON -DBUILD_WITH_FENNEL=ON -DPREFER_SYSTEM_SDL2=ON \
            -DBUILD_SDLGPU=OFF -DBUILD_SURF=OFF -DBUILD_PLAYER=OFF -DBUILD_STUB=OFF; or return
        env -u CMAKE_TOOLCHAIN_FILE ninja -C build-native; or return
    end
end

function package
    install -Dm755 build/bin/tic80 "$pkgdir/usr/lib/tic80/tic80"; or return
    rm -rf demos home; or return
    mkdir -p demos home; or return
    set -l tic80 build/bin/tic80
    test -x build-native/bin/tic80; and set tic80 build-native/bin/tic80
    env HOME=$srcdir/home XDG_DATA_HOME=$srcdir/home SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
        $tic80 --cli --fs $srcdir/demos --cmd 'demo & exit'; or return
    test -f demos/fire.tic; or return
    rm -rf demos/.local; or return
    mkdir -p "$pkgdir/usr/share/tic80"; or return
    cp -r demos "$pkgdir/usr/share/tic80/demos"; or return
    mkdir -p "$pkgdir/usr/bin"; or return
    printf '%s\n' '#!/bin/sh' \
        'd=${XDG_DATA_HOME:-$HOME/.local/share}/com.nesbox.tic/TIC-80' \
        '[ -e "$d" ] || { mkdir -p "$d" && cp -r /usr/share/tic80/demos/. "$d/"; }' \
        'exec tinyhat-run -g /usr/lib/tic80/tic80 "$@"' >"$pkgdir/usr/bin/tic80"; or return
    chmod 755 "$pkgdir/usr/bin/tic80"; or return
    set -l l "$pkgdir/usr/share/licenses/$pkgname"
    install -Dm644 tic80/LICENSE "$l/LICENSE"; or return
    install -Dm644 tic80/vendor/argparse/LICENSE "$l/LICENSE.argparse"; or return
    install -Dm644 tic80/vendor/blip-buf/license.txt "$l/LICENSE.blip-buf"; or return
    install -Dm644 tic80/vendor/giflib/COPYING "$l/LICENSE.giflib"; or return
    install -Dm644 tic80/vendor/jsmn/LICENSE "$l/LICENSE.jsmn"; or return
    install -Dm644 tic80/vendor/libpng/LICENSE "$l/LICENSE.libpng"; or return
    install -Dm644 tic80/vendor/lua/lua.h "$l/LICENSE.lua.h"; or return
    install -Dm644 tic80/vendor/naett/LICENSE "$l/LICENSE.naett"; or return
    install -Dm644 tic80/vendor/zip/LICENSE.txt "$l/LICENSE.zip"; or return
    install -Dm644 tic80/vendor/zlib/LICENSE "$l/LICENSE.zlib"; or return
end
