# No python-capng package: nothing in Tiny Hat uses the Python bindings, and they need SWIG to build
set pkgname libcap-ng
set pkgver 0.9.6
set pkgrel 1
set pkgdesc 'A library for Linux that makes using posix capabilities easy'
set arch i686 x32
set url https://people.redhat.com/sgrubb/libcap-ng/
set license \
    GPL-2.0-or-later \
    LGPL-2.1-or-later
set depends glibc
# No bash completion: Tiny Hat's interactive shell is fish
set provides libcap-ng.so libdrop_ambient.so
set source \
    "https://github.com/stevegrubb/libcap-ng/archive/v$pkgver/$pkgname-$pkgver.tar.gz"
set sha512sums 77bc255688606cbc3a9d40cc1d417ebf748d04b8d837d793708b58431857ebfaa077f00cebfcf03c58ce56985feb63f9f8eb70cce21ba304ca3418a0fe1b61d1
set b2sums 64599a9405895e4b2ec3275cbc58c137be025d6dd11ff51219254495d1370e3dc92a97017fa8651c59426ac81a16660d6194ce0a17b02c502cd85bf44adb7e90
set flags arch

function prepare
    cd $pkgname-$pkgver; or return
    # make stupid autotools happy -_-
    touch NEWS; or return
    autoreconf -fiv; or return
end

function build
    cd $pkgname-$pkgver; or return
    ./configure --enable-static=no --prefix=/usr --sysconfdir=/etc --without-python3 --without-python; or return
    make; or return
end

function check
    make check -C $pkgname-$pkgver; or return
end

function package
    make DESTDIR="$pkgdir" install -C $pkgname-$pkgver; or return
end
