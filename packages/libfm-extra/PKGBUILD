# Built separately from libfm, so that menu-cache can be built before libfm.

pkgname=libfm-extra
pkgver=1.4.1
pkgrel=1
pkgdesc='Extra library for file management'
url='https://github.com/lxde/libfm'
arch=(i686 x32)
license=('LGPL-2.1-or-later OR GPL-2.0-or-later')
depends=(glib2 glibc)
makedepends=(git gtk-doc intltool)
source=("git+https://github.com/lxde/libfm.git#tag=$pkgver")
b2sums=(b56c71996377ee5ac5065ac0d5a291cc6b64ff2771b6bc5fef7bbeb75cc636f4a79a9b4bc4380273673ceeb0a78edad783fb909818a061bbe1ab2931a5d289d7)

prepare() {
  cd libfm
  autoreconf -fiv
}

build() {
  cd libfm
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --with-gnu-ld \
    --with-extra-only \
    --with-gtk=no
  make
}

package() {
  cd libfm
  make DESTDIR="$pkgdir" install
  rm -rf "$pkgdir/usr/include/libfm"
  mv "$pkgdir/usr/include/libfm-1.0" "$pkgdir/usr/include/libfm"
}
