set pkgname intel-ucode
set pkgver 20260925
set pkgrel 1
set pkgdesc 'Microcode update files for Intel CPUs'
set arch any
set url https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files
set nvchecker source=git git=https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files.git prefix=microcode-
set replaces microcode_ctl
set makedepends iucode-tool
set license custom
set source "$url/archive/refs/tags/microcode-$pkgver.tar.gz"
set sha256sums 0ec19023dad1e6dd0c5909174b8dff2555b91cf01671e36271a1ef36655c0cfc
set flags arch

function build
    cd Intel-Linux-Processor-Microcode-Data-Files-microcode-$pkgver; or return
    rm -f intel-ucode{,-with-caveats}/list; or return
    mkdir -p kernel/x86/microcode; or return
    iucode_tool --write-earlyfw=intel-ucode.img intel-ucode{,-with-caveats}/; or return
end

function package
    cd Intel-Linux-Processor-Microcode-Data-Files-microcode-$pkgver; or return
    install -vDm 644 $pkgname/* -t "$pkgdir/usr/lib/firmware/$pkgname/"; or return
    install -D -m0644 intel-ucode.img "$pkgdir"/boot/intel-ucode.img; or return
    install -D -m0644 license "$pkgdir"/usr/share/licenses/$pkgname/LICENSE; or return
end
