set pkgbase libdex
set pkgname libdex
set pkgver 1.2.0
set pkgrel 1
set pkgdesc 'A library supporting \'Deferred Execution\''
set arch i686 x32
set url https://gitlab.gnome.org/GNOME/libdex
set license LGPL-2.1-or-later
set depends glib2 glibc libatomic libgcc liburing
# No documentation (gi-docgen), examples (libsoup3), tests (python-dbusmock, xorg-server-xvfb) or PyGObject overrides
# (python, python-gobject): only the library is installed
set makedepends git glib2-devel meson
set source "git+https://gitlab.gnome.org/GNOME/libdex.git#tag=$pkgver"
set sha256sums dc27887d0d61f5e00462e0c1172c00d760f8dbce9b627cfd3d54dc465e6660cc
set flags arch

function prepare
    cd libdex; or return
end

function build
    set -l meson_options -D docs=false -D examples=false -D tests=false -D pygobject=false -D sysprof=false
    arch-meson -D introspection=disabled -D vapi=false libdex build $meson_options; or return
    meson compile -C build; or return
end

function package_libdex
    set provides libdex-1.so
    meson install -C build --no-rebuild --destdir "$pkgdir"; or return
end
