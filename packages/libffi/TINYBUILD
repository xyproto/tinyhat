set pkgname libffi
set pkgver 3.8.0
set pkgrel 2
set pkgdesc 'Portable foreign function interface library'
set arch i686 x32
set url https://sourceware.org/libffi/
set nvchecker source=git git=https://github.com/libffi/libffi prefix=v
set -g _url https://github.com/libffi/libffi
set license MIT
set depends glibc
set checkdepends dejagnu
set provides libffi.so
set source "$pkgname-$pkgver.tar.gz::$_url/archive/refs/tags/v$pkgver.tar.gz"
set sha256sums bf40d752d8f5fd4505bcd1c7d4208ea87fd12c91f087e359651c776748352dc0
set b2sums 1130b4d585fc56543291df3550daa9085b185c2162817793d0caa107bf68bc421a9f1be9f62a7d3b52fda26b120dd6260821c80e394af7d546688aaad4b162a5
set flags arch

function prepare
    cd $pkgname-$pkgver; or return
    autoreconf -fiv; or return
end

function build
    # remove --disable-exec-static-tramp once ghc and gobject-introspection
    # work fine with it enabled (https://github.com/libffi/libffi/pull/647)
    set -l configure_options \
        --disable-exec-static-tramp \
        --disable-multi-os-directory \
        --disable-static \
        --enable-pax_emutramp \
        --prefix=/usr
    cd $pkgname-$pkgver; or return
    ./configure $configure_options; or return
    make; or return
end

function check
    make -C $pkgname-$pkgver check; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    install -Dm 644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname; or return
    install -Dm 644 README.md -t "$pkgdir"/usr/share/doc/$pkgname; or return
end
