set pkgname libva
set pkgver 2.24.1
set pkgrel 1
set pkgdesc 'Video Acceleration (VA) API for Linux'
set arch i686 x32
set url https://intel.github.io/libva/
set license MIT
set depends \
    glibc \
    libdrm \
    libgl \
    libx11 \
    libxcb \
    libxext \
    libxfixes \
    wayland
set makedepends \
    git \
    libglvnd \
    mesa \
    meson
set optdepends \
    'intel-media-driver: backend for Intel GPUs (>= Broadwell)' \
    'libva-intel-driver: backend for Intel GPUs (<= Haswell)' \
    'libva-mesa-driver: backend for AMD and NVIDIA GPUs'
set provides \
    libva-drm.so \
    libva-glx.so \
    libva-wayland.so \
    libva-x11.so \
    libva.so
set backup etc/libva.conf
set source "git+https://github.com/intel/libva.git#tag=$pkgver"
set b2sums 5e7b85e1c16a68432069cbad3e11096311b97e4532061e97f247c0abbe16c2e991771860b9976f459000247bbc280b4825241a5c0b09571cac6be9b432ab3eaa
set flags arch

function build
    set -a CFLAGS -DENABLE_VA_MESSAGING # Option missing
    arch-meson libva build; or return
    meson compile -C build; or return
end

function package
    meson install -C build --destdir "$pkgdir"; or return
    install -Dm 644 libva/COPYING -t "$pkgdir"/usr/share/licenses/$pkgname; or return
    printf '%s\n' LIBVA_MESSAGING_LEVEL=1 | install -Dm 644 /dev/stdin "$pkgdir"/etc/libva.conf; or return
end
