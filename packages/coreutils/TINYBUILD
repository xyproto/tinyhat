set pkgname coreutils
set pkgver 9.12
set pkgrel 2
set pkgdesc 'The basic file, shell and text manipulation utilities of the GNU operating system'
set arch i686 x32
set url https://www.gnu.org/software/coreutils/
set license GPL-3.0-or-later GFDL-1.3-or-later
set depends acl attr glibc gmp libcap openssl
set makedepends gperf python
set options '!lto'
set source "https://ftp.gnu.org/gnu/coreutils/coreutils-$pkgver.tar.gz" \
    "https://ftp.gnu.org/gnu/coreutils/coreutils-$pkgver.tar.gz.sig" \
    0001-env-printenv-only-quote-when-outputting-to-terminals.patch
set sha256sums 14cbf5a4de0c7b7fa3b9fa7fada4c58b2defe33336aa8fd83d7622c5c4ebdc13 \
    5517066495da2fe4459d07b9284e497276d228c3c0f540f3f879f058345e98fd \
    60df76f209ec6022c313d546370fb33045cd62179499c61bef3e3f2e4d82446e
set flags arch

function prepare
    cd "$pkgname-$pkgver"; or return
    set -l src
    for src in $source
        set src "$(string replace -r -- '(.*?)::.*$' '$1' "$src")"
        set src "$(string replace -r -- '^.*/' '' "$src")"
        if not string match -q -- '*.patch' $src
            continue
        end
        echo "Applying patch $src..."; or return
        patch -Np1 < "../$src"; or return
    end
end

function build
    cd "$pkgname-$pkgver"; or return
    ./configure --prefix=/usr --libexecdir=/usr/lib --with-openssl; or return
    make; or return
end

function package
    cd "$pkgname-$pkgver"; or return
    make DESTDIR="$pkgdir" install; or return
end
