function prepare
    cd $pkgbase-$pkgver; or return
    # Disable sockopt and proc tests as they fail in the container
    sed -i /test_sockopt/d src/meson.build; or return
    sed -i /test_proc/d src/meson.build; or return

    patch -Np1 -i ../0001-units-Enable-statically.patch; or return

    # Fix tests with newer kernels
    patch -Np1 -i ../0002-test-sockopt-loosen-verification-of-stale-pidfds.patch; or return
end

function build
    set -l meson_options \
        -D audit=true \
        -D docs=true \
        -D linux-4-17=true \
        -D system-console-users=gdm,sddm,lightdm,lxdm

    arch-meson $pkgbase-$pkgver build $meson_options; or return
    meson compile -C build; or return
end

function check
    meson test -C build --print-errorlogs; or return
end

# Moves files from $pkgdir to $srcdir/$argv[1], keeping their paths
function _pick
    set -l p $argv[1]
    for f in $argv[2..-1]
        set -l d "$srcdir/$p/"(string replace -- "$pkgdir/" '' $f)
        mkdir -p (dirname $d); or return
        mv $f $d; or return
        rmdir -p --ignore-fail-on-non-empty (dirname $f); or return
    end
end

function package_dbus-broker
    set -a depends libaudit.so libcap-ng.so libexpat.so libsystemd.so
    set install dbus-broker.install

    meson install -C build --destdir "$pkgdir"; or return

    _pick unit $pkgdir/usr/lib/systemd/{system,user}/dbus.service; or return
end

function package_dbus-broker-units
    set pkgdesc "$pkgdesc - Service units"
    set depends dbus dbus-broker
    set provides dbus-units
    set conflicts dbus-daemon-units

    mv unit/* "$pkgdir"; or return
end

function package_dbus-units
    set pkgdesc 'D-Bus service units (default provider)'
    set license CC0-1.0
    set depends dbus-broker-units
end
