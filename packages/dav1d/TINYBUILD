set pkgname dav1d
set pkgver 1.5.4
set pkgrel 1
set pkgdesc 'AV1 cross-platform decoder focused on speed and correctness'
set arch i686 x32
set url https://code.videolan.org/videolan/dav1d
set license BSD-2-Clause
set makedepends glibc meson nasm ninja xxhash
# dav1d-0.8.2-sse2-asm.patch is applied on i686 only (see prepare)
set source "https://downloads.videolan.org/pub/videolan/dav1d/$pkgver/dav1d-$pkgver.tar.xz" \
    "https://code.videolan.org/videolan/dav1d-test-data/-/archive/$pkgver/dav1d-test-data-$pkgver.tar.gz" \
    dav1d-0.8.2-sse2-asm.patch
set sha256sums 686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5 \
    b19926f25347a32633ffb40f6189eb750b50f1b8b02b2eb63954845a744de343 \
    57cd3adbbfe5fc5d8930047e9accce38baaf50266549fc69350c7817c94e11a2
set flags arch

switch $CARCH
    case x32 x86_64 aarch64
        function prepare
            cd "$pkgbase-$pkgver"; or return
            ln -s "$srcdir/dav1d-test-data-$pkgver" tests/dav1d-test-data; or return
        end
    case '*'
        function prepare
            cd "$pkgbase-$pkgver"; or return
            ln -s "$srcdir/dav1d-test-data-$pkgver" tests/dav1d-test-data; or return
            patch -p1 -i "$srcdir/dav1d-0.8.2-sse2-asm.patch"; or return
        end
end

switch $CARCH
    case x32 x86_64 aarch64
        function build
            cd $pkgbase-$pkgver; or return
            arch-meson -Dtestdata_tests='false' -Denable_docs='false' build; or return
            ninja -C build all; or return
        end
    case '*'
        function build
            cd $pkgbase-$pkgver; or return
            arch-meson -Denable_asm=false -Dtestdata_tests='false' -Denable_docs='false' build; or return
            ninja -C build all; or return
        end
end

function package_dav1d
    set depends glibc
    set provides 'libdav1d.so'
    cd "$pkgbase-$pkgver"; or return
    DESTDIR="$pkgdir" ninja -C build install; or return
    install -Dm 644 README.md CONTRIBUTING.md NEWS -t "$pkgdir/usr/share/doc/$pkgname"; or return
    install -Dm 644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end

function package_dav1d-doc
    set pkgdesc "$pkgdesc (documentation)"
    cd "$pkgbase-$pkgver"; or return
    install -d "$pkgdir/usr/share/doc/$pkgbase"; or return
    cp -r build/doc/html -t "$pkgdir/usr/share/doc/$pkgbase"; or return
    install -Dm 644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
