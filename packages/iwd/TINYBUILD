set pkgname iwd
set pkgver 3.12
set pkgrel 2
set pkgdesc 'Internet Wireless Daemon'
set arch i686 x32
set url https://git.kernel.org/cgit/network/wireless/iwd.git/
set nvchecker source=git git=https://git.kernel.org/pub/scm/network/wireless/iwd.git use_max_tag=true
set license LGPL-2.1-or-later
set depends glibc readline libreadline.so ell libgcc
set makedepends python-docutils dbus systemd
set optdepends 'qrencode: for displaying QR code after DPP is started'
set flags arch
set source https://www.kernel.org/pub/linux/network/wireless/iwd-$pkgver.tar.xz \
    0001-use-network-group-for-unprivileged-access.diff \
    0001-rrm-fix-stack-buffer-overflow-in-rrm_report_beacon_r.patch \
    0002-ie-fix-off-by-one-in-HE-Capabilities-Channel-Width-S.patch \
    0003-ft-fix-mde_equal-self-comparison-and-type-mismatch.patch \
    0004-ie-fix-uint8_t-underflow-in-FTE-sub-element-parser.patch
# https://mirrors.edge.kernel.org/pub/linux/network/wireless/sha256sums.asc
set sha256sums d89a5e45c7180170e19be828f9e944a768c593758094fc57a358d0e7c4cb1a49 \
    d5fb4fb864b7a0632117aa2039df535ab5c1d024ae618a1f09e34dfab8ee0cc7 \
    db5e63cf8e7d2071b0048f134e4aebed1f46e0b191cad5530ce99c07b1157b13 \
    cdd07a19f831c5f207817cdf8398a790bb5b233e32bb0e7d7998eb41a1a61763 \
    c160d0c3c7c0219ceff7cf107f8c24c33163c92cee3fc2573c26b1515bd05f22 \
    42dba8b8f2b0d39036df71f4b1887db5915e25ca3575e841d3f5352dfb0d514a
# https://lore.kernel.org/iwd/20240122104541.74f1a697@workstation64.local/T/#u
set options '!lto'

function prepare
    cd $pkgname-$pkgver; or return
    # replace Debian "netdev" group with existing "network" group
    # for unprivileged access to iwd - avoid also log spam
    # https://gitlab.archlinux.org/archlinux/packaging/packages/iwd/-/issues/2 + #3
    patch -Np1 -i ../0001-use-network-group-for-unprivileged-access.diff; or return

    # fixes for https://www.openwall.com/lists/oss-security/2026/08/02/2
    # see https://github.com/abhinavagarwal07/iwd-security-poc/blob/main/patches/README.md
    patch -Np1 -i ../0001-rrm-fix-stack-buffer-overflow-in-rrm_report_beacon_r.patch; or return
    patch -Np1 -i ../0002-ie-fix-off-by-one-in-HE-Capabilities-Channel-Width-S.patch; or return
    patch -Np1 -i ../0003-ft-fix-mde_equal-self-comparison-and-type-mismatch.patch; or return
    patch -Np1 -i ../0004-ie-fix-uint8_t-underflow-in-FTE-sub-element-parser.patch; or return

    # https://lore.kernel.org/iwd/20240122105312.66fb4dbf@workstation64.local/T/#u
    # disable one expected test failure - requires a kernel module we cannot load
    # from inside the chroot
    # sed -i "s:unit/test-wsc::" Makefile.am
    # and another failing test that depends on AES_CTR not available
    sed -i "s:unit/test-storage::" Makefile.am; or return
    # and more since 3.10 - they don't fail building locally
    # sed -i "s:unit/test-crypto::" Makefile.am
    # sed -i "s:unit/test-eapol::" Makefile.am
    autoreconf -vfi; or return
end

function build
    cd $pkgname-$pkgver; or return
    dbus-run-session ./configure --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --libexecdir=/usr/lib/iwd \
        --enable-external-ell \
        --enable-wired \
        --enable-ofono \
        --enable-hwsim \
        --disable-tools; or return
    make; or return
end

function check
    cd $pkgname-$pkgver; or return
    make check; or return
end

function package
    cd $pkgname-$pkgver; or return
    make install DESTDIR="$pkgdir"; or return
    install -Dm 644 README -t "$pkgdir/usr/share/doc/$pkgname"; or return
end
