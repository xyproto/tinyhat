#!/bin/sh
dir=$HOME/books
[ -d "$HOME/Books" ] && [ ! -e "$dir" ] && mv "$HOME/Books" "$dir"
mkdir -p "$dir"
[ -e "$dir/book.md" ] || cp /etc/skel/books/book.md "$dir/book.md"
cd "$dir" || exit 1
mark=${XDG_RUNTIME_DIR:-/tmp}/tinyhat-typewriter.$$
: > "$mark"
tinyhat-soundd --reload
IMAGEPREVIEW_SIXEL=0 foot -T "Writing a book" o --book-mode-text book.md
status=$?
rm -f "$mark"
tinyhat-soundd --reload
exit $status
