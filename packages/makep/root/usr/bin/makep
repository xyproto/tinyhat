#!/usr/bin/env fish

set -g makep_version 0.1.0
umask 022

function die
    echo "makep: $argv" >&2
    exit 1
end

function usage
    echo "usage: makep [-C DIR] [-o OUTDIR] [-s SRCDEST] [-a ARCH] [-v] [-A] [--nobuild | --updsums | --srcinfo | --packagelist | --print-config]" >&2
    exit 2
end

set -g package_dir (pwd)
set -g outdir
set -g srcdest
set -g carch $TINYHAT_ARCH
set -g nobuild 0
set -g updsums 0
set -g ignorearch 0
set -g srcinfo 0
set -g printconfig 0
set -g packagelist 0
set -g verbose 0
while set -q argv[1]
    switch $argv[1]
        case -C
            set package_dir (realpath -- $argv[2]); or die "no directory $argv[2]"
            set -e argv[1]
        case -o
            set outdir $argv[2]
            set -e argv[1]
        case -s
            set srcdest $argv[2]
            set -e argv[1]
        case -a
            set carch $argv[2]
            set -e argv[1]
        case -A --ignorearch
            set ignorearch 1
        case --nobuild
            set nobuild 1
        case --updsums
            set updsums 1
        case --srcinfo
            set srcinfo 1
        case --print-config
            set printconfig 1
        case --packagelist
            set packagelist 1
        case -v --verbose
            set verbose 1
        case '*'
            usage
    end
    set -e argv[1]
end
test -n "$carch"; or set carch (test $srcinfo -eq 1 -o $updsums -eq 1; and echo i686; or uname -m)
set -gx CARCH $carch
test -n "$outdir"; or set outdir $package_dir
test -n "$srcdest"; or set srcdest $package_dir
set outdir (realpath -m -- $outdir)
set srcdest (realpath -m -- $srcdest)
set -g conf $MAKEP_CONF
test -n "$conf"; or set conf /etc/makep.conf
test -f $conf; or set conf (status dirname)/../../etc/makep.conf
test -f $conf; or die "no makep.conf (set MAKEP_CONF)"
for flag in CFLAGS CXXFLAGS LDFLAGS LTOFLAGS MAKEFLAGS
    set -q $flag; and set -gx $flag (string split -n ' ' -- $$flag)
end
source $conf
for handler in (path dirname -- $conf)/makep.d/*.fish
    source $handler
end
makep_triplet $carch >/dev/null; or die "unknown architecture $carch"
if test $printconfig -eq 1
    for flavour in tinyhat arch
        begin
            set -e CFLAGS CXXFLAGS LDFLAGS
            makep_flags $carch $flavour
            printf '%s=%s\n' FLAVOUR $flavour CHOST (makep_triplet $carch) CFLAGS "$CFLAGS" CXXFLAGS "$CXXFLAGS" LDFLAGS "$LDFLAGS" LTOFLAGS "$LTOFLAGS"
        end
    end
    printf '%s=%s\n' PACKAGER "$PACKAGER" OPTIONS "$makep_options"
    exit 0
end
set -g tinybuild $package_dir/TINYBUILD
test -f $tinybuild; or die "no TINYBUILD in $package_dir"

set -g meta_vars pkgdesc arch url license groups depends optdepends provides conflicts replaces backup options install
for v in pkgname pkgbase pkgver pkgrel epoch flags owners makedepends makedepends_build makedepends_host bootstrap_without checkdepends source sha256sums sha512sums b2sums noextract style builddir meson_args cmake_args configure_args make_args install_args install_license $meta_vars
    set -e $v
end
fish -n $tinybuild; or die "$tinybuild has syntax errors"
source $tinybuild
for v in pkgname pkgver pkgrel
    set -q $v[1]; or die "$v is missing in $tinybuild"
end
set -q pkgbase[1]; or set -g pkgbase $pkgname[1]
set -g fullver $pkgver-$pkgrel
set -q epoch[1]; and set fullver $epoch:$fullver
set -q flags[1]; or set -g flags tinyhat
contains -- $flags tinyhat arch; or die "unknown flags $flags (use tinyhat or arch)"
set -g pkgnames $pkgname
set -q builddir[1]; or set -g builddir $pkgbase-$pkgver
if set -q style[1]; and not contains -- $style meson cmake configure make
    die "unknown style $style (use meson, cmake, configure or make)"
end
test $srcinfo -eq 1 -o $updsums -eq 1 -o $ignorearch -eq 1; or contains -- $carch $arch; or contains -- any $arch; or die "$pkgbase is not built for $carch (arch: $arch)"
for v in $meta_vars
    set -q $v; or set -g $v
    set -g base_$v $$v
end
if set -q pkgname[2]
    for name in $pkgname
        functions -q package_$name; or die "split package $name has no package_$name function"
    end
end
# The checksum kinds that makepkg also has; each one that is set has a sum per source (--updsums writes them all)
set -g checksum_kinds
for kind in sha256sums sha512sums b2sums
    set -q $kind[1]; or continue
    set -a checksum_kinds $kind
    test $updsums -eq 1; and continue
    test (count $source) -eq (count $$kind); or die "source has "(count $source)" entries, $kind has "(count $$kind)
end
set -q source[1]; and not set -q checksum_kinds[1]; and die "source is set, but none of sha256sums, sha512sums and b2sums is"

function check_sums -a name i file
    for kind in $checksum_kinds
        set -l sums $$kind
        set -l want $sums[$i]
        set -l tool (string replace sums sum -- $kind)
        set -l got ($tool -- $file | string split -f1 ' ')
        if test $updsums -eq 1
            set -l target new_$kind"[$i]"
            set -g $target $got
            continue
        end
        test "$got" = "$want"; or die "$kind mismatch for $name: $got"
    end
end

# --updsums: writes the checksums of the current sources into the TINYBUILD, like updpkgsums does for a PKGBUILD.
# Each checksum array must be set in one top-level set statement, which may continue over lines ending with \
function write_sums
    set -l lines (cat $tinybuild)
    for kind in $checksum_kinds
        set -l starts
        for n in (seq (count $lines))
            string match -qr "^set $kind( |\$)" -- $lines[$n]; and set -a starts $n
        end
        test (count $starts) -eq 1; or die "$kind must be set in exactly one top-level line to update it"
        set -l first $starts[1]
        set -l last $first
        while string match -q '*\\' -- $lines[$last]
            set last (math $last + 1)
        end
        set -l new_name new_$kind
        set -l sums $$new_name
        set -l repl "set $kind $sums[1]"
        if set -q sums[2]
            set repl "set $kind $sums[1] \\"
            for n in (seq 2 (math (count $sums) - 1))
                set -a repl "    $sums[$n] \\"
            end
            set -a repl "    $sums[-1]"
        end
        set -l before
        test $first -gt 1; and set before $lines[1..(math $first - 1)]
        set -l after
        test $last -lt (count $lines); and set after $lines[(math $last + 1)..-1]
        set lines $before $repl $after
    end
    printf '%s\n' $lines >$tinybuild.new; or die "could not write $tinybuild.new"
    mv -f $tinybuild.new $tinybuild; or die "could not update $tinybuild"
end

function split_set_lines -a name
    set -l fn package_$name
    functions -q $fn; or set fn package
    functions -q $fn; or return 0
    # Lines that continue with \ are joined first, so a set can span several lines
    string replace -ra '\\\\\n\s*' ' ' -- (functions $fn | string collect) | string split \n \
        | string match -r '^\s*set\s+(?:-[a-z]+\s+)*(?:'(string join '|' $meta_vars)')\b.*'
end

function print_field -a key
    for value in $argv[2..-1]
        printf '\t%s = %s\n' $key $value
    end
end

function arch_makedepends -a a
    env CARCH=$a fish -c 'source $argv[1]; and printf "%s\n" $makedepends $makedepends_build $makedepends_host' $tinybuild
end

function print_srcinfo
    set -l arches i686 x32 x86_64 aarch64
    set -l common $makedepends $makedepends_build $makedepends_host
    for a in $arches
        set -l out (arch_makedepends $a); or die "$tinybuild fails for CARCH=$a"
        set -g makedepends_of_$a (string match -v -- '' $out)
        set -l var makedepends_of_$a
        set -l keep
        for d in $common
            contains -- $d $$var; and set -a keep $d
        end
        set common $keep
    end
    printf 'pkgbase = %s\n' $pkgbase
    print_field pkgdesc $pkgdesc
    print_field pkgver $pkgver
    print_field epoch $epoch
    print_field pkgrel $pkgrel
    print_field url $url
    print_field install $install
    print_field arch $arch
    print_field groups $groups
    print_field license $license
    print_field checkdepends $checkdepends
    print_field makedepends $common
    for a in $arches
        set -l var makedepends_of_$a
        for d in $$var
            contains -- $d $common; or print_field makedepends_$a $d
        end
    end
    print_field makedepends_build $makedepends_build
    print_field makedepends_host $makedepends_host
    # Dependencies that the build can do without (it checks for them), so that in a dependency cycle it is built
    # first without them and then again with them (scripts/build_planner.py cross_rules)
    print_field bootstrap_without $bootstrap_without
    print_field depends $depends
    print_field optdepends $optdepends
    print_field provides $provides
    print_field conflicts $conflicts
    print_field replaces $replaces
    print_field backup $backup
    print_field options $options
    print_field source $source
    print_field noextract $noextract
    print_field sha256sums $sha256sums
    print_field sha512sums $sha512sums
    print_field b2sums $b2sums
    for name in $pkgname
        printf '\npkgname = %s\n' $name
        for line in (split_set_lines $name)
            eval $line
        end
        for v in $meta_vars
            set -l base base_$v
            test "$$v" = "$$base"; and continue
            if test (count $$v) -gt 0
                print_field $v $$v
            else
                printf '\t%s = \n' $v
            end
            set -g $v $$base
        end
    end
end

if test $srcinfo -eq 1
    print_srcinfo
    exit 0
end

fish_indent --check $tinybuild >/dev/null 2>&1; or echo "makep: warning: $tinybuild is not formatted, run: fish_indent -w $tinybuild" >&2

if test $packagelist -eq 1
    for name in $pkgname
        for line in (split_set_lines $name)
            eval $line
        end
        set -l a $carch
        test "$arch" = any; and set a any
        echo $outdir/$name-$fullver-$a.pkg.tar.zst
        for v in $meta_vars
            set -l base base_$v
            set -g $v $$base
        end
    end
    exit 0
end

set -gx CARCH $carch
set -gx CBUILD (makep_triplet (uname -m | string replace -r '^i.86$' i686))
set -gx CHOST (makep_triplet $carch)
makep_flags $carch $flags

function option -a name
    contains -- !$name $options; and return 1
    contains -- $name $options; and return 0
    contains -- $name $makep_options
end

contains -- !buildflags $options; and set -e CFLAGS CXXFLAGS LDFLAGS LTOFLAGS
contains -- !makeflags $options; and set -e MAKEFLAGS
# Compile through ccache when it is installed, like makepkg's BUILDENV=(ccache), unless options has !ccache
if test -d /usr/lib/ccache/bin; and not contains -- !ccache $options
    set -gx PATH /usr/lib/ccache/bin $PATH
end
if option lto
    set -gxa CFLAGS $LTOFLAGS
    set -gxa CXXFLAGS $LTOFLAGS
    set -gxa LDFLAGS $LTOFLAGS
end
set -gx CC cc
set -gx CXX c++
set -gx STRIP strip
set -g cross 0
if test $CHOST != $CBUILD; and not test $CHOST = i686-pc-linux-gnu -a (uname -m) = x86_64
    set -l prefix
    for p in $CHOST (string replace -r -- '-(unknown|pc)-' - $CHOST)
        command -q $p-gcc; and set prefix $p; and break
    end
    test -n "$prefix"; or die "no cross compiler for $CHOST (tried $CHOST-gcc)"
    set -q SYSROOT; or set -gx SYSROOT /usr/$prefix
    set -gx CC $prefix-gcc
    set -gx CXX $prefix-g++
    set -gx STRIP $prefix-strip
    for tool in AR:ar NM:nm RANLIB:ranlib OBJCOPY:objcopy OBJDUMP:objdump LD:ld READELF:readelf
        set -l kv (string split : -- $tool)
        set -gx $kv[1] $prefix-$kv[2]
    end
    set cross 1
    set -gx PKG_CONFIG_SYSROOT_DIR $SYSROOT
    set -gx PKG_CONFIG_LIBDIR $SYSROOT/usr/lib/pkgconfig:$SYSROOT/usr/share/pkgconfig
    echo "makep: cross-building for $CHOST on $CBUILD with $prefix-gcc"
end

set -g startdir $package_dir
set -g srcdir $startdir/src
set -g pkgdir
set -q SOURCE_DATE_EPOCH; or set -gx SOURCE_DATE_EPOCH (date +%s)
set -gxa CFLAGS -ffile-prefix-map=$srcdir=/usr/src/debug/$pkgbase
set -gxa CXXFLAGS -ffile-prefix-map=$srcdir=/usr/src/debug/$pkgbase
# Rust: the same, so that no build path ends up in the package (see makep.d/leakpath.fish)
set -gxa RUSTFLAGS --remap-path-prefix=$srcdir=/usr/src/debug/$pkgbase
# Go: no build paths in the binaries either (TINYBUILDs that set GOFLAGS add to it)
set -gxa GOFLAGS -trimpath
# No compiler warnings (-w), so that newer compilers do not stop builds that use -Werror; options warnings keeps them
if not contains -- warnings $options
    set -gxa CFLAGS -w
    set -gxa CXXFLAGS -w
end

function source_name -a entry
    set -l parts (string split -m1 '::' -- $entry)
    if set -q parts[2]
        echo $parts[1]
    else
        string replace -r '[#?].*' '' -- $entry | string replace -r '/+$' '' | string replace -r '.*/' '' | string replace -r '\.git$' ''
    end
end

function source_url -a entry
    set -l parts (string split -m1 '::' -- $entry)
    echo $parts[-1]
end

function fetch_git -a name url i
    set -l repo (string replace -r '^git\+' '' -- $url | string replace -r '[#?].*' '')
    set -l fragment (string match -r '#([^?]*)' -- $url)[2]
    set -l kind (string split -m1 = -- $fragment)[1]
    set -l value (string split -m1 = -- $fragment)[2]
    set -l ref HEAD
    switch "$kind"
        case tag
            set ref refs/tags/$value
        case commit
            set ref $value
        case branch
            set ref refs/heads/$value
        case ''
        case '*'
            die "unsupported git fragment $fragment"
    end
    set -lx GIT_CONFIG_GLOBAL /dev/null
    set -lx GIT_CONFIG_SYSTEM /dev/null
    set -l mirror $srcdest/$name
    if not test -d $mirror
        echo "makep: cloning $repo"
        git clone -q --mirror -- $repo $mirror; or die "could not clone $repo"
    else if not git -C $mirror rev-parse -q --verify "$ref^{commit}" >/dev/null
        git -C $mirror fetch -q --all -p; or die "could not update $repo"
    end
    # A commit that no branch or tag points to any more can still be fetched by its hash
    if test "$kind" = commit; and not git -C $mirror rev-parse -q --verify "$ref^{commit}" >/dev/null
        git -C $mirror fetch -q origin $value; or die "could not fetch commit $value from $repo"
    end
    mkdir -p $mirror/info
    echo '* -export-subst -export-ignore' >$mirror/info/attributes
    if set -q checksum_kinds[1]
        contains -- "$kind" tag commit; or die "$name: a git source needs #tag= or #commit=, so that it can be checksummed"
        set -l archive $srcdir/.makep-$name.tar
        git -c core.abbrev=no -C $mirror archive --format tar -o $archive $value; or die "could not archive $name"
        check_sums $name $i $archive
        rm -f $archive
    end
    git clone -q -s -- $mirror $srcdir/$name; or die "could not check out $name"
    git -C $srcdir/$name checkout -q --force -B makep "$ref^{commit}" --; or die "could not check out $ref in $name"
end

function fetch_sources
    mkdir -p $srcdest
    for i in (seq (count $source))
        set -l entry $source[$i]
        set -l name (source_name $entry)
        set -l url (source_url $entry)
        set -l file
        if string match -q 'git+*' -- $url
            fetch_git $name $url $i
            continue
        else if string match -qr '^[a-z+]+://' -- $url
            set file $srcdest/$name
            if not test -f $file
                echo "makep: downloading $name"
                # MAKEP_FETCH is a command run as: COMMAND OUTFILE URL (Tiny Hat's build uses it for source mirrors)
                if set -q MAKEP_FETCH[1]
                    $MAKEP_FETCH $file.part $url
                else
                    curl -fL --no-progress-meter --retry 3 -o $file.part -- $url
                end
                or begin
                    rm -f $file.part
                    die "could not download $url"
                end
                mv -f $file.part $file
            end
        else
            set file $startdir/$name
            test -f $file; or die "missing source $name"
        end
        check_sums $name $i $file
        ln -sf -- $file $srcdir/$name
        if not contains -- $name $noextract; and string match -qr '\.(tar(\.(gz|bz2|xz|zst|lz|lz4|lzma|Z))?|tgz|tbz2?|txz|tzst|zip|7z)$' -- $name
            bsdtar -xf $file -C $srcdir; or die "could not extract $name"
        else if not contains -- $name $noextract; and string match -qr '\.(gz|bz2|xz|zst|lz|lzma)$' -- $name
            # A single compressed file, such as fix.patch.zst, is decompressed next to it, as makepkg does
            set -l plain $srcdir/(string replace -r '\.[^.]+$' '' -- $name)
            set -l tool (string replace -r '.*\.' '' -- $name)
            switch $tool
                case gz
                    set tool gzip
                case bz2
                    set tool bzip2
                case lzma
                    set tool xz
                case lz
                    set tool lzip
                case zst
                    set tool zstd
            end
            $tool -dc -- $file >$plain; or die "could not decompress $name"
        end
    end
end

function meson_cross_file
    set -l family $carch
    switch $carch
        case i686
            set family x86
        case x32
            set family x86_64
    end
    printf '%s\n' '[binaries]' "c = '$CC'" "cpp = '$CXX'" "ar = '$AR'" "strip = '$STRIP'" "pkg-config = 'pkg-config'" \
        '[properties]' "sys_root = '$SYSROOT'" "pkg_config_libdir = '$PKG_CONFIG_LIBDIR'" \
        '[host_machine]' "system = 'linux'" "cpu_family = '$family'" "cpu = '$carch'" "endian = 'little'" >$srcdir/makep-cross.ini
    echo --cross-file=$srcdir/makep-cross.ini
end

function cmake_cross_args
    printf '%s\n' -DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=$carch -DCMAKE_C_COMPILER=$CC -DCMAKE_CXX_COMPILER=$CXX \
        -DCMAKE_SYSROOT=$SYSROOT -DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY \
        -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY -DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY
end

function style_build
    switch $style
        case meson
            set -l extra
            test $cross -eq 1; and set extra (meson_cross_file)
            meson setup --prefix /usr --libexecdir lib --sbindir bin --buildtype plain --auto-features enabled \
                --wrap-mode nodownload -D b_pie=true -D python.bytecompile=1 $extra $meson_args $builddir build; or return
            meson compile -C build
        case cmake
            set -l extra
            test $cross -eq 1; and set extra (cmake_cross_args)
            cmake -B build -S $builddir -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=None -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON $extra $cmake_args; or return
            cmake --build build
        case configure
            set -l extra
            test $cross -eq 1; and set extra --host=$CHOST --build=$CBUILD
            cd $builddir; or return
            ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var $extra $configure_args; or return
            make $make_args
        case make
            make -C $builddir $make_args
    end
end

function style_package
    switch $style
        case meson
            meson install -C build --destdir $pkgdir
        case cmake
            env DESTDIR=$pkgdir cmake --install build
        case configure
            make -C $builddir DESTDIR=$pkgdir install $install_args
        case make
            make -C $builddir DESTDIR=$pkgdir PREFIX=/usr install $install_args
    end
end

function run_step -a step
    if not functions -q $step
        set -q style[1]; and test $step = build; or return 0
        echo "makep: build ($style)"
        pushd $srcdir
        # A function that ends with set keeps the status it was called with, so start from 0
        if test $verbose -eq 1
            set -g fish_trace 1
        end
        true
        style_build
        set -l st $status
        set -e fish_trace
        popd
        test $st -eq 0; or die "build ($style) failed with status $st"
        return 0
    end
    echo "makep: $step"
    pushd $srcdir
    # A function that ends with set keeps the status it was called with, so start from 0
    if test $verbose -eq 1
        set -g fish_trace 1
    end
    true
    $step
    set -l st $status
    set -e fish_trace
    popd
    test $st -eq 0; or die "$step failed with status $st"
end

function tidy_package
    if not option docs
        for d in $makep_doc_dirs
            rm -rf -- $pkgdir/$d
        end
    end
    if option purge
        rm -f -- $pkgdir/usr/info/dir $pkgdir/usr/share/info/dir
        find $pkgdir ! -type d \( -name .packlist -o -name '*.pod' \) -delete
    end
    if not option libtool
        find $pkgdir ! -type d -name '*.la' -delete
    end
    if not option staticlibs
        for f in (find $pkgdir ! -type d -name '*.a')
            set -l so (string replace -r '\.a$' .so -- $f)
            test -f $so -o -L $so; and rm -f -- $f
        end
    end
    if not option emptydirs
        find $pkgdir -mindepth 1 -depth -type d -empty -delete
    end
end

function strip_binaries
    option strip; or return 0
    for f in (find $pkgdir -type f -perm -u+w)
        switch (file -bi -- $f)
            case 'application/x-executable*' 'application/x-pie-executable*'
                $STRIP --strip-all -- $f
            case 'application/x-sharedlib*'
                $STRIP --strip-unneeded -- $f
            case 'application/x-archive*'
                $STRIP --strip-debug -- $f
        end
    end
end

function drop_prefix_map
    set -l flag -ffile-prefix-map=$srcdir=/usr/src/debug/$pkgbase
    for f in (grep -rlIF -- $flag $pkgdir 2>/dev/null)
        test -L $f; and continue
        sed -i -e "s| $flag||g" -e "s|$flag ||g" -e "s|$flag||g" -- $f; or die "could not edit "(string replace -- $pkgdir/ '' $f)
        if string match -q -- '*.py' $f
            set -l stale (path dirname -- $f)/__pycache__/(path change-extension '' -- (path basename -- $f)).*.pyc
            rm -f -- $stale
        end
    end
end

function sstrip_binaries
    option sstrip; or return 0
    command -q sstrip; or die "options sstrip needs sstrip (add elfkickers to makedepends_build)"
    for f in (find $pkgdir -type f -perm -u+w)
        switch (file -bi -- $f)
            case 'application/x-executable*' 'application/x-pie-executable*'
                sstrip -- $f; or die "sstrip failed on "(string replace -- $pkgdir/ '' $f)
        end
    end
    for pat in $sstrip_files
        set -l files $pkgdir/$pat
        for f in $files
            sstrip -- $f; or die "sstrip failed on "(string replace -- $pkgdir/ '' $f)
        end
    end
end

function zipman
    contains -- !zipman $options; and return 0
    for dir in $pkgdir/usr/share/man $pkgdir/usr/share/info
        test -d $dir; or continue
        # Hard links to one man page are compressed once and linked to the .gz, like makepkg does
        set -l done_inodes
        set -l done_files
        for f in (find $dir -type f ! -name '*.gz' ! -name dir)
            set -l inode (stat -c %i -- $f)
            set -l seen (contains -i -- $inode $done_inodes)
            if test -n "$seen"
                rm -f -- $f
                ln -- $done_files[$seen] $f.gz; or die "could not link $f.gz"
                continue
            end
            set -l links (stat -c %h -- $f)
            gzip -n -9 -f -- $f; or die "could not compress $f"
            if test $links -gt 1
                set -a done_inodes $inode
                set -a done_files $f.gz
            end
        end
        for l in (find $dir -type l ! -name '*.gz')
            set -l target (readlink -- $l)
            ln -sf -- $target.gz $l.gz
            rm -f -- $l
        end
    end
end

function pkginfo
    set -l size (find $pkgdir -type f -printf '%i %s\n' | sort -u -k1,1 | awk '{ s += $2 } END { print s + 0 }')
    printf '%s = %s\n' pkgname $current pkgbase $pkgbase xdata pkgtype=(test (count $pkgnames) -gt 1; and echo split; or echo pkg)
    printf '%s = %s\n' pkgver $fullver pkgdesc "$pkgdesc" url "$url" builddate $SOURCE_DATE_EPOCH packager "$PACKAGER" size $size arch $pkgarch
    for l in $license
        printf 'license = %s\n' $l
    end
    for p in $groups
        printf 'group = %s\n' $p
    end
    for p in $replaces
        printf 'replaces = %s\n' $p
    end
    for p in $conflicts
        printf 'conflict = %s\n' $p
    end
    for p in $provides
        printf 'provides = %s\n' $p
    end
    for p in $backup
        printf 'backup = %s\n' $p
    end
    for p in $depends
        printf 'depend = %s\n' $p
    end
    for p in $optdepends
        printf 'optdepend = %s\n' $p
    end
    for p in $makedepends $makedepends_build $makedepends_host
        printf 'makedepend = %s\n' $p
    end
end

function buildinfo
    printf '%s = %s\n' format 2 pkgname $current pkgbase $pkgbase pkgver $fullver pkgarch $pkgarch pkgbuild_sha256sum (sha256sum -- $tinybuild | string split -f1 ' ') packager "$PACKAGER" builddate $SOURCE_DATE_EPOCH buildtool makep buildtoolver $makep_version
end

function apply_owners -a tarfile
    set -l yaml $srcdir/makep-owners.yaml
    echo Contents: >$yaml
    set -l n 0
    for o in $owners
        set -l f (string split -n ' ' -- $o)
        set -l path (string trim -c / -- $f[1])
        test -e $pkgdir/$path -o -L $pkgdir/$path; or continue
        test -d $pkgdir/$path -a ! -L $pkgdir/$path; and set path $path/
        set -l ids (string split : -- $f[2])
        set -l user (getent passwd $ids[1] | string split -f1 :)
        set -l group (getent group $ids[2] | string split -f1 :)
        printf '    - Filename: %s\n      UID: %s\n      GID: %s\n      Username: "%s"\n      Groupname: "%s"\n' $path $ids[1] $ids[2] "$user" "$group" >>$yaml
        set -q f[3]; and printf '      Mode: 0%s\n' $f[3] >>$yaml
        set n (math $n + 1)
    end
    set -g owned 0
    test $n -gt 0; or return 0
    set owned 1
    command -q metatar; or die "owners is set, but metatar is not installed (add it to makedepends)"
    metatar -s -f $tarfile $srcdir/makep-base.yaml >/dev/null; or return
    metatar -m -f $srcdir/makep-base.yaml $yaml $srcdir/makep-merged.yaml >/dev/null; or return
    metatar -a -f -o $tarfile $srcdir/makep-merged.yaml $tarfile.owned >/dev/null; or return
    mv -f $tarfile.owned $tarfile
end

function make_package
    set -l root --uid 0 --gid 0 --uname root --gname root
    set -l file $outdir/$current-$fullver-$pkgarch.pkg.tar.zst
    set -l payload $srcdir/makep-payload.tar
    set -l meta $srcdir/makep-meta.tar
    mkdir -p $outdir
    pushd $pkgdir
    if set -q install[1]
        cp -- $startdir/$install .INSTALL; or die "missing install file $install"
    end
    pkginfo >.PKGINFO
    buildinfo >.BUILDINFO
    find . -exec touch -h -d @$SOURCE_DATE_EPOCH -- '{}' +
    set -l metafiles .BUILDINFO .PKGINFO
    test -e .INSTALL; and set metafiles .BUILDINFO .INSTALL .PKGINFO
    rm -f $payload
    find . -mindepth 1 ! -path ./.BUILDINFO ! -path ./.INSTALL ! -path ./.MTREE ! -path ./.PKGINFO -printf '%P\0' | LC_ALL=C sort -z | LANG=C bsdtar -cnf $payload $root --no-fflags --no-read-sparse --null --files-from -; or die "could not archive $pkgdir"
    apply_owners $payload; or die "could not apply owners"
    LANG=C bsdtar -cnf $meta $root $metafiles; or die "could not archive the package metadata"
    set -l mtree --format=mtree --options='!all,use-set,type,uid,gid,mode,time,size,sha256,link'
    if test $owned -eq 1
        LANG=C bsdtar -cnf - $mtree @$meta @$payload | gzip -c -f -n >.MTREE
    else
        find . -mindepth 1 ! -name .MTREE -printf '%P\0' | LC_ALL=C sort -z | LANG=C bsdtar -cnf - $root $mtree --null --files-from - | gzip -c -f -n >.MTREE
    end
    touch -d @$SOURCE_DATE_EPOCH .MTREE
    set metafiles (printf '%s\n' $metafiles .MTREE | LC_ALL=C sort)
    LANG=C bsdtar -cnf $meta $root $metafiles; or die "could not archive the package metadata"
    LANG=C bsdtar -cnf - @$meta @$payload | zstd -c -T0 -q - >$file.part
    set -l st $pipestatus
    rm -f $payload $meta
    popd
    string match -qv 0 -- $st; and begin
        rm -f $file.part
        die "could not create the package"
    end
    mv -f $file.part $file
    echo "makep: built $file"
end

function package_split -a name
    for v in $meta_vars
        set -l base base_$v
        set -g $v $$base
    end
    set -g current $name
    set -g pkgname $name
    set -g pkgdir $startdir/pkg/$name
    mkdir -p $pkgdir
    set -l fn package_$name
    functions -q $fn; or set fn package
    if not functions -q $fn; and set -q style[1]; and not set -q pkgnames[2]
        set fn style_package
    end
    if functions -q $fn
        echo "makep: $fn"
        pushd $srcdir
        # A function that ends with set keeps the status it was called with, so start from 0
        if test $verbose -eq 1
            set -g fish_trace 1
        end
        true
        $fn
        set -l st $status
        set -e fish_trace
        popd
        test $st -eq 0; or die "$fn failed with status $st"
    end
    for f in $install_license
        install -Dm644 -t $pkgdir/usr/share/licenses/$name/ -- $srcdir/$builddir/$f; or die "missing license file $f"
    end
    test -n "$(ls -A $pkgdir)"; or echo "makep: warning: $name is empty" >&2
    set -g pkgarch $carch
    test "$arch" = any; and set pkgarch any
    tidy_package
    drop_prefix_map
    strip_binaries
    sstrip_binaries
    zipman
    set -g makep_problems
    emit makep_check $name $pkgdir
    if set -q makep_problems[1]
        printf 'makep: %s\n' $makep_problems >&2
        die "checks failed for $name"
    end
    make_package
end

rm -rf $srcdir $startdir/pkg
mkdir -p $srcdir
if test $updsums -eq 1
    for kind in $checksum_kinds
        set -g new_$kind
        for i in (seq (count $source))
            set -ga new_$kind -
        end
    end
else
    for kind in $checksum_kinds
        contains -- SKIP $$kind; and die "$kind has SKIP, but every source needs its checksum (run makep --updsums)"
    end
end
fetch_sources
if test $updsums -eq 1
    write_sums
    rm -rf $srcdir
    echo "makep: updated the checksums in $tinybuild"
    exit 0
end
test $nobuild -eq 1; and exit 0
run_step prepare
run_step build
for name in $pkgnames
    package_split $name
end
