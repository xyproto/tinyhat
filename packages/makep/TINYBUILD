set pkgname makep
set pkgver 0.1.0
set pkgrel 15
set pkgdesc 'Builds pacman packages from TINYBUILD files, the fish-based package format of Tiny Hat'
set arch any
set url https://github.com/xyproto/tinyhat
set license BSD-3-Clause
set depends fish coreutils findutils file binutils libarchive zstd gzip curl
set optdepends 'git: for git+ sources' 'metatar: for packages that set owners' 'nvchecker: for --sup'
set backup etc/makep.conf

function package
    cp -a $startdir/root/. $pkgdir/; or return
    find $pkgdir -type d -exec chmod 755 '{}' +; or return
    find $pkgdir -type f -perm -u+x -exec chmod 755 '{}' +; or return
    find $pkgdir -type f ! -perm -u+x -exec chmod 644 '{}' +; or return
end
