set pkgbase dropbear
set pkgname dropbear dropbear-scp
set pkgver 2026.94
set pkgrel 1
set pkgdesc 'Lightweight SSH server'
set arch i686 x32
set url https://github.com/mkj/dropbear
set license MIT
set options emptydirs
set depends glibc
set makedepends git
set flags arch
set source "git+$url#tag=DROPBEAR_$pkgver" \
    dropbear.service \
    localoptions.h
set b2sums b8fd474f119e711933d9033b877c9e59aa0ac58c71825ae5c7caa90a86a0e99ee0aeb751d153d607fec202b623eb45723fb58db720d8d0f3581beb8927f9b8b3 \
    e3481447cac72e416a1d332ddb4bc2fbc78b2e558f929449469e05c269e27482e13357d467b8a11c9b7bf6fdecdd6e57717c8008247922adfc545c36e5775217 \
    49628bbce0d26eb33598de276ede705bd592a38b7892c9db0ceebfb0598a1ee6e7e84ed03dbf255ee1adcad0c5214d38dc03e6c04176a405f59a19765cb28388

function prepare
    cd $pkgbase; or return

    cp -fv ../localoptions.h localoptions.h; or return
end

function build
    cd $pkgbase; or return

    autoreconf; or return
    ./configure --bindir=/usr/bin --prefix=/usr --sbindir=/usr/bin; or return
    make PROGRAMS='dbclient dropbear dropbearconvert dropbearkey scp' SCPPROGRESS=1; or return
end

function package_dropbear
    set -a depends libxcrypt zlib

    install -d "$pkgdir/etc/$pkgname"; or return
    make -C $pkgbase install DESTDIR="$pkgdir"; or return
    install -Dm644 $pkgname.service "$pkgdir/usr/lib/systemd/system/$pkgname.service"; or return
    install -Dm644 $pkgbase/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end

function package_dropbear-scp
    set pkgdesc 'Lightweight application for copying files over SSH'
    set provides scp
    set conflicts openssh

    make -C $pkgbase install PROGRAMS=scp DESTDIR="$pkgdir"; or return
    install -Dm644 $pkgbase/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
    rmdir "$pkgdir/usr/share/man/"{man1,}; or return
end
