set pkgname readline
set pkgver 8.3.6
# 8.3.6 is version 8.3 with point patches 001 to 006
set -g _basever (string join . -- (string split . -- $pkgver)[1..2])
set -g _patchlevel (string split . -- $pkgver)[3]
set -q _patchlevel[1]; or set _patchlevel 0
set pkgrel 1
set pkgdesc 'GNU readline library'
set arch i686 x32
set url https://tiswww.case.edu/php/chet/readline/rltop.html
set nvchecker source=htmlparser url=https://cgit.git.savannah.gnu.org/cgit/readline.git/commit/ 'xpath=//div[@class=\'commit-subject\']' 'from_pattern=[rR]eadline-([\d.]+)(\s+patch\s+(\d+))?.*' 'to_pattern=\1\2'
set license GPL-3.0-or-later
set backup etc/inputrc
set depends glibc libncursesw.so ncurses
set provides libhistory.so libreadline.so
set options '!emptydirs'
# INFO: point patches are extended automatically into the source array
set source "https://ftp.gnu.org/gnu/readline/readline-$_basever.tar.gz" \
    inputrc
for p in (seq $_patchlevel)
    set -a source "https://ftp.gnu.org/gnu/readline/readline-$_basever-patches/readline"(string replace -a . '' -- $_basever)-(printf %03d $p)
end
