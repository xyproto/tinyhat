set flags arch

function prepare
    cd $pkgname-$_basever; or return
    for p in (seq $_patchlevel)
        set -l patch readline(string replace -a . '' -- $_basever)-(printf %03d $p)
        echo "applying patch $patch"
        patch -p0 -i ../$patch; or return
    end

    # remove RPATH from shared objects (FS#14366)
    sed -i 's|-Wl,-rpath,$(libdir) ||g' support/shobj-conf; or return
end

function build
    cd $pkgname-$_basever; or return

    # build with -fPIC for x86_64 (FS#15634)
    string match -q 'x86_64*' -- $CARCH; and set -a CFLAGS -fPIC

    ./configure --prefix=/usr; or return
    make SHLIB_LIBS=-lncurses; or return
end

function package
    make -C $pkgname-$_basever DESTDIR="$pkgdir" install; or return
    install -Dm644 inputrc "$pkgdir"/etc/inputrc; or return
end
