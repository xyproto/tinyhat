set pkgname libusb
set pkgver 1.0.30
set pkgrel 1
set pkgdesc 'Library that provides generic access to USB devices'
set arch i686 x32
set url https://libusb.info/
set nvchecker source=git git=https://github.com/libusb/libusb.git prefix=v 'exclude_regex=.*(alpha|beta|rc|pre).*'
set -g _url https://github.com/libusb/libusb
set license LGPL-2.1-or-later
set depends glibc
set makedepends git systemd
set provides libusb-1.0.so
set source "git+$_url.git#tag=v$pkgver"
set sha512sums d21fae358ebef28a733d69af9c361b853a437295230d57fe662b1a57a46480e459d49de4147d8d3297066dcf54f9e28fde28311a50eeec53a7453b71ae8077c6
set b2sums 5e5f8ae594acf3808fba8b0fc01e94317d16fb3d3f25b9b8484d30ca922a75b2c00441a94f49cd2b03aff53f73f46ba88f1f31f065cf7041cf8f968d48ad8869
set flags arch

function prepare
    cd $pkgname; or return
    autoreconf -fiv; or return
end

function build
    cd $pkgname; or return
    ./configure --prefix=/usr; or return
    # prevent excessive overlinking due to libtool
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make; or return
end

function check
    make -k check -C $pkgname; or return
end

function package
    set -a depends systemd-libs libudev.so
    make DESTDIR="$pkgdir" install -C $pkgname; or return
    install -vDm 644 $pkgname/{AUTHORS,ChangeLog,README} -t "$pkgdir/usr/share/doc/$pkgname/"; or return
end
