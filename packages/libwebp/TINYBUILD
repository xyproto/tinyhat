set pkgbase libwebp
set pkgname libwebp libwebp-utils
set pkgver 1.6.0
set pkgrel 2
set pkgdesc 'WebP image codec library'
set url https://developers.google.com/speed/webp/
set nvchecker source=git git=https://chromium.googlesource.com/webm/libwebp 'include_regex=v\d+(\.\d+)*' 'from_pattern=-([a-z])' 'to_pattern=\1' prefix=v
set arch i686 x32
set license BSD-3-Clause
set depends glibc
# No TIFF input in the tools (libtiff links libwebp, so that would be a cycle)
set makedepends cmake giflib libjpeg-turbo libpng ninja
set source "https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-"(string replace -r -- '([a-z])' '-$1' $pkgver)".tar.gz" \
    0001-cmake-Install-anim-utils.patch
set sha256sums e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564 \
    72128445371887c81046ad19cdbd1688e6b180e6428aec579cac0df756c2af35
set b2sums cbdfa8616edce14bf3f8621d9d0d925884d0f40e8775c7d8810575c8bec88f10ed912029cc0a4bccf9bb9eb98824e4b1a89ec61ee53d7ef20a150450d8513168 \
    f059b5c5729e5ead14f2d715e4192e02cab05cfb70d8781d9ffdba961eaeaf4515e2029845e8a5949a69d3a11a0a154128cc9fc58c34032b1d0d500c86ffa266
set flags arch

function prepare
    cd libwebp-$pkgver; or return
    # Install animation utilities
    # https://gitlab.archlinux.org/archlinux/packaging/packages/libwebp/-/merge_requests/1
    patch -Np1 -i ../0001-cmake-Install-anim-utils.patch; or return
end

function build
    set -l cmake_options \
        -D BUILD_SHARED_LIBS=ON \
        -D CMAKE_BUILD_TYPE=None \
        -D CMAKE_INSTALL_LIBDIR=/usr/lib \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_SKIP_INSTALL_RPATH=ON \
        -D CMAKE_DISABLE_FIND_PACKAGE_TIFF=ON \
        -D WEBP_BUILD_CWEBP=ON \
        -D WEBP_BUILD_DWEBP=ON \
        -D WEBP_BUILD_EXTRAS=OFF \
        -D WEBP_BUILD_GIF2WEBP=ON \
        -D WEBP_BUILD_IMG2WEBP=ON \
        -D WEBP_BUILD_VWEBP=OFF
    # Mimic autotools build without --enable-asserts
    set -a CFLAGS -DNDEBUG
    set -a CXXFLAGS -DNDEBUG
    cmake -S libwebp-$pkgver -B build -G Ninja $cmake_options; or return
    cmake --build build; or return
end

function check
    ctest --test-dir build --output-on-failure --stop-on-failure -j(nproc); or return
end

# Move files from $pkgdir to $srcdir/$argv[1], keeping their paths
function _pick
    set -l p $argv[1]
    for f in $argv[2..-1]
        set -l d "$srcdir/$p/"(string replace -r -- '^'(string escape --style=regex "$pkgdir/") '' $f)
        mkdir -p (dirname "$d"); or return
        mv "$f" "$d"; or return
        rmdir -p --ignore-fail-on-non-empty (dirname "$f"); or return
    end
end

function package_libwebp
    set optdepends 'libwebp-utils: WebP conversion and inspection tools'
    set provides libsharpyuv.so libwebp{,decoder,demux,mux}.so
    DESTDIR="$pkgdir" cmake --install build; or return
    _pick utils "$pkgdir"/usr/bin; or return
    install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 \
        libwebp-$pkgver/COPYING; or return
end

function package_libwebp-utils
    set depends giflib glibc libjpeg-turbo libpng libwebp
    mv utils/* "$pkgdir"; or return
    install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 \
        libwebp-$pkgver/COPYING; or return
end
