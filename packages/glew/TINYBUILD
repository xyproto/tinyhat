set pkgname glew
set pkgver 2.3.1
set pkgrel 1
set pkgdesc 'The OpenGL Extension Wrangler Library'
set arch i686 x32
set url https://github.com/nigels-com/glew
set license LicenseRef-glew
set depends glibc libegl libgl glu
set provides libGLEW.so
set source "https://downloads.sourceforge.net/glew/glew-$pkgver.tgz" \
    glew-2.3.0-install.patch \
    glew-ldflags.patch
set sha256sums b64790f94b926acd7e8f84c5d6000a86cb43967bd1e688b03089079799c9e889 \
    2c09632913e21db18576f9677131e63cd78986f08364220d69e8b4a59812d1a9 \
    92d57a082d0a6cdd2e82ed7e3b9aa86e9d15f5f376d8c60ae7a2f4d1f2570459
set flags arch

function prepare
    cd $pkgname-$pkgver; or return
    patch -Np1 -i ../glew-2.3.0-install.patch; or return
    patch -Np1 -i ../glew-ldflags.patch; or return
end

function build
    cd $pkgname-$pkgver; or return
    make SYSTEM=linux-egl STRIP=; or return
end

function package
    cd $pkgname-$pkgver; or return
    make SYSTEM=linux-egl install.all DESTDIR="$pkgdir"; or return
    install -D -m644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
