set pkgname vulkan-icd-loader
set pkgver 1.4.363.0
set pkgrel 1
set pkgdesc 'Vulkan Installable Client Driver (ICD) Loader'
set arch i686 x32
set url https://www.vulkan.org/
set license Apache-2.0
set groups vulkan-devel
set depends glibc
# No python-lxml: the Python code generation only runs with LOADER_CODEGEN/UPDATE_DEPS (or for cross builds)
set makedepends cmake git libx11 libxrandr ninja vulkan-headers wayland
set optdepends 'vulkan-driver: packaged vulkan driver'
set provides libvulkan.so
set source "git+https://github.com/KhronosGroup/Vulkan-Loader#tag=vulkan-sdk-$pkgver"
set sha256sums 80de80decfc3c51e079fceb873b48fe15d806aa8a6b68d1977142990a43e7460
set flags arch

function build
    set -l cmake_options -D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_INSTALL_SYSCONFDIR=/etc -D CMAKE_SKIP_INSTALL_RPATH=ON
    cmake -S Vulkan-Loader -B build -G Ninja $cmake_options; or return
    cmake --build build; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
end
