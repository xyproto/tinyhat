set pkgname mtools
set pkgver 4.0.49
set pkgrel 1
set epoch 1
set pkgdesc 'A collection of utilities to access MS-DOS disks'
set arch i686 x32
set url https://www.gnu.org/software/mtools/
set nvchecker source=regex 'regex=mtools-([\d.]+)\.tar\.bz2?' url=https://ftp.gnu.org/gnu/mtools/
set license GPL-3.0-or-later
set depends bash glibc
# No info manual (texinfo): the install target no longer depends on install-info
set backup etc/mtools.conf
set source "https://ftp.gnu.org/gnu/mtools/mtools-$pkgver.tar.bz2"
set sha256sums 6fe5193583d6e7c59da75e63d7234f76c0b07caf33b103894f46f66a871ffc9f
set flags arch

function prepare
    sed -e '/^SAMPLE FILE$/s:^:# :' -i $pkgname-$pkgver/mtools.conf; or return
    # Do not build and install the info manual, which needs makeinfo (texinfo)
    sed -i 's/ install-scripts install-info$/ install-scripts/' $pkgname-$pkgver/Makefile.in; or return
end

function build
    set -l configure_options --prefix=/usr --mandir=/usr/share/man --infodir=/usr/share/info --sysconfdir=/etc --disable-floppyd --without-x
    cd $pkgname-$pkgver; or return
    ./configure $configure_options; or return
    make; or return
end

function package
    make DESTDIR="$pkgdir" install -C $pkgname-$pkgver; or return
    install -vDm 644 $pkgname-$pkgver/mtools.conf -t "$pkgdir/etc/"; or return
    install -vDm 644 $pkgname-$pkgver/{README,NEWS} -t "$pkgdir/usr/share/doc/$pkgname"; or return
end
