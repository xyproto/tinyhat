set pkgname bison
set pkgver 3.8.2
set pkgrel 8
set pkgdesc 'The GNU general-purpose parser generator'
set arch i686 x32
set url https://www.gnu.org/software/bison/bison.html
set nvchecker source=git git=https://git.savannah.gnu.org/git/bison.git prefix=v
set license GPL-3.0-or-later
set depends gettext glibc m4 sh
set source "https://ftp.gnu.org/gnu/bison/bison-$pkgver.tar.xz"
set sha256sums 9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2
set flags arch

function build
    cd bison-$pkgver; or return
    CFLAGS="$CFLAGS -ffat-lto-objects" ./configure --prefix=/usr --datadir=/usr/share; or return
    make; or return
end

function package
    cd bison-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
end
