# NOTE: requires rebuilt with each new gcc version

set pkgbase libtool
# No multilib on 32-bit, so no lib32-libltdl split package
set pkgname libtool
set pkgver 2.6.2
set pkgrel 5
set -g _gccver 16
set pkgdesc 'A generic library support script'
set arch i686 x32
set url https://www.gnu.org/software/libtool
set nvchecker source=git git=https://git.savannah.gnu.org/git/libtool.git prefix=v
set license 'LGPL-2.0-or-later WITH Libtool-exception'
set depends sh tar
# From the release tarball (generated configure, Makefile.in and man pages): Arch builds from git with ./bootstrap,
# which needs autoconf, automake, help2man and makeinfo
set makedepends "gcc>=$_gccver" glibc
set checkdepends gcc-fortran
set source "https://ftp.gnu.org/gnu/libtool/libtool-$pkgver.tar.xz"
set sha256sums 2ef1067c16c97db930fd740cc9bc3d3ba9a583804ae5ac42cc3e8719e49e191e
set flags arch

function build
    cd libtool-$pkgver; or return
    ./configure --prefix=/usr lt_cv_sys_lib_dlsearch_path_spec="/usr/lib /usr/lib32"; or return
    make; or return
end

function check
    cd libtool-$pkgver; or return
    make check gl_public_submodule_commit=; or return
end

function package_libtool
    set -a depends glibc
    set provides "libltdl=$pkgver" "libtool-multilib=$pkgver"
    set conflicts libltdl libtool-multilib
    set replaces libltdl libtool-multilib

    cd libtool-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
end
