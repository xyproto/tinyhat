set pkgname libmaxminddb mmdblookup
set pkgver 1.14.1
set pkgrel 1
set pkgdesc 'MaxMind GeoIP2 database - split package with library and utilities'
set license Apache-2.0
set arch i686 x32
set url https://maxmind.github.io/libmaxminddb/
set nvchecker source=git git=https://github.com/maxmind/libmaxminddb.git
set optdepends 'geoip2-database: IP geolocation databases'
set flags arch
set source "https://github.com/maxmind/libmaxminddb/releases/download/$pkgver/libmaxminddb-$pkgver.tar.gz"
set sha256sums ca5c87d41339f8bc4daabb53e8a9356b3c995f2d2419b85d7bff823b2ecc252d

function build
    cd "$srcdir/libmaxminddb-$pkgver"; or return
    ./configure --prefix=/usr; or return
    make; or return
end

function check
    cd "$srcdir/libmaxminddb-$pkgver"; or return
    make check; or return
end

function package_libmaxminddb
    set pkgdesc 'MaxMindDB GeoIP2 database library'
    set depends glibc

    cd "$srcdir/libmaxminddb-$pkgver"; or return
    make PREFIX=/usr DESTDIR="$pkgdir" install; or return
    rm -rf $pkgdir/usr/{bin,share/man/man1}; or return
end

function package_mmdblookup
    set pkgdesc 'MaxMindDB GeoIP2 lookup utility'
    set url https://maxmind.github.io/libmaxminddb/mmdblookup.html
    set depends libmaxminddb

    cd "$srcdir/libmaxminddb-$pkgver"; or return
    make PREFIX=/usr DESTDIR="$pkgdir" install; or return
    rm -rf $pkgdir/usr/{lib,include,share/man/man3}; or return
end
