+static char *
+toml_trim(
+	char			*s)
+{
+	char			*e;
+
+	while (isspace((unsigned char)*s))
+		s++;
+	e = s + strlen(s);
+	while (e > s && isspace((unsigned char)e[-1]))
+		*--e = '\0';
+	return s;
+}
+
+static bool
+toml_rest_ok(
+	const char		*s)
+{
+	while (isspace((unsigned char)*s))
+		s++;
+	return *s == '\0' || *s == '#';
+}
+
+static int
+toml_parse(
+	const char		*path,
+	int			(*handler)(void *, const char *,
+					   const char *, const char *),
+	void			*user)
+{
+	FILE			*f;
+	char			line[1024];
+	char			section[256] = "";
+	int			lineno = 0;
+	int			error = 0;
+
+	f = fopen(path, "r");
+	if (!f)
+		return -1;
+	while (fgets(line, sizeof(line), f)) {
+		char		*s, *eq, *key, *val, *end;
+
+		lineno++;
+		s = toml_trim(line);
+		if (*s == '\0' || *s == '#')
+			continue;
+		if (*s == '[') {
+			end = strchr(s, ']');
+			if (!end || !toml_rest_ok(end + 1)) {
+				error = lineno;
+				break;
+			}
+			*end = '\0';
+			s = toml_trim(s + 1);
+			if (*s == '\0' || strlen(s) >= sizeof(section)) {
+				error = lineno;
+				break;
+			}
+			strcpy(section, s);
+			continue;
+		}
+		eq = strchr(s, '=');
+		if (!eq) {
+			error = lineno;
+			break;
+		}
+		*eq = '\0';
+		key = toml_trim(s);
+		val = toml_trim(eq + 1);
+		if (*val == '"' || *val == '\'') {
+			end = strchr(val + 1, *val);
+			if (!end || !toml_rest_ok(end + 1)) {
+				error = lineno;
+				break;
+			}
+			*end = '\0';
+			val++;
+		} else {
+			end = strchr(val, '#');
+			if (end)
+				*end = '\0';
+			val = toml_trim(val);
+			if (!strcmp(val, "true"))
+				val = "1";
+			else if (!strcmp(val, "false"))
+				val = "0";
+		}
+		if (*key == '\0' || *val == '\0' ||
+		    !handler(user, section, key, val)) {
+			error = lineno;
+			break;
+		}
+	}
+	fclose(f);
+	return error;
+}
