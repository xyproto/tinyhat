set pkgname xfsprogs
set pkgver 7.2.1
set pkgrel 1
set pkgdesc 'XFS filesystem utilities'
set arch i686 x32
set license GPL-2.0-only LGPL-2.1-only
set url https://xfs.wiki.kernel.org
# Without device-mapper: only xfs_io (a debugging and test tool) would use it, and Tiny Hat has no LVM
set depends libedit liburcu sh util-linux-libs
set optdepends 'python-dbus: for xfs_scrub_all script' \
    'smtp-forwarder: for xfs_scrub_fail script'
set makedepends git
set source "git+https://git.kernel.org/pub/scm/fs/xfs/xfsprogs-dev.git?signed#tag=v$pkgver" \
    xfsprogs-toml-config.patch \
    xfsprogs-32bit.patch
set b2sums 5ed15066ed3ef1db80554f868c966b9776f71b91e071ca6e400b694d8559dfdbaf28d275c94927d2b12a633b1bfd29edbd6b2bd42568d5847bc99d9c1dff0abc \
    68221b6d8b01aaf4a6d93d2191fc86ae0516ce2c14c5512305d087f4c8584e16b4a000bfd7a5d80f9f3bb4b8bafc2089c74ab03c7f14077a7bdc752f285fed73 \
    e50cdc207d7db0270cc86b8604de132244a7ccf4322dea6aa06a5672109f5ea9b88c66566eb20d64b88e613d9ff460ebf9ec792b43440bcfa770c7468493bb1c

function prepare
    cd $pkgname-dev; or return
    patch -Np1 -i ../xfsprogs-toml-config.patch; or return
    patch -Np1 -i ../xfsprogs-32bit.patch; or return
end

function build
    cd $pkgname-dev; or return
    make configure; or return
    set -lx OPTIMIZER " "
    ./configure --prefix=/usr --sbindir=/usr/bin --libexecdir=/usr/lib \
        --with-systemd-unit-dir=/usr/lib/systemd/system \
        --localstatedir=/var --enable-editline --enable-libicu=no ac_cv_search_dm_task_create=no; or return
    make; or return
end

function package
    cd $pkgname-dev; or return
    make PKG_USER=root PKG_GROUP=root DIST_ROOT="$pkgdir" \
        PKG_ROOT_SBIN_DIR=/usr/bin install; or return
    make PKG_USER=root PKG_GROUP=root DIST_ROOT="$pkgdir" \
        PKG_ROOT_SBIN_DIR=/usr/bin install-dev; or return
end
