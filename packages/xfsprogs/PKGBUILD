pkgname=xfsprogs
pkgver=7.2.1
pkgrel="1"
pkgdesc="XFS filesystem utilities"
arch=(i686 x32)
license=(
  GPL-2.0-only
  LGPL-2.1-only
)
url="https://xfs.wiki.kernel.org"
depends=(
  device-mapper
  libedit
  liburcu
  sh
  util-linux-libs
)
optdepends=(
  'icu: for xfs_scrub'
  'python-dbus: for xfs_scrub_all script'
  'smtp-forwarder: for xfs_scrub_fail script'
)
makedepends=(
  git 
  icu
)
source=(
  git+https://git.kernel.org/pub/scm/fs/xfs/xfsprogs-dev.git?signed#tag=v${pkgver}
  xfsprogs-toml-config.patch
  xfsprogs-32bit.patch
)
b2sums=('SKIP'
        '68221b6d8b01aaf4a6d93d2191fc86ae0516ce2c14c5512305d087f4c8584e16b4a000bfd7a5d80f9f3bb4b8bafc2089c74ab03c7f14077a7bdc752f285fed73'
        'e50cdc207d7db0270cc86b8604de132244a7ccf4322dea6aa06a5672109f5ea9b88c66566eb20d64b88e613d9ff460ebf9ec792b43440bcfa770c7468493bb1c')
validpgpkeys=(
  'AE1B2A9562721A6FC4307C1F46A7EA18AC33E108'
  '2B8185919E8D248981869DED20AE1692E13DDEE0'
  '4020459E58C1A52511F5399113F703E6C11CF6F0'
)

prepare() {
  cd ${pkgname}-dev
  patch -Np1 -i ../xfsprogs-toml-config.patch
  patch -Np1 -i ../xfsprogs-32bit.patch
}

build() {
  cd ${pkgname}-dev
  make configure

  sed -r -i 's/\$\(LIBICU_LIBS\)/\0 -licuuc/' scrub/Makefile

  export OPTIMIZER=" "
  ./configure --prefix=/usr --sbindir=/usr/bin --libexecdir=/usr/lib \
              --with-systemd-unit-dir=/usr/lib/systemd/system \
              --localstatedir=/var --enable-editline
  make
}

package() {
  cd ${pkgname}-dev
  make PKG_USER=root PKG_GROUP=root DIST_ROOT="${pkgdir}" \
       PKG_ROOT_SBIN_DIR="/usr/bin" install
  make PKG_USER=root PKG_GROUP=root DIST_ROOT="${pkgdir}" \
       PKG_ROOT_SBIN_DIR="/usr/bin" install-dev
}

unset -f pkgver
