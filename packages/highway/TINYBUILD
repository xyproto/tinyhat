set pkgname highway
set pkgver 1.4.0
set pkgrel 1
set pkgdesc 'A C++ library that provides portable SIMD/vector intrinsics'
set arch i686 x32
set url https://github.com/google/highway/
set license 'Apache-2.0 OR BSD-3-Clause'
set depends glibc gtest libgcc libstdc++
set makedepends cmake
set source "https://github.com/google/highway/archive/$pkgver/highway-$pkgver.tar.gz"
set sha256sums e72241ac9524bb653ae52ced768b508045d4438726a303f10181a38f764a453c
set flags arch

function build
    cmake -B build -S "$pkgname-$pkgver" -G 'Unix Makefiles' -DCMAKE_BUILD_TYPE:STRING='None' -DCMAKE_INSTALL_PREFIX:PATH='/usr' -DBUILD_SHARED_LIBS:BOOL='ON' -DHWY_SYSTEM_GTEST:BOOL='ON' -Wno-dev; or return
    cmake --build build; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
    install -D -m644 "$pkgname-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
