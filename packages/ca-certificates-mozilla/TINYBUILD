# Mozilla's CA certificates from NSS's certdata.txt, without building NSS (that needs gyp and clang): only the Python
# script that converts them, as Arch's nss PKGBUILD does for its ca-certificates-mozilla split
set pkgname ca-certificates-mozilla
set pkgver 3.131
set pkgrel 1
set pkgdesc "Mozilla's set of trusted CA certificates"
set arch any
set url https://firefox-source-docs.mozilla.org/security/nss/index.html
set license MPL-2.0
set depends 'ca-certificates-utils>=20181109'
set makedepends python
set flags arch
set -g _tag (string replace -a . _ -- $pkgver)
set source "https://ftp.mozilla.org/pub/security/nss/releases/NSS_"$_tag"_RTM/src/nss-$pkgver.tar.gz" \
    bundle.sh \
    certdata2pem.py
set b2sums 407691e4e1d67dac04f9093618f9c1029aa6c7c38d55d24e7436428598598e2bd4578c657ae8981aabfadfa221e95b5216dff42a3d3292ba9cb270b11669c567 \
    4be5dd836c844fdd7b63302a6994d62149082c3bc81eef70f373f416fed80a61a923960e4390d1c391b81ab01b409370d788818a30ffdd3a4ed467b670f990f6 \
    6bb59dcc9289916dcbf8fb6d73db0c0cd7582dc12a3aa4e8be19ec62c9ede65fdd9470a2d92ec5a114506b78d2d21b8ae0a1b45a17dc1f90f7d75434a93da510

function prepare
    mkdir -p certs; or return
    ln -srft certs nss-$pkgver/nss/lib/ckfw/builtins/{certdata.txt,nssckbi.h}; or return
end

function build
    cd certs; or return
    python ../certdata2pem.py; or return
    cd ..; or return
    sh ./bundle.sh; or return
end

function package
    install -Dm644 ca-bundle.trust.p11-kit "$pkgdir/usr/share/ca-certificates/trust-source/mozilla.trust.p11-kit"; or return
end
