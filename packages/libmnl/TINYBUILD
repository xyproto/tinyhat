set pkgname libmnl
set pkgver 1.0.5
set pkgrel 2
set pkgdesc 'Minimalistic user-space library oriented to Netlink developers.'
set arch i686 x32
set url https://www.netfilter.org/projects/libmnl/
set license LGPL2.1
set depends glibc
set source "https://www.netfilter.org/projects/libmnl/files/libmnl-$pkgver.tar.bz2" \
    "https://www.netfilter.org/projects/libmnl/files/libmnl-$pkgver.tar.bz2.sig"
set sha256sums 274b9b919ef3152bfb3da3a13c950dd60d6e2bcd54230ffeca298d03b40d0525 \
    5b838ee2b10da2e23b95a665fe4831dc54c62376362f6de2bed8004d60ae2ffb
set flags arch

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
end
