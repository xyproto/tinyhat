set pkgname libpciaccess
set pkgver 0.19
set pkgrel 1
set pkgdesc 'X11 PCI access library'
set arch i686 x32
set license LicenseRef-libpciaccess
set url https://gitlab.freedesktop.org/xorg/lib/libpciaccess
set depends glibc zlib
set makedepends xorg-util-macros meson
set source "https://xorg.freedesktop.org/releases/individual/lib/$pkgname-$pkgver.tar.xz" \
    "https://xorg.freedesktop.org/releases/individual/lib/$pkgname-$pkgver.tar.xz.sig"
set sha512sums a20ea0ef3d650e2cdc18423ea4770780ce273c35115eece85dbbb59e5f2e24bdbaf88e53b1648f2c5d4fa34b015a3fe8318721bf5655a86a835db323e6ecd4f7 \
    SKIP
set flags arch

function prepare
    mkdir build; or return
end

function build
    arch-meson $pkgname-$pkgver build; or return
    ninja -C build; or return
end

function check
    meson test -C build; or return
end

function package
    DESTDIR="$pkgdir" ninja -C build install; or return
    install -Dm644 $pkgname-$pkgver/COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
