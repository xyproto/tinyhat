set pkgname libxkbcommon
set pkgver 1.13.2
set pkgrel 1
set pkgdesc 'Keymap handling library for toolkits and window systems'
set arch i686 x32
set url https://xkbcommon.org/
set license MIT
# Without X11 and without the Wayland xkbcli tools (interactive-wayland), which Tiny Hat does not need
set makedepends_host glibc libxml2 xkeyboard-config
set makedepends_build git meson
set depends glibc libxml2 xkeyboard-config
set provides libxkbcommon.so libxkbregistry.so
set source "git+https://github.com/xkbcommon/libxkbcommon#tag=xkbcommon-$pkgver"
set sha256sums 2c94c7a5bfeff7954966203503d32bb58da440adbf76a8e32e2b468d218c7477
set flags arch

function prepare
    cd libxkbcommon; or return
end

function build
    set -l meson_options -D enable-docs=false -D enable-x11=false -D enable-wayland=false -D x-locale-root=/usr/share/xkbcommon/locale
    arch-meson libxkbcommon build $meson_options; or return
    meson compile -C build; or return
end

function package
    meson install -C build --destdir "$pkgdir"; or return
    install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 libxkbcommon/LICENSE; or return
end
