set pkgname icu
set pkgver 78.3
set pkgrel 1
set pkgdesc 'International Components for Unicode library'
set arch i686 x32
set url https://icu.unicode.org
set license LicenseRef-Unicode-3.0 BSD-2-Clause BSD-3-Clause NAIST-2003
set depends glibc libstdc++ libgcc sh
set makedepends python
set provides libicudata.so libicui18n.so libicuio.so libicutest.so libicutu.so libicuuc.so
set source "https://github.com/unicode-org/icu/releases/download/release-$pkgver/icu4c-$pkgver-sources.tgz" \
    ICU-22132.patch
set sha256sums 3a2e7a47604ba702f345878308e6fefeca612ee895cf4a5f222e7955fabfe0c0 \
    f534b472dd7a6961591466eef542e2c3ad698d3008c9b6af813c66cbc0b4dd8e
set flags arch

function prepare
    cd icu/source; or return
end

function build
    cd icu/source; or return
    ./configure --prefix=/usr --sysconfdir=/etc --mandir=/usr/share/man --sbindir=/usr/bin; or return
    make; or return
end

function package
    cd icu/source; or return
    make DESTDIR="$pkgdir" install; or return
    install -Dm644 ../LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE; or return
end
