set pkgname strace
set pkgver 7.3
set pkgrel 1
set pkgdesc 'A diagnostic, debugging and instructional userspace tracer'
set arch i686 x32
set url https://strace.io/
set nvchecker source=git git=https://github.com/strace/strace.git prefix=v
set license LGPL-2.1-or-later
set depends glibc libunwind
set source "https://github.com/strace/strace/releases/download/v$pkgver/strace-$pkgver.tar.xz"
set sha256sums 529634c40910895a9a1f3c5c1e65da2ca9ed72fb158dfc4bcc89efdf05e39b72
set flags arch

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr --with-libunwind --enable-mpers=check; or return
    make; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" COPYING; or return
end
