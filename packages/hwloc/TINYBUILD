set pkgname hwloc
set pkgver 2.15.0
set pkgrel 1
set pkgdesc 'Portable Hardware Locality is a portable abstraction of hierarchical architectures'
set arch i686 x32
set url https://www.open-mpi.org/projects/hwloc/
set license BSD-3-Clause
set depends glibc libpciaccess ncurses systemd-libs
switch $CARCH
    case x32 x86_64 aarch64
        set -g makedepends libx11 libxml2 systemd
    case '*'
        set -g makedepends libx11 libxml2 systemd cairo
end
set optdepends 'cairo: PDF, Postscript, and PNG export support' 'libxml2: full XML import/export support'
set options '!docs'
set source "https://www.open-mpi.org/software/hwloc/v2.15/downloads/hwloc-$pkgver.tar.bz2"
set sha256sums 0084b926fff9a960ddbf175654db39054ed60afbb830d2039d8a60686ca06a7f
set flags arch

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr --sbindir=/usr/bin --enable-plugins --sysconfdir=/etc; or return
    make; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    install -Dm 644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
