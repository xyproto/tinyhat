pkgname=zsnes
pkgver=2.3.9
pkgrel=1
pkgdesc="Super Nintendo emulator"
arch=(i686)
url="https://github.com/xyproto/zsnes"
license=(GPL-2.0-or-later)
depends=(sdl3 libglvnd libpng pipewire zlib)
makedepends=(mesa)
source=("zsnes-$pkgver.tar.gz::https://github.com/xyproto/zsnes/archive/refs/tags/v$pkgver.tar.gz")
b2sums=('c1e8eb04b46a200413eed1ac49aa97bda952784feee9fbf2e02d3b34e0c2654d974816fa9a03f82a771fe7511a8a7b7c24f842e37483ff40bae1f8596c843e88')

_zsnes_flags() {
  local flags=-O3
  [ "$CARCH" != i686 ] || flags+=" -fno-pic"
  CFLAGS+=" $flags"
  CXXFLAGS+=" $flags"
}

build() {
  cd zsnes-$pkgver
  _zsnes_flags
  export CFLAGS CXXFLAGS
  make all OPT_FLAGS="$CFLAGS" WITH_AO= PREFIX=/usr
}

package() {
  cd zsnes-$pkgver
  _zsnes_flags
  export CFLAGS CXXFLAGS
  make install DESTDIR="$pkgdir" OPT_FLAGS="$CFLAGS" WITH_AO= PREFIX=/usr
  [ "$CARCH" != i686 ] || readelf -h "$pkgdir/usr/bin/zsnes" | grep -q "Type:.*EXEC"
  mv "$pkgdir/usr/bin/zsnes" "$pkgdir/usr/bin/zsnes-bin"
  printf '#!/bin/sh\nexec tinyhat-run -g /usr/bin/zsnes-bin "$@"\n' >"$pkgdir/usr/bin/zsnes"
  chmod 755 "$pkgdir/usr/bin/zsnes"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
