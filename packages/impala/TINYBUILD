set pkgname impala
set pkgver 0.9.0
set pkgrel 2
set pkgdesc 'TUI for managing wifi'
set url https://github.com/pythops/impala
set depends libgcc glibc iwd
set makedepends cargo
set arch i686
set license GPL-3.0-only
set source "$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
set sha512sums 52428dc343a4fa0165d220752cc7f79460b2308cfa3f07a9142be3d73b7251bc2e0b3133450259c30e5626c0a3d9fad26c09d51707dc6570a2b251c19918035d
set flags arch

# Sets the cargo environment globally, and is called before cd into the source directory
# network: cargo fetch downloads its crates in prepare (builds have no network access otherwise)
set -a options network

function _srcenv
    set -gx CARGO_HOME "$srcdir"
    set -gx CARGO_PROFILE_RELEASE_DEBUG 2
    set -gx CARGO_PROFILE_RELEASE_STRIP false
    set -gx CARGO_PROFILE_RELEASE_LTO thin
    set -gx CARGO_PROFILE_RELEASE_CODEGEN_UNITS 1
    set -gx CARGO_PROFILE_RELEASE_OPT_LEVEL 3
end

function prepare
    _srcenv
    cd "$pkgname-$pkgver"; or return
    cargo fetch --locked --target host-tuple; or return
end

function build
    _srcenv
    cd "$pkgname-$pkgver"; or return
    cargo build --release --frozen; or return
end

function check
    _srcenv
    cd "$pkgname-$pkgver"; or return
    cargo test --frozen; or return
end

function package
    set -a depends libgcc_s.so
    cd "$pkgname-$pkgver"; or return
    install -Dm 755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"; or return
    install -Dm 644 Readme.md -t "$pkgdir/usr/share/doc/$pkgname"; or return
end
