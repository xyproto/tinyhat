set pkgbase dbus-python
set pkgname python-dbus
set pkgver 1.5.0
set pkgrel 1
set pkgdesc 'Python bindings for D-Bus'
set arch i686 x32
set url https://www.freedesktop.org/wiki/Software/dbus/
set license MIT
set depends dbus glib2 glibc python
# No documentation package (python-sphinx, python-sphinx_rtd_theme)
set makedepends git meson python-gobject python-pyproject-metadata python-tomli
set optdepends 'python-gobject: D-Bus services via PyGI'
set source "git+https://gitlab.freedesktop.org/dbus/$pkgbase.git?signed#tag=$pkgbase-$pkgver"
set b2sums e7afea40984b9fe56d751567c71d759353551803a8e08def27f80e061fde613e61cd697886debde0cfa295083a8a7640376fe9512879e3d9e3fa0c4fb01368b2
set flags arch

function build
    arch-meson $pkgbase build \
        -D doc=disabled; or return
    meson compile -C build; or return
    # Generate egg-info
    python "$pkgbase/tools/generate-pkginfo.py" $pkgver PKG-INFO; or return
end

function check
    meson test -C build --print-errorlogs; or return
end

function package_python-dbus
    set conflicts dbus-python python-dbus-common
    set provides "dbus-python=$pkgver" "python-dbus-common=$pkgver"
    set replaces dbus-python python-dbus-common
    meson install -C build --destdir "$pkgdir"; or return
    # Install egg-info and license
    set -l site (python -c 'import site; print(site.getsitepackages()[0])'); or return
    install -Dm644 -t "$pkgdir$site/dbus_python.egg-info/" PKG-INFO; or return
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$pkgbase/COPYING"; or return
end
