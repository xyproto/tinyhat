set pkgname dconf
set pkgver 51.0
set pkgrel 3
set pkgdesc 'Configuration database system'
set arch i686 x32
set url https://gitlab.gnome.org/GNOME/dconf
set license LGPL-2.1-or-later
set depends bash glib2 glibc libgcc
# No documentation (gtk-doc) and no man pages (docbook-xsl, which came with gtk-doc)
set makedepends dbus glib2-devel meson python systemd
set provides libdconf.so
set install dconf.install
set source "https://download.gnome.org/sources/dconf/$(string split -f1 . $pkgver)/dconf-$pkgver.tar.xz" \
    dconf-update.hook \
    dconf-update.script
set sha256sums e65c1b7867f836faad9f9ee04acf5c5a6cae2bbc784833fe093207e0cb590248 \
    8d02176ff001a13d15a7ac087edd2502725494668933fa2c6e6f9cb21ae24e6b \
    330142605370f82f4229e8a94b245f911407eb629b50f1497f415c70164a90ec
set flags arch

function build
    set -l meson_options -D gtk_doc=false -D man=false -D bash_completion=false
    arch-meson -D vapi=false dconf-$pkgver build $meson_options; or return
    meson compile -C build; or return
end

function package
    meson install -C build --no-rebuild --destdir "$pkgdir"; or return
    install -Dm644 dconf-update.hook -t "$pkgdir/usr/share/libalpm/hooks"; or return
    install -D dconf-update.script "$pkgdir/usr/share/libalpm/scripts/dconf-update"; or return
    install -Dm644 /dev/null "$pkgdir/etc/dconf/db/.placeholder"; or return
end
