set pkgname python-pyproject-metadata
set pkgver 0.9.0
set pkgrel 3
set pkgdesc 'PEP 621 metadata parsing'
set arch any
set url https://github.com/pypa/python-pyproject-metadata
set license MIT
set depends python python-packaging
set makedepends python-build python-flit-core python-installer
set source "$url/archive/$pkgver/$pkgname-$pkgver.tar.gz"
set sha512sums ef79e6549c9aeb644a188910ecaac56bf1cf7c4326f4bb1f1e07514eef0f56966e8eaabfe791f82f488810428a4840a7970a1ddf7a80056c630d5f91e85911a1
set flags arch

function build
    cd pyproject-metadata-$pkgver; or return
    python -m build --wheel --no-isolation; or return
end

function package
    cd pyproject-metadata-$pkgver; or return
    python -m installer --destdir="$pkgdir" dist/*.whl; or return
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
