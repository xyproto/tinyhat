set pkgname arm-none-eabi-gcc
set pkgver 16.2.0
set pkgrel 1
set pkgdesc 'The GNU Compiler Collection - cross compiler for ARM EABI (bare-metal) target'
set arch i686 x32
set url https://gcc.gnu.org/
set license GPL LGPL FDL
set depends arm-none-eabi-binutils zlib libmpc libisl zstd
set makedepends gmp mpfr arm-none-eabi-newlib
# arm-none-eabi-newlib is built with this compiler: without newlib, only the compiler and libgcc are built (stage 1),
# enough to build newlib with, and then this is built again with everything
set bootstrap_without arm-none-eabi-newlib
set optdepends 'arm-none-eabi-newlib: Standard C library optimized for embedded systems'
set options '!emptydirs' '!lto'
set source "https://ftp.gnu.org/gnu/gcc/gcc-$pkgver/gcc-$pkgver.tar.xz"
set sha256sums e6738e29597f733270731aa90600f37ffdc045079dfc27ec7e8192cc81085c3e
# Built on x86_64 for aarch64, nothing is emulated: binutils and gcc are first built for x86_64 with
# the arm-none-eabi target, to build the target libraries with (a Canadian cross)
set -g _binutils 2.47
switch $CARCH
    case aarch64
        set -a source https://ftp.gnu.org/gnu/binutils/binutils-$_binutils.tar.bz2
        set -a sha256sums 3068128c75cda9f898ccb4211d360246e8e195ffcc9dfb655b23ae23a54800e8
end
set flags arch
set -g _basedir gcc-16.2.0
set -g _target arm-none-eabi

function prepare
    cd $_basedir; or return
    echo $pkgver >gcc/BASE-VER; or return
    mkdir "$srcdir"/build-{gcc,gcc-nano}; or return
end

function _canadian
    test $CARCH = aarch64; and command -q hostcc; and test -x /opt/tinyhat-cc/launch
end

function _stage1
    not test -f /usr/$_target/include/stdio.h
end

function build
    set CFLAGS $(string replace -- '-Werror=format-security' '' "$CFLAGS")
    set CXXFLAGS $(string replace -- '-Werror=format-security' '' "$CXXFLAGS")
    if _stage1
        cd "$srcdir"/build-gcc; or return
        "$srcdir"/$_basedir/configure --target=$_target --prefix=/usr --with-sysroot=/usr/$_target \
            --with-native-system-header-dir=/include --libexecdir=/usr/lib --enable-languages=c --disable-nls \
            --disable-shared --disable-threads --disable-tls --without-headers --with-newlib --with-gnu-as \
            --with-gnu-ld --with-system-zlib --with-multilib-list=rmprofile; or return
        make all-gcc all-target-libgcc; or return
        return
    end
    if _canadian
        _build_xtools; or return
    end
    cd "$srcdir"/build-gcc; or return
    set -gx CFLAGS_FOR_TARGET '-g -Os -ffunction-sections -fdata-sections'
    set -gx CXXFLAGS_FOR_TARGET '-g -Os -ffunction-sections -fdata-sections'
    _build_gcc; or return
    cd "$srcdir"/build-gcc-nano; or return
    set -gx CFLAGS_FOR_TARGET '-g -Os -ffunction-sections -fdata-sections -fno-exceptions'
    set -gx CXXFLAGS_FOR_TARGET '-g -Os -ffunction-sections -fdata-sections -fno-exceptions'
    _build_gcc; or return
end

# The tools that run on the build machine, x86_64, and are never packaged
function _xtools_env
    set -gx PATH "$srcdir"/xtools/bin $PATH
    # hostcc and the programs it links use the libraries of the build machine
    printf '%s\n' '#!/bin/sh' 'export LD_LIBRARY_PATH=/host/usr/lib' 'exec /host/usr/bin/g++ -B/host/usr/bin --sysroot=/host "$@"' >"$srcdir"/xtools/bin/hostcxx; or return
    for t in ar nm ranlib
        printf '%s\n' '#!/bin/sh' 'export LD_LIBRARY_PATH=/host/usr/lib' "exec /host/usr/bin/$t \"\$@\"" >"$srcdir"/xtools/bin/host$t; or return
    end
    chmod +x "$srcdir"/xtools/bin/host*; or return
    # configure and make run their shell commands with the build machine's bash
    ln -sf /opt/tinyhat-cc/launch "$srcdir"/xtools/bin/bash; or return
    set -gx CONFIG_SHELL "$srcdir"/xtools/bin/bash
end

function _xtools_configure
    env CC=hostcc CXX=hostcxx AR=hostar NM=hostnm RANLIB=hostranlib CFLAGS='-O2 -pipe' CXXFLAGS='-O2 -pipe' \
        LDFLAGS='-Wl,-rpath,/host/usr/lib' CPPFLAGS= $argv --build=x86_64-pc-linux-gnu --host=x86_64-pc-linux-gnu \
        --target=$_target --prefix="$srcdir"/xtools --with-sysroot=/usr/$_target --disable-nls --disable-werror
end

function _build_xtools
    mkdir -p "$srcdir"/xtools/bin "$srcdir"/build-xbinutils "$srcdir"/build-xgcc; or return
    _xtools_env; or return
    cd "$srcdir"/build-xbinutils; or return
    _xtools_configure "$srcdir"/binutils-$_binutils/configure --disable-gdb --disable-gdbserver --disable-sim \
        --disable-gprofng --enable-multilib --enable-interwork --enable-deterministic-archives; or return
    make SHELL=$CONFIG_SHELL; or return
    make SHELL=$CONFIG_SHELL install; or return
    cd "$srcdir"/build-xgcc; or return
    _xtools_configure "$srcdir"/$_basedir/configure --with-native-system-header-dir=/include --enable-languages=c,c++ \
        --disable-decimal-float --disable-libffi --disable-libgomp --disable-libmudflap --disable-libquadmath \
        --disable-libssp --disable-libstdcxx-pch --disable-shared --disable-threads --disable-tls --with-gnu-as \
        --with-gnu-ld --with-newlib --with-multilib-list=rmprofile; or return
    make SHELL=$CONFIG_SHELL all-gcc all-target-libgcc; or return
    make SHELL=$CONFIG_SHELL install-gcc install-target-libgcc; or return
end

function _build_gcc
    set -l canadian
    set -l makeargs
    if _canadian
        set canadian --build=x86_64-pc-linux-gnu --host=aarch64-unknown-linux-gnu
        set -fx CC_FOR_BUILD hostcc
        set -fx CXX_FOR_BUILD hostcxx
        set -fx AR_FOR_BUILD hostar
        set -fx NM_FOR_BUILD hostnm
        set -fx RANLIB_FOR_BUILD hostranlib
        set -fx CFLAGS_FOR_BUILD '-O2 -pipe'
        set -fx CXXFLAGS_FOR_BUILD '-O2 -pipe'
        set -fx CPPFLAGS_FOR_BUILD
        set -fx LDFLAGS_FOR_BUILD '-Wl,-rpath,/host/usr/lib'
        # The top level passes only CFLAGS and LDFLAGS on to the build machine's libraries, but libcpp is C++
        set makeargs SHELL=$CONFIG_SHELL "EXTRA_BUILD_FLAGS=CFLAGS='$CFLAGS_FOR_BUILD' CXXFLAGS='$CXXFLAGS_FOR_BUILD' LDFLAGS='$LDFLAGS_FOR_BUILD'"
        set -fx CC_FOR_TARGET $_target-gcc
        for t in ar as gcc g++ ld nm objcopy objdump ranlib readelf strip
            set -l v (string upper (string replace -a -- - _ (string replace -- g++ cxx $t)))_FOR_TARGET
            set -fx $v $_target-$t
        end
    end
    "$srcdir"/$_basedir/configure $canadian --target=$_target --prefix=/usr --with-sysroot=/usr/$_target --with-native-system-header-dir=/include --libexecdir=/usr/lib --enable-languages=c,c++ --enable-plugins --disable-decimal-float --disable-libffi --disable-libgomp --disable-libmudflap --disable-libquadmath --disable-libssp --disable-libstdcxx-pch --disable-nls --disable-shared --disable-threads --disable-tls --with-gnu-as --with-gnu-ld --with-system-zlib --with-newlib --with-headers=/usr/$_target/include --with-python-dir=share/gcc-arm-none-eabi --with-gmp --with-mpfr --with-mpc --with-isl --with-libelf --enable-gnu-indirect-function --with-host-libstdcxx='-static-libgcc -Wl,-Bstatic,-lstdc++,-Bdynamic -lm' --with-pkgversion='Arch Repository' --with-bugurl='https://gitlab.archlinux.org/archlinux/packaging/packages/arm-none-eabi-gcc/-/issues' --with-multilib-list=rmprofile; or return
    make $makeargs INHIBIT_LIBC_CFLAGS='-DUSE_TM_CLONE_REGISTRY=0'; or return
end

function package
    set -l makeargs
    if _canadian
        set -gx PATH "$srcdir"/xtools/bin $PATH
        set makeargs SHELL=$CONFIG_SHELL
    end
    cd "$srcdir"/build-gcc; or return
    if _stage1
        make DESTDIR="$pkgdir" install-gcc install-target-libgcc -j1; or return
        rm -rf "$pkgdir"/usr/share/man/man7 "$pkgdir"/usr/share/info "$pkgdir"/usr/lib/libcc1.*; or return
        return
    end
    make $makeargs DESTDIR="$pkgdir" install -j1; or return
    cd "$srcdir"/build-gcc-nano; or return
    make $makeargs DESTDIR="$pkgdir.nano" install -j1; or return
    set -l gcc "$pkgdir"/usr/bin/$_target-gcc
    _canadian; and set gcc $_target-gcc
    set multilibs $($gcc -print-multi-lib 2> /dev/null)
    for multilib in $multilibs
        set dir "$(string replace -r -- '(.*?);.*$' '$1' "$multilib")"
        set from_dir "$pkgdir".nano/usr/$_target/lib/"$dir"
        set to_dir "$pkgdir"/usr/$_target/lib/"$dir"
        cp -f "$from_dir"/libstdc++.a "$to_dir"/libstdc++_nano.a; or return
        cp -f "$from_dir"/libsupc++.a "$to_dir"/libsupc++_nano.a; or return
    end
    find "$pkgdir"/usr/lib/gcc/$_target/$pkgver "$pkgdir"/usr/$_target/lib -type f -and \( -name \*.a -or -name \*.o \) -exec $_target-objcopy -R .comment -R .note -R .debug_info -R .debug_aranges -R .debug_pubnames -R .debug_pubtypes -R .debug_abbrev -R .debug_line -R .debug_str -R .debug_ranges -R .debug_loc '{}' \;; or return
    find "$pkgdir"/usr/bin/ "$pkgdir"/usr/lib/gcc/$_target/$pkgver -type f -and \( -executable \) -exec strip '{}' \;; or return
    rm -r "$pkgdir"/usr/share/man/man7; or return
    rm -r "$pkgdir"/usr/share/info; or return
    rm "$pkgdir"/usr/lib/libcc1.*; or return
end
