 static void _mSDLAudioCallback(void* context, Uint8* data, int len);
 
+#if SDL_VERSION_ATLEAST(3, 0, 0)
+static void _mSDLAudioStreamCallback(void* context, SDL_AudioStream* stream, int additional, int total) {
+	UNUSED(total);
+	Uint8 data[4096];
+	while (additional > 0) {
+		int len = (additional + 3) & ~3;
+		if (len > (int) sizeof(data)) {
+			len = sizeof(data);
+		}
+		_mSDLAudioCallback(context, data, len);
+		SDL_PutAudioStreamData(stream, data, len);
+		additional -= len;
+	}
+}
+#endif
