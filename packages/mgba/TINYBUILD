set pkgname mgba
set pkgver 0.10.5
set pkgrel 2
set pkgdesc 'Game Boy Advance emulator, SDL3 frontend'
set arch i686 x32
set url https://mgba.io/
set license MPL-2.0
set depends sdl3 libpng zlib
set makedepends cmake ninja
set source "mgba-$pkgver.tar.gz::https://github.com/mgba-emu/mgba/archive/refs/tags/$pkgver.tar.gz" \
    altenter.patch \
    sdl3.patch \
    gamepad.patch \
    hidecursor.patch \
    scale3.patch
set sha256sums 91d6fbd32abcbdf030d58d3f562de25ebbc9d56040d513ff8e5c19bee9dacf14 \
    SKIP \
    SKIP \
    SKIP \
    SKIP \
    SKIP

function prepare
    cd mgba-$pkgver; or return
    patch -Np1 -i ../altenter.patch; or return
    patch -Np1 -i ../sdl3.patch; or return
    patch -Np1 -i ../gamepad.patch; or return
    patch -Np1 -i ../hidecursor.patch; or return
    patch -Np1 -i ../scale3.patch; or return
end

function build
    cmake -S mgba-$pkgver -B build -G Ninja -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DSDL_VERSION=3 \
        -DBUILD_QT=OFF -DBUILD_SDL=ON -DBUILD_GL=OFF -DBUILD_GLES2=OFF -DBUILD_GLES3=OFF -DUSE_EPOXY=OFF \
        -DBUILD_SHARED=OFF -DBUILD_STATIC=ON -DUSE_FFMPEG=OFF -DUSE_MINIZIP=OFF -DUSE_LIBZIP=OFF \
        -DUSE_SQLITE3=OFF -DUSE_ELF=OFF -DUSE_LUA=OFF -DENABLE_SCRIPTING=OFF -DUSE_LZMA=OFF \
        -DUSE_DISCORD_RPC=OFF -DUSE_EDITLINE=OFF -DUSE_GDB_STUB=OFF -DUSE_DEBUGGERS=OFF; or return
    ninja -C build; or return
end

function package
    DESTDIR="$pkgdir" ninja -C build install; or return
    rm -rf "$pkgdir"/usr/{include,lib} "$pkgdir"/usr/share/{doc,applications,icons}; or return
    install -Dm644 mgba-$pkgver/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
