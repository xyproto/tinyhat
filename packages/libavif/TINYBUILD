set pkgname libavif
set pkgver 1.4.2
set pkgrel 1
set -g _libargparse ee74d1b53bd680748af14e737378de57e2a0a954 # should match cmake/Modules/LocalLibargparse.cmake
set pkgdesc 'Library for encoding and decoding .avif files'
set arch i686 x32
set url https://github.com/AOMediaCodec/libavif
set license LicenseRef-libavif
# No svt-av1: it is 64-bit only
set depends aom \
    dav1d \
    glibc \
    libgcc \
    libjpeg-turbo \
    libpng \
    libstdc++ \
    libwebp \
    libxml2 \
    libyuv \
    rav1e
set makedepends cmake \
    git \
    nasm \
    pandoc-cli
set source "git+https://github.com/AOMediaCodec/libavif#tag=v$pkgver" \
    "git+https://github.com/kmurray/libargparse#commit=$_libargparse"
set sha256sums 2c84afde7ea25afbf3ed9981d65a87723920137e1033f5e4fb48c76c4566ede1 \
    235020da02227503eb09961efd664aca6e544a8b3ed5533cf81e1862bb94f48f
set flags arch

function prepare
    cp -r libargparse libavif/ext; or return
end

function build
    cmake -B build -S $pkgname \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DAVIF_BUILD_APPS=ON \
        -DAVIF_BUILD_MAN_PAGES=ON \
        -DAVIF_CODEC_AOM=SYSTEM \
        -DAVIF_CODEC_DAV1D=SYSTEM \
        -DAVIF_CODEC_RAV1E=SYSTEM \
        -DAVIF_CODEC_SVT=OFF \
        -DAVIF_LIBSHARPYUV=SYSTEM \
        -DAVIF_LIBXML2=SYSTEM \
        -DAVIF_BUILD_GDK_PIXBUF=OFF; or return
    make -C build; or return
end

function package
    make -C build DESTDIR="$pkgdir" install; or return
    install -Dm644 $pkgname/LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname; or return
end
