set pkgname lua
set pkgver 5.5.1
set -g _majorver (string replace -r '\.[^.]*$' '' -- $pkgver)
set pkgrel 1
set pkgdesc 'Powerful lightweight programming language designed for extending applications'
set arch i686 x32
set url https://www.lua.org/
set depends readline
set license MIT
set options '!emptydirs'
set provides lua55
set source "https://www.lua.org/ftp/lua-$pkgver.tar.gz" \
    liblua.so.patch \
    paths.patch \
    lua.pc \
    license-from-upstream
set sha256sums 1c4b4068d67061f2a2231ad2b5422e77acea1487ea9890f6320af614f4373dce \
    fffe49aeb070f7d47c7a0ed556d43560d4de703e71e5ac708490694629b2987a \
    b9512ef0b1a3463d4da40ae52a0a72b391fe8b667a4296920538a6fac0b6f050 \
    ca9252633e782b8f85d6a94ea4f6babd4fe30bd759085b373160b1878e36ff78 \
    142fb08b41a807b192b4b2c166696a1830a1c97967e5099ad0e579bf500e1da4
set flags arch

function prepare
    patch -d lua-$pkgver -p1 -i ../liblua.so.patch; or return
    patch -d lua-$pkgver -p1 -i ../paths.patch; or return
    cp -r lua-$pkgver lua++-$pkgver; or return

    sed "s/%VER%/$_majorver/g;s/%REL%/$pkgver/g" lua.pc >lua-$pkgver/lua.pc; or return
    sed "s/%VER%/$_majorver/g;s/%REL%/$pkgver/g;s/-llua/-llua++/g" lua.pc >lua++-$pkgver/lua++.pc; or return
end

function build
    cd lua-$pkgver; or return
    make MYCFLAGS="$CFLAGS -fPIC" MYLDFLAGS="$LDFLAGS" linux; or return

    cd ../lua++-$pkgver; or return
    make MYCFLAGS="$CXXFLAGS -fPIC" MYLDFLAGS="$LDFLAGS" CC=g++ LUA_A=liblua++.a LUA_SO=liblua++.so linux; or return
end

function package
    cd lua-$pkgver; or return
    make \
        TO_LIB="liblua.so liblua.so.$_majorver liblua.so.$pkgver" \
        INSTALL_DATA='cp -d' \
        INSTALL_TOP="$pkgdir"/usr \
        INSTALL_MAN="$pkgdir"/usr/share/man/man1 \
        install; or return
    ln -sf /usr/bin/lua "$pkgdir"/usr/bin/lua$_majorver; or return
    ln -sf /usr/bin/luac "$pkgdir"/usr/bin/luac$_majorver; or return
    ln -sf /usr/lib/liblua.so.$pkgver "$pkgdir"/usr/lib/liblua$_majorver.so; or return

    install -Dm644 lua.pc "$pkgdir"/usr/lib/pkgconfig/lua55.pc; or return
    ln -sf lua55.pc "$pkgdir"/usr/lib/pkgconfig/lua.pc; or return
    ln -sf lua55.pc "$pkgdir"/usr/lib/pkgconfig/lua5.5.pc; or return
    ln -sf lua55.pc "$pkgdir"/usr/lib/pkgconfig/lua-5.5.pc; or return

    install -d "$pkgdir"/usr/share/doc/$pkgname; or return
    install -m644 doc/*.{png,css,html} "$pkgdir"/usr/share/doc/$pkgname; or return
    install -Dm644 ../license-from-upstream "$pkgdir"/usr/share/licenses/$pkgname/LICENSE; or return

    cd ../lua++-$pkgver; or return
    make \
        TO_LIB="liblua++.so liblua++.so.$_majorver liblua++.so.$pkgver" \
        INSTALL_BIN=null INSTALL_INC=null INSTALL_MAN=../null \
        INSTALL_DATA='cp -d' \
        INSTALL_TOP="$pkgdir"/usr \
        install; or return
    ln -sf /usr/lib/liblua++.so.$pkgver "$pkgdir"/usr/lib/liblua++$_majorver.so; or return

    install -Dm644 lua++.pc "$pkgdir"/usr/lib/pkgconfig/lua++55.pc; or return
    ln -sf lua++55.pc "$pkgdir"/usr/lib/pkgconfig/lua++.pc; or return
    ln -sf lua++55.pc "$pkgdir"/usr/lib/pkgconfig/lua++5.5.pc; or return
    ln -sf lua++55.pc "$pkgdir"/usr/lib/pkgconfig/lua++-5.5.pc; or return
end
