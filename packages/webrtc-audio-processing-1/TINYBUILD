set pkgname webrtc-audio-processing-1
set pkgver 1.3
set pkgrel 6
set pkgdesc "AudioProcessing library based on Google's implementation of WebRTC (legacy)"
set url https://freedesktop.org/software/pulseaudio/webrtc-audio-processing/
set nvchecker source=git git=https://gitlab.freedesktop.org/pulseaudio/webrtc-audio-processing.git 'include_regex=v1(\.\d+)*' prefix=v
set arch i686 x32
set license BSD-3-Clause
set depends abseil-cpp glibc libgcc libstdc++
set makedepends git meson
set provides libwebrtc-audio-coding-1.so libwebrtc-audio-processing-1.so
set source "git+https://gitlab.freedesktop.org/pulseaudio/webrtc-audio-processing.git?signed#tag=v$pkgver" \
    0001-Fix-compilation-with-GCC-15.patch
set b2sums ce5cb5c44474add0beb769b41ca64588dd4b2e164934161360ab71bf5fc520d6aa9cc10b070652a438fc80b00cd7245d7676ed07badb711cba8aa943b2fabbe2 \
    1962d02b733e3e62acebf3c794c85443c8aa667f84dbee2d25e76bc64f41cff3d49427c230e90ea1f2e3761167e7a03444cb7dc07e820c75f517f3c864fdcd3e
set flags arch

function prepare
    cd webrtc-audio-processing; or return
    # Fix compilation with gcc 15
    git apply -3 ../0001-Fix-compilation-with-GCC-15.patch; or return
end

function build
    # This requires SSE, so enable it on i686
    if test $CARCH = i686
        set -a CXXFLAGS -msse
        set -a CFLAGS -msse
    end
    # must match abseil
    set -l meson_options -D cpp_std=c++17
    arch-meson webrtc-audio-processing build $meson_options; or return
    meson compile -C build; or return
end

function check
    meson test -C build --print-errorlogs; or return
end

function package
    meson install -C build --destdir "$pkgdir"; or return
    install -Dm644 webrtc-audio-processing/COPYING \
        -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
