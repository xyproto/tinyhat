set pkgname patchelf
set pkgver 0.19.3
set pkgrel 1
set pkgdesc 'Small utility to modify the dynamic linker and RPATH of ELF executables'
set arch i686 x32
set url https://nixos.org/patchelf.html
set license GPL-3.0-or-later
set depends libgcc libstdc++
set makedepends git
set source "git+https://github.com/NixOS/patchelf.git#tag=$pkgver"
set sha512sums 5d91e4fd07456afef592b310dccec5f0806d538877ac651e18f2326165194b11e7feab1a8f7b20e2778586ace1112e5ccb48f3889450980e9c80518f132a5da4
set b2sums 4e35b37364c26a67140c0574d2a2b70db29977ae22fe473a73ad85a8f816d96564285e2c5eca7d2acbf91f31bff632d53317bfe4f3f35e60cdb31eff66097e44
set flags arch

function prepare
    cd patchelf; or return
    autoreconf -fiv; or return
end

function build
    cd patchelf; or return
    ./configure --prefix=/usr; or return
    make; or return
end

function package
    cd patchelf; or return
    make DESTDIR="$pkgdir" install; or return
end
