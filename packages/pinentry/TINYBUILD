set pkgname pinentry
set pkgver 1.3.3
set pkgrel 1
set pkgdesc 'Collection of simple PIN or passphrase entry dialogs which utilize the Assuan protocol'
set arch i686 x32
set url https://gnupg.org/related_software/pinentry/
set nvchecker source=regex url=https://www.gnupg.org/ftp/gcrypt/pinentry/ 'regex=pinentry-([^"]*)\.tar' 'exclude_regex=.*diff.*'
set license GPL
set depends glibc ncurses libassuan libsecret glib2
set optdepends 'gcr: GNOME backend' 'gtk3: GTK backend' 'kguiaddons: Qt6 backend' 'kwindowsystem: Qt6 backend'
set source "https://www.gnupg.org/ftp/gcrypt/pinentry/pinentry-$pkgver.tar.bz2" \
    pinentry
set sha256sums c2970f16d6afb66ecddfca767d743936c86239bff936eed7fd7597a678414b63 \
    b902d07c061e0cf6d661014516172f7a35f477362edb779f863935733d1c4dde
set flags arch

function build
    cd "$pkgname-$pkgver"; or return
    CXXFLAGS="-std=c++17" ./configure --prefix=/usr --enable-pinentry-tty --enable-pinentry-curses --enable-fallback-curses --enable-pinentry-emacs --disable-pinentry-gnome3 --disable-pinentry-qt --enable-libsecret --disable-pinentry-efl --disable-pinentry-gtk2 --disable-pinentry-qt --disable-pinentry-qt5 --disable-pinentry-gnome3 --disable-pinentry-emacs --disable-pinentry-fltk --disable-pinentry-tqt; or return
    make; or return
end

function package
    set -a depends libglib-2.0.so libncursesw.so libsecret-1.so
    cd "$pkgname-$pkgver"; or return
    make DESTDIR="$pkgdir" install; or return
    install -Dm 755 ../pinentry -t "$pkgdir/usr/bin"; or return
end
