set pkgname tty-solitaire
set pkgver 1.4.1
set pkgrel 1
set pkgdesc 'ncurses-based klondike solitaire game'
set arch i686 x32
set url https://github.com/mpereira/tty-solitaire
set nvchecker source=git git=https://github.com/mpereira/tty-solitaire.git prefix=v
set license MIT
set depends git ncurses
set source "git+https://github.com/mpereira/tty-solitaire.git#tag=v$pkgver"
set sha256sums e3cc5f8b9930c5f02b4eaa4cfc891cc92e607e600e01ea3db89c92eb3575bd53
set flags arch

function build
    cd $pkgname; or return
    make; or return
end

function package
    cd $pkgname; or return
    make PREFIX=/usr DESTDIR="$pkgdir" install; or return
    install -Dm644 -t "$pkgdir"/usr/share/licenses/$pkgname LICENSE; or return
end
