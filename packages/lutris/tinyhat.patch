diff --git a/lutris/util/graphics/wlrandr.py b/lutris/util/graphics/wlrandr.py
new file mode 100644
index 0000000..594bb5a
--- /dev/null
+++ b/lutris/util/graphics/wlrandr.py
@@ -0,0 +1,107 @@
+"""Display management for wlroots compositors, through wlr-randr"""
+
+import json
+import subprocess
+from collections import namedtuple
+from collections.abc import Iterable
+from typing import Any
+
+from lutris.settings import DEFAULT_RESOLUTION_HEIGHT, DEFAULT_RESOLUTION_WIDTH
+from lutris.util.display import DisplayManager
+from lutris.util.log import logger
+from lutris.util.system import find_executable
+
+Output = namedtuple("Output", ("name", "mode", "position", "rotation", "primary", "rate", "preferred_mode"))
+
+
+def _query(command: str) -> list[dict[str, Any]]:
+    try:
+        result = subprocess.run([command, "--json"], capture_output=True, text=True, timeout=5, check=True)
+        return [o for o in json.loads(result.stdout) if o.get("enabled")]
+    except (OSError, subprocess.SubprocessError, ValueError) as ex:
+        logger.debug("wlr-randr is not usable: %s", ex)
+        return []
+
+
+def _mode(output: dict[str, Any], key: str) -> dict[str, Any] | None:
+    return next((m for m in output.get("modes", []) if m.get(key)), None)
+
+
+def _name(mode: dict[str, Any] | None) -> str | None:
+    return "%sx%s" % (mode["width"], mode["height"]) if mode else None
+
+
+class WlrDisplayManager(DisplayManager):
+    """Display manager for compositors with wlr-output-management, like dwl, Sway and labwc"""
+
+    def __init__(self) -> None:
+        command = find_executable("wlr-randr")
+        if not command:
+            raise RuntimeError("wlr-randr is not installed")
+        self.command: str = command
+        if not _query(command):
+            raise RuntimeError("The compositor does not support wlr-output-management")
+
+    def get_outputs(self) -> list[Output]:
+        outputs = []
+        for index, output in enumerate(_query(self.command)):
+            current = _mode(output, "current")
+            if not current:
+                continue
+            position = output.get("position", {})
+            outputs.append(
+                Output(
+                    name=output["name"],
+                    mode=_name(current),
+                    position="%s,%s" % (position.get("x", 0), position.get("y", 0)),
+                    rotation=output.get("transform", "normal"),
+                    primary=index == 0,
+                    rate="%.3f" % current.get("refresh", 60),
+                    preferred_mode=_name(_mode(output, "preferred")),
+                )
+            )
+        return outputs
+
+    def get_display_names(self) -> list[str]:
+        return [output.name for output in self.get_outputs()]
+
+    def get_resolutions(self) -> list[str]:
+        resolutions = {_name(m) for o in _query(self.command) for m in o.get("modes", [])}
+        resolutions.discard(None)
+        if not resolutions:
+            return ["%sx%s" % (DEFAULT_RESOLUTION_WIDTH, DEFAULT_RESOLUTION_HEIGHT)]
+        return sorted(resolutions, key=lambda r: [int(n) for n in r.split("x")], reverse=True)
+
+    def get_current_resolution(self) -> tuple[str, str]:
+        outputs = self.get_outputs()
+        if not outputs:
+            return str(DEFAULT_RESOLUTION_WIDTH), str(DEFAULT_RESOLUTION_HEIGHT)
+        width, height = outputs[0].mode.split("x")
+        return width, height
+
+    def set_resolution(self, resolution: str | Iterable[Output]) -> None:
+        if not resolution:
+            return
+        if isinstance(resolution, str):
+            outputs = self.get_outputs()
+            if not outputs or resolution not in self.get_resolutions():
+                logger.warning("Resolution %s doesn't exist.", resolution)
+                return
+            commands = [[self.command, "--output", outputs[0].name, "--mode", resolution]]
+        else:
+            commands = [
+                [self.command, "--output", o.name, "--on", "--mode", "%s@%sHz" % (o.mode, o.rate), "--pos", o.position,
+                 "--transform", o.rotation or "normal"]
+                for o in resolution
+            ]
+        for command in commands:
+            logger.info("Changing the display mode: %s", " ".join(command))
+            subprocess.run(command, check=False)
+
+    def get_config(self) -> list[Output]:
+        return self.get_outputs()
+
+    def turn_off_except(self, display: str) -> None:
+        for output in self.get_outputs():
+            if output.name != display:
+                subprocess.run([self.command, "--output", output.name, "--off"], check=False)
