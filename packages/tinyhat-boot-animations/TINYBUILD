# The Boot Animations gallery from tinyhat-bootsplash: a GTK 4 program for choosing and previewing the boot and
# shutdown animations. The splash itself is packages/tinyhat-splash
set pkgname tinyhat-boot-animations
set pkgver 1.0.2.r1.g018ff5e
set -g _commit 018ff5e819d6510557ab4e7f492054e0a8d42fc2
set pkgrel 1
set pkgdesc 'Tiny Hat Boot Animations gallery, for choosing and previewing boot and shutdown animations'
set arch i686 x32
set url https://github.com/xyproto/tinyhat-bootsplash
set license BSD-3-Clause
set depends glibc gtk4 tinyhat-splash
set makedepends_host gtk4
set source "tinyhat-bootsplash-$_commit.tar.gz::https://github.com/xyproto/tinyhat-bootsplash/archive/$_commit.tar.gz"
set sha256sums cbe45ea33a776fe05058eaa5a8302b4c4c1953ac268c919147509d6659aaa83b

function build
    cd tinyhat-bootsplash-$_commit; or return
    # The theme colours come from the environment, as #rrggbb
    set -l hat (string replace -r '^#' '' -- "$TINYHAT_THEME_HAT_COLOR")
    set -l highlight (string replace -r '^#' '' -- "$TINYHAT_THEME_HAT_HIGHLIGHT_COLOR")
    make PREFIX=/usr COLORS="-DHAT_COLOR=0x$hat -DHAT_HIGHLIGHT_COLOR=0x$highlight" tinyhat-boot-animations; or return
end

function package
    cd tinyhat-bootsplash-$_commit; or return
    install -Dm755 tinyhat-boot-animations "$pkgdir"/usr/bin/tinyhat-boot-animations; or return
    install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE; or return
end
