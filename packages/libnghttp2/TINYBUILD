    git+https://github.com/ngtcp2/urlparse.git#commit=59b068a7618a256c6823b0b9801b61d1d04677a3
set sha512sums 48f3bf6748abf46e9b1a2cfcfc4053ef8a7d532898da854d508c520c7adcca3a8690f81d2683d14398cf937a3f7c9276000c569ccc1183bbf20d449e64f5c315 \
    258d0461c3fbd80b4f4675c2a4af7cd621a6a0d152ee30eea4a9f1123f7e7590b65ba6ca2e00252db6fc818446132464ca8f582362f133e48987769f7aa717f5 \
