set pkgname libnghttp2
set pkgver 1.70.0
set pkgrel 2
set pkgdesc 'Framing layer of HTTP/2 is implemented as a reusable C library'
set arch i686 x32
set url https://nghttp2.org/
set nvchecker source=git git=https://github.com/nghttp2/nghttp2.git prefix=v
set license MIT
set depends glibc
set provides libnghttp2.so
set makedepends git
set conflicts 'nghttp2<1.20.0-2'
set source "git+https://github.com/nghttp2/nghttp2.git?signed#tag=v$pkgver" \
    git+https://github.com/ngtcp2/munit.git#commit=114805e1bab0222574b5eb3a92461ad5216647ed \
