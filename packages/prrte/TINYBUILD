# Moves files from $pkgdir to $srcdir/$argv[1], for another split package
function _pick
    set -l p $argv[1]
    for f in $argv[2..-1]
        set -l d "$srcdir/$p/"(string replace -- "$pkgdir/" '' $f)
        mkdir -p (path dirname $d); or return
        mv $f $d; or return
        rmdir -p --ignore-fail-on-non-empty (path dirname $f); or return
    end
end

function prepare
    cd $pkgbase-$pkgver; or return
    ./autogen.pl; or return
    # append our options to the system config file
    cat ../prte-mca-params.conf >>src/etc/prte-mca-params.conf; or return
end

function build
    set -l configure_options \
        --prefix=/usr \
        --sysconfdir=/etc/$pkgbase

    # set environment variables for reproducible build
    # see https://docs.prrte.org/en/latest/release-notes.html
    set -lx HOSTNAME buildhost
    set -lx USER builduser

    cd $pkgbase-$pkgver; or return
    ./configure $configure_options; or return
    # prevent excessive overlinking due to libtool
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make V=1; or return
end

function check
    make -k check -C $pkgbase-$pkgver; or return
end

function package_prrte
    set depends glibc hwloc libevent libevent_{core,pthreads}-2.1.so openpmix libpmix.so
    set optdepends 'openssh: for execution on remote hosts via plm_ssh_agent' 'prrte-docs: for documentation'
    set provides libprrte.so
    set backup etc/$pkgbase/prte-default-hostfile etc/$pkgbase/prte-mca-params.conf etc/$pkgbase/prte.conf

    make DESTDIR="$pkgdir" install -C $pkgname-$pkgver; or return
    pushd "$pkgdir"; or return
    _pick $pkgbase-docs usr/share/{doc,prte/rst}; or return
    popd
    install -vDm 644 $pkgname-$pkgver/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"; or return

    # avoid a conflict with putty which also provides pterm: https://gitlab.archlinux.org/archlinux/packaging/packages/prrte/-/issues/1
    mv "$pkgdir"/usr/bin/{,prrte-}pterm; or return
    mv "$pkgdir"/usr/share/man/man1/{,prrte-}pterm.1; or return

    # install our dummy ssh wrapper
    install -vDm 755 prrte-ssh -t "$pkgdir/usr/bin/"; or return
end

function package_prrte-docs
    set pkgdesc "$pkgdesc - documentation"

    mv -v $pkgname/* "$pkgdir"; or return
    install -vDm 644 $pkgbase-$pkgver/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
