set pkgname libverto
set pkgver 0.3.2
set pkgrel 6
set pkgdesc 'Main event loop abstraction library'
set arch i686 x32
set url https://github.com/latchset/libverto
set license MIT
set depends glibc libevent
set provides libverto.so libverto-libevent.so libverto-module-base
# No conflicts with 'krb5<1.19.3-2' and 'libverto-libevent<0.3.2-4': more cycle breaking with krb5
set replaces 'libverto-libevent<0.3.2-4'
set flags arch
set source "https://github.com/latchset/libverto/releases/download/$pkgver/libverto-$pkgver.tar.gz"
set sha256sums 8d1756fd704f147549f606cd987050fb94b0b1ff621ea6aa4d6bf0b74450468a

function build
    cd "$pkgname-$pkgver"; or return
    ./configure --prefix=/usr \
        --disable-static \
        --with-libevent \
        --without-libev \
        --without-glib; or return
    make; or return
end

function check
    cd "$pkgname-$pkgver"; or return
    make check; or return
end

function package
    cd "$pkgname-$pkgver"; or return
    make DESTDIR="$pkgdir" install; or return

    install -Dm0644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
