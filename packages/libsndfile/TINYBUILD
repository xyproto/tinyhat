set pkgname libsndfile
set pkgver 1.2.2
set pkgrel 4
set pkgdesc 'A C library for reading and writing files containing sampled audio data'
set arch i686 x32
set url https://libsndfile.github.io/libsndfile/
set license LGPL-2.1-or-later
set depends glibc
set makedepends alsa-lib cmake flac lame libogg libvorbis mpg123 opus python sqlite
set optdepends 'alsa-lib: for sndfile-play'
set provides libsndfile.so
set flags arch
set source https://github.com/$pkgname/$pkgname/releases/download/$pkgver/$pkgname-$pkgver.tar.xz{,.asc} \
    "$pkgname-1.2.2-CVE-2022-33065.patch::https://github.com/libsndfile/libsndfile/commit/0754562e13d2e63a248a1c82f90b30bc0ffe307c.patch"
set sha512sums a6e3ea3ac5d91befaa99f6a31a3fac44e7b7c11f1de4698167317a461d5a19a2651d47486a920b34400f18367b4f6173bf0c1c9ba80eb682cece1b5beee352a0 \
    SKIP \
    a91112f067e8267ad6448517c6dc7234b1f8664612990e5ef6a074259bbe61e5b389bc334cd4a36ddf7a0bfa5943b9a1c450fe601713dd887cb6bc5172cd0a49
set b2sums bc8e49983d9ad9dfd98984e2ffef501c6f576480e556e9f9ef91c7d597524cc1bb8baed15dfef8e239f72c42136c524117029eb8271f3a2c9d607fee490279b5 \
    SKIP \
    21116ed199bf97b151fd3d6c6684d45a0f5f246afd5b1389b778198445045b93fc5fbe9ae7509e8fa4312f70b4751017f5f2f947101ed6874a6db15a8754c63e
switch $CARCH
    case i686
        # disable SSE2 on i686
        set -a source libsndfile-1.0.31-no-sse2.patch
        set -a sha512sums 3088df360db3e8a86e9586597594db0a2c633504bb2453ff17e9bd062ce29a8773ec35426dfda9391eac72cccb2ca12dbab11915f9c4313283b858f756a85f0b
        set -a b2sums 6066f0a0856c9ce8fdc88ce3fd62c4207be371e5854b14d40c60aa0bf920a5c2f42e6b8abf863fe8dcacf539419c90514cf511844814638df3cffa12514ceb76
end

function prepare
    patch -d $pkgname-$pkgver -Np1 -i ../$pkgname-1.2.2-CVE-2022-33065.patch; or return
    if test $CARCH = i686
        cd "$srcdir/$pkgbase-$pkgver"; or return
        patch -p1 -i "$srcdir/libsndfile-1.0.31-no-sse2.patch"; or return
    end
end

function build
    set -l cmake_options \
        -B build \
        -D BUILD_SHARED_LIBS=ON \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_BUILD_TYPE=None \
        -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -D ENABLE_EXTERNAL_LIBS=ON \
        -D ENABLE_MPEG=ON \
        -S $pkgname-$pkgver \
        -W no-dev
    set -l cmake_test_options \
        -B build-test \
        -D CMAKE_BUILD_TYPE=None \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -S $pkgname-$pkgver \
        -W no-dev

    cmake $cmake_test_options; or return
    cmake --build build-test --verbose; or return
    cmake $cmake_options; or return
    cmake --build build --verbose; or return
end

function check
    ctest --test-dir build-test --output-on-failure; or return
end

function package
    set -a depends flac libFLAC.so lame libmp3lame.so libogg libogg.so libvorbis libvorbis.so libvorbisenc.so mpg123 libmpg123.so opus libopus.so

    DESTDIR="$pkgdir" cmake --install build; or return
    install -vDm 644 $pkgname-$pkgver/{AUTHORS,ChangeLog,README} -t "$pkgdir/usr/share/doc/$pkgname"; or return
end
