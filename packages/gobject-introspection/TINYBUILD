set pkgbase gobject-introspection
set pkgname gobject-introspection gobject-introspection-runtime libgirepository
set pkgver 1.86.0
set pkgrel 1
set pkgdesc 'Introspection system for GObject-based libraries'
set url https://wiki.gnome.org/Projects/GObjectIntrospection
set arch i686 x32
set license GPL-2.0-or-later LGPL-2.0-or-later
set -g _glibver 2.90.1
set makedepends "glib2=$_glibver" cairo git glibc libffi libffi meson python python-mako python-markdown \
    python-setuptools
set source "git+https://gitlab.gnome.org/GNOME/gobject-introspection.git#tag=$pkgver" \
    "git+https://gitlab.gnome.org/GNOME/glib.git?signed#tag=$_glibver" \
    git+https://gitlab.gnome.org/GNOME/gobject-introspection-tests.git
set b2sums 46007e1c426ebfde0d94b84398a1d99e0fc516f1b5a78590d0d1ddec76b90d19a9c6f4f9959a6d243cbb3601390763bbdd7d05d1d1c3d4fb9746f453b40ea849 \
    d2a3b7c9745b4473621bc77d1fa690c062510cb53dd24555abceb0216ddb9c3f18214774a6c4a948daf0edcf4738db9ed1cba47ec92481d4eee18906bc0e78a3 \
    SKIP
set flags arch

function prepare
    cd $pkgbase; or return
    git submodule init; or return
    git submodule set-url gobject-introspection-tests "$srcdir/gobject-introspection-tests"; or return
    git -c protocol.file.allow=always -c protocol.allow=never submodule update; or return
end

function build
    arch-meson $pkgbase build -D glib_src_dir="$srcdir/glib" -D gtk_doc=false; or return
    meson compile -C build; or return
end

function check
    meson test -C build --print-errorlogs; or return
end

function _pick
    set -l p $argv[1]
    for f in $argv[2..-1]
        set -l d "$srcdir/$p/"(string replace -- "$pkgdir/" '' $f)
        mkdir -p (dirname $d); or return
        mv $f $d; or return
        rmdir -p --ignore-fail-on-non-empty (dirname $f); or return
    end
end

function package_gobject-introspection
    set depends "gobject-introspection-runtime=$pkgver" "libgirepository=$pkgver" glib2 glibc libffi python
    set -a depends python-mako python-markdown python-setuptools
    meson install -C build --destdir "$pkgdir"; or return
    # Relax the glib requirement in the pc files: when building glib2 itself, the chroot only has the
    # prebuilt glib2, while this version of gobject-introspection needs a newer one. Everything else in
    # the build environment gets the locally built glib2 anyway.
    sed -i 's/^Requires: \(.*\)$/Requires: glib-2.0, gobject-2.0/' "$pkgdir"/usr/lib/pkgconfig/gobject-introspection*.pc; or return
    cd "$pkgdir"; or return
    python -m compileall -d /usr/lib/$pkgbase usr/lib/$pkgbase; or return
    python -O -m compileall -d /usr/lib/$pkgbase usr/lib/$pkgbase; or return
    _pick libg usr/include/gobject-introspection-1.0; or return
    _pick libg usr/lib/libgirepository-1.0.so*; or return
    _pick libg usr/lib/pkgconfig/gobject-introspection*-1.0.pc; or return
    _pick libg usr/lib/girepository-1.0/GIRepository-2.0.typelib; or return
    _pick libg usr/share/gir-1.0/GIRepository-2.0.gir; or return
    _pick runtime usr/lib/girepository-1.0; or return
end

function package_gobject-introspection-runtime
    set pkgdesc "$pkgdesc - runtime"
    set depends "libgirepository=$pkgver"
    mv runtime/* "$pkgdir"; or return
end

function package_libgirepository
    set pkgdesc "$pkgdesc - runtime library"
    set depends glib2 glibc libffi libffi.so libg{lib,object,module}-2.0.so
    set provides libgirepository-1.0.so
    mv libg/* "$pkgdir"; or return
end
