set pkgname libthai
set pkgver 0.1.30
set pkgrel 1
set pkgdesc 'Thai language support library'
set arch i686 x32
set url https://linux.thai.net/projects/libthai
set license LGPL-2.1-or-later
set depends glibc libdatrie
set makedepends autoconf-archive doxygen git
set source "git+https://github.com/tlwg/libthai.git#tag=v$pkgver"
set b2sums b098f6dfdfc23b77e9b56861cdb71897e7d77a9c5d2196119192ff80c592b78bf580006b56134641b5e3882a833f983ac471a19991fc94b6cb165377a828ff07
set flags arch

function prepare
    cd $pkgname; or return
    autoreconf -fi; or return
end

function build
    cd $pkgname; or return
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var; or return
    make; or return
end

function check
    cd $pkgname; or return
    make check; or return
end

function package
    cd $pkgname; or return
    make DESTDIR="$pkgdir" install; or return
end
