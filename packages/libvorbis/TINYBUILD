set pkgbase libvorbis
set pkgname libvorbis libvorbis-docs
set pkgver 1.3.7
set pkgrel 4
set pkgdesc 'Reference implementation of the Ogg Vorbis audio format'
set arch i686 x32
set url https://www.xiph.org/vorbis/
set license BSD-3-Clause
set depends glibc libogg
set makedepends git
set -g _tag 0c55fa38933fd4bdb7db7c298b27e7bf2f2c5e98
set source "git+https://github.com/xiph/vorbis.git?signed#tag=$_tag"
set sha256sums f58777e598c5ef1c9f21698e581f6e62729f3d343ec4aa270051fb304a56fe26
set flags arch

function prepare
    cd vorbis; or return
    ./autogen.sh; or return
end

function build
    cd vorbis; or return
    ./configure \
        --prefix=/usr \
        --disable-static \
        --enable-shared; or return
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make; or return
end

function check
    make -C vorbis check -j1; or return
end

function package_libvorbis
    set -a depends libogg.so
    set provides libvorbis.so libvorbisenc.so libvorbisfile.so
    make DESTDIR="$pkgdir" -C vorbis install; or return
    mkdir -p doc/usr/share; or return
    mv {"$pkgdir",doc}/usr/share/doc; or return
    install -Dm 644 vorbis/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end

function package_libvorbis-docs
    set pkgdesc "$pkgdesc (documentation)"
    set depends
    mv doc/* "$pkgdir"; or return
    install -Dm 644 vorbis/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"; or return
end
