set pkgname lazygit
set pkgver 0.66.2
set pkgrel 1
set pkgdesc 'Simple terminal UI for git commands'
set arch i686
set url https://github.com/jesseduffield/lazygit
set license MIT
set depends git
set makedepends go-tinyhat
set options '!buildflags'
set source "lazygit-$pkgver.tar.gz::https://github.com/jesseduffield/lazygit/archive/refs/tags/v$pkgver.tar.gz"
set sha256sums fcaad0909af765ef87bd873164a4de78435515ab4d8b04f58d6ad51e8ecd00e5

function build
    cd lazygit-$pkgver; or return
    set -lx GOROOT /usr/lib/go-tinyhat
    set -lx GOPATH "$srcdir/gopath"
    set -lx GOCACHE "$srcdir/gocache"
    set -lx GOTOOLCHAIN local
    set -lx GOFLAGS -mod=vendor
    set -lx CGO_ENABLED 0
    set -lx GOARCH 386
    set -lx GO386 softfloat
    switch $CARCH
        case aarch64
            set GOROOT /usr/lib/go
            set GOARCH arm64
        case x86_64
            set GOROOT /usr/lib/go
            set GOARCH amd64
    end
    set -lx PATH $GOROOT/bin $PATH
    go build -trimpath -buildvcs=false \
        -ldflags "-s -w -X main.version=$pkgver -X main.buildSource=tinyhat" -o lazygit; or return
end

function package
    install -Dm755 lazygit-$pkgver/lazygit "$pkgdir/usr/bin/lazygit"; or return
    install -Dm644 lazygit-$pkgver/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
