set pkgbase libevent
set pkgname libevent
set pkgver 2.1.13
set pkgrel 2
set pkgdesc 'Event notification library'
set url https://libevent.org/
set arch i686 x32
set license BSD-3-Clause-Modification
# No documentation (doxygen)
set makedepends cmake ninja openssl python
set source "https://github.com/libevent/libevent/releases/download/release-$pkgver-stable/libevent-$pkgver-stable.tar.gz" \
    0001-EVENT__SIZEOF_TIME_T.patch
set sha256sums f7e9383b8c0baa81b687e5b5eecc01beefaf1b19b64151d95ed61647fe7a315c \
    945fc885b15692721bc7ae52f5774ef4fab8cc0f6108baa8860ab368de8675cf
set flags arch

function prepare
    cd libevent-$pkgver-stable; or return

    # this is needed to build thunderbird with system libs!
    patch -Np1 -i ../0001-EVENT__SIZEOF_TIME_T.patch; or return
end

function build
    set -l cmake_options \
        -B build \
        -S libevent-$pkgver-stable \
        -D CMAKE_BUILD_TYPE=None \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -D CMAKE_SKIP_INSTALL_RPATH=TRUE \
        -D EVENT__DISABLE_REGRESS=OFF \
        -D EVENT__DOXYGEN=OFF \
        -D EVENT__LIBRARY_TYPE=SHARED \
        -G Ninja

    cmake $cmake_options; or return
    cmake --build build; or return
end

function check
    # Disable flaky tests: https://github.com/libevent/libevent/issues/1407
    # Note: Backporting e.g. https://github.com/libevent/libevent/pull/1555 didn't resolve this!
    set -l ctest_options \
        --exclude-regex '(regress__timerfd_EPOLL|regress__timerfd_EPOLL_debug|regress__changelist_EPOLL|regress__changelist_EPOLL_debug|regress__timerfd_changelist_EPOLL|regress__timerfd_changelist_EPOLL_debug|regress__SELECT|regress__SELECT_debug|regress__POLL|regress__POLL_debug)' \
        --output-on-failure \
        --stop-on-failure

    cd build; or return
    ctest $ctest_options; or return
end

function package_libevent
    set provides libevent{,_core,_extra,_openssl,_pthreads}-2.1.so
    set depends glibc openssl
    set optdepends 'python: event_rpcgen.py'

    DESTDIR="$pkgdir" cmake --install build; or return
    sed -i "s|set(LIBEVENT_INCLUDE_DIRS \"$srcdir/[^\"]*\")|set(LIBEVENT_INCLUDE_DIRS \"\")|" "$pkgdir/usr/lib/cmake/libevent/LibeventConfig.cmake"; or return

    install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 libevent-$pkgver-stable/LICENSE; or return
end
