set pkgname liburcu
set pkgver 0.15.7
set pkgrel 1
set pkgdesc 'LGPLv2.1 userspace RCU (read-copy-update) library'
set arch i686 x32
set url https://lttng.org/urcu
set license LGPL2.1
set depends glibc
set source "https://lttng.org/files/urcu/userspace-rcu-$pkgver.tar.bz2"
set sha256sums 2556b83adc0f9b3ac8024e613e17d014d04c4c49110604ce55fcb14eae32edd3
set flags arch

function build
    cd "$srcdir"/userspace-rcu-$pkgver; or return
    ./configure --prefix=/usr; or return
    make; or return
end

function package
    cd "$srcdir"/userspace-rcu-$pkgver; or return
    make install DESTDIR="$pkgdir"; or return
end
