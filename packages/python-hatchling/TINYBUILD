set pkgname python-hatchling
set pkgver 1.32.4
set pkgrel 1
set pkgdesc 'Extensible, standards compliant build backend used by Hatch'
set arch any
set url https://github.com/pypa/hatch/tree/master/backend
set nvchecker source=pypi pypi=hatchling
set license MIT
# python-editables is only needed for editable installs (Arch has it as a depend; upstream does not)
set depends python python-packaging python-pathspec python-pluggy python-tomlkit python-trove-classifiers
set makedepends python-build python-installer
set source "https://github.com/pypa/hatch/archive/hatchling-v$pkgver.tar.gz"
set b2sums be84990cf0a04a180221fa14642e7245c2b58830f2d538ba82446e4f525812cd9af598cc41e734b9c9e158c103c8f073abf2e5f240fa6fedf83d154bd092c453
set flags arch

# hatchling builds itself (backend-path in backend/pyproject.toml)

function build
    cd hatch-hatchling-v$pkgver; or return
    python -m build --wheel --no-isolation backend; or return
end

function package
    cd hatch-hatchling-v$pkgver; or return
    python -m installer --destdir="$pkgdir" backend/dist/*.whl; or return
    install -Dm644 backend/LICENSE.txt -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
