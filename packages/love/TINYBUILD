set pkgname love
set pkgver 12.0.r1853.gdef2451
set -g _commit def245102c67909f9902095af613b1ae05249b62
set pkgrel 1
set pkgdesc 'An open-source 2D game engine which uses the versatile Lua scripting language to create dynamic gaming experiences'
set arch i686
set url http://love2d.org/
set license zlib
set depends luajit freetype2 harfbuzz openal libvorbis libogg libmodplug sdl3 zlib shared-mime-info hicolor-icon-theme desktop-file-utils libtheora openssl
set makedepends cmake ninja git
set flags arch
set source "love::git+https://github.com/love2d/love#commit=$_commit" love-openssl4.patch
set sha512sums bd159069b1e5dac11110d877d7d64a6606cce63dd77d48c0b8b00f272a1bccf56af044a9f9fa52323696672a4d0bcafe7f6a8134b6056eee15c1b3d1eb4f573f \
    b8a953972858c962bbf902548da7a119bd00792cfd69be115711c61a409e16861db076f2a62049da26295396345462839e9c73171d800b5965bc75431be5db6a

function prepare
    patch -Np1 -d love -i "$srcdir/love-openssl4.patch"; or return
end

function build
    switch $CARCH
        case i686
            set -a CFLAGS -msse2 -mfpmath=sse
            set -a CXXFLAGS -msse2 -mfpmath=sse
    end
    cmake -S love -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SHARED_LINKER_FLAGS="$LDFLAGS -Wl,--start-group"; or return
    ninja -C build; or return
end

function package
    DESTDIR="$pkgdir" ninja -C build install; or return
    install -Dm755 "$pkgdir/usr/bin/love" "$pkgdir/usr/lib/love/love"; or return
    printf '%s\n' \
        '#!/bin/sh' \
        'ver() { IFS=. read -r major minor <<V' \
        '$1' \
        V \
        '  echo $((${major:-0} * 100 + ${minor:-0})); }' \
        'if [ -n "$TINYHAT_GL_VERSION" ] && [ "$(ver "$TINYHAT_GL_VERSION")" -lt 303 ] && [ "$(ver "${TINYHAT_GLES_VERSION:-0.0}")" -lt 300 ]; then' \
        '  export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe' \
        '  command -v tinyhat-notice >/dev/null && tinyhat-notice "This graphics chip has OpenGL $TINYHAT_GL_VERSION, LÖVE needs 3.3, so it runs in software and can be slow" 8' \
        fi \
        'exec /usr/lib/love/love "$@"' >"$pkgdir/usr/bin/love"; or return
    install -Dm0644 love/license.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"; or return
end
