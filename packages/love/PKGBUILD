# Maintainer: Sven-Hendrik Haase <svenstaro@archlinux.org>
# Contributor: Linus Sjögren <thelinx@unreliablepollution.net>
# Contributor: Eric Forgeot < http://anamnese.online.fr >, dreeze
pkgname=love
pkgver=12.0.r1835.gb7daef0
_commit=b7daef0f7c1dc5888090f5d5b22d4eaf4ffd1d87
pkgrel=1
pkgdesc="An open-source 2D game engine which uses the versatile Lua scripting language to create dynamic gaming experiences"
arch=(i686)
url="http://love2d.org/"
license=('zlib')
depends=('luajit' 'freetype2' 'harfbuzz' 'openal' 'libvorbis' 'libogg' 'libmodplug' 'sdl3' 'zlib' 'shared-mime-info' 'hicolor-icon-theme' 'desktop-file-utils' 'libtheora')
makedepends=('cmake' 'ninja' 'git')
source=("love::git+https://github.com/love2d/love#commit=$_commit")
sha512sums=('6f1e23c9456ce83be9227a0036373da8c17e7082d76c871acb7db801d24ab30a23ce1a7c6f72f9a4c67793cef5ce0226e7b2316f59367242926f894ab74eae7f')

prepare() {
  echo 'target_link_libraries(love_physics_box2d PUBLIC love_3p_box2d)' >> love/CMakeLists.txt
}

build() {
  cmake -S love -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm0644 love/license.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# vim:set ts=2 sw=2 et:

unset -f pkgver
