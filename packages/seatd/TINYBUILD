set pkgname seatd
set pkgver 0.9.3
set pkgrel 1
set pkgdesc 'A minimal seat management daemon, and a universal seat management library'
set arch i686 x32
set url 'https://sr.ht/~kennylevinsen/seatd/'
set nvchecker source=git 'git=https://git.sr.ht/~kennylevinsen/seatd'
set license MIT
set provides libseat.so
set replaces libseat
set makedepends meson ninja scdoc systemd
set depends systemd-libs
set source "$pkgname-$pkgver.tar.gz::https://git.sr.ht/~kennylevinsen/seatd/archive/$pkgver.tar.gz" \
    sysuser.conf
set fallbackurl "$pkgname-$pkgver.tar.gz::https://github.com/kennylevinsen/seatd/archive/refs/tags/$pkgver.tar.gz"
set sha256sums 302564d54d8e28191fadfd734f2675ecb0c9e0615a58011b89ef15dfa4dbaa96 \
    e833292adf5da25b5258a5209c258f0e4c12e1d6fe81cf228fd0cfb575080d78
set flags arch

function build
    mkdir build; or return
    meson --prefix=/usr \
        --buildtype=plain \
        -Dexamples=disabled \
        -Dserver=enabled \
        -Dlibseat-logind=systemd \
        -Dman-pages=enabled \
        "seatd-$pkgver" \
        build; or return
    ninja -C build; or return
end

function check
    ninja -C build test; or return
end

function package
    DESTDIR="$pkgdir/" ninja -C build install; or return
    install -Dm644 "seatd-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
    # Allow users in the "seat" group to access seatd, and provide a service
    # that will be necessary for e.g. wlroots-based seat management
    install -Dm644 "seatd-$pkgver/contrib/systemd/seatd.service" \
        -t "$pkgdir/usr/lib/systemd/system/"; or return
    install -Dm644 sysuser.conf "$pkgdir/usr/lib/sysusers.d/seatd.conf"; or return
end
