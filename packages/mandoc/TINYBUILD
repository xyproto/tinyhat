set pkgname mandoc
set pkgver 1.14.6
set pkgrel 5
set pkgdesc 'A suite of tools compiling mdoc from the OpenBSD project'
set arch i686 x32
set url https://mdocml.bsd.lv
set license ISC
set depends zlib
set makedepends less
set optdepends 'less: default pager'
set provides man
set conflicts man
set -g _archive "$pkgname-$pkgver"
set source "$url/snapshots/$_archive.tar.gz" \
    configure.local \
    mandoc.service \
    mandoc.timer
set sha256sums 8bf0d570f01e70a6e124884088870cbed7537f36328d512909eb10cd53179d9c \
    383772d5dd7c51319588ac4b63d4e7c452490568f6a3e905d118fdd6c4aa8a68 \
    2091411d5f87a3c371a5ba74b4773d1e454046446fa2cb045485979e52419bb6 \
    6b8df810386c581800074adb89c17c7e22dc5784e71e6069ebb039183b59df83
set flags arch

# Single-quotes a value for a shell script
function _shquote
    echo "'"(string replace -a "'" "'\\''" -- "$argv")"'"
end

function prepare
    cd "$_archive"; or return
    cp ../configure.local .; or return
end

function build
    cd "$_archive"; or return
    # apply CFLAGS and LDFLAGS from the build configuration
    printf '%s\n' "CFLAGS="(_shquote $CFLAGS) "LDFLAGS="(_shquote $LDFLAGS) >>configure.local; or return
    ./configure; or return
    make; or return
end

function package
    cd "$_archive"; or return
    DESTDIR="$pkgdir" make install; or return
    install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE; or return
    install -Dm0644 -t "$pkgdir/usr/lib/systemd/system/" ../mandoc.timer; or return
    install -Dm0644 -t "$pkgdir/usr/lib/systemd/system/" ../mandoc.service; or return
    install -dm0755 "$pkgdir/usr/lib/systemd/system/timers.target.wants"; or return
    ln -s ../mandoc.timer "$pkgdir"/usr/lib/systemd/system/timers.target.wants/mandoc.timer; or return
end
