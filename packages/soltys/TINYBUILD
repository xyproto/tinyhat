set pkgname soltys
set pkgver 1.0
set pkgrel 1
set pkgdesc 'Soltys, a comedy adventure game (English, freeware), for ScummVM'
set arch any
set url https://www.scummvm.org/games/#games-soltys
set license LicenseRef-soltys-Freeware
set optdepends 'scummvm: to play the game'
set source "https://downloads.scummvm.org/frs/extras/Soltys/soltys-en-v$pkgver.zip"
set sha256sums 87b89e654b8a5b8ebe342cb4c5c6049ab9a43a5efb474d9c49bafb77dcce48f6

function package
    install -Dm644 vol.cat vol.dat license.txt -t $pkgdir/usr/share/games/soltys/; or return
    install -Dm644 license.txt $pkgdir/usr/share/licenses/$pkgname/LICENSE; or return
end
