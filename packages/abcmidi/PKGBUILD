pkgname=abcmidi
pkgver=2026_10_09
pkgrel="1"
pkgdesc='Tools for ABC and MIDI files'
groups=(pro-audio)
arch=(i686 x32)
url='https://github.com/sshlien/abcmidi'
license=(GPL-2.0-or-later)
makedepends=(git)
depends=(glibc)
source=("git+$url#tag=${pkgver//_/.}")
b2sums=('d7a74c9ecea1ad388e546a6f1a6e6b8d777b4ca5428dbf0581bacd7f4ce0d052b2c9fd2d753c00c7cae0e9aeff9bcd2312dc655ec2ea039bcf44ce6ffa42c662')

prepare() {
  sed -i 's/extern int lyrics_meta/int lyrics_meta/g' $pkgname/genmidi.c
}

build() {
  cd $pkgname
  export CFLAGS+=' -std=c99 -Wno-implicit-function-declaration -Wl,--allow-multiple-definition'
  ./configure --prefix=/usr
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
  install -m 755 -d "$pkgdir"/usr/share/doc/$pkgname/{programming,samples}
  install -m 644 -t "$pkgdir"/usr/share/doc/$pkgname/programming doc/programming/*.{abc,txt}
  install -m 644 -t "$pkgdir"/usr/share/doc/$pkgname/samples samples/*.abc
}

unset -f pkgver
