set pkgname cmake
set pkgver 4.4.5
set pkgrel 1
set pkgdesc 'A cross-platform open-source make system'
set arch i686 x32
set url https://www.cmake.org/
set license BSD-3-Clause
set depends curl expat glibc hicolor-icon-theme jsoncpp libarchive libgcc libstdc++ libuv ncurses rhash zlib
set makedepends git nlohmann-json
set optdepends 'make: for unix Makefile generator' 'ninja: for ninja generator' 'qt6-base: cmake-gui'
set source "git+https://gitlab.kitware.com/cmake/cmake.git#tag=v$pkgver?signed"
set sha256sums SKIP
set flags arch

function build
    cd $pkgname; or return
    ./bootstrap --prefix=/usr --mandir=/share/man --docdir=/share/doc/cmake --datadir=/share/cmake --system-libs --no-system-cppdap --parallel=$(/usr/bin/getconf _NPROCESSORS_ONLN); or return
    make; or return
end

function package
    cd $pkgname; or return
    make DESTDIR="$pkgdir" install; or return
    install -Dm644 LICENSE.rst -t "$pkgdir"/usr/share/licenses/$pkgname; or return
end
