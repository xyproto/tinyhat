set pkgname cmake
set pkgver 4.4.5
set pkgrel 1
set pkgdesc 'A cross-platform open-source make system'
set arch i686 x32
set url https://www.cmake.org/
set nvchecker source=gitlab gitlab=cmake/cmake host=gitlab.kitware.com use_max_tag=true prefix=v 'exclude_regex=.*rc.*'
set license BSD-3-Clause
# Bundled curl, jsoncpp and librhash (--no-system-curl --no-system-jsoncpp --no-system-librhash): curl is built with
# cmake, so a cmake that needs curl would be a cycle; no cmake-gui, so no hicolor-icon-theme. jsoncpp and rhash dropped;
# nlohmann-json is not used by this CMake version (its bundled cppdap uses jsoncpp)
set depends expat glibc libarchive libgcc libstdc++ libuv ncurses openssl zlib
set makedepends git
set optdepends 'make: for unix Makefile generator' 'ninja: for ninja generator' 'qt6-base: cmake-gui'
set source "git+https://gitlab.kitware.com/cmake/cmake.git#tag=v$pkgver?signed"
set sha256sums d1333636a747c66babda24b16debfbb79b3b5b4e3d9e700cfcdfea0ede3bd3a8
set flags arch

function build
    cd $pkgname; or return
    ./bootstrap --prefix=/usr --mandir=/share/man --docdir=/share/doc/cmake --datadir=/share/cmake --system-libs --no-system-curl --no-system-cppdap --no-system-jsoncpp --no-system-librhash --parallel=$(/usr/bin/getconf _NPROCESSORS_ONLN); or return
    make; or return
end

function package
    cd $pkgname; or return
    make DESTDIR="$pkgdir" install; or return
    install -Dm644 LICENSE.rst -t "$pkgdir"/usr/share/licenses/$pkgname; or return
end
