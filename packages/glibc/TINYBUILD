function prepare
    mkdir -p glibc-build; or return
end

function build
    # No systemtap probes (they need sys/sdt.h at build time), no lib32 build (Tiny Hat builds for one ABI at a time)
    set -l flags --prefix=/usr --enable-bind-now --enable-fortify-source \
        --enable-kernel=4.4 --enable-multi-arch --enable-stack-protector=strong --disable-nscd --disable-profile \
        --disable-werror --libdir=/usr/lib --libexecdir=/usr/lib
    switch $CARCH
        case i686
            # No ISA level marking, so that the libraries load on every i686 CPU (FS32#145)
            set -a flags libc_cv_include_x86_isa_level=no
        case '*'
            # Control-flow enforcement and SFrame are for 64-bit x86 only
            set -a flags --enable-cet --enable-sframe
    end
    # _FORTIFY_SOURCE=3 is built in with --enable-fortify-source
    set CFLAGS (string replace -- -Wp,-D_FORTIFY_SOURCE=3 '' $CFLAGS)
    cd glibc-build; or return
    printf '%s\n' slibdir=/usr/lib rtlddir=/usr/lib sbindir=/usr/bin rootsbindir=/usr/bin >configparms
    "$srcdir"/glibc/configure $flags; or return
    make -O; or return
    # Pregenerated locales: localedef does not work under fakeroot in package()
    make -C "$srcdir"/glibc/localedata objdir="$srcdir"/glibc-build DESTDIR="$srcdir"/locales install-locale-files; or return
end

function package_glibc
    set pkgdesc 'GNU C Library'
    set depends 'linux-api-headers>=4.10' tzdata filesystem
    set optdepends 'perl: for mtrace'
    set backup etc/gai.conf etc/locale.gen etc/tunables.conf etc/tunables.conf.d/shstk.conf
    make -C glibc-build DESTDIR="$pkgdir" install; or return
    rm -f "$pkgdir"/etc/ld.so.cache
    # Shipped in tzdata
    rm -f "$pkgdir"/usr/bin/{tzselect,zdump,zic}
    cd glibc; or return
    install -dm755 "$pkgdir"/usr/lib/locale; or return
    install -m644 posix/gai.conf "$pkgdir"/etc/gai.conf; or return
    install -m755 "$srcdir"/locale-gen "$pkgdir"/usr/bin; or return
    install -m644 "$srcdir"/locale.gen.txt "$pkgdir"/etc/locale.gen; or return
    sed -e '1,3d' -e 's|/| |g' -e 's|\\\\| |g' -e 's|^|#|g' localedata/SUPPORTED >>"$pkgdir"/etc/locale.gen; or return
    sed -e '1,3d' -e 's|/| |g' -e 's| \\\\||g' localedata/SUPPORTED >"$pkgdir"/usr/share/i18n/SUPPORTED; or return
    # C.UTF-8, so that it is always available
    cp -r "$srcdir"/locales/usr/lib/locale/C.utf8 -t "$pkgdir"/usr/lib/locale; or return
    sed -i '/#C\.UTF-8 /d' "$pkgdir"/etc/locale.gen; or return
    # Tracing probes for libstdc++ exceptions, used by gdb's catch command
    install -Dm644 "$srcdir"/sdt.h "$pkgdir"/usr/include/sys/sdt.h; or return
    install -Dm644 "$srcdir"/sdt-config.h "$pkgdir"/usr/include/sys/sdt-config.h; or return
    for hook in 10-glibc-locale-gen 10-glibc-remove-locale-archive 11-glibc-ldconfig 11-glibc-remove-ldconfig-cache \
        12-glibc-iconvconfig 12-glibc-remove-iconvconfig-cache
        install -vDm 644 ../$hook.hook -t "$pkgdir"/usr/share/libalpm/hooks/; or return
    end
    install -vDm 644 ../tunables.conf -t "$pkgdir"/etc/; or return
    install -vDm 644 ../shstk.conf -t "$pkgdir"/etc/tunables.conf.d/; or return
end

function package_glibc-locales
    set pkgdesc 'Pregenerated locales for GNU C Library'
    set depends "glibc=$pkgver"
    cp -r locales/* -t "$pkgdir"; or return
    rm -r "$pkgdir"/usr/lib/locale/C.utf8; or return
    # deduplicate locale data
    hardlink -c "$pkgdir"/usr/lib/locale; or return
end
