set pkgname nspr
set pkgver 4.40
set pkgrel 1
set pkgdesc 'Netscape Portable Runtime'
set url https://developer.mozilla.org/en-US/docs/Mozilla/Projects/NSPR
set arch i686 x32
set license MPL-2.0
set depends glibc sh
set makedepends git zip
set source "git+https://github.com/mozilla/nspr#tag=NSPR_$(string replace -a . _ -- $pkgver)_RTM" \
    0001-linux-prefer-GCC-provided-atomics-to-asssembly-imple.patch \
    0002-configure.in-Remove-assembly-files-from-build.patch
set b2sums 85f718df7c96d4eff50e0d47554c2658dfebb1a4d2dbe177a679ad2d55b77251cb11fa97704ae202b4ea87de3cff89ec3b5dc38c4236d76c4f649da4e42ac1e0 \
    4726267397f2bc5dedb2ccff941448932118712183915b4517a8a65d129dde4c2a16dbb6cf63bfae43add16b9c9ae62343cf7c777b25a90c81a727124c0d6d01 \
    eec760670dfeac2d27cd41573bb97ee4e8251c54d80f2404bc4e32058511a3c63f37fe9f37bc6348a7d3cf0eaf5440bec1479ec38141d64d2e61137b67912be3
set flags arch

function prepare
    cd nspr; or return
    # https://bugzilla.mozilla.org/show_bug.cgi?id=1496426
    # https://gitlab.archlinux.org/archlinux/packaging/packages/nspr/-/merge_requests/1
    patch -Np1 -i ../0001-linux-prefer-GCC-provided-atomics-to-asssembly-imple.patch; or return
    patch -Np1 -i ../0002-configure.in-Remove-assembly-files-from-build.patch; or return
    autoreconf -fvi; or return
end

function build
    # 32-bit build
    set -l configure_options \
        --prefix=/usr \
        --libdir=/usr/lib \
        --includedir=/usr/include/nspr \
        --enable-optimize \
        --disable-debug \
        --disable-64bit
    cd nspr; or return
    ./configure $configure_options; or return
    set -l make_options
    if set -q SOURCE_DATE_EPOCH[1]
        set make_options SH_NOW="$SOURCE_DATE_EPOCH"000000 \
            SH_DATE=(date --utc --date="@$SOURCE_DATE_EPOCH" '+%Y-%m-%d %T')
    end
    make $make_options; or return
    make -C pr/tests; or return
end

function check
    cd nspr; or return
    make -C pr/tests runtests; or return
end

function package
    cd nspr; or return
    make DESTDIR="$pkgdir" install; or return
    ln -s nspr.pc "$pkgdir/usr/lib/pkgconfig/mozilla-nspr.pc"; or return
    rm -r "$pkgdir"/usr/include/nspr/md; or return
    rm "$pkgdir"/usr/bin/{compile-et.pl,prerr.properties}; or return
end
