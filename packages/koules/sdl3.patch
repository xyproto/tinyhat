-}
 
 
 static void
@@ -1315,6 +1306,77 @@
 
 
 
+#define HOLE_PULL_RANGE 150
+#define HOLE_PULL (BALL_SPEED * 0.4)
+
+static void
+hole_pull (CONST int i)
+{
+  int             r;
+  float           pull, xp, yp, d;
+  switch (object[i].type)
+    {
+    case ROCKET:
+      if (object[i].time)
+	return;
+      pull = HOLE_PULL / 3;
+      break;
+    case BALL:
+    case LBALL:
+    case BBALL:
+    case LUNATIC:
+    case INSPECTOR:
+      pull = HOLE_PULL;
+      break;
+    default:
+      return;
+    }
+  for (r = 0; r < nobjects; r++)
+    if (object[r].live && object[r].type == HOLE)
+      {
+	xp = object[r].x - object[i].x;
+	yp = object[r].y - object[i].y;
+	d = sqrt (xp * xp + yp * yp);
+	if (d > 0 && d < HOLE_PULL_RANGE)
+	  {
+	    normalize (&xp, &yp, pull * (1 - d / HOLE_PULL_RANGE));
+	    object[i].fx += xp;
+	    object[i].fy += yp;
+	  }
+      }
+}
+
+static void
+hole_field (CONST int i)
+{
+  float           a = RAD (rand () % 360);
+  float           d = HOLE_PULL_RANGE * (50 + rand () % 50) / 100.0;
+  float           speed = 2 + rand () % 3;
+  addpoint ((object[i].x + sin (a) * d) * 256, (object[i].y + cos (a) * d) * 256,
+	    -sin (a) * speed * 256, -cos (a) * speed * 256,
+	    ball (4) + rand () % 12, (d - HOLE_RADIUS) / speed);
+}
+
+static void
+swallow (CONST int hole, CONST int i)
+{
+  int             n, time;
+  int             c = color (object[i].type, i, object[i].letter);
+  float           a, d, x, y;
+  for (n = 0; n < 24; n++)
+    {
+      a = RAD (n * 15 + rand () % 15);
+      d = object[i].radius + rand () % 8;
+      x = object[i].x + sin (a) * d;
+      y = object[i].y + cos (a) * d;
+      time = 6 + rand () % 6;
+      addpoint (x * 256, y * 256,
+		(object[hole].x - x) * 256 / time,
+		(object[hole].y - y) * 256 / time,
+		c + rand () % 16, time);
+    }
+}
+
