+/***********************************************************
+*                      K O U L E S                         *
+*----------------------------------------------------------*
+*  C1995 JAHUSOFT                                          *
+*        Jan Hubicka                                       *
+*----------------------------------------------------------*
+*   Copyright(c)1995,1996 by Jan Hubicka.See README for    *
+*                     licence details.                     *
+*----------------------------------------------------------*
+*  gl.c  8-bit software drawing into memory screens        *
+***********************************************************/
+#include "../koules.h"
+
+typedef unsigned char uchar;
+
+VScreenType     currentscreen;
+
+#define WIDTH MAPWIDTH
+#define HEIGHT (MAPHEIGHT + 20)
+#define PIXEL(x,y) (currentscreen->vbuf[(x) + (y) * WIDTH])
+
+void
+gl_setpixel (int x, int y, int c)
+{
+  if (x >= 0 && y >= 0 && x < WIDTH && y < HEIGHT)
+    PIXEL (x, y) = c;
+}
+
+void
+gl_hline (int x1, int y, int x2, int c)
+{
+  if (x1 > x2)
+    {
+      int             t = x1;
+      x1 = x2;
+      x2 = t;
+    }
+  if (y < 0 || y >= HEIGHT || x2 < 0 || x1 >= WIDTH)
+    return;
+  if (x1 < 0)
+    x1 = 0;
+  if (x2 >= WIDTH)
+    x2 = WIDTH - 1;
+  memset (&PIXEL (x1, y), c, x2 - x1 + 1);
+}
+
+void
+gl_fillbox (int x, int y, int w, int h, int c)
+{
+  if (x < 0)
+    w += x, x = 0;
+  if (y < 0)
+    h += y, y = 0;
+  if (x + w > WIDTH)
+    w = WIDTH - x;
+  if (y + h > HEIGHT)
+    h = HEIGHT - y;
+  if (w <= 0 || h <= 0)
+    return;
+  for (; h > 0; h--, y++)
+    memset (&PIXEL (x, y), c, w);
+}
+
+void
+gl_clearscreen (int c)
+{
+  memset (currentscreen->vbuf, c, WIDTH * HEIGHT);
+}
+
+void
+gl_line (int x1, int y1, int x2, int y2, int c)
+{
+  int             dx = abs (x2 - x1), dy = -abs (y2 - y1);
+  int             sx = x1 < x2 ? 1 : -1, sy = y1 < y2 ? 1 : -1;
+  int             err = dx + dy;
+  if ((x1 < 0 && x2 < 0) || (y1 < 0 && y2 < 0) ||
+      (x1 >= WIDTH && x2 >= WIDTH) || (y1 >= HEIGHT && y2 >= HEIGHT))
+    return;
+  for (;;)
+    {
+      int             e2;
+      gl_setpixel (x1, y1, c);
+      if (x1 == x2 && y1 == y2)
+	break;
+      e2 = 2 * err;
+      if (e2 >= dy)
+	err += dy, x1 += sx;
+      if (e2 <= dx)
+	err += dx, y1 += sy;
+    }
+}
+
+void
+gl_copyscreen (VScreenType source, VScreenType destination)
+{
+  memcpy (destination->vbuf, source->vbuf, WIDTH * HEIGHT);
+}
+
+/*
+ * Compiled bitmap format, one record per line:
+ * (<pixels to skip> <pixel count> <pixels>)* 0xff
+ * Pixel value 0 is transparent.
+ */
+char           *
+gl_compileboxmask (int w, int h, char *bitmap)
+{
+  uchar          *src = (uchar *) bitmap;
+  uchar          *out = malloc (w * h * 3 + h + 1), *p = out;
+  int             x, y;
+  if (out == NULL)
+    perror ("create_bitmap"), exit (1);
+  for (y = 0; y < h; y++)
+    {
+      x = 0;
+      while (x < w)
+	{
+	  int             skip = 0, count = 0;
+	  while (x < w && !src[x] && skip < 254)
+	    x++, skip++;
+	  if (x >= w)
+	    break;
+	  *p++ = skip;
+	  while (x + count < w && src[x + count] && count < 255)
+	    count++;
+	  *p++ = count;
+	  memcpy (p, src + x, count);
+	  p += count;
+	  x += count;
+	}
+      *p++ = 0xff;
+      src += w;
+    }
+  return (char *) out;
+}
+
+void
+gl_putboxmaskcompiled (int x0, int y0, int w, int h, char *bitmap)
+{
+  uchar          *dp = (uchar *) bitmap;
+  int             y;
+  (void) w;
+  for (y = y0; y < y0 + h; y++)
+    {
+      int             x = x0;
+      int             visible = y >= 0 && y < HEIGHT;
+      for (;;)
+	{
+	  int             count = *dp++;
+	  if (count == 0xff)
+	    break;
+	  x += count;
+	  count = *dp++;
+	  if (visible)
+	    {
+	      int             from = x < 0 ? -x : 0;
+	      int             to = x + count > WIDTH ? WIDTH - x : count;
+	      if (to > from)
+		memcpy (&PIXEL (x + from, y), dp + from, to - from);
+	    }
+	  x += count;
+	  dp += count;
+	}
+    }
+}
+
+void
+gl_expandfont (int fw, int fh, int fg, unsigned char *font, void *out)
+{
+  uchar          *f2 = out;
+  int             i, x, y, b = 0;
+  for (i = 0; i < 256; i++)
+    for (y = 0; y < fh; y++)
+      for (x = 0; x < fw; x++)
+	{
+	  if (x % 8 == 0)
+	    b = *font++;
+	  *f2++ = (b & (128 >> (x % 8))) ? fg : 0;
+	}
+}
+
+void
+gl_write (int x, int y, int mode, void *font, char *text)
+{
+  uchar          *glyphs = font;
+  for (; *text; text++, x += 8)
+    {
+      uchar          *g = glyphs + (uchar) * text * 64;
+      int             gx, gy;
+      for (gy = 0; gy < 8; gy++)
+	for (gx = 0; gx < 8; gx++, g++)
+	  if (*g || mode == WRITEMODE_OVERWRITE)
+	    gl_setpixel (x + gx, y + gy, *g);
+    }
+}
diff -ruN a/sdl/init.c b/sdl/init.c
--- a/sdl/init.c	1970-01-01 01:00:00.000000000 +0100
+++ b/sdl/init.c	2026-11-26 11:14:09.198902217 +0100
@@ -0,0 +1,414 @@
+/***********************************************************
+*                      K O U L E S                         *
+*----------------------------------------------------------*
+*  C1995 JAHUSOFT                                          *
+*        Jan Hubicka                                       *
+*----------------------------------------------------------*
+*   Copyright(c)1995,1996 by Jan Hubicka.See README for    *
+*                   licence details.                       *
+*----------------------------------------------------------*
+*  init.c SDL3 initialization, display, input and timing   *
+***********************************************************/
+#define PLATFORM_VARIABLES_HERE
+#include "../koules.h"
+#include "../framebuffer.h"
+#include <time.h>
+
+VScreenType     physicalscreen, backscreen, starbackground, background;
+void           *fontblack;
+void           *fontwhite;
+
+int             GAMEWIDTH = 640;
+int             GAMEHEIGHT = 460;
+int             MAPWIDTH = 640;
+int             MAPHEIGHT = 460;
+int             DIV = 1;
+
+int             mousex, mousey;
+unsigned int    mousebuttons;
+
+extern unsigned char gl_font8x8[];
+extern void     starwars ();
+extern void     game ();
+extern void     setcustompalette (CONST int, CONST float);
+
+static SDL_Window *window;
+static SDL_Renderer *renderer;
+static SDL_Texture *texture;
+static Uint32   palette32[256];
+static int      fullscreen;
+static int      idle;
+static Uint64   lastpresent;
+static Uint64   period = 40000000, deadline;
+static Uint8    keystate[SDL_SCANCODE_COUNT];
+
+static VScreenType
+allocatescreen (void)
+{
+  VScreenType     s = malloc (sizeof (GraphicsContext));
+  if (s == NULL || (s->vbuf = calloc (MAPWIDTH, MAPHEIGHT + 20)) == NULL)
+    perror ("allocatescreen"), exit (1);
+  return s;
+}
+
+static void
+present (void)
+{
+  void           *pixels;
+  int             pitch, x, y;
+  if (renderer == NULL)
+    return;
+  if (SDL_LockTexture (texture, NULL, &pixels, &pitch))
+    {
+      unsigned char  *src = (unsigned char *) physicalscreen->vbuf;
+      for (y = 0; y < MAPHEIGHT + 20; y++)
+	{
+	  Uint32         *row = (Uint32 *) ((Uint8 *) pixels + y * pitch);
+	  for (x = 0; x < MAPWIDTH; x++)
+	    row[x] = palette32[*src++];
+	}
+      SDL_UnlockTexture (texture);
+    }
+  SDL_SetRenderDrawColor (renderer, 0, 0, 0, 255);
+  SDL_RenderClear (renderer);
+  SDL_RenderTexture (renderer, texture, NULL, NULL);
+  SDL_RenderPresent (renderer);
+  lastpresent = SDL_GetTicksNS ();
+  idle = 1;
+}
+
+void
+gl_showscreen (VScreenType source)
+{
+  if (source != physicalscreen)
+    gl_copyscreen (source, physicalscreen);
+  present ();
+}
+
+void
+gl_waitretrace (void)
+{
+  Uint64          retrace = lastpresent + SDL_NS_PER_SECOND / 60 - 2 * SDL_NS_PER_MS;
+  Uint64          now = SDL_GetTicksNS ();
+  if (now < retrace)
+    SDL_DelayNS (retrace - now);
+}
+
+void
+gl_setpalette (Palette * pal)
+{
+  int             i;
+  for (i = 0; i < 256; i++)
+    {
+      int             r = pal->color[i].red & 63, g = pal->color[i].green & 63,
+                      b = pal->color[i].blue & 63;
+      palette32[i] = 0xff000000u | (Uint32) ((r << 2 | r >> 4) << 16) |
+	(Uint32) ((g << 2 | g >> 4) << 8) | (Uint32) (b << 2 | b >> 4);
+    }
+  present ();
+}
+
+void
+TimerStart (long usec)
+{
+  period = (Uint64) usec *1000;
+  deadline = SDL_GetTicksNS () + period;
+}
+
+int
+TimerOnTime (void)
+{
+  return SDL_GetTicksNS () <= deadline;
+}
+
+void
+TimerWait (void)
+{
+  Uint64          now = SDL_GetTicksNS ();
+  if (tbreak)
+    {
+      tbreak = 0;
+      deadline = now + period;
+    }
+  if (deadline > now)
+    SDL_DelayNS (deadline - now);
+  else if (now - deadline > SDL_NS_PER_SECOND / 4)
+    deadline = now;
+  deadline += period;
+  idle = 1;
+}
+
+int
+IsPressed (int scancode)
+{
+  return scancode > SDL_SCANCODE_UNKNOWN && scancode < SDL_SCANCODE_COUNT &&
+    keystate[scancode];
+}
+
+int
+Pressed (void)
+{
+  int             i;
+  for (i = SDL_SCANCODE_UNKNOWN + 1; i < SDL_SCANCODE_COUNT; i++)
+    if (keystate[i])
+      return 1;
+  return mousebuttons && mousex > 0 && mousey > 0 &&
+    mousex < MAPWIDTH && mousey < MAPHEIGHT;
+}
+
+int
+GetKey (void)
+{
+  int             i, key = 0;
+  for (i = SDL_SCANCODE_UNKNOWN + 1; i < SDL_SCANCODE_COUNT; i++)
+    if (keystate[i])
+      {
+	if (key)
+	  return 0;
+	key = i;
+      }
+  return key;
+}
+
+static void
+setfullscreen (int on)
+{
+  fullscreen = on;
+  SDL_SetWindowFullscreen (window, on);
+}
+
+void
+ProcessEvents (void)
+{
+  SDL_Event       e;
+  float           wx, wy, lx, ly;
+  SDL_MouseButtonFlags buttons;
+  int             i;
+  if (!idle)
+    SDL_WaitEventTimeout (NULL, 5);
+  idle = 0;
+  for (i = 0; i < SDL_SCANCODE_COUNT; i++)
+    keystate[i] &= 1;
+  while (SDL_PollEvent (&e))
+    switch (e.type)
+      {
+      case SDL_EVENT_QUIT:
+	uninitialize ();
+	exit (0);
+      case SDL_EVENT_KEY_DOWN:
+	if (e.key.scancode == SDL_SCANCODE_F11)
+	  {
+	    if (!e.key.repeat)
+	      setfullscreen (!fullscreen);
+	  }
+	else if (e.key.scancode < SDL_SCANCODE_COUNT)
+	  keystate[e.key.scancode] = 1;
+	break;
+      case SDL_EVENT_KEY_UP:
+	if (e.key.scancode < SDL_SCANCODE_COUNT && keystate[e.key.scancode] == 1)
+	  keystate[e.key.scancode] = 2;
+	break;
+      case SDL_EVENT_WINDOW_FOCUS_LOST:
+	if (gamemode == GAME)
+	  keystate[SDL_SCANCODE_PAUSE] = 2;
+	break;
+      case SDL_EVENT_WINDOW_EXPOSED:
+      case SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED:
+	present ();
+	break;
+      }
+  buttons = SDL_GetMouseState (&wx, &wy);
+  if (SDL_GetMouseFocus () == window &&
+      SDL_RenderCoordinatesFromWindow (renderer, wx, wy, &lx, &ly))
+    {
+      mousex = (int) lx;
+      mousey = (int) ly;
+      mousebuttons = (buttons & SDL_BUTTON_LMASK) != 0;
+    }
+  else
+    mousex = mousey = -1, mousebuttons = 0;
+}
+
+static void
+seticon (void)
+{
+  int             radius = 24, x, y, r;
+  SDL_Surface    *icon = SDL_CreateSurface (radius * 2, radius * 2, SDL_PIXELFORMAT_ARGB8888);
+  if (icon == NULL)
+    return;
+  for (y = 0; y < radius * 2; y++)
+    {
+      Uint32         *row = (Uint32 *) ((Uint8 *) icon->pixels + y * icon->pitch);
+      for (x = 0; x < radius * 2; x++)
+	{
+	  row[x] = 0;
+	  if ((x - radius) * (x - radius) + (y - radius) * (y - radius)
+	      < (radius - 0.5) * (radius - 0.5))
+	    {
+	      r = (x - 3 * radius / 4) * (x - 3 * radius / 4) +
+		(y - radius / 4) * (y - radius / 4);
+	      r = r * 32 / (1.5 * radius) / (1.5 * radius);
+	      if (r > 31)
+		r = 31;
+	      row[x] = palette32[4 * 32 + r];
+	    }
+	}
+    }
+  SDL_SetWindowIcon (window, icon);
+  SDL_DestroySurface (icon);
+}
+
+static void
+initialize (void)
+{
+  SDL_Rect        bounds;
+  int             scale = 1;
+  SDL_SetAppMetadata ("Koules", "1.4", "koules");
+  if (!SDL_Init (SDL_INIT_VIDEO | SDL_INIT_EVENTS))
+    {
+      fprintf (stderr, "SDL_Init: %s\n", SDL_GetError ());
+      exit (1);
+    }
+#ifdef SOUND
+  if (sndinit)
+    init_sound ();
+#endif
+  if (SDL_GetDisplayUsableBounds (SDL_GetPrimaryDisplay (), &bounds))
+    while ((scale + 1) * MAPWIDTH <= bounds.w &&
+	   (scale + 1) * (MAPHEIGHT + 20) + 64 <= bounds.h && scale < 4)
+      scale++;
+  if (!SDL_CreateWindowAndRenderer ("Koules", MAPWIDTH * scale, (MAPHEIGHT + 20) * scale,
+				    SDL_WINDOW_RESIZABLE | (fullscreen ? SDL_WINDOW_FULLSCREEN : 0),
+				    &window, &renderer))
+    {
+      fprintf (stderr, "SDL_CreateWindowAndRenderer: %s\n", SDL_GetError ());
+      exit (1);
+    }
+  SDL_SetWindowMinimumSize (window, MAPWIDTH / 2, (MAPHEIGHT + 20) / 2);
+  SDL_SetRenderVSync (renderer, 1);
+  SDL_SetRenderLogicalPresentation (renderer, MAPWIDTH, MAPHEIGHT + 20,
+				    SDL_LOGICAL_PRESENTATION_LETTERBOX);
+  texture = SDL_CreateTexture (renderer, SDL_PIXELFORMAT_XRGB8888,
+			       SDL_TEXTUREACCESS_STREAMING, MAPWIDTH, MAPHEIGHT + 20);
+  if (texture == NULL)
+    {
+      fprintf (stderr, "SDL_CreateTexture: %s\n", SDL_GetError ());
+      exit (1);
+    }
+#if SDL_VERSION_ATLEAST(3, 4, 0)
+  SDL_SetTextureScaleMode (texture, SDL_SCALEMODE_PIXELART);
+#else
+  SDL_SetTextureScaleMode (texture, SDL_SCALEMODE_NEAREST);
+#endif
+  SDL_HideCursor ();
+
+  physicalscreen = allocatescreen ();
+  backscreen = allocatescreen ();
+  background = allocatescreen ();
+  starbackground = allocatescreen ();
+  currentscreen = backscreen;
+  setcustompalette (0, 1);
+  seticon ();
+
+  fontblack = malloc (256 * 8 * 8);
+  fontwhite = malloc (256 * 8 * 8);
+  if (fontblack == NULL || fontwhite == NULL)
+    perror ("font"), exit (1);
+  gl_expandfont (8, 8, back (3), gl_font8x8, fontblack);
+  gl_expandfont (8, 8, 255, gl_font8x8, fontwhite);
+}
+
+void
+uninitialize ()
+{
+  static int      uninitialized = 0;
+  if (uninitialized)
+    return;
+  uninitialized = 1;
+#ifdef SOUND
+  if (sndinit)
+    kill_sound ();
+#endif
+  SDL_Quit ();
+}
+
+static void
+usage (const char *name)
+{
+  printf ("Usage: %s [options]\n"
+	  " -f  start in fullscreen mode (F11 toggles)\n"
+#ifdef SOUND
+	  " -d  disable sound\n"
+#endif
+	  " -M  disable mouse support\n"
+	  " -h  show this help\n", name);
+}
+
+int
+main (int argc, char **argv)
+{
+  int             c;
+  nrockets = 1;
+  while ((c = getopt (argc, argv, "fdMh")) != -1)
+    {
+      switch (c)
+	{
+	case 'f':
+	  fullscreen = 1;
+	  break;
+#ifdef SOUND
+	case 'd':
+	  sndinit = 0;
+	  break;
+#endif
+	case 'M':
+	  nomouse = 1;
+	  drawpointer = 0;
+	  break;
+	case 'h':
+	  usage (argv[0]);
+	  return 0;
+	default:
+	  usage (argv[0]);
+	  return 2;
+	}
+    }
+  srand (time (NULL));
+  create_bitmap ();
+  initialize ();
+#ifdef SOUND
+  sound = sndinit;
+#endif
+  gamemode = MENU;
+  drawbackground ();
+  drawstarbackground ();
+
+  keys[0][0] = SDL_SCANCODE_UP;
+  keys[0][1] = SDL_SCANCODE_DOWN;
+  keys[0][2] = SDL_SCANCODE_LEFT;
+  keys[0][3] = SDL_SCANCODE_RIGHT;
+
+  keys[1][0] = SDL_SCANCODE_W;
+  keys[1][1] = SDL_SCANCODE_S;
+  keys[1][2] = SDL_SCANCODE_A;
+  keys[1][3] = SDL_SCANCODE_D;
+
+  keys[2][0] = SDL_SCANCODE_I;
+  keys[2][1] = SDL_SCANCODE_K;
+  keys[2][2] = SDL_SCANCODE_J;
+  keys[2][3] = SDL_SCANCODE_L;
+
+  keys[3][0] = SDL_SCANCODE_KP_8;
+  keys[3][1] = SDL_SCANCODE_KP_5;
+  keys[3][2] = SDL_SCANCODE_KP_4;
+  keys[3][3] = SDL_SCANCODE_KP_6;
+
+  keys[4][0] = SDL_SCANCODE_HOME;
+  keys[4][1] = SDL_SCANCODE_END;
+  keys[4][2] = SDL_SCANCODE_DELETE;
+  keys[4][3] = SDL_SCANCODE_PAGEDOWN;
+  starwars ();
+  game ();
+  uninitialize ();
+  return 0;
+}
