diff -ruN a/sdl/sound.c b/sdl/sound.c
--- a/sdl/sound.c	1970-01-01 01:00:00.000000000 +0100
+++ b/sdl/sound.c	2026-11-26 11:01:40.296191607 +0100
@@ -0,0 +1,126 @@
+/***********************************************************
+*                      K O U L E S                         *
+*----------------------------------------------------------*
+*  C1995 JAHUSOFT                                          *
+*        Jan Hubicka                                       *
+*----------------------------------------------------------*
+*   Copyright(c)1995,1996 by Jan Hubicka.See README for    *
+*                   licence details.                       *
+*----------------------------------------------------------*
+*  sound.c sample playback with SDL3 audio streams         *
+***********************************************************/
+#include "../koules.h"
+
+#define NVOICES 8
+
+static const char *names[NSAMPLES] =
+{
+  "start.raw",
+  "end.raw",
+  "colize.raw",
+  "destroy1.raw",
+  "destroy2.raw",
+  "creator1.raw",
+  "creator2.raw"
+};
+
+static void    *samples[NSAMPLES];
+static size_t   sizes[NSAMPLES];
+static SDL_AudioDeviceID device;
+static SDL_AudioStream *voices[NVOICES];
+
+static void    *
+loadsample (const char *name, size_t * size)
+{
+  char            path[1024];
+  const char     *base;
+  void           *data;
+  SDL_snprintf (path, sizeof (path), "%s/%s", SOUNDDIR, name);
+  if ((data = SDL_LoadFile (path, size)) != NULL)
+    return data;
+  if ((base = SDL_GetBasePath ()) != NULL)
+    {
+      SDL_snprintf (path, sizeof (path), "%ssounds/%s", base, name);
+      if ((data = SDL_LoadFile (path, size)) != NULL)
+	return data;
+    }
+  fprintf (stderr, "koules: could not load sound %s\n", name);
+  return NULL;
+}
+
+void
+init_sound ()
+{
+  SDL_AudioSpec   spec = {SDL_AUDIO_U8, 1, 8010};
+  int             i;
+  if (!SDL_InitSubSystem (SDL_INIT_AUDIO))
+    {
+      fprintf (stderr, "koules: audio unavailable: %s\n", SDL_GetError ());
+      sndinit = 0;
+      return;
+    }
+  device = SDL_OpenAudioDevice (SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, NULL);
+  if (!device)
+    {
+      fprintf (stderr, "koules: could not open audio device: %s\n", SDL_GetError ());
+      sndinit = 0;
+      return;
+    }
+  for (i = 0; i < NVOICES; i++)
+    {
+      voices[i] = SDL_CreateAudioStream (&spec, NULL);
+      if (voices[i] == NULL)
+	{
+	  fprintf (stderr, "koules: SDL_CreateAudioStream: %s\n", SDL_GetError ());
+	  kill_sound ();
+	  sndinit = 0;
+	  return;
+	}
+      SDL_SetAudioStreamGain (voices[i], 0.5f);
+    }
+  if (!SDL_BindAudioStreams (device, voices, NVOICES))
+    {
+      fprintf (stderr, "koules: SDL_BindAudioStreams: %s\n", SDL_GetError ());
+      kill_sound ();
+      sndinit = 0;
+      return;
+    }
+  for (i = 0; i < NSAMPLES; i++)
+    samples[i] = loadsample (names[i], &sizes[i]);
+}
+
+int
+play_sound (int k)
+{
+  int             i, best = 0, bestqueued = -1;
+  if (!device || k < 0 || k >= NSAMPLES || samples[k] == NULL)
+    return 0;
+  for (i = 0; i < NVOICES; i++)
+    {
+      int             queued = SDL_GetAudioStreamQueued (voices[i]);
+      if (queued <= 0)
+	{
+	  best = i;
+	  break;
+	}
+      if (bestqueued < 0 || queued < bestqueued)
+	best = i, bestqueued = queued;
+    }
+  if (i == NVOICES)
+    SDL_ClearAudioStream (voices[best]);
+  SDL_PutAudioStreamData (voices[best], samples[k], (int) sizes[k]);
+  return 0;
+}
+
+void
+kill_sound ()
+{
+  int             i;
+  for (i = 0; i < NVOICES; i++)
+    if (voices[i] != NULL)
+      SDL_DestroyAudioStream (voices[i]), voices[i] = NULL;
+  if (device)
+    SDL_CloseAudioDevice (device), device = 0;
+  for (i = 0; i < NSAMPLES; i++)
+    SDL_free (samples[i]), samples[i] = NULL;
+}
