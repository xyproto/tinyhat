set pkgname libfabric
set pkgver 2.7.0
set pkgrel 1
set pkgdesc 'User-space API for OpenFabrics Interfaces (OFI)'
set arch i686 x32
set url https://ofiwg.github.io/libfabric/
set nvchecker source=git git=https://github.com/ofiwg/libfabric.git prefix=v 'exclude_regex=.*(pre|rc|alpha|beta).*'
set license 'BSD-2-Clause OR GPL-2.0-or-later'
set depends glibc numactl
set options '!lto'
set source https://github.com/ofiwg/libfabric/releases/download/v$pkgver/libfabric-$pkgver.tar.bz2
set sha512sums 1f1614aeb8fac2166ccc0e6dffb9c32704dbff7cbc4988126e5603280fc33f6b65d22cd29ae4fe16516999b5fb44be46b6f6ecd823e2bc2cc586d26242389c9e
set flags arch

function prepare
    cd $pkgname-$pkgver; or return
    autoreconf -fvi; or return
end

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr; or return
    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool; or return
    make; or return
end

function check
    cd $pkgname-$pkgver; or return
    make test; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
    install -vDm 644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"; or return
end
