set pkgname patch
set pkgver 2.8.1
set pkgrel 1
set pkgdesc 'A utility to apply patch files to original sources'
set arch i686 x32
set url https://www.gnu.org/software/patch/
set nvchecker source=git git=https://git.savannah.gnu.org/git/patch.git prefix=v
set license GPL-3.0-or-later
set depends glibc attr
# From the release tarball: Arch builds from git with ./bootstrap (autoconf, automake, makeinfo)
set makedepends ed
set optdepends 'ed: for patch -e functionality'
set flags arch
set source "https://ftp.gnu.org/gnu/patch/patch-$pkgver.tar.xz"
set sha256sums 3240c7959c5347c8ed347e3c4201c0337bf4240d5cf09d68889e58eeaba30e17

function build
    cd $pkgname-$pkgver; or return
    ./configure --prefix=/usr; or return
    make; or return
end

function check
    cd $pkgname-$pkgver; or return
    make check; or return
end

function package
    cd $pkgname-$pkgver; or return
    make DESTDIR="$pkgdir" install; or return
end
