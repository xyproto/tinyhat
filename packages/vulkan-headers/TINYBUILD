set pkgname vulkan-headers
set pkgver 1.4.363.0
set pkgrel 1
set epoch 1
set pkgdesc 'Vulkan header files and API registry'
set arch any
set url https://www.vulkan.org/
set nvchecker source=git git=https://github.com/KhronosGroup/Vulkan-Headers.git 'include_regex=vulkan-sdk-\d+(\.\d+)*' prefix=vulkan-sdk-
set license 'Apache-2.0 OR MIT'
set groups vulkan-devel
set makedepends cmake ninja
set optdepends 'python: Registry tools'
set provides "vulkan-hpp=$pkgver"
set source "https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/vulkan-sdk-$pkgver.tar.gz"
set sha256sums 4a078be12bef21cfebc09d878b77a63cff9d68f899254a0b00d0e37ef73e7f7e
set flags arch

function build
    set -l cmake_options -D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_INSTALL_SYSCONFDIR=/etc -D CMAKE_SKIP_INSTALL_RPATH=ON
    cmake -S Vulkan-Headers-vulkan-sdk-$pkgver -B build -G Ninja $cmake_options; or return
    cmake --build build; or return
end

function package
    DESTDIR="$pkgdir" cmake --install build; or return
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" Vulkan-Headers-vulkan-sdk-$pkgver/LICENSES/MIT.txt; or return
end
