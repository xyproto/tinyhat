+int
+snapbox(double x, double y, struct wlr_box *box)
+{
+	Monitor *m = xytomon(x, y);
+	int l, r, t, b, hw, hh, g = gappx;
+
+	if (!m)
+		return 0;
+	l = x < m->m.x + snapedge;
+	r = x >= m->m.x + m->m.width - snapedge;
+	t = y < m->m.y + snapedge;
+	b = y >= m->m.y + m->m.height - snapedge;
+	if (l || r) {
+		t = t || y < m->m.y + snapcorner;
+		b = b || y >= m->m.y + m->m.height - snapcorner;
+	} else if (t || b) {
+		l = x < m->m.x + snapcorner;
+		r = x >= m->m.x + m->m.width - snapcorner;
+	}
+	if (l == r && t == b)
+		return 0;
+
+	hw = (m->w.width - 3 * g) / 2;
+	hh = (m->w.height - 3 * g) / 2;
+	box->x = m->w.x + g;
+	box->width = m->w.width - 2 * g;
+	box->y = m->w.y + g;
+	box->height = m->w.height - 2 * g;
+	if (l != r) {
+		box->x = l ? m->w.x + g : m->w.x + 2 * g + hw;
+		box->width = l ? hw : m->w.width - 3 * g - hw;
+	}
+	if (t != b) {
+		box->y = t ? m->w.y + g : m->w.y + 2 * g + hh;
+		box->height = t ? hh : m->w.height - 3 * g - hh;
+	}
+	return 1;
+}
+
+void
+snappreview(void)
+{
+	struct wlr_box b;
+	int bw = (int)borderpx;
+
+	if (cursor_mode != CurMove || !grabc || !snapbox(cursor->x, cursor->y, &b)) {
+		wlr_scene_node_set_enabled(&snapframe->node, 0);
+		return;
+	}
+	wlr_scene_node_set_position(&snapframe->node, b.x, b.y);
+	wlr_scene_rect_set_size(snaprects[0], b.width, b.height);
+	wlr_scene_rect_set_size(snaprects[1], b.width, bw);
+	wlr_scene_rect_set_size(snaprects[2], b.width, bw);
+	wlr_scene_node_set_position(&snaprects[2]->node, 0, b.height - bw);
+	wlr_scene_rect_set_size(snaprects[3], bw, b.height);
+	wlr_scene_rect_set_size(snaprects[4], bw, b.height);
+	wlr_scene_node_set_position(&snaprects[4]->node, b.width - bw, 0);
+	wlr_scene_node_reparent(&snapframe->node, grabc->scene->node.parent);
+	wlr_scene_node_place_above(&snapframe->node, &grabc->scene->node);
+	wlr_scene_node_set_enabled(&snapframe->node, 1);
+}
