 void
+taskhover(void)
+{
+	Monitor *m;
+	int hover, cx;
+
+	wl_list_for_each(m, &mons, link) {
+		hover = 0;
+		if (m->scene_buffer->node.enabled && cursor->x >= m->m.x && cursor->x < m->m.x + m->m.width
+				&& cursor->y >= m->m.y + (topbar ? 0 : m->m.height - m->b.real_height)
+				&& cursor->y < m->m.y + (topbar ? m->b.real_height : m->m.height)) {
+			cx = (int)((cursor->x - m->m.x) * m->wlr_output->scale);
+			for (int i = 0; i < m->ntasks; i++)
+				if (cx >= m->taskx[i] && cx < m->taskx[i + 1])
+					hover = i + 1;
+		}
+		if (hover != m->taskhover) {
+			m->taskhover = hover;
+			drawbar(m);
+		}
+	}
+}
