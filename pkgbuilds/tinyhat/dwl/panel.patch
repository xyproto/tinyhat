 void
+drawlayout(Monitor *m, int x, int w)
+{
+	int s = m->b.height * 9 / 16, ix = x + (w - s) / 2, iy = (m->b.height - s) / 2;
+	int t = MAX(2, s / 5), ws = s * 2 / 3, hw = (s - 1) / 2, n = 2;
+	int win[4][4] = {{ix, iy, ws, ws}, {ix + s - ws, iy + s - ws, ws, ws}};
+
+	drwl_setscheme(m->drw, colors[SchemeNorm]);
+	drwl_rect(m->drw, x, 0, w, m->b.height, 1, 1);
+	if (m->lt[m->sellt]->arrange) {
+		n = 4;
+		t = MAX(1, hw / 3);
+		for (int i = 0; i < 4; i++) {
+			win[i][0] = ix + (i % 2) * (s - hw);
+			win[i][1] = iy + (i / 2) * (s - hw);
+			win[i][2] = win[i][3] = hw;
+		}
+	}
+	for (int i = 0; i < n; i++) {
+		drwl_rect(m->drw, win[i][0], win[i][1], win[i][2], win[i][3], 1, 1);
+		drwl_rect(m->drw, win[i][0], win[i][1], win[i][2], win[i][3], 0, 0);
+		drwl_rect(m->drw, win[i][0], win[i][1], win[i][2], t, 1, 0);
+	}
+}
