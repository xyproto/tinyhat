 void
+drawtasks(Monitor *m, int x, int w)
+{
+	Client *t, *sel = focustop(m);
+	int n = 0, bw, pad = m->b.height / 8 + 1;
+	char label[256];
+
+	drwl_setscheme(m->drw, colors[SchemeNorm]);
+	drwl_rect(m->drw, x, 0, w, m->b.height, 1, 1);
+	wl_list_for_each_reverse(t, &clients, link)
+		if (t->mon == m && (t->tags & m->tagset[m->seltags]) && n < (int)LENGTH(m->tasks))
+			m->tasks[n++] = t;
+	m->ntasks = n;
+	if (!n)
+		return;
+	bw = MIN(w / n, m->b.height * 10);
+	for (int i = 0; i < n; i++) {
+		t = m->tasks[i];
+		m->taskx[i] = x + i * bw;
+		snprintf(label, sizeof(label), t->isminimized ? "[%s]" : "%s", client_get_title(t));
+		drwl_setscheme(m->drw, colors[t == sel && !t->isminimized ? SchemeSel : SchemeNorm]);
+		drwl_text(m->drw, m->taskx[i] + pad, pad, bw - 2 * pad, m->b.height - 2 * pad, m->lrpad / 2, label, 0);
+		if (t != sel || t->isminimized)
+			drwl_rect(m->drw, m->taskx[i] + pad, pad, bw - 2 * pad, m->b.height - 2 * pad, 0, 0);
+	}
+	m->taskx[n] = x + n * bw;
+}
