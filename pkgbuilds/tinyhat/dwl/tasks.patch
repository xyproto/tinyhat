 void
+minimize(const Arg *arg)
+{
+	Client *c = focustop(selmon);
+	if (!c)
+		return;
+	if (c->isfullscreen)
+		setfullscreen(c, 0);
+	c->isminimized = 1;
+	arrange(selmon);
+	focusclient(focustop(selmon), 1);
+	drawbars();
+}
+
+void
+showdesktop(const Arg *arg)
+{
+	Client *c;
+	int shown = 0;
+	if (!selmon)
+		return;
+	wl_list_for_each(c, &clients, link)
+		if (c->mon == selmon && (c->tags & selmon->tagset[selmon->seltags]) && !c->isminimized)
+			shown = 1;
+	wl_list_for_each(c, &clients, link) {
+		if (c->mon != selmon || !(c->tags & selmon->tagset[selmon->seltags]))
+			continue;
+		if (shown && !c->isminimized) {
+			if (c->isfullscreen)
+				setfullscreen(c, 0);
+			c->isminimized = c->desktophidden = 1;
+		} else if (!shown && c->desktophidden) {
+			c->isminimized = c->desktophidden = 0;
+		}
+	}
+	arrange(selmon);
+	focusclient(focustop(selmon), 1);
+	drawbars();
+}
+
+void
+taskclick(const Arg *arg)
+{
+	Client *c, *t = NULL;
+	wl_list_for_each(c, &clients, link)
+		if (c == arg->v)
+			t = c;
+	if (!t)
+		return;
+	if (t == focustop(t->mon) && !t->isminimized) {
+		minimize(arg);
+		return;
+	}
+	t->isminimized = t->desktophidden = 0;
+	selmon = t->mon;
+	arrange(t->mon);
+	focusclient(t, 1);
+	drawbars();
+}
