prepare() {
  rm -rf tic80
  mkdir tic80
  tar --no-same-owner -xf tic80-$pkgver.tar.gz -C tic80 --strip-components=1
  cd tic80
  for m in "${_vendor[@]}"; do
    mkdir -p "vendor/${m%-*}"
    tar --no-same-owner -xf "../tic80-$m.tar.gz" --strip-components=1 -C "vendor/${m%-*}"
  done
  sed -i 's/if(BUILD_STATIC AND NOT USE_GLES2)/if(BUILD_STATIC AND NOT USE_GLES2 AND NOT PREFER_SYSTEM_SDL2)/' cmake/sdl.cmake
}

build() {
  CFLAGS="$CFLAGS -fno-pie"
  LDFLAGS="$LDFLAGS -no-pie"
  export CFLAGS LDFLAGS
  cmake -S tic80 -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_STATIC=ON -DCMAKE_POSITION_INDEPENDENT_CODE=OFF \
    -DBUILD_WITH_ALL=OFF -DBUILD_WITH_LUA=ON -DBUILD_WITH_FENNEL=ON -DPREFER_SYSTEM_SDL2=ON \
    -DBUILD_SDLGPU=OFF -DBUILD_SURF=OFF -DBUILD_PLAYER=OFF -DBUILD_STUB=OFF
  ninja -C build
}

package() {
  install -Dm755 build/bin/tic80 "$pkgdir/usr/lib/tic80/tic80"
  mkdir -p "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec tinyhat-gpu /usr/lib/tic80/tic80 "$@"\n' >"$pkgdir/usr/bin/tic80"
  chmod 755 "$pkgdir/usr/bin/tic80"
  local l="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 tic80/LICENSE "$l/LICENSE"
  install -Dm644 tic80/vendor/argparse/LICENSE "$l/LICENSE.argparse"
  install -Dm644 tic80/vendor/blip-buf/license.txt "$l/LICENSE.blip-buf"
  install -Dm644 tic80/vendor/giflib/COPYING "$l/LICENSE.giflib"
  install -Dm644 tic80/vendor/jsmn/LICENSE "$l/LICENSE.jsmn"
  install -Dm644 tic80/vendor/libpng/LICENSE "$l/LICENSE.libpng"
  install -Dm644 tic80/vendor/lua/lua.h "$l/LICENSE.lua.h"
  install -Dm644 tic80/vendor/naett/LICENSE "$l/LICENSE.naett"
  install -Dm644 tic80/vendor/zip/LICENSE.txt "$l/LICENSE.zip"
  install -Dm644 tic80/vendor/zlib/LICENSE "$l/LICENSE.zlib"
}
