pkgname=tic-80
pkgver=1.3.1
pkgrel=1
pkgdesc="TIC-80 fantasy console with Lua and Fennel"
arch=(i686 x32)
url="https://tic80.com/"
license=(MIT LGPL-2.1-or-later Libpng Zlib Unlicense)
depends=(sdl2-compat)
makedepends=(cmake ninja)
_vendor=(argparse-0d5f5d07 blip-buf-330226d9 giflib-1aa11b06 jsmn-25647e69 libpng-ed217e3e lua-75ea9ccb naett-10a96244 zip-296ff242 zlib-51b7f2ab)
source=("tic80-$pkgver.tar.gz::https://github.com/nesbox/TIC-80/archive/refs/tags/v$pkgver.tar.gz"
