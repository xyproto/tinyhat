        "tic80-zlib-51b7f2ab.tar.gz::https://github.com/madler/zlib/archive/51b7f2abdade71cd9bb0e7a373ef2610ec6f9daf.tar.gz")
noextract=("${source[@]%%::*}")
sha256sums=('e99f26ba4b1cbad16bb1455bd14905bd912f13786b2f897e97733563c0475fe0'
            'b14cfe4b95a4cd1cf148eeecf0dba94ebf5b4312de12f5f5254e7040017477f1'
