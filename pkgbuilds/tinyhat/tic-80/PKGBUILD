        "tic80-blip-buf-330226d9.tar.gz::https://github.com/nesbox/blip-buf/archive/330226d9b55ecbeea644e17b5e0f096a165ca07e.tar.gz"
        "tic80-giflib-1aa11b06.tar.gz::https://github.com/nesbox/giflib/archive/1aa11b06d0025eda77b56aec8254130654d4397b.tar.gz"
