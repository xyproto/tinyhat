pkgname=pure-fish
pkgver=4.19.2
pkgrel=1
pkgdesc="Pretty, minimal and fast fish prompt"
arch=(any)
url="https://github.com/pure-fish/pure"
license=(MIT)
depends=(fish)
source=("pure-fish-$pkgver.tar.gz::https://github.com/pure-fish/pure/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('3d42523b48d92a83861257f902ff4c8c39ee7ee80d8da51d22b6ad5e1ad091d4')

package() {
  install -d "$pkgdir/etc/fish/conf.d" \
    "$pkgdir/etc/fish/functions" \
    "$pkgdir/usr/share/licenses/$pkgname"
  install -m644 pure-$pkgver/conf.d/*.fish "$pkgdir/etc/fish/conf.d/"
  install -m644 pure-$pkgver/functions/*.fish "$pkgdir/etc/fish/functions/"
  install -m644 pure-$pkgver/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
