pkgname=raylib
pkgver=6.2
pkgrel=1
pkgdesc="raylib 6.0 on SDL3 and OpenGL 2.1"
arch=(i686 x32)
url="https://www.raylib.com/"
license=(Zlib)
depends=(sdl3)
makedepends=(cmake ninja mesa libglvnd)
source=("raylib-$pkgver.tar.gz::https://github.com/raysan5/raylib/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('df7a13129b1bec9e73a6962efff170beba310ee6eab8f94cd000b7316b4db5ee')

build() {
  cmake -S raylib-$pkgver -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DPLATFORM=SDL -DOPENGL_VERSION=2.1 -DBUILD_SHARED_LIBS=ON -DBUILD_EXAMPLES=OFF
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 raylib-$pkgver/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
