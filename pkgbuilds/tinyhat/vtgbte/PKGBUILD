pkgname=vtgbte
_commit=1a9f460390f0e8c7ab32dd7df0f125ad23d405a9
pkgver=0+1a9f4603
pkgrel=1
pkgdesc="Keyboard-driven Game Boy tile editor for the terminal"
arch=(i686 x32)
url="https://github.com/paul-arutyunov/vtGBte"
license=(MIT)
depends=(ncurses)
source=("vtGBte-$_commit.tar.gz::https://github.com/paul-arutyunov/vtGBte/archive/$_commit.tar.gz")
sha256sums=('9d9c61b9ae3bb0ef50b4c4ec383d55ab5ca7190be6030c37729feb7f66591a1c')

build() {
  cd vtGBte-$_commit
  make CC=cc CFLAGS="$CFLAGS -I." LDFLAGS="$LDFLAGS"
}

package() {
  cd vtGBte-$_commit
  install -Dm755 gbt "$pkgdir/usr/bin/vtgbte"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
