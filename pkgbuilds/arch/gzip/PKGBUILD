# Contributor: judd <jvinet@zeroflux.org>

pkgname=gzip
pkgver=1.15
pkgrel="1"
pkgdesc='GNU compression utility'
arch=(i686 x32)
url='https://www.gnu.org/software/gzip/'
license=('GPL-3.0-or-later')
depends=('glibc' 'sh' 'coreutils' 'sed')
makedepends=('git' 'less' 'python' 'wget')
optdepends=('diffutils: zdiff/zcmp support'
            'grep: zegrep/zfgrep/zforce/zgrep support'
            'less: zless support'
            'util-linux: zmore support')
validpgpkeys=('155D3FC500C834486D1EEA677FD9FCCB000BEEEE') # Jim Meyering <jim@meyering.net>
source=("git+https://git.savannah.gnu.org/git/gzip.git?signed#tag=v${pkgver}"
        "git+https://git.savannah.gnu.org/git/gnulib.git")
sha256sums=('1496b08cdd5320634b59860b09c6c5048ebb04b32a723fa39a3652f08102e2ba'
            'SKIP')

prepare() {
  cd "${pkgname}"

  git submodule init
  git config submodule.gnulib.url "${srcdir}/gnulib"
  git -c protocol.file.allow=always submodule update

  ./bootstrap
}

build() {
  cd "${pkgname}"
  ./configure \
    --prefix=/usr \
    --disable-gcc-warnings
  make
}

check() {
  cd "${pkgname}"
  make check
}

package() {
  cd "${pkgname}"
  make DESTDIR="${pkgdir}" install
}

makedepends=($(printf '%s\n' "${makedepends[@]}" | grep -v -x -e git -e wget -e texinfo))
source=("https://ftp.gnu.org/gnu/${pkgname}/${pkgname}-${pkgver}.tar.xz")
unset b2sums
sha256sums=('9aa0cc780dec156b8282844833b342ab7cb08c25d2cd9a1869cdd0df31deff48')
prepare() { :; }
eval "$(
  declare -f build check package | sed -E 's/cd "?\$\{?pkgname\}?"?;?$/cd "${pkgname}-${pkgver}"/'
)"

unset -f pkgver
