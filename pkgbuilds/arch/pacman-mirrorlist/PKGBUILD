sha256sums=('868eb0a40b0dd0808a04e58c48f51c35990131f1e8092de5a4c6654be08be643')
md5sums=('5e3b5914765e40fdef5079d3db83e3ff')
b2sums=('d135896c6b0717c748aefafb1607da88111ab45d034196d33a5efe71690aabc2c34271cd63bae856c3aa52f1a6ac2cbe0491a57137226702b181029408be4489')

unset -f pkgver
