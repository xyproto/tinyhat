# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=tslib
pkgver=1.24
pkgrel="1"
pkgdesc="Touchscreen Access Library"
arch=(i686 x32)
url="https://github.com/kergoth/tslib"
license=(LGPL-2.1-only)
depends=(glibc)
makedepends=(git)
source=(git+https://github.com/kergoth/tslib#tag=$pkgver?signed)
sha256sums=('28f8be6333243dae15ef097ac0a16509003794aef038577b800f2fd2a0782387')
validpgpkeys=(F2082B880F9E423934686E3F500398DF5AB387D3) # Martin Kepplinger <martink@posteo.de>

prepare() {
  cd $pkgname
  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}

# Ignore pgp for now as it seems to fail with unknown pubkey (it's the correct one)
if [[ $pkgver == "1.23" ]]; then
  unset source[1]
  unset sha256sums[1]
fi

unset -f pkgver
