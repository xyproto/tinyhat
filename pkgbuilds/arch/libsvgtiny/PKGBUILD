# Maintainer: Alexander F. Rødseth <xyproto@archlinux.org>

pkgname=libsvgtiny
pkgver=0.1.8
pkgrel="2"
pkgdesc='SVG Tiny library'
arch=(i686 x32)
url='https://www.netsurf-browser.org/projects/libsvgtiny/'
license=(MIT)
makedepends=(gperf libdom libwapcaplet netsurf-buildsystem)
depends=('libdom>=0.4.2')
source=("https://download.netsurf-browser.org/libs/releases/libsvgtiny-$pkgver-src.tar.gz")
b2sums=('846ff04efe2f1a696ae43826233ee8ff9a348e3e816792294aab865db70f72b122e5da71ffe88eae3282483f3d932305970d305d7740826bb8f692584cbeb30b')

prepare() {
  sed -i 's:_BSD_SOURCE:_DEFAULT_SOURCE:' $pkgname-$pkgver/Makefile
}

build() {
  export CFLAGS="$CFLAGS -shared -fPIC -w"
  export LDFLAGS="$LDFLAGS -shared"
  make -C $pkgname-$pkgver COMPONENT_TYPE=lib-shared INCLUDEDIR=include LIBDIR=lib PREFIX=/usr
}

package() {
  make -C $pkgname-$pkgver COMPONENT_TYPE=lib-shared DESTDIR="$pkgdir" INCLUDEDIR=include LIBDIR=lib PREFIX=/usr install
  install -Dm644 $pkgname-$pkgver/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}

unset -f pkgver
