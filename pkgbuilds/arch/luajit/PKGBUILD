pkgname=luajit
pkgver=2.1.1792349434+dd3b243
_commit=${pkgver##*+}
pkgrel="1"
pkgdesc='Just-in-time compiler and drop-in replacement for Lua 5.1'
arch=(i686)
url='https://luajit.org/'
license=('MIT')
depends=('glibc' 'libgcc')
source=("LuaJIT-${_commit}.tar.gz::https://github.com/LuaJIT/LuaJIT/archive/${_commit}.tar.gz")
sha256sums=('a6ac8457c474c6fb71aaa7660dd5bf8f6e0506496fc74786b2dae18e26a768cc')
b2sums=('d7d6b358668be45e50ee139f8e244a2625cbcd63f95677d4709e4f38a4753181edeff764a53421dc741f00787e4385d315a78dd3cd8852e2f19c7595d8cd62db')

build() {
  cd "LuaJIT-${_commit}"*/

  # Avoid early stripping
  make amalg PREFIX=/usr BUILDMODE=dynamic TARGET_STRIP=" @:"
}

check() {
  cd "LuaJIT-${_commit}"*/

  # Make sure that pkgver matches packaged commit
  local _ct=${pkgver##*.}
  test "${_ct%%+*}" == "$(cat .relver)"
}

package() {
  cd "LuaJIT-${_commit}"*/

  make install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
}

if [ "$CARCH" = 'i486' ]; then
  source+=('luajit-2.0-505e2c0-i486.patch')
  b2sums+=('4a467db526fa550942dee7da7dd599f5976f519573773afab74c372bbb2aa243d60384699c50695dadf0be086fc5b54253692d0836c22da4b079a73b0eb7a822')
  prepare() {
    cd "LuaJIT-${_commit}"
    patch -p1 -i "$srcdir/luajit-2.0-505e2c0-i486.patch"
  }
fi

if [ "$CARCH" = 'i686' ]; then
  source+=('c7815e1a1b49871e645252bb12e722fb4879df11.patch')
  b2sums+=('fabd0be78309d8211e96d4d0cf105ae6a27f46110d8b19513d10bdd7c6045221fc5c8e21d1bcc1def854d7d1bf6473c99fb7bc7e4d5307188129c3c87cf8c69b')
  prepare() {
    cd "LuaJIT-${_commit}"
    patch -p1 -i "$srcdir/c7815e1a1b49871e645252bb12e722fb4879df11.patch"
  }
fi

unset md5sums
unset sha256sums

eval "$(declare -f prepare | sed 's|cd "LuaJIT-${_commit}";|cd "LuaJIT-${_commit}"*/;|')"

unset -f pkgver
