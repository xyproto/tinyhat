pkgname=pkgconf
pkgver=2.5.1
pkgrel=1
pkgdesc="Package compiler and linker metadata toolkit"
url="https://github.com/pkgconf/pkgconf"
license=(ISC)
arch=(i486 i686 pentium4 x86_64)
depends=(
  glibc
)
makedepends=(
  git
  meson
)
provides=(
  libpkgconf.so
  pkg-config
  pkgconfig
)
conflicts=(pkg-config)
replaces=(pkg-config)
source=(
  "git+$url#tag=pkgconf-$pkgver"
  {x86_64,i686}-pc-linux-gnu.personality
)
b2sums=('d0dedc79397bb4ccf9b8c117fd8aa72cb22ef1ae45fd45748a8befe18ece31fe21d39010751806c0bad0ad8ce1a3d9c6750b67ac8378361c336e21a3d4a23073'
        'c04583e19149c1035cb7777a59f0fbc4988b672d8e45105e33def3d0f9054464e33a400a3e7c7e8b99b334e4fe06aaa9d7e34662e806096d4374bd6b12d803db'
        '94c8fd12b5f33611fd6dbeae03b20e72bcf2937e764766e2633b2fd4c14925860d57eee234016c81b0563a47b112ac9ef4a8b3bb9fa3fc0dd266f355bc156c58')

prepare() {
  cd pkgconf
}

build() {
  local meson_options=(
    -D tests=disabled  # Tests need kyua
  )

  arch-meson pkgconf build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  local p
  for p in *.personality; do
    install -Dm644 "$p" -t "$pkgdir/usr/share/pkgconfig/personality.d"
    ln -s pkgconf "$pkgdir/usr/bin/${p%.*}-pkg-config"
  done

  ln -s pkgconf "$pkgdir/usr/bin/pkg-config"
  ln -s pkgconf.1 "$pkgdir/usr/share/man/man1/pkg-config.1"

  install -Dm644 pkgconf/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}

# vim:set sw=2 sts=-1 et:

# -- Arch32
# doesn't work, use PKGBUILD-with-autoconf
# this version here buidls, but libpkgconf.so is missing for instance

# use muon instead of meson, no python (and meson needs python)
makedepends=(${makedepends[@]//meson/})
makedepends+=(muon-meson)
makedepends+=(ninja)

eval "$(
  declare -f build | \
    sed '
      /local meson_options.*/ a \
          meson_options+=(-D prefix=/usr)
      s/arch-meson pkgconf \(.*\)/muon meson configure pkgconf \1/g
      s/meson compile \(.*\)/ninja -C pkgconf\/build/g
    '
  declare -f package | \
    sed '
      s|meson install.*|cd pkgconf/build; muon install -d "$pkgdir"; cd ../..|
    '
)"

source+=(muon-cdata.patch)
b2sums+=(dc3b9ed47efbed09ec2dc590dcdf2b384e5853c90a99f7ed363f73ef59cbd4273f6771eb5496c639b1622decc16560e1d15bd9f5d4b63694bc1118c076be5a88)

eval "$(
  declare -f prepare | \
    sed '
      /cd pkgconf/ a \
        patch -p1 -i ../muon-cdata.patch
    '
)"

unset check
unset checkdepends
