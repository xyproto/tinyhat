pkgname=pkgconf
pkgver=3.0.10
pkgrel="1"
pkgdesc="Package compiler and linker metadata toolkit"
url="https://github.com/pkgconf/pkgconf"
license=(ISC)
arch=(i686 x32)
depends=(
  glibc
)
makedepends=(
  git
  meson
)
provides=(
  libpkgconf.so
  pkg-config
  pkgconfig
)
conflicts=(pkg-config)
replaces=(pkg-config)
source=(
  "git+$url#tag=pkgconf-$pkgver"
  {x86_64,i686}-pc-linux-gnu.personality
)
b2sums=('724d41c5735dcf0763d376c6a1a813ca018bc4a9afeeaf391f41c364aca4f7ff42da22255eac0c947ed31da6798c1e3e3ff739c4f991010e489432397e969fd7'
        'c04583e19149c1035cb7777a59f0fbc4988b672d8e45105e33def3d0f9054464e33a400a3e7c7e8b99b334e4fe06aaa9d7e34662e806096d4374bd6b12d803db'
        '94c8fd12b5f33611fd6dbeae03b20e72bcf2937e764766e2633b2fd4c14925860d57eee234016c81b0563a47b112ac9ef4a8b3bb9fa3fc0dd266f355bc156c58')

prepare() {
  cd pkgconf
}

build() {
  local meson_options=(
  )

  arch-meson pkgconf build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  local p
  for p in *.personality; do
    install -Dm644 "$p" -t "$pkgdir/usr/share/pkgconfig/personality.d"
    ln -s pkgconf "$pkgdir/usr/bin/${p%.*}-pkg-config"
  done

  ln -s pkgconf "$pkgdir/usr/bin/pkg-config"
  ln -s pkgconf.1 "$pkgdir/usr/share/man/man1/pkg-config.1"

  install -Dm644 pkgconf/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}

# vim:set sw=2 sts=-1 et:

# -- Arch32 specific --

# use i686 personality as main personality, no lib32, no 64-bit

source=(${source[@]//x86_64-pc-linux-gnu.personality/})
b2sums=(${b2sums[@]//c04583e19149c1035cb7777a59f0fbc4988b672d8e45105e33def3d0f9054464e33a400a3e7c7e8b99b334e4fe06aaa9d7e34662e806096d4374bd6b12d803db/})
b2sums[1]='b44d82b4c4fd32eeed11a3e5a5ab7331f27467d0f83c118eb381d872cc41a1d69e00605a598a35e9288edf5e8fdadaebfff4bd83131506665c7ab94ef7a678a3'

eval "$(
  declare -f package | \
    sed 's@{x86_64,i686}@i686@'
)"

unset -f pkgver
