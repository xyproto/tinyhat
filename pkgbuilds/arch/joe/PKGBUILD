pkgname=joe
pkgver=4.8
pkgrel="1"
pkgdesc='Classic text editor' # Joe's Own Editor, since 1988
arch=(i686 x32)
url='https://joe-editor.sourceforge.io/'
license=(GPL-2.0-or-later)
makedepends=(git)
depends=(glibc ncurses)
optdepends=('gpm: console mouse support')
backup=('etc/joe/ftyperc' 'etc/joe/jicerc.ru' 'etc/joe/jmacsrc'
        'etc/joe/joerc' 'etc/joe/jpicorc' 'etc/joe/jstarrc' 'etc/joe/rjoerc')
source=("git+https://github.com/joe-editor/joe#tag=releases/joe-$pkgver")
b2sums=('fb6e6ce5867dad323464b72f555b45a65c374bb64f178fe9d4de8963ff1b783811b81383151da482e3b6a942bbd1a66485c03774bd0a6edffa463d6c39b1d702')

build() {
  cd $pkgname
  ./autojoe
  ./configure --mandir=/usr/share/man --prefix=/usr --sysconfdir=/etc
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}

unset -f pkgver
