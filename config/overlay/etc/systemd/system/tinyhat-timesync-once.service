[Unit]
Description=Stop the time sync service once the clock has been set
After=systemd-timesyncd.service
Wants=systemd-timesyncd.service

[Service]
Type=simple
ExecStart=/bin/sh -c '/usr/lib/systemd/systemd-time-wait-sync && { hwclock --systohc; exec systemctl stop systemd-timesyncd.service; }'

[Install]
WantedBy=multi-user.target
