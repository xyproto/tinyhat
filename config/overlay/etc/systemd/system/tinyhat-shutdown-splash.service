[Unit]
Description=Show the Tiny Hat shutdown splash
DefaultDependencies=no
After=getty@tty1.service tinyhat-shutdown-sound.service
Before=systemd-poweroff.service systemd-reboot.service systemd-halt.service
ConditionKernelCommandLine=quiet

[Service]
Type=forking
ExecStart=@/usr/bin/tinyhat-splash @tinyhat-splash --shutdown

[Install]
WantedBy=poweroff.target reboot.target halt.target
