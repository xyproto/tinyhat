# The Tiny Hat in CHIP-8. Move the hat with W A S D or the arrow keys.
# Press Ctrl+Space twice in rapid succession to assemble and run it with octo-run.

: hat
  0x3C 0x3C 0x3C 0x3C 0xFF 0xFF

: wait
  vf := 2
  delay := vf
  loop
    vf := delay
    while vf != 0
  again
;

: main
  v0 := 28
  v1 := 13
  i := hat
  sprite v0 v1 6
  loop
    v2 := 0
    v3 := 0
    v4 := OCTO_KEY_A if v4 key then v2 := 255
    v4 := OCTO_KEY_D if v4 key then v2 := 1
    v4 := OCTO_KEY_W if v4 key then v3 := 255
    v4 := OCTO_KEY_S if v4 key then v3 := 1
    sprite v0 v1 6
    v0 += v2
    v1 += v3
    sprite v0 v1 6
    wait
  again
