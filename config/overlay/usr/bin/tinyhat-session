#!/bin/sh
mkdir -p "$HOME/downloads"
: "${BROWSER:=/usr/bin/netsurfy}"
: "${EDITOR:=/usr/bin/o}"
: "${MANPAGER:=/usr/bin/o}"
export BROWSER EDITOR MANPAGER
export GTK_A11Y=none WLR_XWAYLAND=/usr/bin/Xwayland DOSBOX_CONF=/etc/tinyhat/dosbox-x.conf:/run/tinyhat-midi/dosbox-x.conf EGL_LOG_LEVEL=fatal XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=dwl SDL_VIDEODRIVER=wayland SDL_FRAMEBUFFER_ACCELERATION=opengles2 SDL_RENDER_DRIVER=software SDL_VIDEO_WAYLAND_MODE_SCALING=aspect DRAW_USE_LLVM=0 O_THEME=xoria SDL_GAMECONTROLLERCONFIG_FILE="$HOME/.config/tinyhat/gamecontrollerdb.txt"
eval "$(MESA_SHADER_CACHE_DISABLE=true tinyhat-glinfo 2>/dev/null)"
TINYHAT_SDL_RENDER=software
if [ "${TINYHAT_GLES_VERSION:-0.0}" != 0.0 ]; then
	TINYHAT_SDL_RENDER=opengles2,opengl,software
elif [ "${TINYHAT_GL_VERSION%%.*}" -ge 3 ] 2>/dev/null || [ "${TINYHAT_GL_VERSION:-0}" = 2.1 ]; then
	TINYHAT_SDL_RENDER=opengl,software
fi
export TINYHAT_GL_VERSION TINYHAT_GLES_VERSION TINYHAT_GL_RENDERER TINYHAT_GL_SOFTWARE TINYHAT_SDL_RENDER
log=${XDG_RUNTIME_DIR:-/tmp}/dwl.log
printf '\033[?25l'
bar=${XDG_RUNTIME_DIR:-/tmp}/tinyhat-bar
for try in 1 2 3; do
	udevadm settle -t 30 2>/dev/null
	start=$(cut -d. -f1 /proc/uptime)
	rm -f "$bar"
	mkfifo -m 600 "$bar"
	tinyhat-status >"$bar" &
	status=$!
	MALLOC_MMAP_THRESHOLD_=131072 MALLOC_TRIM_THRESHOLD_=131072 dwl -s tinyhat-autostart <"$bar" >"$log" 2>&1
	rc=$?
	kill "$status" 2>/dev/null
	rm -f "$bar"
	[ "$rc" = 0 ] && exit 0
	[ "$(systemctl is-system-running 2>/dev/null)" = stopping ] && exit 0
	[ $(($(cut -d. -f1 /proc/uptime) - start)) -ge 20 ] && break
	grep -q 'Could not initialize renderer\|Failed to create renderer' "$log" && export WLR_RENDERER=pixman
	sleep 3
done
[ -p /run/tinyhat-splash ] && timeout 1 sh -c 'echo quit >/run/tinyhat-splash' 2>/dev/null
printf '\033[?25h'
tail -n 15 "$log"
echo "The graphical session stopped. The log is in $log. Type tinyhat-session to start it again."
