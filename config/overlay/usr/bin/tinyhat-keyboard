#!/bin/sh
conf=$HOME/.config/tinyhat/keyboard
bar=${XDG_RUNTIME_DIR:-/tmp}/tinyhat-bar
notice() { [ -p "$bar" ] && printf 'notice %s\n' "$1" >"$bar"; }
list=$(awk '/^! layout/ { f = 1; next } /^!/ { f = 0 } f && NF { c = $1; $1 = ""; sub(/^ +/, ""); print $0 " (" c ")" }' \
	/usr/share/X11/xkb/rules/base.lst 2>/dev/null | sort)
[ -n "$list" ] || { notice "Could not read the list of keyboard layouts" 6; exit 1; }
choice=$(printf '%s\n' "$list" | fuzzel --dmenu --prompt "Keyboard layout ❯ ") || exit 0
[ -n "$choice" ] || exit 0
code=$(printf '%s\n' "$choice" | sed 's/.*(//; s/)$//')
[ -n "$code" ] || exit 0
old=
[ -f "$conf" ] && old=$(cat "$conf")
[ "$code" = "$old" ] || {
	mkdir -p "${conf%/*}"
	echo "$code" >"$conf"
	pid=$(pidof dwl) && kill -USR1 $pid
}
notice "Keyboard layout: $choice"
if doas localectl set-x11-keymap "$code" 2>/dev/null && mountpoint -q /persist; then
	doas cp /etc/vconsole.conf /persist/vconsole.conf
fi
