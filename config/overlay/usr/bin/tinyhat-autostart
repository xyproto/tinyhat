#!/bin/sh
vars="WAYLAND_DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP SDL_VIDEODRIVER SDL_FRAMEBUFFER_ACCELERATION SDL_RENDER_DRIVER SDL_VIDEO_WAYLAND_MODE_SCALING TINYHAT_GL_VERSION TINYHAT_GLES_VERSION TINYHAT_GL_RENDERER TINYHAT_GL_SOFTWARE TINYHAT_SDL_RENDER${GSK_RENDERER:+ GSK_RENDERER}"
systemctl --user import-environment $vars
dbus-update-activation-environment --systemd $vars 2>/dev/null
tinyhat-wallpaper
[ -p /run/tinyhat-splash ] && timeout 1 sh -c 'echo handoff >/run/tinyhat-splash' 2>/dev/null
[ -e "$HOME/.config/mc/ini" ] || { mkdir -p "$HOME/.config/mc" && cp /etc/skel/.config/mc/ini "$HOME/.config/mc/ini"; }
tinyhat-soundd &
mkdir -p "$HOME/cprojects"
for d in /etc/skel/cprojects/*/; do
	d=${d%/}
	[ -e "$HOME/cprojects/${d##*/}" ] || cp -r "$d" "$HOME/cprojects/${d##*/}"
done
