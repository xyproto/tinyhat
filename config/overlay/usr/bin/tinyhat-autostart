#!/bin/sh
vars="WAYLAND_DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP SDL_VIDEODRIVER SDL_FRAMEBUFFER_ACCELERATION SDL_RENDER_DRIVER SDL_VIDEO_WAYLAND_MODE_SCALING TINYHAT_GL_VERSION TINYHAT_GLES_VERSION TINYHAT_GL_RENDERER TINYHAT_GL_SOFTWARE TINYHAT_SDL_RENDER${DRAW_USE_LLVM:+ DRAW_USE_LLVM}${GSK_RENDERER:+ GSK_RENDERER}${LIBGL_ALWAYS_SOFTWARE:+ LIBGL_ALWAYS_SOFTWARE}"
systemctl --user import-environment $vars
dbus-update-activation-environment --systemd $vars 2>/dev/null
[ -p /run/tinyhat-splash ] && timeout 1 sh -c 'echo handoff >/run/tinyhat-splash' 2>/dev/null
[ -e "$HOME/.config/mc/ini" ] || { mkdir -p "$HOME/.config/mc" && cp /etc/skel/.config/mc/ini "$HOME/.config/mc/ini"; }
for kind in cprojects asmprojects; do
	mkdir -p "$HOME/$kind"
	for d in "/etc/skel/$kind"/*/; do
		d=${d%/}
		[ -e "$HOME/$kind/${d##*/}" ] || cp -r "$d" "$HOME/$kind/${d##*/}"
	done
done
# The log of a kernel crash during an earlier boot, if the kernel kept one (see /usr/lib/tinyhat/crashlogs)
ls /var/lib/tinyhat/crashlogs/*.txt >/dev/null 2>&1 && tinyhat-crashlog-viewer &
