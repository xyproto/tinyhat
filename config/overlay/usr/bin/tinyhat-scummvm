#!/bin/sh
tinyhat-scan-games --fixup
ini=$HOME/.config/scummvm/scummvm.ini
if [ -f "$ini" ] && [ ! -e "$HOME/.config/scummvm/.tinyhat-surfacesdl" ]; then
	sed -i 's/^gfx_mode=opengl$/gfx_mode=surfacesdl/' "$ini"
	: >"$HOME/.config/scummvm/.tinyhat-surfacesdl"
fi
if [ -f "$ini" ] && [ ! -e "$HOME/.config/scummvm/.tinyhat-windowed" ]; then
	sed -i 's/^fullscreen=true$/fullscreen=false/' "$ini"
	: >"$HOME/.config/scummvm/.tinyhat-windowed"
fi
bench=/run/tinyhat-midi/dosbox-x.conf
rate=$(sed -n 's/^rate=//p' "$bench" 2>/dev/null)
frames=$(sed -n 's/^blocksize=//p' "$bench" 2>/dev/null)
[ -n "$rate" ] && set -- --output-rate="$rate" "$@"
tinyhat-slow && set -- --music-driver=adlib "$@"
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/tinyhat-scummvm.lock"
flock 9
LD_BIND_NOW=1 SDL_AUDIO_DEVICE_SAMPLE_FRAMES=${frames:-2048} SDL_RENDER_DRIVER=${TINYHAT_SCUMMVM_RENDER:-${TINYHAT_SDL_RENDER:-opengles2}} exec nice -n -5 scummvm --soundfont="$(tinyhat-soundfont)" "$@"
