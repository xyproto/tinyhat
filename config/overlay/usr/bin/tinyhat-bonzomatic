#!/bin/sh
if [ $# -eq 0 ] && [ ! -f config.json ]; then
	mode=
	for s in /sys/class/drm/card*-*/status; do
		[ "$(cat "$s" 2>/dev/null)" = connected ] || continue
		mode=$(head -n 1 "${s%/status}/modes" 2>/dev/null)
		[ -n "$mode" ] && break
	done
	w=${mode%%x*}
	h=${mode#*x}
	h=${h%%[!0-9]*}
	if [ -n "$w" ] && [ -n "$h" ]; then
		conf=${XDG_RUNTIME_DIR:-/tmp}/tinyhat-bonzomatic.json
		printf '{ "window": { "width": %s, "height": %s, "fullscreen": true } }\n' "$w" "$h" >"$conf"
		set -- "$conf"
	fi
fi
major=${TINYHAT_GL_VERSION%%.*}
minor=${TINYHAT_GL_VERSION#*.}
if [ -z "$TINYHAT_GL_VERSION" ] || [ "${major:-0}" -gt 4 ] || { [ "${major:-0}" -eq 4 ] && [ "${minor:-0}" -ge 1 ]; }; then
	start=$(date +%s)
	bonzomatic "$@" && exit 0
	[ $(($(date +%s) - start)) -lt 5 ] || exit 1
fi
tinyhat-notice "This graphics card lacks OpenGL 4.1, using the slower software renderer" 6
LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe MESA_GL_VERSION_OVERRIDE=4.1FC MESA_GLSL_VERSION_OVERRIDE=410 exec bonzomatic "$@"
