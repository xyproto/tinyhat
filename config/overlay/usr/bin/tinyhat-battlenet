#!/bin/sh
[ "$1" = --run ] || exec foot -T Battle.net "$0" --run
fail() {
	printf '\n%s\nPress Enter to close.\n' "$1"
	read -r _
	exit 1
}
doas pacman -Sy --noconfirm || fail "Could not update the package database."
doas pacman -S --needed --noconfirm wine-staging || fail "Could not install wine-staging."
setup=$HOME/.cache/tinyhat/Battle.net-Setup.exe
if [ ! -f "$setup" ]; then
	mkdir -p "${setup%/*}"
	curl -fL -o "$setup.tmp" 'https://www.battle.net/download/getInstallerForGame?os=win&gameProgram=BATTLENET_APP&version=Live' &&
		mv "$setup.tmp" "$setup" || fail "Could not download Battle.net."
fi
exec wine "$setup"
