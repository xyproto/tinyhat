#!/bin/sh
confdir=${XDG_CONFIG_HOME:-$HOME/.config}/tinyhat
hide=$confdir/hide-help
mode=$confdir/wallpaper
pidfile=${XDG_RUNTIME_DIR:-/tmp}/tinyhat-swaybg.pid
if [ "${1-}" = --cycle ]; then
	mkdir -p "$confdir"
	case $(cat "$mode" 2>/dev/null) in
	4) n=1 ;;
	1) n=0 ;;
	0) n=5 ;;
	5) n=2 ;;
	2) n=3 ;;
	*) if [ -e "$hide" ]; then n=3; else n=4; fi ;;
	esac
	if [ "$n" = 3 ]; then
		rm -f "$hide"
	fi
	echo "$n" >"$mode"
elif [ "${1-}" = --toggle ]; then
	mkdir -p "$confdir"
	if [ -e "$hide" ]; then
		rm -f "$hide"
	else
		: >"$hide"
	fi
fi
old=$(cat "$pidfile" 2>/dev/null)
case $(cat "$mode" 2>/dev/null) in
0) set -- -c 008080 ;;
1) set -- -c 000000 ;;
2) set -- -m fill -c 1a1b26 -i /usr/share/backgrounds/archlinux/small.png
	;;
4) set -- -m center -c 1a1b26 -i /usr/share/backgrounds/tinyhat/wirehat.png ;;
5) set -- -m tile -c 1a1b26 -i /usr/share/backgrounds/tinyhat/hundetann.png ;;
*) set -- -m left -c 1a1b26 -i /usr/share/backgrounds/tinyhat/wirehat.png
	[ -e "$hide" ] || set -- "$@" -t /etc/tinyhat/help.txt
	;;
esac
swaybg "$@" &
echo $! >"$pidfile"
if [ -n "$old" ] && [ "$(cat "/proc/$old/comm" 2>/dev/null)" = swaybg ]; then
	sleep 0.3
	kill "$old"
fi
