#!/usr/bin/fish

# Pick, cycle and swap the Tiny Hat desktop backgrounds.
# Backgrounds: 0 = plain teal, 1 = plain black, 2 = arch photo filled,
# 3 = help screen, 4 = arch photo centered, 5 = arch photo tiled.
# The numbering matches the old sh version, so a saved choice keeps working.

set -l confdir (set -q XDG_CONFIG_HOME[1]; and echo $XDG_CONFIG_HOME; or echo $HOME/.config)/tinyhat
set -l hidemark $confdir/hide-help
set -l modefile $confdir/wallpaper
set -l rundir (set -q XDG_RUNTIME_DIR[1]; and echo $XDG_RUNTIME_DIR; or echo /tmp)
set -l pidfile $rundir/tinyhat-swaybg.pid

# How the backgrounds cycle: help → centered image → black → teal → tiled → filled → back to help
set -l cycle 3 4 1 0 5 2

switch "$argv[1]"
case "--cycle"
	mkdir -p $confdir
	# Pick the next background. With the help hidden, the cycle starts at the help screen.
	set -l n (count $cycle)
	set -l pos (contains -i -- (cat $modefile 2>/dev/null) $cycle)
	if test -n "$pos"
		set mode $cycle[(math "(($pos) % $n) + 1")]
	else if test -e $hidemark
		set mode $cycle[1]
	else
		set mode 4
	end
	if test $mode = 3
		rm -f $hidemark
	end
	echo $mode > $modefile
case "--toggle"
	mkdir -p $confdir
	# Show or hide the panel with key hints
	if test -e $hidemark
		rm -f $hidemark
	else
		touch $hidemark
	end
end

set -l args
set -l mode (cat $modefile 2>/dev/null)
switch "$mode"
case 0
	set args -c 008080
case 1
	set args -c 000000
case 2
	set args -m fill -c 1a1b26 -i /usr/share/backgrounds/archlinux/small.png
case 4
	set args -m center -c 1a1b26 -i /usr/share/backgrounds/tinyhat/wirehat.png
case 5
	set args -m tile -c 1a1b26 -i /usr/share/backgrounds/tinyhat/hundetann.png
case '*'
	# The help screen, with the sorting-key hints on top, unless they were hidden
	set args -m left -c 1a1b26 -i /usr/share/backgrounds/tinyhat/wirehat.png
	if not test -e $hidemark
		set args $args -t /etc/tinyhat/help.txt
	end
end

# Start the new wallpaper bottom layer, then stop the one it replaced
set -l old (cat $pidfile 2>/dev/null)
swaybg $args &
echo $last_pid > $pidfile
set -l comm (cat /proc/$old/comm 2>/dev/null)
if test -n "$old"; and test "$comm" = swaybg
	sleep 0.3
	kill $old
end
