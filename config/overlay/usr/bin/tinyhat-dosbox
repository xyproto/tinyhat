#!/bin/sh
mkdir -p "$HOME/DOS"
set -- -conf /etc/tinyhat/dosbox-x.conf -userconf -fastlaunch "$@"
[ ! -f /run/tinyhat-midi/dosbox-x.conf ] || set -- "$@" -conf /run/tinyhat-midi/dosbox-x.conf
set -- "$@" -set "midi fluid.soundfont=$(tinyhat-soundfont)"
mt32=$HOME/.local/share/tinyhat/mt32
if [ -f "$mt32/MT32_CONTROL.ROM" ] || [ -f "$mt32/CM32L_CONTROL.ROM" ]; then
	set -- "$@" -set "midi mididevice=mt32" -set "midi mt32.romdir=$mt32/"
fi
removable=
harddisk=
for d in /media/*/; do
	mountpoint -q "$d" || continue
	dev=$(findmnt -no SOURCE --target "$d")
	case $(readlink -f "/sys/class/block/${dev##*/}") in
	*/usb* | */mmc*) [ -n "$removable" ] || removable=$d ;;
	*/block/sr*) [ -n "$removable" ] || removable=$d ;;
	*) [ -n "$harddisk" ] || harddisk=$d ;;
	esac
done
conf=${XDG_RUNTIME_DIR:-/tmp}/tinyhat-dosbox.conf
ae() { printf '%s\n' "$@" >>"$conf"; }
printf '[autoexec]\n' >"$conf"
set -- "$@" -conf "$conf"
ae "@echo off" "mount y /usr/share/tinyhat/dos -ro" "set PATH=Z:\\;Y:\\"
drivec="the DOS folder in your home directory"
drived=
drivee=
if [ -n "$harddisk" ] && [ -n "$(find "$harddisk" -maxdepth 1 \( -iname command.com -o -iname autoexec.bat \) -print -quit)" ]; then
	ae "mount c \"$harddisk\"" "mount e \"$HOME/DOS\""
	drivee=$drivec
	drivec="the DOS hard disk of this PC"
else
	ae "mount c \"$HOME/DOS\""
	if [ -n "$harddisk" ]; then
		ae "mount e \"$harddisk\""
		drivee="the hard disk of this PC"
	fi
fi
if [ -n "$removable" ]; then
	case $(findmnt -no FSTYPE --target "$removable") in
	iso9660 | udf) ae "mount d \"$removable\" -t cdrom" ;;
	*) ae "mount d \"$removable\"" ;;
	esac
	drived="the USB stick or CD"
fi
ae "cls" "c:" "echo Tiny Hat DOS" "echo." "echo C:  $drivec"
[ -z "$drived" ] || ae "echo D:  $drived"
[ -z "$drivee" ] || ae "echo E:  $drivee"
ae "echo." \
	"echo DIR lists files, CD NAME enters a folder, CD .. goes back." \
	"echo K lists the programs here. Type a program name to run it." \
	"echo Alt+Enter: fullscreen   Ctrl+F10: grab or release the mouse   EXIT: quit" \
	"echo." "@echo on"
LD_BIND_NOW=1 SDL_VIDEO_WAYLAND_MODE_SCALING=aspect43 exec nice -n -5 dosbox-x "$@"
