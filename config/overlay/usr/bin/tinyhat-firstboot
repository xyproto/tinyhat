#!/bin/sh
conf=$HOME/.config/tinyhat
[ -e "$conf/firstboot" ] && exit 0
mkdir -p "$conf"
: >"$conf/firstboot"
choice=$(printf 'Set up WiFi\nSet the keyboard layout\nSet the timezone\nSkip\n' |
	fuzzel --dmenu --prompt "Welcome to Tiny Hat ❯ ") || exit 0
case $choice in
"Set up WiFi") exec tinyhat-wifi ;;
"Set the keyboard layout") exec tinyhat-keyboard ;;
"Set the timezone") exec tinyhat-timezone ;;
esac
