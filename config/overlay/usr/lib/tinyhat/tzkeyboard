#!/bin/sh
cc=$(awk -v tz="$1" '!/^#/ && $3 == tz { print $1; exit }' /usr/share/zoneinfo/zone.tab)
case $cc in
AL | AT | AZ | BA | BE | BR | CH | CZ | DE | DK | EE | ES | FI | FO | FR | HR | HU | IS | IT | JP | KR | LT | LV | ME | MT | NO | PL | PT | RO | SE | SI | SK | TR | VN)
	echo "$cc" | tr A-Z a-z ;;
GB | IE | IM | JE | GG | GI) echo gb ;;
RS) echo "rs latin" ;;
LU) echo "ch fr" ;;
LI) echo ch ;;
SM | VA) echo it ;;
AD) echo es ;;
GL) echo dk ;;
SJ) echo no ;;
AX) echo fi ;;
DZ | MA | TN | MC) echo fr ;;
AR | BO | CL | CO | CR | CU | DO | EC | GT | HN | MX | NI | PA | PE | PR | PY | SV | UY | VE) echo latam ;;
*) echo us ;;
esac
