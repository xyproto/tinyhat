#!/bin/sh
dir=/etc/pacman.d/gnupg
ver=$(pacman -Q archlinux32-keyring 2>/dev/null)
[ -f "$dir/trustdb.gpg" ] || pacman-key --init || exit 1
[ "$(cat "$dir/.tinyhat-keyring" 2>/dev/null)" = "$ver" ] && exit 0
pacman-key --populate archlinux32 || exit 1
pacman-key --lsign-key 80EC18799E8BCD375C6E64ABE4D41569196B1160
echo "$ver" >"$dir/.tinyhat-keyring"
