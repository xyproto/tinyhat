#!/bin/sh
online() {
	awk '$2 == "00000000" { f = 1 } END { exit !f }' /proc/net/route ||
		awk '$1 ~ /^0+$/ && $2 == "00" && $10 != "lo" { f = 1 } END { exit !f }' /proc/net/ipv6_route
}
until online; do
	sleep 15
done
keyrings="archlinux32-keyring archlinux-keyring"
if pacman -Q archlinuxarm-keyring >/dev/null 2>&1; then
	keyrings=archlinuxarm-keyring
else
	pacman-key --lsign-key 80EC18799E8BCD375C6E64ABE4D41569196B1160 >/dev/null 2>&1
fi
tries=1
until /usr/lib/tinyhat/pacman -Sy --noconfirm --needed $keyrings; do
	[ "$tries" -lt 20 ] || exit 1
	tries=$((tries + 1))
	sleep 15
done
