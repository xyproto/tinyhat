#!/bin/sh
boot=$(cat /run/tinyhat/bootdev 2>/dev/null)
[ -b "$boot" ] || exit 0
disk=$(readlink -f "/sys/class/block/${boot#/dev/}/..")
disk=${disk##*/}
esp=
for p in /sys/block/"$disk"/"$disk"*/partition; do
	[ "$(cat "$p" 2>/dev/null)" = 1 ] && p=${p%/partition} && esp=/dev/${p##*/}
done
[ -b "$esp" ] && [ "$(blkid -p -s TYPE -o value "$esp")" = vfat ] || exit 0
until pidof dwl >/dev/null; do
	sleep 2
done
mnt=$(findmnt -rno TARGET -S "$esp" | head -n 1)
own=0
if [ -z "$mnt" ]; then
	mnt=/run/tinyhat/esp
	mkdir -p "$mnt"
	mount -t vfat -o noatime "$esp" "$mnt" || exit 0
	own=1
fi
env=$mnt/tinyhat/grubenv
if [ -f "$env" ] && [ "$(stat -c %s "$env")" = 1024 ] && grep -q '^gfx_pending=.' "$env"; then
	vars=$(grep -v '^#\|^gfx_pending=' "$env")
	hdr="# GRUB Environment Block"
	used=$(printf '%s\n%s' "$hdr" "$vars" | wc -c)
	[ -n "$vars" ] && used=$((used + 1))
	if [ "$used" -le 1024 ]; then
		{
			echo "$hdr"
			[ -n "$vars" ] && echo "$vars"
			head -c $((1024 - used)) /dev/zero | tr '\0' '#'
		} | dd of="$env" conv=notrunc,fsync status=none
	fi
fi
[ "$own" = 1 ] && umount "$mnt"
exit 0
