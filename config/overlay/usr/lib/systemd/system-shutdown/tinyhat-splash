#!/bin/sh
[ -p /run/tinyhat-splash ] || exit 0
i=0
while [ "$i" -lt 60 ] && grep -qx tinyhat-soundd /proc/[0-9]*/comm 2>/dev/null; do
	sleep 0.1
	i=$((i + 1))
done
timeout 1 sh -c 'echo burst >/run/tinyhat-splash' 2>/dev/null
i=0
while [ "$i" -lt 30 ] && [ ! -e /run/tinyhat-splash.done ]; do
	sleep 0.1
	i=$((i + 1))
done
