for _p in opencl-mesa vulkan-nouveau mesa-docs; do
  pkgname=(${pkgname[@]/$_p/})
done
for _p in rust-bindgen rust cbindgen python-sphinx-hawkmoth python-sphinx; do
  makedepends=(${makedepends[@]/$_p/})
done
eval "$(
  declare -f build | \
    sed '
      s/-D gallium-rusticl=true/-D gallium-rusticl=false/
      s/-D gallium-rusticl-enable-drivers=[^ ]* //
      s/-D html-docs=enabled/-D html-docs=disabled/
      s/microsoft-experimental,nouveau,/microsoft-experimental,/
      s/-D intel-rt=enabled/-D intel-rt=disabled/
      s/-D gallium-drivers=all/-D gallium-drivers=r300,r600,radeonsi,crocus,v3d,vc4,freedreno,etnaviv,i915,nouveau,svga,tegra,virgl,lima,panfrost,llvmpipe,softpipe,iris,d3d12,asahi,rocket,ethosu/
    '
  declare -f package_mesa | \
    sed '
      /_pick opencl /d
      /_pick vknvidia /d
      /_pick docs /d
    '
)"
if [ "$CARCH" = 'i686' ]; then
  eval "$(
    declare -f build | \
      sed '
        s/arch-meson /arch-meson -Dsse2=false /
      '
  )"
fi
_x='libx11|libxcb|libxext|libxrandr|libxshmfence|libxxf86vm|xcb-util-keysyms|xorgproto'
_d=(); for _p in "${makedepends[@]}"; do [[ $_p =~ ^($_x)$ ]] || _d+=("$_p"); done; makedepends=("${_d[@]}")
eval "$(
  declare -f build | sed 's/-D gles1=disabled/-D gles1=disabled -D platforms=wayland -D glx=disabled -D xlib-lease=disabled/'
  for _f in $(declare -F | awk '$3 ~ /^package_/ {print $3}'); do
    declare -f $_f | sed -E ':a; /depends=\(/s/([( ])('"$_x"')([ )])/\1\3/; ta'
  done
)"
eval "$(
  declare -f package_mesa | sed 's/ln -sr $libdir\/libGLX_{mesa,indirect}.so.0 )/)/'
)"
