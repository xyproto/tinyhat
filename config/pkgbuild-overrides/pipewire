pkgname=(${pkgname[@]/pipewire-onnx/})
pkgname=(${pkgname[@]/pipewire-roc/})
makedepends=(${makedepends[@]/onnxruntime/})
makedepends=(${makedepends[@]/roc-toolkit/})
eval "$(
  declare -f build | sed 's/-D bluez5-codec-lc3plus=disabled/-D bluez5-codec-lc3plus=disabled -D onnxruntime=disabled -D roc=disabled/'
  declare -f package_pipewire | sed '/_pick onnx /d; /_pick roc /d'
)"
makedepends=(${makedepends[@]/sdl2/})
eval "$(
  declare -f build | sed 's/-D selinux=disabled/-D selinux=disabled -D sdl2=disabled/'
)"
pkgname=(${pkgname[@]/pipewire-x11-bell/})
makedepends=(${makedepends[@]/libcanberra/})
makedepends=(${makedepends[@]/libx11/})
makedepends=(${makedepends[@]/libxfixes/})
eval "$(
  declare -f build | sed 's/-D selinux=disabled/-D selinux=disabled -D libcanberra=disabled -D x11=disabled -D x11-xfixes=disabled/'
  declare -f package_pipewire | sed '/_pick x11-bell /d; /pipewire-x11-bell: /d'
)"
