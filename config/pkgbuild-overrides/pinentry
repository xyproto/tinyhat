makedepends=($(printf '%s\n' "${makedepends[@]}" | grep -v -x -E 'qt[56]-.*|kguiaddons|kwindowsystem|gcr.*|efl|emacs|fltk|gtk2.*|libxml2-legacy'))
makedepends_i686=($(printf '%s\n' "${makedepends_i686[@]}" | grep -v -x -E 'gcr.*'))
eval "$(
  declare -f build | sed 's/--enable-libsecret/--enable-libsecret --disable-pinentry-efl --disable-pinentry-gtk2 --disable-pinentry-qt --disable-pinentry-qt5 --disable-pinentry-gnome3 --disable-pinentry-emacs --disable-pinentry-fltk --disable-pinentry-tqt/'
  declare -f package | sed '/pinentry-gtk/d'
)"
