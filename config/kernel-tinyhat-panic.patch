+static void draw_panic_kmsg_header(struct drm_scanout_buffer *sb, const struct font_desc *font,
+				   u32 fg_color, u32 bg_color)
+{
+	int msg_w = get_max_line_len(panic_msg, panic_msg_lines) * font->width;
+	int msg_h = panic_msg_lines * font->height;
+	struct drm_rect r_logo, r_msg, r_head;
+	int bottom;
+
+	drm_panic_logo_rect(&r_logo, font);
+	drm_rect_translate(&r_logo, font->width, font->height);
+	r_msg = DRM_RECT_INIT(r_logo.x2 + 3 * font->width,
+			      r_logo.y1 + max(0, drm_rect_height(&r_logo) - msg_h) / 2, msg_w, msg_h);
+	bottom = max(r_logo.y2, r_msg.y2) + font->height;
+	if (r_msg.x2 > sb->width || bottom > sb->height / 2)
+		return;
+	r_head = DRM_RECT_INIT(0, 0, sb->width, bottom);
+	drm_panic_fill(sb, &r_head, bg_color);
+	drm_panic_logo_draw(sb, &r_logo, font, fg_color);
+	draw_txt_rectangle(sb, font, panic_msg, panic_msg_lines, false, &r_msg, fg_color);
+}
