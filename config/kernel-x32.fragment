CONFIG_X86_X32_ABI=y
CONFIG_IA32_EMULATION=y
# Thermal zones and fan control of newer Intel laptops (64-bit only)
CONFIG_INT340X_THERMAL=m
CONFIG_LOCALVERSION="-tinyhat64"
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=y
CONFIG_EFIVAR_FS=y
CONFIG_NR_CPUS=64
CONFIG_NTSYNC=m
CONFIG_BINFMT_MISC=m
CONFIG_EFI_VARS_PSTORE=y
CONFIG_VMD=y
CONFIG_AMD_PMC=m
CONFIG_DRM_XE=m
CONFIG_SND_HDA_SCODEC_CS35L41_I2C=m
CONFIG_SND_HDA_SCODEC_CS35L41_SPI=m
CONFIG_SND_HDA_SCODEC_TAS2781_I2C=m
CONFIG_SND_HDA_SCODEC_TAS2781_SPI=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
