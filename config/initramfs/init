#!/bin/busybox sh
/bin/busybox --install -s /bin
export PATH=/bin

mount -t devtmpfs -o mode=0755,nosuid dev /dev
mount -t proc -o nosuid,nodev,noexec proc /proc
mount -t sysfs -o nosuid,nodev,noexec sys /sys
mount -t tmpfs -o mode=0755,nosuid,nodev run /run

label=TINYHAT
toram=auto
persist=1
mode=stick
init=/usr/lib/systemd/systemd
quiet=0
splash=1
for arg in $(cat /proc/cmdline); do
	case $arg in
	tinyhat.label=*) label=${arg#*=} ;;
	init=*) init=${arg#*=} ;;
	tinyhat.toram | tinyhat.toram=1) toram=1 ;;
	tinyhat.toram=0) toram=0 ;;
	tinyhat.nopersist) persist=0 ;;
	tinyhat.persist=*) mode=${arg#*=} ;;
	tinyhat.shell) sh ;;
	quiet) quiet=1 ;;
	tinyhat.nosplash) splash=0 ;;
	esac
done
[ ! -f /modules/order ] || while read -r m; do insmod "/modules/$m.ko"; done </modules/order
[ "$quiet" = 1 ] && printf '\033[?25l' >/dev/tty1 2>/dev/null
[ "$quiet" = 1 ] && [ "$splash" = 1 ] && [ -c /dev/fb0 ] && /bin/tinyhat-splash
if [ "$init" != /usr/lib/systemd/systemd ]; then
	echo 1 >/proc/sys/kernel/ctrl-alt-del
fi

say() {
	[ -p /run/tinyhat-splash ] && timeout 1 sh -c 'echo "$1" >/run/tinyhat-splash' sh "$1" 2>/dev/null
}

copy() {
	chunks=$((($(stat -c %s "$1") + 8388607) / 8388608))
	i=0
	while [ "$i" -lt "$chunks" ]; do
		dd if="$1" of="$2" bs=8M skip="$i" seek="$i" count=1 conv=notrunc 2>/dev/null || return 1
		i=$((i + 1))
		say "progress $((i * 100 / chunks))"
	done
}

rescue() {
	say quit
	echo "Tiny Hat: $*"
	echo "Dropping to a shell. Type 'exit' to try booting again."
	setsid cttyhack sh
}

xfs_label_is() {
	[ "$(dd if="$1" bs=4 count=1 2>/dev/null)" = XFSB ] &&
		[ "$(dd if="$1" bs=1 skip=108 count=12 2>/dev/null | tr -d '\0')" = "$2" ]
}

tinyhat_disk() {
	[ "$(/usr/bin/sfdisk --disk-id "/dev/$1" 2>/dev/null)" = 0x7417a700 ]
}

find_label() {
	for b in ${2:-/sys/class/block/*}; do
		d=/dev/${b##*/}
		[ -b "$d" ] || continue
		xfs_label_is "$d" "$1" && echo "$d" && return 0
	done
	return 1
}

find_cd() {
	for b in /sys/class/block/sr*; do
		d=/dev/${b##*/}
		[ -b "$d" ] || continue
		[ "$(dd if="$d" bs=1 skip=32769 count=5 2>/dev/null)" = CD001 ] || continue
		mkdir -p /run/tinyhat/boot
		mount -t iso9660 -o ro "$d" /run/tinyhat/boot 2>/dev/null || continue
		[ -f /run/tinyhat/boot/tinyhat/root.sfs ] && echo "$d" && return 0
		umount /run/tinyhat/boot
	done
	return 1
}

removable() {
	[ "$(cat "/sys/block/$1/removable" 2>/dev/null)" = 1 ] && return 0
	case $(readlink -f "/sys/block/$1/device") in */usb*) return 0 ;; esac
	[ "$(cat "/sys/block/$1/device/type" 2>/dev/null)" = SD ]
}

fstype() {
	blkid "$1" 2>/dev/null | sed -n 's/.* TYPE="\([^"]*\)".*/\1/p'
}

hostmount() {
	case $(fstype "$1") in
	ext2 | ext3 | ext4) set -- "$1" "$2" ext4 "$3" ;;
	xfs) set -- "$1" "$2" xfs "$3" ;;
	vfat) set -- "$1" "$2" vfat "$3,flush" ;;
	exfat) set -- "$1" "$2" exfat "$3" ;;
	ntfs) set -- "$1" "$2" ntfs3 "$3" ;;
	*) return 1 ;;
	esac
	mount -t "$3" -o "$4" "$1" "$2" 2>/dev/null
}

hibernated() {
	case $(fstype "$1") in
	ext3 | ext4) [ $(($(od -An -tu4 -j 1120 -N 4 "$1") & 4)) -ne 0 ] ;;
	ntfs) case $(head -c 4 "$2/hiberfil.sys" 2>/dev/null) in hibr | HIBR | wake | WAKE) return 0 ;; esac; return 1 ;;
	*) return 1 ;;
	esac
}

find_savefile() {
	for b in /sys/block/*; do
		n=${b##*/}
		case $n in loop* | ram* | zram* | sr* | fd* | "$1") continue ;; esac
		removable "$n" && continue
		for p in "$b/$n"*; do
			[ -f "$p/partition" ] || continue
			d=/dev/${p##*/}
			[ -b "$d" ] || continue
			case $(fstype "$d") in
			ext2 | ext3 | ext4) o=ro,noload ;;
			xfs) o=ro,norecovery ;;
			vfat | exfat | ntfs) o=ro ;;
			*) continue ;;
			esac
			hostmount "$d" /run/tinyhat/host "$o" || continue
			f=/run/tinyhat/host/tinyhat/config.img
			if [ -f "$f" ] && xfs_label_is "$f" THCONFIG && ! hibernated "$d" /run/tinyhat/host; then
				umount /run/tinyhat/host
				hostmount "$d" /run/tinyhat/host noatime || return 1
				if grep -q "^$d /run/tinyhat/host [^ ]* rw[, ]" /proc/mounts &&
					mount -t xfs -o loop,noatime,lazytime "$f" /run/tinyhat/data; then
					return 0
				fi
				umount /run/tinyhat/host
				return 1
			fi
			umount /run/tinyhat/host
		done
	done
	return 1
}

exitrd() {
	mkdir -p /run/initramfs/bin
	cp /bin/busybox /run/initramfs/bin/busybox
	cat >/run/initramfs/shutdown <<'EOF'
#!/bin/busybox sh
/bin/busybox mkdir -p /proc /sys /dev /tmp
/bin/busybox --install -s /bin
export PATH=/bin
[ -e /proc/mounts ] || mount -t proc proc /proc
[ -e /dev/null ] || mount -t devtmpfs dev /dev
sync
for i in 1 2 3 4 5 6; do
	awk '$2 ~ "^/oldroot" { print $2 }' /proc/mounts | sort -r | while read -r m; do
		umount "$m" 2>/dev/null || mount -o remount,ro "$m" 2>/dev/null
	done
	for l in /sys/block/loop*; do
		[ -e "$l/loop/backing_file" ] && losetup -d "/dev/${l##*/}" 2>/dev/null
	done
	grep -q " /oldroot" /proc/mounts || break
done
sync
case $1 in
reboot) reboot -f ;;
halt) halt -f ;;
*) poweroff -f ;;
esac
EOF
	chmod 755 /run/initramfs/shutdown
}

uptime() { read -r up _ </proc/uptime; echo "${up%.*}"; }

partnum() {
	for p in /sys/block/"$disk"/"$disk"*/partition; do
		[ "$(cat "$p" 2>/dev/null)" = "$1" ] && p=${p%/partition} && echo "/dev/${p##*/}" && return 0
	done
	return 1
}

make_data() {
	[ -x /usr/bin/mkfs.xfs ] && [ "$(partnum 2)" = "$dev" ] || return 1
	tinyhat_disk "$disk" || return 1
	case $(/usr/bin/sfdisk --part-type "/dev/$disk" 1 2>/dev/null) in ef | c) ;; *) return 1 ;; esac
	count=$(ls -d /sys/block/"$disk"/"$disk"*/partition 2>/dev/null | wc -l)
	[ "$quiet" = 1 ] || echo "Tiny Hat: creating persistent storage on the rest of the drive (one time only)"
	say "msg Creating persistent storage (one time only)"
	say "progress 5"
	if [ "$count" = 2 ]; then
		free=$(/usr/bin/sfdisk -F -q "/dev/$disk" 2>/dev/null | awk 'END { print $3 }')
		[ -n "$free" ] && [ $((free / 2048)) -ge 64 ] || return 1
		echo ",,L" | /usr/bin/sfdisk --append --no-reread -q "/dev/$disk" >/dev/null 2>&1 || return 1
		/usr/bin/partx -a "/dev/$disk" 2>/dev/null || /usr/bin/partx -u "/dev/$disk" 2>/dev/null
	elif [ "$count" != 3 ]; then
		return 1
	fi
	i=0
	until part=$(partnum 3) && [ -b "$part" ]; do
		[ "$i" -lt 50 ] || return 1
		sleep 0.1
		i=$((i + 1))
	done
	[ "$(/usr/bin/sfdisk --part-type "/dev/$disk" 3 2>/dev/null)" = 83 ] && [ -z "$(/usr/bin/wipefs -n "$part" 2>&1)" ] || return 1
	say "progress 35"
	say "msg Formatting persistent storage"
	TEST_DIR=1 TEST_DEV=1 QA_CHECK_FS=xfs /usr/bin/mkfs.xfs -q -f -K -l size=16m -L THDATA "$part" >/dev/null 2>&1 || return 1
	mount -t xfs -o noatime "$part" /run/tinyhat/data || return 1
	: >/run/tinyhat/data/.tinyhat-seed
	umount /run/tinyhat/data
	say "progress 100"
}

deadline=$(($(uptime) + 30))
while :; do
	dev=$(find_label "$label") && break
	dev=$(find_cd) && break
	if [ "$(uptime)" -ge $deadline ]; then
		rescue "no bootable partition, USB stick or CDROM labeled $label found"
		deadline=$(($(uptime) + 30))
	fi
	sleep 0.2
done

mkdir -p /run/tinyhat/boot /run/tinyhat/lower /run/tinyhat/rw /newroot
case $dev in
/dev/sr*) ;;
*) mount -t xfs -o ro,noatime "$dev" /run/tinyhat/boot || rescue "could not mount $dev" ;;
esac
sfs=/run/tinyhat/boot/tinyhat/root.sfs
if [ "$toram" = auto ]; then
	toram=0
	mem_kb=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
	sfs_kb=$(($(stat -c %s "$sfs") / 1024))
	[ "$mem_kb" -ge $((sfs_kb + 250 * 1024)) ] && toram=1
fi
if [ "$toram" = 1 ]; then
	[ "$quiet" = 1 ] || echo "Tiny Hat: copying the system to RAM, this takes a moment..."
	mount -t tmpfs -o size=90%,mode=0755 ram /run/tinyhat/rw
	say "msg Copying Tiny Hat to RAM"
	if copy "$sfs" /run/tinyhat/rw/root.sfs; then
		sfs=/run/tinyhat/rw/root.sfs
		: >/run/tinyhat/toram
	else
		rm -f /run/tinyhat/rw/root.sfs
	fi
	say "progress -1"
	say "msg"
else
	mount -t tmpfs -o size=75%,mode=0755 rw /run/tinyhat/rw
fi
mount -t squashfs -o ro,loop "$sfs" /run/tinyhat/lower || rescue "could not mount $sfs"
mkdir -p /run/tinyhat/data /run/tinyhat/host
disk=$(readlink -f "/sys/class/block/${dev#/dev/}/..")
disk=${disk##*/}
[ -f "/sys/class/block/${dev#/dev/}/partition" ] && [ -d "/sys/block/$disk" ] || persist=0
case $mode in
"" | stick) { removable "$disk" || tinyhat_disk "$disk"; } && where=disk || where= ;;
machine) removable "$disk" && where=file || where=disk ;;
*) where= ;;
esac
[ "$persist" = 1 ] || where=
if [ "$where" = disk ] && ! find_label THDATA "/sys/block/$disk/$disk*" >/dev/null; then
	make_data
	say "progress -1"
	say "msg"
fi
if [ "$where" = disk ] && data=$(find_label THDATA "/sys/block/$disk/$disk*") && [ "$data" != "$dev" ]; then
	mount -t xfs -o noatime,lazytime "$data" /run/tinyhat/data || where=
elif [ "$where" = file ] && find_savefile "$disk"; then
	exitrd
else
	where=
fi
if [ -n "$where" ] && [ -f /run/tinyhat/data/state/bootanim/hat ] && [ -p /run/tinyhat-splash ]; then
	say "hat /run/tinyhat/lower /run/tinyhat/data/state/bootanim/hat"
	i=0
	while [ ! -e /run/tinyhat-splash.hat ] && [ "$i" -lt 20 ]; do
		sleep 0.1
		i=$((i + 1))
	done
fi
if [ -n "$where" ]; then
	root=root-$(od -An -tu4 -j8 -N4 "$sfs" | tr -d ' ')
	mkdir -p "/run/tinyhat/data/$root/upper" "/run/tinyhat/data/$root/work"
	mount -t overlay -o lowerdir=/run/tinyhat/lower,upperdir=/run/tinyhat/data/$root/upper,workdir=/run/tinyhat/data/$root/work overlay /newroot &&
		echo "$root" >/run/tinyhat/persistroot
fi
if [ ! -f /run/tinyhat/persistroot ]; then
	mkdir -p /run/tinyhat/rw/upper /run/tinyhat/rw/work
	mount -t overlay -o lowerdir=/run/tinyhat/lower,upperdir=/run/tinyhat/rw/upper,workdir=/run/tinyhat/rw/work overlay /newroot || rescue "could not mount the overlay"
fi
umount -l /run/tinyhat/lower /run/tinyhat/rw /run/tinyhat/boot
[ "$where" = disk ] && umount -l /run/tinyhat/data
if [ "$where" = file ] && [ ! -f /run/tinyhat/persistroot ]; then
	umount /run/tinyhat/data
	umount /run/tinyhat/host
	rm -rf /run/initramfs
fi

echo "$dev" >/run/tinyhat/bootdev
if [ "$init" != /usr/lib/systemd/systemd ]; then
	printf '\033[?25h'
	say quit
	sleep 0.3
fi
mount --move /run /newroot/run
umount /sys /proc
exec switch_root /newroot "$init"
