configuration {
    show-icons: true;
    icon-theme: "tinyhat";
    font: "JetBrains Mono NL Bold 14";
    terminal: "foot";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    drun-display-format: "{name}";
    display-drun: "❯";
    display-run: "run ❯";
    display-window: "window ❯";
    kb-cancel: "Escape,Control+g,Control+c";
    kb-secondary-copy: "";
}

* {
    bg: #0e3a3aff;
    fg: #ffffffff;
    match: #7fdfd8ff;
    selection: #1a9e96ff;
    selection-fg: #ffffffff;
    selection-match: #c9fff7ff;
    border-color: #2ab8b0ff;
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 40%;
    padding: 8px;
    background-color: @bg;
    border: 2px;
    border-color: @border-color;
    border-radius: 8px;
}

inputbar {
    children: [prompt, entry];
    spacing: 8px;
    padding: 4px 8px;
}

prompt {
    text-color: @match;
}

entry {
    cursor: text;
    placeholder: "";
}

listview {
    lines: 15;
    spacing: 2px;
    scrollbar: false;
    fixed-height: false;
}

element {
    padding: 4px 8px;
    spacing: 8px;
    border-radius: 4px;
}

element selected {
    background-color: @selection;
    text-color: @selection-fg;
}

element-icon {
    size: 1.2em;
    background-color: inherit;
}

element-text {
    vertical-align: 0.5;
    background-color: inherit;
    text-color: inherit;
    highlight: bold #7fdfd8;
}

element-text selected {
    highlight: bold #c9fff7;
}
