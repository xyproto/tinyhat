--- a/src/video/wayland/SDL_waylandframebuffer.c	1970-01-01 01:00:00.000000000 +0100
+++ b/src/video/wayland/SDL_waylandframebuffer.c	2026-10-05 12:01:59.668006949 +0200
@@ -0,0 +1,170 @@
+/*
