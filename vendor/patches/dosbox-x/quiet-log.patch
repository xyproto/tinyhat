@@ -48,6 +48,33 @@
 extern bool logging_con;
 
 static bool has_LOG_Init = false;
+static std::string early_log;
+
+static void flush_early_log(void) {
+	if (early_log.empty()) return;
+	fputs(early_log.c_str(),stderr);
+	fflush(stderr);
+	early_log.clear();
+}
+
+static void print_quiet_con(const char *s) {
+	std::string out;
+	for (; *s; s++) {
+		if (*s == 27) {
+			if (s[1] == '[') {
+				s += 2;
+				while (*s && !(*s >= 0x40 && *s <= 0x7e)) s++;
+				if (!*s) break;
+			}
+			else if (s[1]) s++;
+			continue;
+		}
+		out += *s;
+	}
+	if (out.empty()) return;
+	fprintf(stdout,"%s\n",out.c_str());
+	fflush(stdout);
+}
 static bool has_LOG_EarlyInit = false;
 static bool do_LOG_stderr = false;
 
