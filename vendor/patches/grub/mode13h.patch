 static grub_err_t
+grub_video_vga_set_palette (unsigned int start, unsigned int count,
+                            struct grub_video_palette_data *palette_data)
+{
+  unsigned int i;
+
+  if (!mode13)
+    return grub_error (GRUB_ERR_IO, "can't change palette");
+
+  for (i = 0; i < count && start + i < 256; i++)
+    grub_vga_palette_write (start + i, palette_data[i].r >> 2,
+			    palette_data[i].g >> 2, palette_data[i].b >> 2);
+
+  return grub_video_fb_set_palette (start, count, palette_data);
+}
+
+static grub_err_t
+grub_video_vga_setup_mode13 (grub_video_mode_type_t mode_type,
+			     grub_video_mode_type_t mode_mask)
+{
+  struct grub_video_palette_data palette[256];
+  grub_err_t err;
+  unsigned int i, r, g, b;
+
+  if ((mode_mask & GRUB_VIDEO_MODE_TYPE_DEPTH_MASK)
+      && ((mode_type & GRUB_VIDEO_MODE_TYPE_DEPTH_MASK)
+	  >> GRUB_VIDEO_MODE_TYPE_DEPTH_POS) != 8)
+    return grub_error (GRUB_ERR_UNKNOWN_DEVICE, "no matching mode found");
+
+  framebuffer.temporary_buffer = grub_calloc (MODE13_HEIGHT, MODE13_WIDTH);
+  framebuffer.front_page = 0;
+  framebuffer.back_page = 0;
+  if (!framebuffer.temporary_buffer)
+    return grub_errno;
+
+  saved_map_mask = get_map_mask ();
+
+  text_mode = grub_vga_set_mode (0x13);
+  setup = 1;
+  mode13 = 1;
+
+  grub_memset (&framebuffer.mode_info, 0, sizeof (framebuffer.mode_info));
+  framebuffer.mode_info.width = MODE13_WIDTH;
+  framebuffer.mode_info.height = MODE13_HEIGHT;
+  framebuffer.mode_info.mode_type = GRUB_VIDEO_MODE_TYPE_INDEX_COLOR
+    | GRUB_VIDEO_MODE_TYPE_DOUBLE_BUFFERED
+    | GRUB_VIDEO_MODE_TYPE_UPDATING_SWAP;
+  framebuffer.mode_info.bpp = 8;
+  framebuffer.mode_info.bytes_per_pixel = 1;
+  framebuffer.mode_info.pitch = MODE13_WIDTH;
+  framebuffer.mode_info.number_of_colors = 256;
+  framebuffer.mode_info.blit_format
+    = grub_video_get_blit_format (&framebuffer.mode_info);
+
+  err = grub_video_fb_create_render_target_from_pointer (&framebuffer.render_target,
+							 &framebuffer.mode_info,
+							 framebuffer.temporary_buffer);
+  if (err)
+    return err;
+
+  is_target = 1;
+  err = grub_video_fb_set_active_render_target (framebuffer.render_target);
+  if (err)
+    return err;
+
+  for (i = 0; i < GRUB_VIDEO_FBSTD_NUMCOLORS; i++)
+    palette[i] = grub_video_fbstd_colors[i];
+  for (r = 0; r < 6; r++)
+    for (g = 0; g < 6; g++)
+      for (b = 0; b < 6; b++, i++)
+	{
+	  palette[i].r = r * 51;
+	  palette[i].g = g * 51;
+	  palette[i].b = b * 51;
+	  palette[i].a = 255;
+	}
+  for (r = 1; i < 256; r++, i++)
+    {
+      palette[i].r = palette[i].g = palette[i].b = r * 10;
+      palette[i].a = 255;
+    }
+
+  return grub_video_vga_set_palette (0, 256, palette);
+}
